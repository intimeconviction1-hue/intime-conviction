---
import { CULTURE } from '../lib/culture.mjs';
const { titre = 'Livres, films et histoire' } = Astro.props;
---
<section class="culture-selection" aria-labelledby="titre-culture">
  <div class="titre-section"><h2 id="titre-culture">{titre}</h2><a href="/rubrique/le-greffe/">Voir les livres et les films</a></div>
  <p class="culture-intro">Cinéma, livres et histoire : trois portes d’entrée dans la culture judiciaire.</p>
  <ul>{CULTURE.map(c=><li><p class="meta">{c.genre} · {c.auteur}</p><h3><a href={'/culture/'+c.slug+'/'}>{c.titre}</a></h3><p>{c.extrait}</p><a class="ouvrir" href={'/culture/'+c.slug+'/'}>Découvrir cette œuvre <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></li>)}</ul>
</section>
<style>
  .culture-intro { color:var(--encre-2); margin:0 0 1.5rem; }
  ul { display:grid; grid-template-columns:1.35fr 1fr 1fr; padding:0; margin:0; list-style:none; counter-reset:culture; border-bottom:1px solid var(--filet); }
  li { counter-increment:culture; min-width:0; padding:1.5rem; border-top:1px solid var(--filet); border-right:1px solid var(--filet); display:flex; flex-direction:column; }
  li:first-child { padding-left:0; }li:last-child { border-right:0; }
  h3 { font-size:2rem; line-height:1.1; margin:0.75rem 0; }li:first-child h3 { font-size:clamp(2rem,3.5vw,3rem); font-style:normal; }
  li>p:not(.meta) { font-size:1.0625rem; color:var(--encre-2); margin:0 0 1rem; }
  .meta { margin:0; }.ouvrir { display:inline-flex; align-items:center; gap:1rem; min-height:44px; margin-top:auto; font-family:var(--sans); font-size:0.75rem; }
  @media(max-width:47.99rem) { ul { grid-template-columns:minmax(0,1fr); }li { padding:1.25rem 0; border-right:0; } }

  ul{gap:1rem;border-bottom:0;grid-template-columns:repeat(3,minmax(0,1fr))}li,li:first-child{padding:1.5rem;background:var(--pied);color:var(--pied-texte);border:0;min-height:340px;position:relative}li::before{content:counter(culture,decimal-leading-zero);font:600 3.5rem/1 var(--serif);color:var(--pied-survol);margin-bottom:1.5rem}li .meta,li>p:not(.meta){color:#c9c6c0}h3,li:first-child h3{font-size:2rem;font-weight:600;font-style:normal}li a:hover{color:var(--pied-survol)}.ouvrir{padding-top:1rem;border-top:1px solid #ffffff33} @media(max-width:47.99rem){ul{grid-template-columns:1fr}li,li:first-child{min-height:0;padding:1.5rem}li::before{font-size:2.5rem;margin-bottom:1rem}}

/* Cartes culture selon l'identite signaletique. */
.culture-selection{padding-bottom:1.5rem}
.culture-intro{font:650 .91rem/1.6 var(--sans);text-transform:uppercase}
ul{gap:0;grid-template-columns:repeat(3,minmax(0,1fr));border:2px solid #111314;background:#111314}
li,li:first-child{background:#17191a;color:#fff;border:0;border-right:2px solid #333;padding:2rem;min-height:380px}
li:last-child{border-right:0}
li::before{background:#ffe100;display:inline-flex;align-self:start;color:#111314;padding:.3rem .56rem;font:900 1rem/1.2 var(--sans);margin-bottom:3rem}
li .meta{font-weight:850;letter-spacing:.07em;text-transform:uppercase;color:#ffe100}
li>p:not(.meta){color:#d0d0cc;font:450 .93rem/1.65 var(--sans)}
h3,li:first-child h3{font:900 clamp(1.7rem,2.7vw,2.65rem)/1.08 var(--sans);letter-spacing:-.055em;text-transform:uppercase}
li a:hover{color:#ffe100}
.ouvrir{color:#fff;font:850 .7rem/1.45 var(--sans);text-transform:uppercase;letter-spacing:.03em;border-color:#555}
@media(max-width:63.99rem){li,li:first-child{padding:1.3rem;min-height:360px}}
@media(max-width:47.99rem){ul{grid-template-columns:1fr}li,li:first-child{min-height:0;padding:1.5rem;border-right:0;border-bottom:2px solid #515151}li::before{margin-bottom:1.5rem}li:last-child{border-bottom:0}}

</style>
