---
import { getImage } from 'astro:assets';
const { image, fallbackImage, alt, source, credit, licence, licenceUrl, prioritaire = false, responsiveImages = false, legendeCompacte = false } = Astro.props;
const responsiveWidths = responsiveImages && image.format ? [...new Set([360, 640, 960].map(width => Math.min(width, image.width)))].filter(width => width > 0) : [];
const responsiveSources = responsiveImages ? await Promise.all(responsiveWidths.map(width => getImage({ src: image, width, format: 'webp', quality: 84 }))) : [];
const responsiveSrcset = responsiveSources.map((variant, index) => `${variant.src} ${responsiveWidths[index]}w`).join(', ');
---
<figure class="visuel-assises">
  <img src={image.src} srcset={responsiveSrcset || undefined} sizes={responsiveImages ? "(max-width: 37rem) 100vw, (max-width: 58rem) 50vw, 33vw" : undefined} width={image.width} height={image.height} alt={alt} loading={prioritaire ? 'eager' : 'lazy'} decoding="async" data-fallback-src={fallbackImage?.src} onerror="if (this.dataset.fallbackSrc && this.src !== this.dataset.fallbackSrc) { this.removeAttribute('srcset'); this.removeAttribute('sizes'); this.src = this.dataset.fallbackSrc; this.onerror = null; }" />
  <figcaption>
    {legendeCompacte ? <>
      <span>{/génér/i.test(credit ?? '') ? 'Illustration générée' : 'Visuel'}</span>
      <details class="credits-photo"><summary>Crédits photo</summary><span>{alt}{credit && <> · <a href={source}>{credit}</a></>}{licence && <> · <a href={licenceUrl}>{licence}</a></>}</span></details>
    </> : <>{alt} · <a href={source}>{credit}</a>{licence && <> · <a href={licenceUrl}>{licence}</a></>}</>}
  </figcaption>
</figure>
<style>
  .visuel-assises{margin:0;background:#f7f3ec;min-width:0;color:#34302c}
  img{display:block;width:100%;height:auto;max-height:24rem;object-fit:contain}
  figcaption{padding:.65rem .8rem;font:.76rem/1.45 var(--sans);border-top:1px solid #d9cfc3}
  a{text-decoration:underline;text-underline-offset:.14em}
  .credits-photo{display:inline;margin-left:.45rem}
  .credits-photo summary{display:inline;cursor:pointer;text-decoration:underline;text-underline-offset:.14em}
  .credits-photo summary::marker{content:''}
  .credits-photo[open] span{display:block;margin-top:.3rem}
</style>
