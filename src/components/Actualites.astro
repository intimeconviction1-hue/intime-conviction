---
import { lienDirectPresse } from '../lib/fil-actualites.mjs';
import { lireActualites } from '../lib/veille.mjs';
import { hierarchiserPresse } from '../lib/hierarchiser-presse.mjs';
import { presenterTitrePresse, extraitPresseValide } from '../lib/presentation-presse.mjs';
import { regrouperPresseAccueil } from '../lib/regrouper-presse.mjs';
import { rubrique } from '../lib/rubriques.mjs';
import { photosArticles, illustrationNeutre } from '../lib/photos-articles.mjs';
import croquisAudience from '../assets/croquis-audience-panoramique.webp';
import croquisManchette from '../assets/croquis-manchette.webp';
import croquisDossier from '../assets/dossier-delibere-croquis.webp';
import croquisBandeau from '../assets/croquis-audience-bandeau.webp';
import croquisCode from '../assets/code-procedure-penale-croquis.webp';
import croquisAssises from '../assets/assises-landru.webp';
const { rubriqueSlug = 'cours-du-jour', limite = 8, titre, lienRubrique = true, debut = 0, compacte = false, accueil = false, imagesExclues = [] } = Astro.props;
const r = rubrique(rubriqueSlug);
const titreAffiche = titre ?? r.libelle;
const fil = await lireActualites();
const candidates = hierarchiserPresse((fil?.articles ?? []).filter(n=>n.rubrique === rubriqueSlug)).slice(debut);
const nouvelles = regrouperPresseAccueil(candidates).slice(0, limite);
const afficher = nouvelles.length > 0 || rubriqueSlug === 'cours-du-jour';
const formatDate = new Intl.DateTimeFormat('fr-FR',{day:'numeric',month:'long',year:'numeric',timeZone:'Europe/Paris'});

// Une photographie d'un tribunal n'est utilisée que si le titre indique
// explicitement le lieu correspondant. Sinon, illustration non documentaire.
const visuelsParLieu = [
  [/\b(aix[- ]en[- ]provence|aix|sollacaro|ettori)\b/i, '/proces-sollacaro-et-tout-recommence-aux-assises/11/2026/'],
  [/\b(blois|inass touloub)\b/i, '/inass-touloub-a-blois-le-poids-des-trente-neuf-annees/11/2026/'],
  [/\b(tulle)\b/i, '/mort-lyanna-tulle-proces-ajourne/11/2026/'],
  [/\b(vannes)\b/i, '/vannes-verdict-inceste-en-appel/11/2026/'],
  [/\b(limoges|saint[- ]junien)\b/i, '/saint-junien-verdict-coups-et-menaces/11/2026/'],
  [/\b(saint[- ]brieuc)\b/i, '/affaire-ferreira-ce-que-les-aveux-permettent-de-verifier/11/2026/'],
  [/\b(paris|zecler)\b/i, '/michel-zecler-les-excuses-face-aux-images/11/2026/'],
];
const illustrationsGeneriques = [
  croquisAudience, croquisManchette, croquisDossier,
  croquisBandeau, croquisCode, croquisAssises,
];
// Attribution pour l'ensemble des cartes : une image ne peut être retenue
// qu'une seule fois sur l'accueil, même lorsque deux titres citent le même lieu.
function choisirVisuelsPresse(articles) {
  const imagesUtilisees = new Set(imagesExclues.filter(Boolean));
  return articles.map(({titre}, index) => {
    const correspondant = visuelsParLieu.find(([motif]) => motif.test(titre));
    const photoLieu = correspondant && photosArticles[correspondant[1]];
    if (photoLieu && !imagesUtilisees.has(photoLieu.image.src)) {
      imagesUtilisees.add(photoLieu.image.src);
      return {...photoLieu, estIllustration: true};
    }
    // Repli documentaire neutre, jamais un autre tribunal présenté comme le lieu du procès.
    const image = illustrationsGeneriques.find(image => !imagesUtilisees.has(image.src));
    if (!image) throw new Error('Photothèque insuffisante : impossible de proposer des visuels uniques à la une. Ajouter de nouvelles illustrations distinctes et créditées.');
    imagesUtilisees.add(image.src);
    return {...illustrationNeutre, image, estIllustration: true,
      lieu: 'Illustration judiciaire générique · Ne représente pas les faits rapportés',
      source: image.src, lienLicence: image.src};
  });
}
// La photothèque privée fournit une sélection de visuels d'archives neutres,
// distincts de ceux des articles de la rédaction. Aucune autre image privée
// n'est accessible au composant ou à la page publique.
let imagesPressePrivees = [];
try {
  const { readFileSync, existsSync } = await import('node:fs');
  if (existsSync('.cache/photos-presse.json')) {
    imagesPressePrivees = JSON.parse(readFileSync('.cache/photos-presse.json', 'utf8'));
  }
} catch (erreur) {
  throw new Error('Sélection photographique de presse invalide : ' + erreur.message);
}
const selectionPresse = (articles) => {
  if (!imagesPressePrivees.length) return choisirVisuelsPresse(articles);
  const reserve = new Set(imagesExclues.filter(Boolean));
  const choix = [];
  // Privilégier une variété stable sur chaque affichage, plutôt que
  // réutiliser systématiquement les cinq premières photographies.
  for (const article of articles) {
    const texte = [article.titre, article.source, article.lien].join('|');
    let h = 2166136261;
    for (const char of texte) h = Math.imul(h ^ char.charCodeAt(0), 16777619) >>> 0;
    const debut = h % imagesPressePrivees.length;
    const photo = Array.from({length:imagesPressePrivees.length}, (_, i) =>
      imagesPressePrivees[(debut + i) % imagesPressePrivees.length]
    ).find(item => !reserve.has(item.image.src));
    if (!photo) throw new Error('Sélection presse insuffisante pour illustrer toutes les cartes sans doublon.');
    reserve.add(photo.image.src);
    choix.push(photo);
  }
  return choix;
};
const visuelsAccueil = accueil ? selectionPresse(nouvelles) : [];

---
{afficher && <section id="actualites" class:list={["actualites", { compacte, "presse-accueil": accueil }]} aria-labelledby="titre-actualites">
  <div class="titre-section">
    <h2 id="titre-actualites">{titreAffiche}</h2>
    {accueil && <a href="/revue-de-presse/">Toute la revue de presse ↗</a>}
    {lienRubrique && <a href={`/rubrique/${r.slug}/`}>Toute la rubrique <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>}
  </div>
  <p class="provenance">{accueil ? "Les derniers titres repérés sur les audiences, les verdicts et les procès criminels." : "Sélection de titres publiés par les médias cités. Les liens conduisent vers les publications des médias cités, directement ou par un lien de référencement."}</p>
  {nouvelles.length ? <ul class="nouvelles">
    {nouvelles.map((n, i) => <li>
      {accueil && (() => { const photo = visuelsAccueil[i]; return <figure class="visuel-presse"><a href={n.lien} target="_blank" rel="noopener noreferrer" aria-label={`Lire l’article de ${n.source} : ${n.titre}`}><img src={photo.image.src} width={photo.image.width} height={photo.image.height} alt={photo.lieu} loading="lazy" decoding="async" /></a><figcaption>Illustration · <a href={photo.source} target="_blank" rel="noopener noreferrer">{photo.auteur}</a></figcaption></figure>; })()}

      <p class="meta"><span class="source">{n.source}</span><time datetime={n.date}>{n.dateAlerte ? "Référence du " : ""}{formatDate.format(new Date(n.date))}</time></p>
      {(() => { const presentation = presenterTitrePresse(n.titre, n.source); return <>
        <h3><a href={n.lien} target="_blank" rel="noopener noreferrer" title={presentation.original}>{presentation.titre}<span class="sr-only"> — Lire chez {n.source} (nouvel onglet)</span></a></h3>
        {extraitPresseValide(n) && <p class="chapeau-presse">{extraitPresseValide(n)}</p>}
        {presentation.abrege && <p class="precision-titre">Titre abrégé dans le relevé · <a href={n.lien} target="_blank" rel="noopener noreferrer">Lire le titre complet chez {n.source}</a></p>}
        {!lienDirectPresse(n.lien) && <p class="precision-titre">Référence repérée dans la presse · <a href={n.lien} target="_blank" rel="noopener noreferrer">Consulter la source</a></p>}
      </>; })()}
    </li>)}
  </ul> : <p>Aucun article à afficher dans cette sélection. <a class="secours" href="/archives/presse/">Consulter les archives de presse.</a></p>}
</section>}
<style>
  .chapeau-presse{font:400 .96rem/1.55 var(--serif);color:var(--encre);margin:.55rem 0 0;max-width:66ch}
  .precision-titre{font:500 .77rem/1.5 var(--sans);color:var(--encre-2);margin:.4rem 0 0}
  .precision-titre a{text-decoration:underline;text-underline-offset:.15em}
  .actualites { scroll-margin-top:2rem; }
  .provenance { font-size:1.0625rem; color:var(--encre-2); margin:0.5rem 0; }
  .releve { font-size:0.625rem; margin:0.5rem 0 1.5rem; }
  .nouvelles { list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:0 2rem; }
  .nouvelles li { min-width:0; border-bottom:1px solid var(--filet); padding:1.4rem 0; }
  .nouvelles li:first-child { grid-column:span 2; grid-row:span 2; padding-right:2rem; border-right:1px solid var(--filet); }
  .nouvelles .meta { display:flex; align-items:baseline; flex-wrap:wrap; gap:0.35rem 0.75rem; margin:0; font-size:0.625rem; }
  .source { min-width:0; overflow-wrap:anywhere; color:var(--rouge); font-weight:700; }
  h3 { font-size:1.35rem; line-height:1.24; margin:0.65rem 0 0; }
  .nouvelles li:first-child h3 { font-size:clamp(2rem,3.2vw,3rem); line-height:1.12; margin-top:1rem; }
  h3 a { display:block; min-height:44px; }
  .titre-section a svg { flex-shrink:0; }
  .indisponible { font-family:var(--sans); font-size:0.8125rem; color:var(--encre-2); }
  .secours { text-decoration:underline; text-underline-offset:0.2em; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
  .compacte .nouvelles li:first-child { grid-row:auto; }
  @media(max-width:63.99rem) { .nouvelles { grid-template-columns:repeat(2,minmax(0,1fr)); }.nouvelles li:first-child { grid-column:span 1; }.nouvelles li:first-child h3 { font-size:2rem; } }
  @media(max-width:47.99rem) { .nouvelles { grid-template-columns:minmax(0,1fr); }.nouvelles li:first-child { grid-column:auto; grid-row:auto; padding-right:0; border-right:0; }.nouvelles li:first-child h3 { font-size:1.75rem; } }

/* Flash d'actualite : composition de chaine documentaire, sans effets de presse ancienne. */
.actualites{padding-bottom:1rem}
.provenance{font:600 .87rem/1.55 var(--sans);max-width:85ch;color:#3d4242}
.releve{font-size:.68rem;font-weight:750;text-transform:uppercase}
.nouvelles{gap:0;grid-template-columns:repeat(3,minmax(0,1fr));border-left:2px solid #111314;border-top:2px solid #111314}
.nouvelles li{border:0;border-right:2px solid #111314;border-bottom:2px solid #111314;min-height:205px;padding:1.5rem;position:relative;background:#fff}
.nouvelles li:first-child{padding:2rem;border-right:2px solid #111314;background:#17191a;color:#fff}
.nouvelles .meta{font-weight:800;font-size:.65rem;text-transform:uppercase;letter-spacing:.025em}
.source{display:inline-block;background:#ffe100;color:#111314;font-weight:900;padding:.23rem .5rem}
.nouvelles li:first-child .meta{color:#dededb}
h3{font:850 clamp(1.1rem,1.7vw,1.5rem)/1.18 var(--sans);letter-spacing:-.04em;margin-top:1rem}
.nouvelles li:first-child h3{font:900 clamp(1.9rem,3.3vw,3.4rem)/1.05 var(--sans);letter-spacing:-.07em;text-transform:uppercase;margin-top:1.5rem}
.nouvelles li:first-child h3 a:hover{color:#ffe100}
.nouvelles li:not(:first-child) h3 a:hover{background:#ffe100;color:#111314}
.indisponible{font-weight:700;border-left:5px solid #ffe100;padding-left:1rem}
@media(max-width:63.99rem){.nouvelles{grid-template-columns:repeat(2,minmax(0,1fr))}.nouvelles li:first-child{grid-column:span 1}.nouvelles li:first-child h3{font-size:clamp(1.8rem,3.2vw,2.6rem)}}
@media(max-width:47.99rem){.nouvelles{grid-template-columns:1fr}.nouvelles li{min-height:0;padding:1.3rem}.nouvelles li:first-child{grid-column:auto;grid-row:auto;padding:1.5rem}.nouvelles li:first-child h3{font-size:clamp(1.8rem,7vw,2.9rem)}}

  .presse-accueil{padding:1.15rem clamp(1rem,3vw,2rem);border-top:4px solid #84323d;background:#f0e9e0}
  .presse-accueil .titre-section{margin:0;border:0;padding:0}
  .presse-accueil .titre-section h2{color:#641e30}
  .presse-accueil .nouvelles{border:0;gap:1rem;margin-top:.85rem}
  .presse-accueil .nouvelles li,.presse-accueil .nouvelles li:first-child{grid-column:auto;grid-row:auto;min-height:0;padding:1rem;border:1px solid #d2c8bf;background:#fffdf8;color:#252124}
  .presse-accueil .nouvelles li:first-child .meta{color:inherit}
  .presse-accueil .nouvelles h3,.presse-accueil .nouvelles li:first-child h3{font:650 clamp(1.15rem,2vw,1.5rem)/1.2 var(--serif);letter-spacing:normal;text-transform:none;margin:.5rem 0 0}
  .presse-accueil .nouvelles h3 a:hover{color:#641e30;background:none;text-decoration:underline}
  .presse-accueil .source{padding:0;color:#84323d;background:none}
  /* Une référence principale puis quatre titres lisibles, sans rupture de style. */
  .presse-accueil .nouvelles{grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}
  .presse-accueil .nouvelles li:first-child{grid-column:1/-1;background:#faf4ea;border-left:4px solid #84323d;padding:clamp(1.1rem,2.4vw,1.65rem)}
  .presse-accueil .nouvelles li:first-child h3{font-size:clamp(1.45rem,2.6vw,2.15rem);max-width:60ch}
  .presse-accueil .nouvelles li{min-height:0}
  .presse-accueil .visuel-presse{margin:0 0 .8rem;min-width:0}
  .presse-accueil .visuel-presse>a{display:block;aspect-ratio:16/9;overflow:hidden;background:#e5ded5}
  .presse-accueil .visuel-presse img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .2s ease}
  .presse-accueil .visuel-presse>a:hover img{transform:scale(1.025)}
  .presse-accueil .visuel-presse figcaption{font:500 .68rem/1.45 var(--sans);color:#655e59;margin-top:.3rem}
  .presse-accueil .visuel-presse figcaption a{text-decoration:underline;text-underline-offset:.15em}
  .presse-accueil .nouvelles li:first-child .visuel-presse>a{aspect-ratio:2.15/1}

  .presse-accueil .nouvelles a:focus-visible{outline:3px solid #84323d;outline-offset:4px}
  @media(max-width:47.99rem){
    .presse-accueil .nouvelles{grid-template-columns:minmax(0,1fr)}
    .presse-accueil .nouvelles li:first-child{grid-column:auto}
  }
</style>
