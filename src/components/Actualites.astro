---
import { lireActualites } from '../lib/veille.mjs';
import { rubrique } from '../lib/rubriques.mjs';
const { rubriqueSlug = 'cours-du-jour', limite = 8, titre, lienRubrique = true, debut = 0, compacte = false } = Astro.props;
const r = rubrique(rubriqueSlug);
const titreAffiche = titre ?? r.nom;
const fil = await lireActualites();
const candidates = (fil?.articles ?? []).filter(n=>n.rubrique === rubriqueSlug).slice(debut);
// Les flux peuvent livrer des titres déjà abrégés : privilégier les titres complets
// sur l'accueil, sans reconstituer ni altérer le libellé de la source.
const titreAbrege = (n) => /(?:\.\.\.|…)(?:\s*[—–-]\s*[^—–]+)?\s*$/.test(n.titre);
const nouvelles = compacte
  ? [...candidates.filter(n=>!titreAbrege(n)),...candidates.filter(titreAbrege)].slice(0,limite)
  : candidates.slice(0,limite);
const afficher = nouvelles.length > 0 || rubriqueSlug === 'cours-du-jour';
const formatDate = new Intl.DateTimeFormat('fr-FR',{day:'numeric',month:'long',year:'numeric',timeZone:'Europe/Paris'});
---
{afficher && <section id="actualites" class:list={["actualites", { compacte }]} aria-labelledby="titre-actualites">
  <div class="titre-section">
    <h2 id="titre-actualites">{titreAffiche}</h2>
    {lienRubrique && <a href={`/rubrique/${r.slug}/`}>Toute la rubrique <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>}
  </div>
  <p class="provenance">Revue de presse des procès criminels. Articles publiés par les médias cités.</p>
  {nouvelles.length ? <ul class="nouvelles">
    {nouvelles.map(n => <li>
      <p class="meta"><span class="source">{n.source}</span><time datetime={n.date}>{n.dateAlerte ? "Référence du " : ""}{formatDate.format(new Date(n.date))}</time></p>
      <h3><a href={n.lien} target="_blank" rel="noopener noreferrer">{n.titre}<span class="sr-only"> — {n.source} (nouvel onglet)</span></a></h3>
    </li>)}
  </ul> : <p>Aucun article à afficher dans cette sélection. <a class="secours" href="/archives/presse/">Consulter les archives de presse.</a></p>}
</section>}
<style>
  .actualites { scroll-margin-top:2rem; }
  .provenance { font-size:1.0625rem; color:var(--encre-2); margin:0.5rem 0; }
  .releve { font-size:0.625rem; margin:0.5rem 0 1.5rem; }
  .nouvelles { list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:0 2rem; }
  .nouvelles li { min-width:0; border-bottom:1px solid var(--filet); padding:1.4rem 0; }
  .nouvelles li:first-child { grid-column:span 2; grid-row:span 2; padding-right:2rem; border-right:1px solid var(--filet); }
  .nouvelles .meta { display:flex; align-items:baseline; flex-wrap:wrap; gap:0.35rem 0.75rem; margin:0; font-size:0.625rem; }
  .source { min-width:0; overflow-wrap:anywhere; color:var(--rouge); font-weight:700; }
  h3 { font-size:1.35rem; line-height:1.24; margin:0.65rem 0 0; }
  .nouvelles li:first-child h3 { font-size:clamp(2rem,3.2vw,3rem); line-height:1.12; margin-top:1rem; }
  h3 a { display:block; min-height:44px; }
  .titre-section a svg { flex-shrink:0; }
  .indisponible { font-family:var(--sans); font-size:0.8125rem; color:var(--encre-2); }
  .secours { text-decoration:underline; text-underline-offset:0.2em; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
  .compacte .nouvelles li:first-child { grid-row:auto; }
  @media(max-width:63.99rem) { .nouvelles { grid-template-columns:repeat(2,minmax(0,1fr)); }.nouvelles li:first-child { grid-column:span 1; }.nouvelles li:first-child h3 { font-size:2rem; } }
  @media(max-width:47.99rem) { .nouvelles { grid-template-columns:minmax(0,1fr); }.nouvelles li:first-child { grid-column:auto; grid-row:auto; padding-right:0; border-right:0; }.nouvelles li:first-child h3 { font-size:1.75rem; } }

/* Flash d'actualite : composition de chaine documentaire, sans effets de presse ancienne. */
.actualites{padding-bottom:1rem}
.provenance{font:600 .87rem/1.55 var(--sans);max-width:85ch;color:#3d4242}
.releve{font-size:.68rem;font-weight:750;text-transform:uppercase}
.nouvelles{gap:0;grid-template-columns:repeat(3,minmax(0,1fr));border-left:2px solid #111314;border-top:2px solid #111314}
.nouvelles li{border:0;border-right:2px solid #111314;border-bottom:2px solid #111314;min-height:205px;padding:1.5rem;position:relative;background:#fff}
.nouvelles li:first-child{padding:2rem;border-right:2px solid #111314;background:#17191a;color:#fff}
.nouvelles .meta{font-weight:800;font-size:.65rem;text-transform:uppercase;letter-spacing:.025em}
.source{display:inline-block;background:#ffe100;color:#111314;font-weight:900;padding:.23rem .5rem}
.nouvelles li:first-child .meta{color:#dededb}
h3{font:850 clamp(1.1rem,1.7vw,1.5rem)/1.18 var(--sans);letter-spacing:-.04em;margin-top:1rem}
.nouvelles li:first-child h3{font:900 clamp(1.9rem,3.3vw,3.4rem)/1.05 var(--sans);letter-spacing:-.07em;text-transform:uppercase;margin-top:1.5rem}
.nouvelles li:first-child h3 a:hover{color:#ffe100}
.nouvelles li:not(:first-child) h3 a:hover{background:#ffe100;color:#111314}
.indisponible{font-weight:700;border-left:5px solid #ffe100;padding-left:1rem}
@media(max-width:63.99rem){.nouvelles{grid-template-columns:repeat(2,minmax(0,1fr))}.nouvelles li:first-child{grid-column:span 1}.nouvelles li:first-child h3{font-size:clamp(1.8rem,3.2vw,2.6rem)}}
@media(max-width:47.99rem){.nouvelles{grid-template-columns:1fr}.nouvelles li{min-height:0;padding:1.3rem}.nouvelles li:first-child{grid-column:auto;grid-row:auto;padding:1.5rem}.nouvelles li:first-child h3{font-size:clamp(1.8rem,7vw,2.9rem)}}

</style>
