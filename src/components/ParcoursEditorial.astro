---
const parcours = [
  {
    numero: '01',
    titre: 'Raconter.',
    accroche: 'Le déroulement des audiences et les décisions de justice.',
    detail: 'Des comptes rendus d’audience et des chroniques pour suivre les débats judiciaires et les décisions rendues.',
    liens: [
      { texte: 'Suivre les audiences', href: '/rubrique/cours-du-jour/' },
      { texte: 'Lire les chroniques', href: '/rubrique/la-cour-se-leve/' }
    ]
  },
  {
    numero: '02',
    titre: 'Expliquer.',
    accroche: 'Les règles et les acteurs du procès criminel.',
    detail: 'Des explications sur la procédure, les jurés, les droits des parties et les voies de recours.',
    liens: [
      { texte: 'Les règles du procès', href: '/rubrique/le-banc-des-jures/' },
      { texte: 'Les décryptages', href: '/rubrique/l-expose/' }
    ]
  },
  {
    numero: '03',
    titre: 'Transmettre.',
    accroche: 'Les affaires et les décisions dans leur contexte historique.',
    detail: 'Accéder aux publications antérieures du journal et aux références conservées dans ses archives.',
    liens: [
      { texte: 'Réflexions et opinions', href: '/rubrique/delibere/' },
      { texte: 'Explorer les archives', href: '/archives/' }
    ]
  }
];
---
<section class="parcours-editoriaux" aria-labelledby="parcours-editoriaux-titre">
  <header class="parcours-editoriaux-intro">
    <div>
      <p class="sur-titre">LES CONTENUS DU JOURNAL</p>
      <h2 id="parcours-editoriaux-titre">NOS DOMAINES<br /><span>DE COUVERTURE.</span></h2>
    </div>
    <p>Suivre les audiences, comprendre les procédures et consulter les archives du journal.</p>
  </header>
  <div class="parcours-editoriaux-grille">
    {parcours.map((p) => <article class="parcours-editorial">
      <span class="numero">{p.numero}</span>
      <h3>{p.titre}</h3>
      <p class="accroche">{p.accroche}</p>
      <p class="detail">{p.detail}</p>
      <nav aria-label={`Explorer : ${p.titre}`}>
        {p.liens.map((l) => <a href={l.href}>{l.texte}<span aria-hidden="true">↗</span></a>)}
      </nav>
    </article>)}
  </div>
  <p class="note">Les articles du journal et les publications des médias référencés sont présentés séparément.</p>
</section>
<style>
  .parcours-editoriaux{margin-top:4.5rem;border-top:5px solid var(--encre);padding-top:1.5rem}
  .parcours-editoriaux-intro{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,0.8fr);align-items:end;gap:1.5rem;margin-bottom:2.2rem}
  .sur-titre{font:700 .62rem/1.5 var(--sans);letter-spacing:.1em;color:var(--rouge);margin:0 0 1rem}
  .parcours-editoriaux h2{font-size:clamp(2.25rem,4.2vw,4rem);font-weight:600;line-height:1.04;letter-spacing:-.025em;margin:0}
  .parcours-editoriaux h2 em{font-style:normal;color:var(--rouge)}
  .parcours-editoriaux-intro>p{font:400 1.15rem/1.55 var(--serif);max-width:37ch;margin:0 0 .15rem;color:var(--encre-2)}
  .parcours-editoriaux-grille{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--filet-fort);border:1px solid var(--filet-fort)}
  .parcours-editorial{min-width:0;background:var(--papier);padding:1.55rem 1.6rem 1.3rem;display:flex;flex-direction:column}
  .numero{font:700 .65rem/1.6 var(--sans);color:var(--rouge);letter-spacing:.1em}
  .parcours-editorial h3{font-size:clamp(1.8rem,2.45vw,2.8rem);font-weight:600;line-height:1.04;margin:1rem 0 1.15rem}
  .accroche{font:600 1.1rem/1.3 var(--serif);margin:0 0 .7rem}
  .detail{font:400 .88rem/1.6 var(--sans);color:var(--encre-2);margin:0 0 1.7rem}
  .parcours-editorial nav{margin-top:auto;border-top:1px solid var(--filet)}
  .parcours-editorial nav a{display:flex;justify-content:space-between;gap:.7rem;align-items:center;min-height:45px;padding:.5rem 0;border-bottom:1px solid var(--filet);font:600 .72rem/1.4 var(--sans)}
  .parcours-editorial nav a:hover{text-decoration:underline;text-decoration-color:var(--rouge);text-underline-offset:.2em}
  .parcours-editorial nav a span{color:var(--rouge);font-size:1.05rem}
  .note{font:400 .68rem/1.6 var(--sans);color:var(--encre-2);margin:.9rem 0 0}
  @media(max-width:63.99rem){.parcours-editorial{padding:1.2rem}.parcours-editoriaux-intro>p{font-size:1rem}}
  @media(max-width:47.99rem){.parcours-editoriaux{margin-top:3rem}.parcours-editoriaux-intro{grid-template-columns:1fr;gap:.8rem;margin-bottom:1.5rem}.parcours-editoriaux h2{font-size:2.45rem}.parcours-editoriaux-grille{grid-template-columns:1fr}.parcours-editorial h3{font-size:2.15rem;margin:.6rem 0 .75rem}.detail{margin-bottom:1rem}.parcours-editorial nav a{min-height:48px}}

/* Section broadcast : typographie en capitales, cellules franches et reperes jaunes. */
.parcours-editoriaux{border-top:8px solid #111314;padding-top:1.3rem}
.parcours-editoriaux-intro{grid-template-columns:1.6fr .7fr;gap:2rem}
.sur-titre{display:inline-block;background:#ffe100;color:#111314;padding:.4rem .6rem;font-size:.7rem;font-weight:900;letter-spacing:.1em}
.parcours-editoriaux h2{font:900 clamp(2.4rem,4.65vw,5.2rem)/.99 var(--sans);letter-spacing:-.075em;text-transform:uppercase}
.parcours-editoriaux h2 span{color:#111314;background:#ffe100;padding:.02em .12em .07em;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.parcours-editoriaux-intro>p{font:700 1rem/1.6 var(--sans);text-transform:uppercase;color:#454747;max-width:29ch}
.parcours-editoriaux-grille{background:#111314;border:2px solid #111314;gap:2px}
.parcours-editorial{background:#efefeb;padding:2rem;min-height:380px}
.parcours-editorial:nth-child(2){background:#111314;color:#fff}
.numero{background:#ffe100;display:inline-flex;align-self:start;color:#111314;padding:.36rem .6rem;font:900 .77rem/1.3 var(--sans);letter-spacing:0}
.parcours-editorial h3{font:900 clamp(1.9rem,2.45vw,2.9rem)/1.02 var(--sans);text-transform:uppercase;letter-spacing:-.055em;margin:2rem 0 1.3rem}
.accroche{font:750 1.04rem/1.45 var(--sans)}
.detail{font:500 .88rem/1.6 var(--sans);color:#434646}
.parcours-editorial:nth-child(2) .detail{color:#ccc}
.parcours-editorial nav{border-top:1px solid #9e9e98}
.parcours-editorial nav a{font:850 .66rem/1.45 var(--sans);text-transform:uppercase;letter-spacing:.015em;border-color:#b5b7b0}
.parcours-editorial:nth-child(2) nav a{border-color:#565656}
.parcours-editorial nav a:hover{background:#ffe100;color:#111314;text-decoration:none}
.parcours-editorial nav a span{color:inherit}
.note{font:650 .66rem/1.55 var(--sans);text-transform:uppercase}
@media(max-width:63.99rem){.parcours-editorial{padding:1.5rem;min-height:0}}
@media(max-width:47.99rem){.parcours-editoriaux-intro{grid-template-columns:1fr}.parcours-editoriaux h2{font-size:clamp(2.2rem,9vw,4rem)}.parcours-editoriaux-grille{grid-template-columns:1fr}.parcours-editorial{padding:1.4rem}.parcours-editorial h3{font-size:2rem;margin:1rem 0}.parcours-editorial:nth-child(2){background:#111314}}

</style>
