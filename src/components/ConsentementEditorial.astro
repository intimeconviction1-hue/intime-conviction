---
/*
 * Information éditoriale et choix de mesure d'audience.
 * Aucun appel Google ne part avant un consentement explicite.
 */
---
<section id="consentement-editorial" class="consentement-editorial" role="dialog" aria-modal="false" aria-labelledby="consentement-titre" aria-describedby="consentement-texte" hidden>
  <div class="consentement-interieur">
    <div class="consentement-intro">
      <p class="consentement-surtitre">LE CHOIX DU LECTEUR</p>
      <h2 id="consentement-titre">Avez-vous une intime conviction&nbsp;?</h2>
      <p id="consentement-texte" class="consentement-texte">Avec votre accord, Google Analytics nous aide à mesurer la fréquentation et l’origine des visites. Vous pouvez refuser et lire librement le journal.</p>
    </div>
    <div class="consentement-actions">
      <button type="button" data-consent="refuser" class="consentement-choix">Tout refuser</button>
      <button type="button" data-consent="accepter" class="consentement-choix">Tout accepter</button>
      <button type="button" id="consentement-parametrer" class="consentement-parametrer" aria-controls="consentement-details" aria-expanded="false">Personnaliser</button>
    </div>
    <div id="consentement-details" class="consentement-details" hidden>
      <div class="consentement-detail-ligne">
        <div>
          <strong>Mesure d’audience</strong>
          <p>Google Analytics 4. Activé uniquement après votre accord.</p>
        </div>
        <label class="consentement-option">
          <input type="checkbox" id="consentement-mesure" />
          <span>Autoriser</span>
        </label>
      </div>
      <button type="button" id="consentement-enregistrer" class="consentement-enregistrer">Enregistrer mon choix</button>
    </div>
    <p class="consentement-note">Choix conservé 6 mois, modifiable dans «&nbsp;Gérer mes cookies&nbsp;». <a href="/confidentialite/">Confidentialité</a></p>
  </div>
</section>

<script>
  // Mode strict : aucune requête Google, ni ping de consentement avant opt-in.
  const KEY = 'ic:analytics:consent:v1';
  const DUREE = 180 * 24 * 60 * 60 * 1000;
  const GA_ID = 'G-LBH06QWG2R';

  const boite = document.querySelector<HTMLElement>('#consentement-editorial');
  const details = document.querySelector<HTMLElement>('#consentement-details');
  const parametrer = document.querySelector<HTMLButtonElement>('#consentement-parametrer');
  const mesure = document.querySelector<HTMLInputElement>('#consentement-mesure');
  const ouvrirDepuisPied = document.querySelector<HTMLButtonElement>('#gestion-confidentialite');
  let ouvertDepuisPied = false;

  type Decision = 'accepter' | 'refuser';
  function lireDecision(): Decision | null {
    try {
      const brut = localStorage.getItem(KEY);
      if (!brut) return null;
      const choix = JSON.parse(brut);
      if ((choix.value === 'accepter' || choix.value === 'refuser') && Number.isFinite(choix.at) && Date.now() - choix.at < DUREE && choix.at <= Date.now()) return choix.value;
      localStorage.removeItem(KEY);
    } catch { /* stockage indisponible : demander à nouveau */ }
    return null;
  }

  function garderDecision(value: Decision) {
    try { localStorage.setItem(KEY, JSON.stringify({ value, at: Date.now() })); }
    catch { /* Choix valable sur cette page uniquement si le stockage est bloqué */ }
  }

  // Cette fonction n'est appelée QUE pour une décision d'acceptation explicite.
  let charge = false;
  function chargerAnalytics() {
    if (charge) return;
    charge = true;
    const w = window as Window & { dataLayer?: unknown[] };
    w.dataLayer = w.dataLayer || [];
    function gtag(...args: unknown[]) { w.dataLayer!.push(args); }
    gtag('consent', 'default', {
      analytics_storage: 'granted',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
    gtag('js', new Date());
    gtag('config', GA_ID, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
      anonymize_ip: true,
      cookie_expires: 15552000,
      // La page vue est émise explicitement une seule fois après l'accord.
      send_page_view: false
    });
    gtag('event', 'page_view', {
      send_to: GA_ID,
      page_location: location.origin + location.pathname,
      page_title: document.title
    });
    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
    document.head.append(script);
  }

  function effacerCookiesGA() {
    // Le rechargement stoppe les scripts Analytics déjà chargés.
    const prefixes = ['_ga', '_gid', '_gat', '_gac_'];
    document.cookie.split(';').forEach(item => {
      const nom = item.split('=')[0]?.trim();
      if (nom && prefixes.some(p => nom === p || nom.startsWith(p + '_'))) {
        document.cookie = encodeURIComponent(nom) + '=; Max-Age=0; Path=/; SameSite=Lax; Secure';
        document.cookie = encodeURIComponent(nom) + '=; Max-Age=0; Path=/; Domain=.intimeconviction.fr; SameSite=Lax; Secure';
      }
    });
  }

  function fermer() {
    if (boite) boite.hidden = true;
    if (details) details.hidden = true;
    if (parametrer) parametrer.setAttribute('aria-expanded', 'false');
  }

  function terminer(value: Decision) {
    const ancienne = lireDecision();
    garderDecision(value);
    fermer();
    if (value === 'accepter') {
      chargerAnalytics();
    } else if (charge || ancienne === 'accepter') {
      effacerCookiesGA();
      location.reload();
    }
    if (ouvertDepuisPied) ouvrirDepuisPied?.focus({ preventScroll: true });
    ouvertDepuisPied = false;
  }

  // Signaux éditoriaux uniquement après consentement. Il s'agit de clics,
  // et non de preuves qu'un article a réellement été partagé sur le réseau.
  document.addEventListener('click', (event) => {
    if (!charge || lireDecision() !== 'accepter') return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    const shareX = target.closest('a.partager-x');
    const shareWhatsApp = target.closest('a.partager-whatsapp');
    const archiveToNews = target.closest('.passerelle-archives a[href]');
    if (!shareX && !shareWhatsApp && !archiveToNews) return;
    const w = window as Window & { dataLayer?: unknown[] };
    if (!Array.isArray(w.dataLayer)) return;
    // Ne transmettre que le chemin public de l'article, jamais les paramètres
    // de recherche, les données personnelles ou l'identité du lecteur.
    const item_id = location.pathname;
    if (shareX || shareWhatsApp) {
      w.dataLayer.push(['event', 'share', {
        method: shareX ? 'x' : 'whatsapp',
        content_type: 'article',
        item_id
      }]);
    } else {
      w.dataLayer.push(['event', 'select_content', {
        content_type: 'archive_to_news',
        item_id
      }]);
    }
  });

  document.querySelector<HTMLButtonElement>('[data-consent="accepter"]')?.addEventListener('click', () => terminer('accepter'));
  document.querySelector<HTMLButtonElement>('[data-consent="refuser"]')?.addEventListener('click', () => terminer('refuser'));
  parametrer?.addEventListener('click', () => {
    if (!details) return;
    details.hidden = !details.hidden;
    parametrer.setAttribute('aria-expanded', String(!details.hidden));
    if (!details.hidden) mesure?.focus();
  });
  document.querySelector<HTMLButtonElement>('#consentement-enregistrer')?.addEventListener('click', () => terminer(mesure?.checked ? 'accepter' : 'refuser'));
  ouvrirDepuisPied?.addEventListener('click', () => {
    if (!boite) return;
    ouvertDepuisPied = true;
    boite.hidden = false;
    if (mesure) mesure.checked = lireDecision() === 'accepter';
    document.querySelector<HTMLButtonElement>('[data-consent="refuser"]')?.focus();
  });

  const choix = lireDecision();
  if (choix === 'accepter') chargerAnalytics();
  else if (choix === null && boite) boite.hidden = false;
  // Si l'internaute refuse, même la bibliothèque gtag n'est pas téléchargée.
</script>

<style>
  #consentement-editorial[hidden],#consentement-details[hidden]{display:none!important}
  .consentement-editorial{
    position:fixed;z-index:10000;bottom:max(.75rem,env(safe-area-inset-bottom));right:max(.75rem,env(safe-area-inset-right));left:auto;
    width:min(780px,calc(100vw - 1.5rem));max-height:min(60dvh,420px);overflow:auto;
    background:#fbf9f4;color:#292125;border:1px solid #d3c8bf;border-left:3px solid #641e30;
    box-shadow:0 5px 22px #1b18212b;
    font-family:var(--sans);font-size:.87rem;line-height:1.45;text-align:left;overscroll-behavior:contain
  }
  .consentement-interieur{display:grid;grid-template-columns:minmax(0,1fr) 255px;align-items:center;gap:.3rem 1.25rem;padding:.85rem 1rem .7rem}
  .consentement-intro{min-width:0}
  .consentement-surtitre{margin:0 0 .15rem;font:750 .59rem/1.3 var(--sans);letter-spacing:.12em;color:#641e30}
  .consentement-editorial h2{margin:0;font:550 clamp(1.15rem,2.2vw,1.4rem)/1.12 var(--serif);letter-spacing:-.02em;color:#27191f}
  .consentement-texte{margin:.3rem 0 0;font:450 .79rem/1.4 var(--sans);color:#383136}
  .consentement-actions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-content:center;gap:.4rem}
  .consentement-choix{width:100%;min-height:44px;padding:.5rem .2rem;cursor:pointer;color:#fffdf9;background:#641e30;border:1px solid #641e30;font:720 .75rem/1.2 var(--sans);text-align:center}
  .consentement-choix:hover{background:#4a1726}
  .consentement-choix:focus-visible,.consentement-parametrer:focus-visible,.consentement-enregistrer:focus-visible,.consentement-option:focus-within{outline:3px solid #aa5f37;outline-offset:2px}
  .consentement-parametrer{grid-column:1/-1;justify-self:center;min-height:36px;background:transparent;color:#641e30;border:0;padding:.25rem .35rem;cursor:pointer;font:650 .74rem/1.2 var(--sans);text-decoration:underline;text-underline-offset:.15rem}
  .consentement-details{grid-column:1/-1;border-top:1px solid #d9c9bd;margin-top:.25rem;padding:.7rem 0 .2rem;background:transparent}
  .consentement-detail-ligne{display:flex;justify-content:space-between;gap:1rem;align-items:center}
  .consentement-detail-ligne strong{font:750 .81rem/1.3 var(--sans)}
  .consentement-detail-ligne p{margin:.2rem 0 0;font:450 .77rem/1.45 var(--sans)}
  .consentement-option{display:flex;align-items:center;gap:.45rem;cursor:pointer;font:650 .78rem/1.2 var(--sans)}
  .consentement-option input{width:20px;height:20px;accent-color:#641e30}
  .consentement-enregistrer{min-height:44px;margin-top:.5rem;padding:.45rem 1rem;background:#641e30;color:#fffdf9;border:1px solid #641e30;cursor:pointer;font:730 .78rem/1.25 var(--sans)}
  .consentement-note{grid-column:1/-1;margin:.1rem 0 0;font:450 .68rem/1.4 var(--sans);color:#62565b}
  .consentement-note a{text-decoration:underline;text-underline-offset:2px;color:#641e30}
  @media(max-width:670px){
    .consentement-editorial{right:.5rem;bottom:max(.5rem,env(safe-area-inset-bottom));width:calc(100vw - 1rem);max-height:min(55dvh,340px)}
    .consentement-interieur{grid-template-columns:minmax(0,1fr);gap:.45rem;padding:.75rem .85rem .65rem}
    .consentement-actions{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
    .consentement-parametrer{min-height:30px}
    .consentement-editorial h2{font-size:1.22rem}
    .consentement-texte{font-size:.77rem;line-height:1.35}
    .consentement-note{font-size:.66rem}
  }
</style>

