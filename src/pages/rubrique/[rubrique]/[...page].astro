---
import Base from '../../../layouts/Base.astro';
import ListeArticles from '../../../components/ListeArticles.astro';
import Actualites from '../../../components/Actualites.astro';
import Culture from '../../../components/Culture.astro';
import { RUBRIQUES, rubrique } from '../../../lib/rubriques.mjs';
import { tousLesArticles } from '../../../lib/articles.mjs';

export async function getStaticPaths({ paginate }) {
  const articles = await tousLesArticles();
  return RUBRIQUES.flatMap((r) =>
    paginate(articles.filter((a) => a.data.rubrique === r.slug), { params: { rubrique: r.slug }, pageSize: 30 }),
  );
}

const { page } = Astro.props;
const r = rubrique(Astro.params.rubrique);
const titre = page.currentPage > 1 ? `${r.nom}, page ${page.currentPage}` : r.nom;
const ressources = {
  'cours-du-jour': [
    {titre:'Agenda des sessions',url:'/agenda/'}
  ],
  'le-banc-des-jures': [
    {titre:'Comprendre les assises',url:'/comprendre/'},
    {titre:'Annuaire des juridictions',url:'/annuaire/'},
    {titre:'Assister à une audience',url:'/assister/'}
  ],
  'l-expose': [
    {titre:'Dossiers judiciaires',url:'/dossiers/'},
    {titre:'Chronologie des affaires',url:'/chronologie/'},
    {titre:'Carte des affaires',url:'/carte/'},
    {titre:'Jurisprudence criminelle',url:'/jurisprudence/'}
  ],
  'le-greffe': [
    {titre:'Livres et cinéma',url:'/rubrique/le-greffe/#titre-culture'},
    {titre:'Archives du journal',url:'/archives/'}
  ]
};
const liensRubrique = ressources[r.slug] ?? [];
---
<Base titre={titre} description={`${r.nom} — ${r.sousTitre}. ${page.total} articles d'Intime Conviction.`} rubriqueActive={r.slug}>
  <header class="titre-page">
    <p class="etiquette">Rubrique</p>
    <h1>{r.nom}</h1>
    <p class="sous-titre">{r.sousTitre}</p>
    <p class="meta">{page.total.toLocaleString('fr-FR')} articles d’archives · page {page.currentPage} sur {page.lastPage}</p>
  </header>
  {page.currentPage === 1 && liensRubrique.length > 0 && (
    <nav class="ressources-rubrique" aria-label={`Accès thématiques : ${r.nom}`}>
      <h2>À découvrir dans cette rubrique</h2>
      <ul>{liensRubrique.map(l => <li><a href={l.url}>{l.titre} <span aria-hidden="true">↗</span></a></li>)}</ul>
    </nav>
  )}
  {page.currentPage === 1 && r.slug === 'le-banc-des-jures' && (
    <aside class="lecture-jures" aria-labelledby="lecture-jures-titre">
      <p class="lecture-jures-surtitre">LE BANC DES JURÉS / À LIRE</p>
      <h2 id="lecture-jures-titre"><a href="/jures-en-mai/05/2022/">Un nom tiré au sort, une vie devant les assises</a></h2>
      <p>De la liste électorale au verdict : comment un citoyen peut être appelé à juger un crime. Une enquête de synthèse nourrie des tirages municipaux et des règles officielles.</p>
      <a class="lecture-jures-action" href="/jures-en-mai/05/2022/">Lire le récit <span aria-hidden="true">↗</span></a>
    </aside>
  )}
  {page.currentPage === 1 && r.slug === 'cours-du-jour' && <Actualites rubriqueSlug="cours-du-jour" limite={24} titre="Dans la presse" lienRubrique={false} />}
  {page.currentPage === 1 && r.slug === 'le-greffe' && <Culture titre="À lire, à voir" />}
  <div class="titre-section"><h2>Les articles d’Intime Conviction</h2></div>
  <ListeArticles articles={page.data} rubriqueVisible={false} niveau={3} />
  <nav class="pagination" aria-label="Pages">
    {page.url.prev ? <a href={page.url.prev}>← Plus récents</a> : <span />}
    {page.url.next ? <a href={page.url.next}>Plus anciens →</a> : <span />}
  </nav>
</Base>

<style>
  .ressources-rubrique{border-top:1px solid var(--filet-fort);border-bottom:1px solid var(--filet);padding:1.25rem 0 1.5rem;margin:1rem 0 2rem}
  .ressources-rubrique h2{font-family:var(--sans);font-size:.85rem;letter-spacing:.04em;font-weight:750;margin:0 0 1rem}
  .ressources-rubrique ul{display:flex;flex-wrap:wrap;list-style:none;padding:0;margin:0;gap:.65rem}
  .ressources-rubrique a{display:inline-flex;align-items:center;min-height:44px;padding:.65rem .85rem;border:1px solid var(--filet);font-family:var(--sans);font-size:.8rem;font-weight:600;text-decoration:none}
  .ressources-rubrique a:hover,.ressources-rubrique a:focus-visible{border-color:var(--rouge);color:var(--rouge)}
  .ressources-rubrique a span{margin-left:.6rem}

  .lecture-jures{background:#17191a;color:#fff;padding:clamp(1.4rem,4vw,3rem);margin:2rem 0 3rem;border-left:8px solid #ffe100}
  .lecture-jures-surtitre{font:800 .7rem/1.4 var(--sans);letter-spacing:.08em;color:#ffe100;margin:0 0 1rem}
  .lecture-jures h2{font:800 clamp(1.8rem,3.1vw,3.2rem)/1.1 var(--serif);letter-spacing:-.025em;max-width:24ch;margin:0 0 1rem}
  .lecture-jures h2 a:hover,.lecture-jures h2 a:focus-visible{color:#ffe100}
  .lecture-jures>p:not(.lecture-jures-surtitre){font:450 1.02rem/1.65 var(--sans);max-width:70ch;color:#e0e0df}
  .lecture-jures-action{display:inline-flex;align-items:center;min-height:44px;padding-bottom:.4rem;margin-top:.4rem;border-bottom:3px solid #ffe100;font:800 .75rem/1.3 var(--sans);text-transform:uppercase;letter-spacing:.05em}
</style>
