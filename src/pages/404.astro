---
import Base from '../layouts/Base.astro';
---
<Base titre="Page introuvable">
  <div class="article">
    <p class="meta"><span class="rouge etiquette">Erreur 404</span></p>
    <h1>Cette page n'existe pas, ou plus.</h1>
    <p>L'article a peut-être été retiré. Les <a href="/archives/">archives</a> rangent tous les articles par année, et l'<a href="/">accueil</a> présente les six rubriques.</p>
  </div>
</Base>
