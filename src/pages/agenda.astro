---
import Base from '../layouts/Base.astro';
import {DATE_CONTROLE_AGENDA,SESSIONS_AGENDA,SOURCES_A_COMPLETER,AUDIENCES_A_RECONFIRMER,sessionsAvenir,dateLocaleAgenda} from '../lib/agenda-sessions.mjs';

const dateDuJour=dateLocaleAgenda();
const dates=sessionsAvenir(SESSIONS_AGENDA,dateDuJour);
const audiences=sessionsAvenir(AUDIENCES_A_RECONFIRMER,dateDuJour);
const formatDate=s=>new Intl.DateTimeFormat('fr-FR',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(s+'T12:00:00Z'));
const toutesLesPeriodes=[...dates,...audiences];
const departements=[...new Set(toutesLesPeriodes.map(a=>a.departement))].sort((a,b)=>a.localeCompare(b,'fr'));
const tousLesMois=new Set();
for(const entree of toutesLesPeriodes){
  const [annee,mois]=entree.debut.split('-').map(Number);
  const [finAnnee,finMois]=entree.fin.split('-').map(Number);
  for(let an=annee,m=mois;an<finAnnee || (an===finAnnee && m<=finMois);){
    tousLesMois.add(`${an}-${String(m).padStart(2,'0')}`);
    if(++m>12){m=1;an++;}
  }
}
const moisDisponibles=[...tousLesMois].sort().map(value=>({
  value,
  label:new Intl.DateTimeFormat('fr-FR',{month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(value+'-01T12:00:00Z'))
}));
---
<Base titre="Agenda des sessions criminelles" description="Dates de sessions publiées par les cours d’appel. Sources officielles identifiées, sans déduire les audiences individuelles ni les décisions." rubriqueActive="annuaire">
  <header class="tete-agenda">
    <p class="sur-titre">Les juridictions / Les sessions annoncées</p>
    <h1>Agenda des <span>sessions criminelles</span></h1>
    <p>Les périodes ci-dessous proviennent des intitulés de rôles publiés par les cours d’appel. Une période de session ne confirme ni la tenue d’un procès particulier ni l’accès du public à chaque audience.</p>
    <p id="alerte-actualite" class="alerte-actualite" data-date-generation={dateDuJour} data-date-verification={DATE_CONTROLE_AGENDA} hidden role="status"></p>
    <p class="date-controle">Sources vérifiées le <time datetime={DATE_CONTROLE_AGENDA}>{formatDate(DATE_CONTROLE_AGENDA)}</time>. Sessions non terminées au <time datetime={dateDuJour}>{formatDate(dateDuJour)}</time>, date de génération de cette page.</p>
  </header>
  <form class="filtres-agenda" id="filtres-agenda" aria-label="Filtrer les sessions et audiences">
    <div>
      <label for="filtre-departement">Département</label>
      <select id="filtre-departement" name="departement">
        <option value="">Tous les départements</option>
        {departements.map(n=><option value={n}>{n}</option>)}
      </select>
    </div>
    <div>
      <label for="filtre-mois">Période</label>
      <select id="filtre-mois" name="mois">
        <option value="">Toutes les périodes</option>
        {moisDisponibles.map(m=><option value={m.value}>{m.label}</option>)}
      </select>
    </div>
    <button type="reset">Effacer les filtres</button>
    <p id="resultats-agenda" role="status" aria-live="polite">Affichage de toutes les périodes répertoriées.</p>
  </form>
  <section class="sessions" aria-labelledby="titre-sessions">
    <div class="titre-liste"><h2 id="titre-sessions">Sessions non terminées</h2><span id="compteur-sessions">{dates.length} période{dates.length > 1 ? 's' : ''} répertoriée{dates.length > 1 ? 's' : ''}</span></div>
    {dates.length === 0 && <p class="agenda-vide">Aucune session future ou en cours ne figure dans notre sélection actuellement vérifiée. Consultez les rôles officiels pour les nouvelles dates.</p>}
    <ol>
      {dates.map(s=>(
        <li data-agenda-ligne data-departement={s.departement} data-debut={s.debut} data-fin={s.fin}>
          <div class="periode"><time datetime={s.debut}>{formatDate(s.debut)}</time><span>au</span><time datetime={s.fin}>{formatDate(s.fin)}</time></div>
          <div class="contenu">
            <p class="localisation">{s.ville} · {s.departement}</p>
            <h3>{s.juridiction}</h3>
            <p>{s.libelle}</p>
            <a href={s.source} target="_blank" rel="noopener noreferrer">Consulter la page officielle <span class="sr-only">(nouvel onglet)</span><span aria-hidden="true">↗</span></a>
          </div>
        </li>
      ))}
    </ol>
  </section>
  <section class="audiences-indicatives" aria-labelledby="titre-audiences-indicatives">
    <div class="titre-liste"><h2 id="titre-audiences-indicatives">Audiences à reconfirmer</h2><span>Quimper et Rennes · Bretagne</span></div>
    <p>Ces dates et qualifications proviennent de calendriers publics de la cour d’appel de Rennes. Dernières mises à jour affichées : 8 juin 2026 pour le Finistère et 16 septembre 2026 pour l’Ille-et-Vilaine. Lors du contrôle du 7 novembre 2026, leurs pages directes renvoyaient une maintenance. <strong>Le maintien de ces audiences n’est donc pas reconfirmé.</strong> Avant tout déplacement, consulter le greffe. Les audiences devant la cour d’assises des mineurs sont exclues de cette sélection ; une audience évoquant des victimes mineures ne relève pas nécessairement de cette juridiction.</p>
    {audiences.length === 0 ? <p>Aucune date non échue ne subsiste dans cette sélection.</p> : (
      <ol>{audiences.map(a=>(
        <li data-agenda-ligne data-departement={a.departement} data-debut={a.debut} data-fin={a.fin}>
          <div class="periode"><time datetime={a.debut}>{formatDate(a.debut)}</time><span>au</span><time datetime={a.fin}>{formatDate(a.fin)}</time></div>
          <div>
            <p class="localisation">{a.ville} · {a.departement}</p>
            <h3>{a.juridiction}</h3>
            <p>Objet mentionné au calendrier : {a.objet}.</p>
            <a href={a.source} target="_blank" rel="noopener noreferrer">Consulter la page institutionnelle <span class="sr-only">(nouvel onglet)</span></a>
          </div>
        </li>
      ))}</ol>
    )}
  </section>
  <section class="sources-en-cours" aria-labelledby="titre-sources-en-cours">
    <div class="titre-liste"><h2 id="titre-sources-en-cours">Juridictions à vérifier</h2><span>Aucune date d’audience annoncée ici</span></div>
    <p>Les pages suivantes ont été repérées, mais la période exacte des sessions n’a pas encore été confirmée. Elles ne figurent donc pas dans l’agenda daté.</p>
    <ul>
      {SOURCES_A_COMPLETER.map(s=>(
        <li><div><strong>{s.ressort}</strong><span>{s.statut}</span></div><a href={s.source} target="_blank" rel="noopener noreferrer">Voir la source officielle <span class="sr-only">(nouvel onglet)</span></a></li>
      ))}
    </ul>
  </section>
  <aside class="precautions">
    <h2>Avant de se déplacer</h2>
    <p>Les rôles peuvent être modifiés, notamment à l’approche des audiences. Plusieurs documents d’une même cour peuvent présenter des périodes qui se chevauchent : ils ne désignent pas nécessairement des procès différents. Vérifiez directement auprès du greffe ou de la cour d’appel les dates, la juridiction compétente et les conditions d’accès. Certaines audiences, notamment celles concernant des mineurs, ne sont pas publiques.</p>
    <a href="/veille-roles/">Consulter toutes les sources officielles répertoriées</a>
  </aside>
</Base>
<script>
  const filtres=document.querySelector<HTMLFormElement>('#filtres-agenda');
  const territoire=document.querySelector<HTMLSelectElement>('#filtre-departement');
  const periode=document.querySelector<HTMLSelectElement>('#filtre-mois');
  const message=document.querySelector<HTMLElement>('#resultats-agenda');
  const lignes=[...document.querySelectorAll<HTMLElement>('[data-agenda-ligne]')];
  const aujourdhuiParis=()=>new Intl.DateTimeFormat('en-CA',{
    year:'numeric',month:'2-digit',day:'2-digit',timeZone:'Europe/Paris'
  }).format(new Date());
  function afficherSelection(){
    const departement=territoire?.value??'';
    const mois=periode?.value??'';
    const debutMois=mois?mois+'-01':'';
    const finMois=mois?mois+'-31':'';
    const aujourdHui=aujourdhuiParis();
    let visibles=0;
    let encoreActuelles=0;
    for(const ligne of lignes){
      const nonTerminee=(ligne.dataset.fin??'')>=aujourdHui;
      const memeDepartement=!departement||ligne.dataset.departement===departement;
      const memePeriode=!mois||(ligne.dataset.debut!<=finMois&&ligne.dataset.fin!>=debutMois);
      ligne.hidden=!(nonTerminee&&memeDepartement&&memePeriode);
      if(nonTerminee)encoreActuelles++;
      if(!ligne.hidden)visibles++;
    }
    if(message)message.textContent=encoreActuelles===0
      ?'Toutes les périodes répertoriées sont terminées. Consulter les rôles officiels pour les prochaines sessions.'
      :visibles===0
      ?'Aucune période non terminée ne correspond à ces filtres.'
      :visibles+' période'+(visibles>1?'s':'')+' affichée'+(visibles>1?'s':'')+'.';
    const compteurSessions=document.querySelector<HTMLElement>('#compteur-sessions');
    if(compteurSessions){
      const n=lignes.filter(l=>l.closest('.sessions')&&!l.hidden).length;
      compteurSessions.textContent=n+' période'+(n>1?'s':'')+' répertoriée'+(n>1?'s':'');
    }
  }
  const params=new URLSearchParams(window.location.search);
  const departementDemande=params.get('departement');
  if(departementDemande && territoire && [...territoire.options].some(option=>option.value===departementDemande)){
    territoire.value=departementDemande;
  }
  const moisDemande=params.get('mois');
  if(moisDemande && periode && [...periode.options].some(option=>option.value===moisDemande)){
    periode.value=moisDemande;
  }
  afficherSelection();
  const alerte=document.querySelector<HTMLElement>('#alerte-actualite');
  if(alerte){
    const aujourdhui=aujourdhuiParis();
    const conversion=(v:string)=>Date.parse(v+'T12:00:00Z');
    const dateVerification=alerte.dataset.dateVerification??'';
    const dateGeneration=alerte.dataset.dateGeneration??'';
    const joursDepuisControle=Math.floor((conversion(aujourdhui)-conversion(dateVerification))/86400000);
    const joursDepuisGeneration=Math.floor((conversion(aujourdhui)-conversion(dateGeneration))/86400000);
    if(joursDepuisControle>7 || joursDepuisGeneration>1){
      alerte.hidden=false;
      alerte.textContent='Attention : cette sélection n’est pas un calendrier judiciaire en temps réel. La dernière vérification documentaire date de '+dateVerification+' et cette page a été générée le '+dateGeneration+'. Consultez les rôles officiels avant tout déplacement.';
    }
  }
  filtres?.addEventListener('change',afficherSelection);
  filtres?.addEventListener('reset',()=>requestAnimationFrame(afficherSelection));
</script>
<style>
.tete-agenda{margin:2rem 0 2.5rem;padding:clamp(1.5rem,4vw,3rem);background:#f3f0eb;border-top:3px solid #a12c39;color:#202529}
.sur-titre{margin:0 0 1rem;font:650 .8rem/1.5 var(--sans);color:#96313b}
.tete-agenda h1{font:650 clamp(2.6rem,6vw,5rem)/1.08 var(--serif);letter-spacing:-.045em;margin:0 0 1.1rem}
.tete-agenda h1 span{color:#96313b}
.tete-agenda>p:not(.sur-titre){max-width:75ch;font:450 1rem/1.7 var(--sans)}
.tete-agenda .date-controle{font-size:.83rem!important;color:#575b5e}
.titre-liste{display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;align-items:baseline;border-bottom:2px solid #a12c39;padding-bottom:.8rem}
.titre-liste h2{font:650 clamp(1.7rem,3vw,2.6rem)/1.15 var(--serif);margin:0}
.titre-liste span{font:550 .82rem var(--sans)}
.sessions ol{list-style:none;margin:0;padding:0}
.sessions li{display:grid;grid-template-columns:minmax(11rem,1fr) minmax(0,2fr);gap:clamp(1rem,3vw,2.5rem);padding:1.5rem 0;border-bottom:1px solid #d9d5cf}
.periode{display:flex;flex-direction:column;align-items:flex-start;gap:.15rem;font:650 .94rem/1.45 var(--sans)}
.periode span{font:450 .75rem var(--sans);color:#596066}
.localisation{font:650 .8rem/1.5 var(--sans);color:#96313b;margin:0 0 .4rem}
.contenu h3{font:600 clamp(1.3rem,2vw,1.65rem)/1.25 var(--serif);margin:0}
.contenu>p:not(.localisation){font:450 .9rem/1.6 var(--sans);margin:.5rem 0}
.contenu a{display:inline-block;font:650 .84rem/1.6 var(--sans);text-decoration:underline;text-underline-offset:.22em}
.contenu a:hover,.precautions a:hover{color:#96313b}
.precautions{border-left:3px solid #a12c39;background:#f3f0eb;padding:1.4rem clamp(1.2rem,3vw,2.2rem);margin:2.5rem 0 3.5rem}
.precautions h2{font:650 1.5rem var(--serif);margin:0}
.precautions p{font:450 .92rem/1.7 var(--sans)}
.precautions a{font:650 .85rem/1.55 var(--sans);text-decoration:underline;text-underline-offset:.2em}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
@media(max-width:40rem){.sessions li{grid-template-columns:minmax(0,1fr);gap:.7rem}.periode{flex-direction:row;flex-wrap:wrap;gap:.4rem}.tete-agenda{margin-top:1.1rem}.tete-agenda h1{overflow-wrap:anywhere}}
.agenda-vide{padding:1.4rem 0;font:450 .95rem/1.7 var(--sans);max-width:65ch}

.sources-en-cours{margin:3rem 0}
.sources-en-cours>p{font:450 .91rem/1.65 var(--sans);max-width:76ch;margin:1rem 0}
.sources-en-cours ul{padding:0;margin:0;list-style:none}
.sources-en-cours li{display:flex;justify-content:space-between;gap:1.25rem;align-items:baseline;padding:1rem 0;border-bottom:1px solid #d9d5cf}
.sources-en-cours li>div{display:flex;flex-direction:column;gap:.25rem}
.sources-en-cours strong{font:650 1rem/1.5 var(--sans)}
.sources-en-cours li span{font:450 .82rem/1.55 var(--sans);color:#596066}
.sources-en-cours a{font:650 .82rem/1.5 var(--sans);text-decoration:underline;text-underline-offset:.2em}
.sources-en-cours a:hover{color:#96313b}
@media(max-width:40rem){.sources-en-cours li{flex-direction:column;gap:.5rem}}

.audiences-indicatives{margin:3rem 0;padding:1.5rem;background:#f5f2ed;border-left:3px solid #a12c39}
.audiences-indicatives>p{font:450 .91rem/1.7 var(--sans);max-width:85ch}
.audiences-indicatives ol{list-style:none;margin:0;padding:0}
.audiences-indicatives li{display:grid;grid-template-columns:minmax(11rem,1fr) minmax(0,2fr);gap:1.5rem;padding:1.3rem 0;border-top:1px solid #d9d5cf}
.audiences-indicatives h3{font:600 clamp(1.3rem,2vw,1.65rem)/1.3 var(--serif);margin:.15rem 0}
.audiences-indicatives li p:not(.localisation){font:450 .87rem/1.6 var(--sans)}
.audiences-indicatives li a{font:650 .82rem/1.5 var(--sans);text-decoration:underline;text-underline-offset:.2em}
.audiences-indicatives li a:hover{color:#96313b}
@media(max-width:40rem){.audiences-indicatives{padding:1rem}.audiences-indicatives li{grid-template-columns:minmax(0,1fr);gap:.7rem}}

.filtres-agenda{display:flex;flex-wrap:wrap;align-items:end;gap:.9rem 1.2rem;padding:1.2rem;margin:1.8rem 0 2rem;background:#f3f0eb;border-top:2px solid #a12c39;font:500 .86rem/1.5 var(--sans)}
.filtres-agenda>div{display:flex;flex-direction:column;gap:.35rem;flex:1 1 190px;min-width:0}
.filtres-agenda label{font-weight:650;color:#202529}
.filtres-agenda select{font:500 .93rem/1.4 var(--sans);padding:.7rem .65rem;border:1px solid #aaa39d;border-radius:0;min-height:44px;max-width:100%;background:#fff;color:#202529}
.filtres-agenda button{font:650 .8rem/1.4 var(--sans);text-transform:none;letter-spacing:0;background:#fff;color:#202529;border:1px solid #a12c39;border-radius:0;padding:.75rem .9rem;min-height:44px;cursor:pointer}
.filtres-agenda button:hover{background:#a12c39;color:#fff}
.filtres-agenda #resultats-agenda{flex-basis:100%;margin:0;color:#555b5f;font-size:.81rem}
.sessions li[hidden],.audiences-indicatives li[hidden]{display:none!important}
@media(max-width:40rem){.filtres-agenda{padding:1rem}.filtres-agenda button{width:100%}}
.alerte-actualite:not([hidden]){display:block;margin:1rem 0;padding:1rem;background:#fff4dc;border-left:4px solid #98631b;color:#272521;font:650 .85rem/1.6 var(--sans)}
</style>
