---
import Base from '../layouts/Base.astro';
const livres = [
  { auteur:'Emmanuel Carrère', titre:'L’Adversaire', description:'Un récit littéraire sur une affaire criminelle et le vertige de la vérité.' },
  { auteur:'Philippe Jaenada', titre:'La Serpe', description:'Une contre-enquête littéraire qui interroge l’instruction, les indices et la mémoire d’un procès.' },
  { auteur:'Gilles Perrault', titre:'Le Pull-over rouge', description:'Un ouvrage de référence dans les débats autour d’une affaire judiciaire française.' }
];
---
<Base titre="La Boutique" description="La Boutique d’Intime Conviction : une sélection éditoriale de livres de justice criminelle et les futures éditions originales du journal.">
  <div class="boutique">
    <header class="hero">
      <p class="kicker">INTIME CONVICTION / LA BOUTIQUE</p>
      <h1>La justice se lit<br /><span>aussi hors du prétoire.</span></h1>
      <p class="intro">Une librairie choisie avec exigence, des objets éditoriaux à venir et, demain, les éditions du journal. Une boutique à part de la rédaction, fidèle à la curiosité qui anime Intime Conviction.</p>
      <a class="lien" href="#librairie">Découvrir la sélection <span aria-hidden="true">↘</span></a>
    </header>
    <section class="bloc" id="librairie" aria-labelledby="librairie-titre">
      <div class="entete-bloc"><div><p class="kicker">01 / LA LIBRAIRIE</p><h2 id="librairie-titre">Des livres qui font procès.</h2></div><p>Trois premières recommandations. Les liens marchands seront proposés après validation des partenariats, sans compromis sur les choix de la rédaction.</p></div>
      <div class="grille">
        {livres.map((livre,i)=><article class="fiche"><span class="numero">SÉLECTION {String(i+1).padStart(2,'0')}</span><div class="couverture" aria-hidden="true"><span>INTIME<br />CONVICTION</span><strong>{livre.titre}</strong><small>{livre.auteur}</small></div><h3>{livre.titre}</h3><p class="auteur">{livre.auteur}</p><p>{livre.description}</p><span class="statut">Sélection éditoriale · Achat bientôt disponible</span></article>)}
      </div>
      <p class="note">Les visuels ci-dessus sont des compositions typographiques du journal et non les couvertures commerciales des ouvrages.</p>
    </section>
    <section class="editions" aria-labelledby="editions-titre"><div><p class="kicker">02 / LES ÉDITIONS</p><h2 id="editions-titre">Nos propres dossiers, bientôt.</h2><p>Des publications numériques originales sur le fonctionnement des cours d’assises, les grandes affaires et l’histoire du procès criminel. Chaque publication sera documentée, sourcée et annoncée avec son contenu et son prix avant toute mise en vente.</p></div><div class="macaron"><span>ÉDITIONS</span><strong>IC.</strong><span>À PARAÎTRE</span></div></section>
    <section class="transparence" aria-labelledby="transparence-titre"><p class="kicker">INDÉPENDANCE & TRANSPARENCE</p><h2 id="transparence-titre">L’éditorial reste libre.</h2><p>La boutique est distincte du travail journalistique. À l’avenir, certains liens pourront donner lieu à une commission si un achat est effectué. Ces liens seront identifiés clairement ; leur présence n’influencera ni la couverture des procès ni les analyses publiées dans le journal.</p><p>Aucun achat ni paiement n’est actuellement proposé sur cette page.</p></section>
  </div>
</Base>
<style>
.boutique{--rouge:#9b303d;color:#252a2d;font-family:var(--sans);padding-bottom:4rem}.hero{padding:clamp(2rem,6vw,5rem) clamp(1rem,4vw,3rem);background:#f2ece4;border-top:5px solid var(--rouge);margin-top:2rem}.kicker{color:var(--rouge);font-size:.72rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.hero h1{font-size:clamp(2.8rem,6vw,6.4rem);font-weight:800;letter-spacing:-.065em;line-height:1.03;max-width:950px;margin:1rem 0 1.5rem}.hero h1 span{color:var(--rouge)}.intro{font-size:clamp(1.06rem,1.7vw,1.35rem);line-height:1.6;max-width:740px}.lien{display:inline-block;margin-top:1.5rem;padding:.8rem 1rem;background:#252a2d;color:white;text-decoration:none;font-weight:700}.lien:focus-visible,.lien:hover{background:var(--rouge)}.bloc{padding-top:4rem}.entete-bloc{display:flex;justify-content:space-between;align-items:end;gap:2rem;border-bottom:1px solid #ccc3b9;padding-bottom:1.7rem}.entete-bloc h2,.editions h2,.transparence h2{font-size:clamp(1.9rem,3.2vw,3.2rem);line-height:1.12;letter-spacing:-.04em;margin:.5rem 0}.entete-bloc>p{max-width:340px;line-height:1.65}.grille{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.3rem;margin-top:1.8rem}.fiche{padding:1.1rem;border:1px solid #ded7d0;background:#fff;display:flex;flex-direction:column;align-items:start}.numero,.statut{font-size:.68rem;letter-spacing:.08em;font-weight:700;text-transform:uppercase}.numero{color:#6d6d6d;margin-bottom:1rem}.couverture{width:100%;aspect-ratio:4/3;background:linear-gradient(135deg,#2f3033,#64252d);color:#fff;padding:1.5rem;display:flex;flex-direction:column;justify-content:space-between}.couverture span{font-size:.7rem;letter-spacing:.12em;font-weight:800}.couverture strong{font-size:clamp(1.4rem,2.3vw,2.3rem);line-height:1.1;letter-spacing:-.04em}.couverture small{font-size:.8rem}.fiche h3{font-size:1.35rem;line-height:1.25;margin:1.2rem 0 .2rem}.fiche p{line-height:1.6}.fiche .auteur{font-size:.85rem;color:#6c6461;margin:0}.statut{color:#88424a;border-top:1px solid #e7e2df;padding-top:1rem;margin-top:auto;line-height:1.5}.note{font-size:.8rem;color:#665d5b}.editions{display:flex;gap:2rem;align-items:center;justify-content:space-between;padding:3rem;background:#27282a;color:#fff;margin-top:4rem}.editions h2{color:#fff}.editions p:not(.kicker){line-height:1.75;max-width:700px}.editions .kicker{color:#e6a7ac}.macaron{min-width:175px;aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:space-evenly;border:2px solid #ba6c76;border-radius:50%;color:#efd8d9}.macaron strong{font-size:4rem;letter-spacing:-.1em}.macaron span{font-size:.7rem;letter-spacing:.12em}.transparence{border-top:1px solid #d5cac2;margin-top:4rem;padding-top:2rem;max-width:780px}.transparence p:not(.kicker){line-height:1.75}@media(max-width:760px){.entete-bloc,.editions{display:block}.grille{grid-template-columns:1fr}.macaron{margin-top:2rem}.hero{margin-top:1rem}.editions{padding:2rem}.couverture{aspect-ratio:1.6}}
</style>