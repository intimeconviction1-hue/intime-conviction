---
import { signatureRedaction } from '../../../../lib/diffusion.mjs';
import { DOSSIERS, dossiersPourArticle, referencesPourDossier } from '../../../../lib/dossiers.mjs';
import { lireVeille } from '../../../../lib/veille.mjs';
import { routesArticles } from '../../../../lib/adresses-articles.mjs';
import Base from '../../../../layouts/Base.astro';
import { photoPourArticle } from '../../../../lib/photos-articles.mjs';
import { indexerMaillage, relierAuGuide } from '../../../../lib/maillage.mjs';
import ListeArticles from '../../../../components/ListeArticles.astro';
import { rubrique } from '../../../../lib/rubriques.mjs';
import { corpsAffiche } from '../../../../lib/corps-article.mjs';
import { provenanceVerifiee } from '../../../../lib/provenance-archives.mjs';
import { formatArchiveVerifie } from '../../../../lib/formats-archives.mjs';
import { tousLesArticles, dateLongue, minutesDeLecture } from '../../../../lib/articles.mjs';

// L'adresse est celle de l'ancien WordPress, /titre/mois/année/, pour que les
// liens partagés depuis 2009 mènent toujours au bon article.
export async function getStaticPaths() {
  const [articles, veille] = await Promise.all([tousLesArticles(), lireVeille()]);
  const dossiersPublies = new Set(DOSSIERS.filter(dossier => referencesPourDossier(dossier, veille.articles).length));
  const recommandations = indexerMaillage(articles);
  return routesArticles(articles).map(({ params, article, redirection }) => {
    if (redirection) return { params, props: { redirection } };
    return { params, props: { article, modules: recommandations(article), dossiers: dossiersPourArticle(article.data).filter(dossier => dossiersPublies.has(dossier)) } };
  });
}

const { article, modules, dossiers, redirection } = Astro.props;
if (redirection) return Astro.redirect(redirection, 301);
const { data } = article;
const r = rubrique(data.rubrique);
const photo = photoPourArticle(data);
const provenance = provenanceVerifiee(data.chemin);
const formatArchive = formatArchiveVerifie(data.chemin);
const signatureArchive = String(data.auteur ?? '').trim();
// Le nom du journal provient d'un champ WordPress importé et ne suffit pas
// à identifier la personne qui a rédigé un texte historique.
const redaction = signatureRedaction(signatureArchive);
const urlPartage = new URL(data.chemin, Astro.site);
urlPartage.searchParams.set('utm_source', 'whatsapp');
urlPartage.searchParams.set('utm_medium', 'social');
urlPartage.searchParams.set('utm_campaign', 'partage_lecteurs');
const lienWhatsApp = new URL('https://wa.me/');
lienWhatsApp.searchParams.set('text', `${data.titre} — ${urlPartage}`);

const urlPartageX = new URL(data.chemin, Astro.site);
urlPartageX.searchParams.set('utm_source', 'x');
urlPartageX.searchParams.set('utm_medium', 'social');
urlPartageX.searchParams.set('utm_campaign', 'partage_lecteurs');
const lienX = new URL('https://twitter.com/intent/tweet');
const titrePartageX = data.titre.length > 165 ? data.titre.slice(0, 162).trimEnd() + '…' : data.titre;
lienX.searchParams.set('text', titrePartageX);
lienX.searchParams.set('url', urlPartageX.href);
lienX.searchParams.set('via', 'IntimeConv');
const archiveHistorique = data.date.getTime() < Date.now() - 365 * 86400000;

const auteurIdentifie = provenance?.auteur ?? (signatureArchive.toLocaleLowerCase('fr') === 'intime conviction' ? null : (signatureArchive || null));
---
<Base cheminCanonique={data.chemin} image={photo?.image.src} imageAlt={photo?.lieu} titre={data.titre} titreSeo={data.titreSeo} description={data.extrait} descriptionSeo={data.descriptionSeo} rubriqueActive={data.rubrique} noindex={data.verificationEnCours === true} article={{ headline:data.titre,section:r.libelle,imageDimensions:photo ? {width:photo.image.width,height:photo.image.height} : undefined,datePublished:data.date.toISOString(),dateModified:data.dateMiseAJour?.toISOString(),author:auteurIdentifie, authorType:redaction ? 'Organization' : 'Person', type:redaction && data.rubrique === 'cours-du-jour' ? 'NewsArticle' : 'Article' }}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context':'https://schema.org',
    '@type':'BreadcrumbList',
    itemListElement:[
      {'@type':'ListItem',position:1,name:'Accueil',item:'https://www.intimeconviction.fr/'},
      {'@type':'ListItem',position:2,name:r.libelle,item:new URL('/rubrique/'+r.slug+'/',Astro.site).href},
      {'@type':'ListItem',position:3,name:data.titre,item:new URL(data.chemin,Astro.site).href}
    ]
  })} />
  <div class="lecture-progression" aria-hidden="true"></div>
  <nav class="fil-ariane" aria-label="Fil d’Ariane">
    <a href="/">Accueil</a><span aria-hidden="true">/</span><a href={`/rubrique/${r.slug}/`}>{r.libelle}</a><span aria-hidden="true">/</span><span>Article du {dateLongue(data.date)}</span>
  </nav>
  <article class="article">
    <p class="etiquette"><a href={`/rubrique/${r.slug}/`}>{r.libelle}</a></p>
    <h1>{data.titre}</h1>
    <p class="meta">
      <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
      {/* Les corrections sont tracées dans dateModified des données structurées, sans second horodatage dans la signature éditoriale. */}
      {auteurIdentifie && <> · {auteurIdentifie}</>}
      · {minutesDeLecture(data.mots)} min de lecture
    </p>
    {provenance && (
      <aside class="credit-archive" aria-label="Provenance de cette archive">
        <strong>Provenance de l’article</strong>
        <p>Texte publié initialement par <a href={provenance.url} rel="noopener noreferrer" target="_blank">{provenance.media}<span class="sr-only"> (nouvel onglet)</span></a>, signé {provenance.auteur}, le <time datetime={provenance.publieLe}>{dateLongue(new Date(provenance.publieLe + 'T12:00:00Z'))}</time>.</p>
      </aside>
    )}
    {formatArchive && (
      <aside class="format-archive" aria-label="Nature de cette archive">
        <strong>{formatArchive.nom}</strong>
        <p>{formatArchive.explication}</p>
      </aside>
    )}
    <div class="outils-lecture"><span>Confort de lecture</span><button id="taille-texte" type="button" aria-pressed="false">Agrandir le texte</button>{data.verificationEnCours !== true && <a class="partager-x" href={lienX.href} target="_blank" rel="noopener noreferrer" aria-label="Partager cet article sur X, nouvel onglet">Partager sur X</a>}{data.verificationEnCours !== true && <a class="partager-whatsapp" href={lienWhatsApp.href}>Partager sur WhatsApp</a>}<button id="copier-lien" type="button">Copier le lien</button><span id="partage-statut" role="status"></span></div>
    {photo && (
      <figure class="photo-article">
        <img src={photo.image.src} width={photo.image.width} height={photo.image.height} alt={photo.lieu} fetchpriority="high" />
        <figcaption>{photo.lieu} · <a href={photo.source}>{photo.auteur}</a> · <a href={photo.lienLicence}>{photo.licence}</a></figcaption>
      </figure>
    )}
    <div class="corps" set:html={data.verificationEnCours ? corpsAffiche(data.html, data.date) : relierAuGuide(corpsAffiche(data.html, data.date))} />
    {archiveHistorique && data.verificationEnCours !== true && (
      <aside class="passerelle-archives" aria-label="Actualité du journal">
        <span>POURSUIVRE LA LECTURE</span>
        <a href="/rubrique/cours-du-jour/#articles-redaction">Découvrir les dernières actualités judiciaires du journal</a>
      </aside>
    )}
    <nav class="retour-archives" aria-label="Parcourir les dossiers et les archives">
      {redaction && data.rubrique === 'l-expose' && <a href="/dossiers/">Les dossiers de la rédaction</a>}
      {dossiers.map(dossier => <a href={`/dossiers/${dossier.slug}/`}>Suivre le dossier · {dossier.titre}</a>)}
      <a href={`/archives/${data.date.getFullYear()}/`}>Tous les articles de {data.date.getFullYear()}</a>
      <a href="/archives/presse/">Archives de presse</a>
    </nav>
  </article>

  {modules.map(({ titre, articles }, index) => (
    <aside class="voisins" aria-labelledby={`maillage-${index}`}>
      <div class="titre-section"><h2 id={`maillage-${index}`}>{titre}</h2></div>
      <ListeArticles articles={articles} rubriqueVisible={false} extraits={false} />
    </aside>
  ))}
</Base>

<script>
const taille=document.querySelector<HTMLButtonElement>('#taille-texte')!;
taille.addEventListener('click',()=>{const actif=taille.getAttribute('aria-pressed')!=='true';taille.setAttribute('aria-pressed',String(actif));document.querySelector('.corps')!.classList.toggle('texte-grand',actif);taille.textContent=actif?'Taille normale':'Agrandir le texte';});
document.querySelector('#copier-lien')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);document.querySelector('#partage-statut')!.textContent='Lien copié';}catch{document.querySelector('#partage-statut')!.textContent='Copiez l’adresse depuis votre navigateur.';}});
const barre=document.querySelector<HTMLElement>('.lecture-progression')!;const article=document.querySelector('.article')!;
function progression(){const r=article.getBoundingClientRect();barre.style.width=Math.max(0,Math.min(100,(-r.top/Math.max(1,r.height-innerHeight))*100))+'%';}addEventListener('scroll',progression,{passive:true});progression();
</script>

<style>
.photo-article{margin:1.5rem 0}
.photo-article img{display:block;width:100%;height:auto}
.photo-article figcaption{margin-top:.45rem;color:var(--encre-2);font:.75rem/1.5 var(--sans)}
.photo-article a{text-decoration:underline;text-underline-offset:.15em}

.fil-ariane{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center;max-width:var(--mesure);margin:2rem auto 0;font:850 .63rem/1.5 var(--sans);letter-spacing:.045em;text-transform:uppercase}
.fil-ariane span[aria-hidden]{color:#787b77}
.fil-ariane a{border-bottom:2px solid var(--action);padding-bottom:.15rem}
.fil-ariane a:hover{background:var(--action);color:var(--sur-action)}
.article{margin-top:2rem}
.outils-lecture{border-bottom:1px solid var(--filet);padding-bottom:1rem}
@media(max-width:47.99rem){.fil-ariane{margin-top:1.5rem;font-size:.6rem;gap:.5rem}.article{margin-top:1.3rem}}


.fil-ariane{font:650 .69rem/1.6 var(--sans);letter-spacing:0;text-transform:none;color:#565b5e}
.fil-ariane a{border-bottom:1px solid #a12c39}
.fil-ariane a:hover{background:transparent;color:#a12c39}
.partager-whatsapp,.partager-x{font:inherit;color:inherit;text-decoration:underline;text-underline-offset:.2em}
.passerelle-archives{margin-top:2.15rem;padding:.9rem 0;border-top:1px solid var(--filet);border-bottom:1px solid var(--filet);font-family:var(--sans)}
.passerelle-archives span{display:block;font-size:.65rem;font-weight:750;letter-spacing:.08em;color:var(--encre-2);margin-bottom:.3rem}
.passerelle-archives a{font-size:.95rem;line-height:1.4;color:var(--encre);text-decoration:underline;text-decoration-color:#873147;text-underline-offset:.2em}
.passerelle-archives a:hover{color:var(--rouge)}
.outils-lecture :is(button,a):focus-visible{outline:3px solid #a12c39}


.credit-archive{margin:1.25rem 0;padding:1rem 1.2rem;border-left:3px solid #a12c39;background:#f0eee9;color:#202529}
.credit-archive strong{font:700 .77rem/1.5 var(--sans)}
.credit-archive p{font:450 .9rem/1.65 var(--sans);margin:.35rem 0 0}
.credit-archive a{text-decoration:underline;text-underline-offset:.17em}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}

.format-archive{margin:1.2rem 0;padding:1rem 1.2rem;background:#f3f0eb;border-left:3px solid #77726b;color:#252a2d}
.format-archive strong{font:700 .82rem/1.5 var(--sans)}
.format-archive p{font:450 .91rem/1.65 var(--sans);margin:.35rem 0 0}

.retour-archives{display:flex;flex-wrap:wrap;gap:.65rem 1.5rem;border-top:1px solid var(--filet);margin-top:2rem;padding-top:1.15rem;font:650 .83rem/1.5 var(--sans)}
.retour-archives a{text-decoration:underline;text-underline-offset:.2em}
.retour-archives a:hover{color:#a12c39}

/* Repères éditoriaux, sommaire et chronologie : contenus statiques, sans script. */
.corps :global(.dossier-reperes){margin:1.5rem 0 1rem;padding:clamp(1rem,3vw,1.7rem);border:1px solid var(--filet);border-top:4px solid var(--rouge-journal);background:var(--surface-journal);color:var(--encre-journal)}
.corps :global(.dossier-label){font:750 .68rem/1.5 var(--sans);letter-spacing:.09em;color:var(--rouge-journal);margin:0 0 .6rem}
.corps :global(.dossier-reperes h2){font:650 clamp(1.6rem,4vw,2.15rem)/1.12 var(--serif);margin:0 0 1.1rem}
.corps :global(.dossier-reperes dl){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem 1.1rem;margin:0}
.corps :global(.dossier-reperes dl>div){border-top:1px solid var(--filet);padding-top:.65rem;min-width:0}
.corps :global(.dossier-reperes dt){font:650 .75rem/1.5 var(--sans);color:var(--encre-2);margin-bottom:.25rem}
.corps :global(.dossier-reperes dd){font:650 .94rem/1.5 var(--sans);margin:0;overflow-wrap:anywhere}
.corps :global(.dossier-reserve){border-top:1px solid var(--filet);font:500 .8rem/1.55 var(--sans);margin:1rem 0 0;padding-top:.75rem}
.corps :global(.dossier-sommaire){display:flex;flex-wrap:wrap;gap:.35rem .9rem;border-block:1px solid var(--filet);margin:1rem 0 1.75rem;padding:.45rem 0}
.corps :global(.dossier-sommaire a){display:inline-flex;min-height:44px;align-items:center;font:650 .85rem/1.4 var(--sans);color:var(--encre-journal);text-decoration:underline;text-decoration-color:var(--rouge-journal);text-underline-offset:.25em}
.corps :global(.dossier-chronologie){list-style:none;margin:1.2rem 0 2rem;padding:0;border-left:2px solid var(--filet)}
.corps :global(.dossier-chronologie li){position:relative;padding:0 0 1.25rem 1.3rem;margin:0;display:grid;grid-template-columns:minmax(7rem,10rem) minmax(0,1fr);gap:.5rem 1rem}
.corps :global(.dossier-chronologie li::before){content:"";position:absolute;left:-6px;top:.45rem;width:10px;height:10px;border-radius:50%;background:var(--rouge-journal)}
.corps :global(.dossier-chronologie time){font:700 .83rem/1.5 var(--sans);color:var(--rouge-journal)}
.corps :global(.dossier-chronologie strong){font:650 1.15rem/1.3 var(--serif)}
.corps :global(.dossier-chronologie p){font:450 .93rem/1.6 var(--sans);margin:.35rem 0 0}
.corps :global(h2[id]){scroll-margin-top:1.5rem}
@media(max-width:35rem){.corps :global(.dossier-reperes dl){grid-template-columns:1fr}.corps :global(.dossier-chronologie li){grid-template-columns:1fr;gap:.25rem}.corps :global(.dossier-sommaire){display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
