---
import Base from '../../../../layouts/Base.astro';
import ListeArticles from '../../../../components/ListeArticles.astro';
import { rubrique } from '../../../../lib/rubriques.mjs';
import { tousLesArticles, dateLongue, minutesDeLecture } from '../../../../lib/articles.mjs';

// L'adresse est celle de l'ancien WordPress, /titre/mois/année/, pour que les
// liens partagés depuis 2009 mènent toujours au bon article.
export async function getStaticPaths() {
  const articles = await tousLesArticles();
  // Precalcul des voisins par rubrique en O(n), plutot qu'un filtrage
  // integral de 3 436 articles pour chacune des pages generees.
  const groupes = new Map();
  for (const article of articles) {
    if (!groupes.has(article.data.rubrique)) groupes.set(article.data.rubrique, []);
    groupes.get(article.data.rubrique).push(article);
  }
  const voisinage = new Map();
  for (const groupe of groupes.values()) {
    for (let i = 0; i < groupe.length; i++) {
      voisinage.set(groupe[i], [groupe[i - 1], groupe[i + 1], groupe[i + 2]].filter(Boolean));
    }
  }
  return articles.map((article) => {
    const [, slug, mois, annee] = article.data.chemin.split('/');
    return { params: { slug, mois, annee }, props: { article, voisins: voisinage.get(article) ?? [] } };
  });
}

const { article, voisins } = Astro.props;
const { data } = article;
const r = rubrique(data.rubrique);
const signatureArchive = String(data.auteur ?? '').trim();
// Le nom du journal provient d'un champ WordPress importé et ne suffit pas
// à identifier la personne qui a rédigé un texte historique.
const auteurIdentifie = signatureArchive.toLocaleLowerCase('fr') === 'intime conviction' ? null : (signatureArchive || null);
---
<Base titre={data.titre} description={data.extrait} rubriqueActive={data.rubrique} noindex={data.verificationEnCours === true} article={{ headline:data.titre,datePublished:data.date.toISOString(),dateModified:data.dateMiseAJour?.toISOString(),author:auteurIdentifie }}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context':'https://schema.org',
    '@type':'BreadcrumbList',
    itemListElement:[
      {'@type':'ListItem',position:1,name:'Accueil',item:'https://www.intimeconviction.fr/'},
      {'@type':'ListItem',position:2,name:r.nom,item:new URL('/rubrique/'+r.slug+'/',Astro.site).href},
      {'@type':'ListItem',position:3,name:data.titre,item:new URL(data.chemin,Astro.site).href}
    ]
  })} />
  <div class="lecture-progression" aria-hidden="true"></div>
  <nav class="fil-ariane" aria-label="Fil d’Ariane">
    <a href="/">Accueil</a><span aria-hidden="true">/</span><a href={`/rubrique/${r.slug}/`}>{r.nom}</a><span aria-hidden="true">/</span><span>Article du {dateLongue(data.date)}</span>
  </nav>
  <article class="article">
    <p class="etiquette"><a href={`/rubrique/${r.slug}/`}>{r.nom}</a></p>
    <h1>{data.titre}</h1>
    <p class="meta">
      <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
      {data.dateMiseAJour && <> · Mis à jour le <time datetime={data.dateMiseAJour.toISOString()}>{dateLongue(data.dateMiseAJour)}</time></>}
      {auteurIdentifie && <> · {auteurIdentifie}</>}
      · {minutesDeLecture(data.mots)} min de lecture
    </p>
    <div class="outils-lecture"><span>Confort de lecture</span><button id="taille-texte" type="button" aria-pressed="false">Agrandir le texte</button><button id="copier-lien" type="button">Copier le lien</button><span id="partage-statut" role="status"></span></div>
    <div class="corps" set:html={data.html} />
  </article>

  {voisins.length > 0 && (
    <aside class="voisins" aria-labelledby="voisins">
      <div class="titre-section"><h2 id="voisins">À lire également dans {r.nom}</h2></div>
      <ListeArticles articles={voisins} rubriqueVisible={false} extraits={false} />
    </aside>
  )}
</Base>

<script>
const taille=document.querySelector<HTMLButtonElement>('#taille-texte')!;
taille.addEventListener('click',()=>{const actif=taille.getAttribute('aria-pressed')!=='true';taille.setAttribute('aria-pressed',String(actif));document.querySelector('.corps')!.classList.toggle('texte-grand',actif);taille.textContent=actif?'Taille normale':'Agrandir le texte';});
document.querySelector('#copier-lien')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);document.querySelector('#partage-statut')!.textContent='Lien copié';}catch{document.querySelector('#partage-statut')!.textContent='Copiez l’adresse depuis votre navigateur.';}});
const barre=document.querySelector<HTMLElement>('.lecture-progression')!;const article=document.querySelector('.article')!;
function progression(){const r=article.getBoundingClientRect();barre.style.width=Math.max(0,Math.min(100,(-r.top/Math.max(1,r.height-innerHeight))*100))+'%';}addEventListener('scroll',progression,{passive:true});progression();
</script>

<style>
.fil-ariane{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center;max-width:var(--mesure);margin:2rem auto 0;font:850 .63rem/1.5 var(--sans);letter-spacing:.045em;text-transform:uppercase}
.fil-ariane span[aria-hidden]{color:#787b77}
.fil-ariane a{border-bottom:2px solid #ffe100;padding-bottom:.15rem}
.fil-ariane a:hover{background:#ffe100;color:#151515}
.article{margin-top:2rem}
.outils-lecture{border-bottom:1px solid var(--filet);padding-bottom:1rem}
@media(max-width:47.99rem){.fil-ariane{margin-top:1.5rem;font-size:.6rem;gap:.5rem}.article{margin-top:1.3rem}}


.fil-ariane{font:650 .69rem/1.6 var(--sans);letter-spacing:0;text-transform:none;color:#565b5e}
.fil-ariane a{border-bottom:1px solid #a12c39}
.fil-ariane a:hover{background:transparent;color:#a12c39}
.outils-lecture button:focus-visible{outline:3px solid #a12c39}

</style>
