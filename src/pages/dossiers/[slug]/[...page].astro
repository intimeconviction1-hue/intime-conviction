---
import Base from '../../../layouts/Base.astro';
import { lireVeille } from '../../../lib/veille.mjs';
import { DOSSIERS, referencesPourDossier, statistiquesDossier } from '../../../lib/dossiers.mjs';
import { reperesPourDossier, couvertureParMois, VERIFICATION_AU } from '../../../lib/chronologie-judiciaire.mjs';
import ChronologieEvenements from '../../../components/ChronologieEvenements.astro';
import CouvertureMensuelle from '../../../components/CouvertureMensuelle.astro';

export async function getStaticPaths({ paginate }) {
  const veille = await lireVeille();
  return DOSSIERS.flatMap(dossier => {
    const references = referencesPourDossier(dossier, veille.articles);
    if (!references.length) return [];
    const statistiques = statistiquesDossier(references);
    const moisCouverture = couvertureParMois(references);
    return paginate(references, {
      params: { slug: dossier.slug },
      props: { dossier, statistiques, moisCouverture },
      pageSize: 42
    });
  });
}

const { page, dossier, statistiques, moisCouverture } = Astro.props;
const reperes = reperesPourDossier(dossier.slug);
const nombre = (n) => n.toLocaleString('fr-FR');
const date = (s) => new Intl.DateTimeFormat('fr-FR', {
  day:'numeric',month:'long',year:'numeric',timeZone:'Europe/Paris'
}).format(new Date(s + 'T12:00:00Z'));
const titrePage = dossier.titre + (page.currentPage > 1 ? ' · page ' + page.currentPage : '');
---
<Base
  titre={titrePage}
  description={'Revue de presse sur ' + dossier.titre + ' : ' + nombre(statistiques.total) + ' références datées, publiées par ' + statistiques.medias + ' médias. Sources externes identifiées.'}
  rubriqueActive="dossiers"
>
  <nav aria-label="Fil d’Ariane" class="fil-ariane"><a href="/">ACCUEIL</a><span aria-hidden="true">/</span><a href="/dossiers/">DOSSIERS</a><span aria-hidden="true">/</span><span aria-current="page">{dossier.titre}</span></nav>
  <header class="entete-dossier">
    <div class="en-tete-annotation"><span>INTIME CONVICTION / REVUE DE PRESSE</span><span>FONDS DOCUMENTAIRE</span></div>
    <p class="repere">{dossier.repere}</p>
    <h1>{dossier.titre}<span class="point">.</span></h1>
    <p class="description">{dossier.presentation}</p>
    <div class="compteurs">
      <div><strong>{nombre(statistiques.total)}</strong><span>RÉFÉRENCES</span></div>
      <div><strong>{nombre(statistiques.medias)}</strong><span>MÉDIAS CITÉS</span></div>
      <div><strong>{statistiques.annees.length}</strong><span>ANNÉES D’ALERTES</span></div>
    </div>
  </header>

  <div class="separation">
    <div class="methode">
      <h2>CE QUE CONTIENT CE DOSSIER</h2>
      <p>Une liste de titres et de liens de presse ayant une <strong>mention explicite</strong> du sujet. Les contenus appartiennent aux médias cités. Certains titres peuvent seulement évoquer l’affaire, sans porter sur le même procès ou la même procédure. Aucun fait ni aucune décision de justice n’est déduit automatiquement de ces rapprochements.</p>
      <p>Les dates ci-dessous sont celles des <strong>alertes Google</strong>, pas nécessairement celles de publication, d’audience ou de jugement. Un lien ancien peut être devenu indisponible.</p>
    </div>
    <aside class="periode">
      <h2>REPÈRES DANS LE FONDS</h2>
      <p><span>PREMIÈRE ALERTE CONSERVÉE</span><strong>{date(statistiques.debut)}</strong></p>
      <p><span>DERNIÈRE ALERTE CONSERVÉE</span><strong>{date(statistiques.fin)}</strong></p>
    </aside>
  </div>

  {page.currentPage === 1 && reperes.length > 0 && (
    <section class="repere-detail" id="reperes-judiciaires" aria-labelledby="titre-reperes">
      <div class="tete-reperes">
        <p>LE TEMPS JUDICIAIRE / REPÈRES DOCUMENTÉS</p>
        <h2 id="titre-reperes">LES ÉTAPES<br /><span>DU DOSSIER.</span></h2>
        <div class="explication-reperes">
          <p>Les dates ci-dessous désignent les événements judiciaires rapportés dans des articles de presse identifiés. Elles sont <strong>distinctes des dates des alertes</strong> utilisées dans le reste du dossier.</p>
          <p>Il s’agit d’une sélection non exhaustive, vérifiée au <time datetime={VERIFICATION_AU}>{date(VERIFICATION_AU)}</time>. Le caractère définitif d’une décision ou l’état d’un recours ne sont pas présumés.</p>
          <a href="/chronologie/">VOIR LA CHRONOLOGIE DE TOUS LES DOSSIERS <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <ChronologieEvenements reperes={reperes} />
    </section>
  )}
  {page.currentPage === 1 && <CouvertureMensuelle moisDonnes={moisCouverture} />}
  {page.currentPage > 1 && (
    <p class="retour-frise">Le registre des étapes judiciaires et l’historique mensuel des alertes sont présentés sur la <a href={'/dossiers/' + dossier.slug + '/#reperes-judiciaires'}>première page de ce dossier</a>.</p>
  )}

  <section class="couverture" aria-labelledby="titre-periode">
    <h2 id="titre-periode">DANS LES ARCHIVES <span>PAR ANNÉE</span></h2>
    <ul>
      {statistiques.annees.map(([annee, n]) => (
        <li><a href={'/archives/presse/' + annee + '/'} title={'Voir toute la revue de presse de ' + annee}><strong>{annee}</strong><span>{nombre(n)} mentions dans ce dossier</span><span aria-hidden="true">↗</span></a></li>
      ))}
    </ul>
    <p>Les liens par année ouvrent l’archive complète de presse, sans filtre sur ce dossier.</p>
  </section>

  <section class="references" aria-labelledby="titre-references">
    <div class="titre-references">
      <div><p>LES SOURCES / PAGE {page.currentPage} SUR {page.lastPage}</p><h2 id="titre-references">LA REVUE<br /><span>DES TITRES.</span></h2></div>
      <span>{page.data.length} références affichées sur {nombre(statistiques.total)}</span>
    </div>
    <ol class="liste-references" start={(page.currentPage - 1) * page.size + 1}>
      {page.data.map((reference) => (
        <li>
          <div class="ligne-meta"><span class="source">{reference.source}</span><span>ALERTE DU <time datetime={reference.dateAlerte}>{date(reference.dateAlerte)}</time></span></div>
          <h3><a href={reference.lien} rel="noopener noreferrer" target="_blank">{reference.titre} <span class="sr-only">(site externe, nouvel onglet)</span><span class="sortie" aria-hidden="true">↗</span></a></h3>
        </li>
      ))}
    </ol>
    <nav class="pagination-dossiers" aria-label="Pages du dossier">
      {page.url.prev ? <a href={page.url.prev} rel="prev">← PAGE PRÉCÉDENTE</a> : <span aria-hidden="true"></span>}
      <span>{page.currentPage} / {page.lastPage}</span>
      {page.url.next ? <a href={page.url.next} rel="next">PAGE SUIVANTE →</a> : <span aria-hidden="true"></span>}
    </nav>
  </section>

  <div class="bas-dossier">
    <a href="/dossiers/">← REVENIR À TOUS LES DOSSIERS</a>
    <a href="/archives/presse/">CONSULTER LA REVUE DE PRESSE →</a>
  </div>
</Base>
<style>
.fil-ariane{display:flex;gap:.7rem;flex-wrap:wrap;align-items:center;padding:1.3rem 0;font:850 .65rem/1.5 var(--sans);letter-spacing:.05em}
.fil-ariane a:hover{text-decoration:underline}
.entete-dossier{background:#151718;color:#fff;border-top:8px solid #ffe100;padding:clamp(1.5rem,5vw,4rem)}
.en-tete-annotation{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font:850 .64rem/1.45 var(--sans);letter-spacing:.075em;color:#d9d9d6}
.repere{font:900 .77rem/1.3 var(--sans);letter-spacing:.07em;margin:3rem 0 1rem;color:#ffe100}
.entete-dossier h1{font:900 clamp(3rem,7.3vw,7rem)/.98 var(--sans);letter-spacing:-.075em;margin:0 0 1.4rem;max-width:13ch}
.point{color:#ffe100}
.entete-dossier .description{font:650 clamp(.98rem,1.5vw,1.2rem)/1.55 var(--sans);max-width:68ch;color:#e8e8e5;margin:0 0 3rem}
.compteurs{display:flex;gap:1.5rem 4rem;border-top:1px solid #6c6c69;padding-top:1.3rem;flex-wrap:wrap}
.compteurs div{display:flex;flex-direction:column;gap:.3rem}
.compteurs strong{font:900 clamp(2rem,3.5vw,3.2rem)/1 var(--sans);color:#ffe100}
.compteurs span{font:850 .65rem/1.4 var(--sans);letter-spacing:.065em}
.separation{display:grid;grid-template-columns:1.6fr 1fr;border-bottom:4px solid #151718}
.methode{padding:2.3rem 2rem 2.5rem 0}
.separation h2{font:900 1rem/1.2 var(--sans);letter-spacing:.02em;margin:0 0 1rem}
.methode p{font:500 .92rem/1.65 var(--sans);max-width:75ch;margin:.65rem 0}
.periode{background:#ffe100;color:#151718;padding:2rem}
.periode p{display:flex;flex-direction:column;gap:.3rem;margin:1.4rem 0 0;border-top:1px solid #151718;padding-top:.8rem}
.periode p span{font:900 .63rem/1.45 var(--sans);letter-spacing:.07em}
.periode p strong{font:850 1rem/1.35 var(--sans)}
.couverture{margin:3rem 0}
.couverture h2{font:900 clamp(1.65rem,2.6vw,2.4rem)/1.1 var(--sans);letter-spacing:-.05em;margin:0 0 1.1rem}
.couverture h2 span{color:#666}
.couverture ul{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:.5rem;list-style:none;margin:0;padding:0}
.couverture li a{display:flex;flex-direction:column;gap:.25rem;background:#f0f0eb;color:#151718;border:2px solid #151718;padding:1rem;min-height:108px}
.couverture li a:hover{background:#ffe100;color:#151718}
.couverture li strong{font:900 2rem/1 var(--sans)}
.couverture li span{font:700 .65rem/1.4 var(--sans)}
.couverture li span:last-child{align-self:end;margin-top:auto;font:900 1rem var(--sans)}
.couverture>p{font:500 .75rem/1.5 var(--sans);color:var(--encre-2)}
.titre-references{border-top:7px solid #151718;border-bottom:3px solid #151718;padding:1.7rem 0;display:flex;justify-content:space-between;align-items:end;gap:1.5rem}
.titre-references p{font:900 .65rem/1.4 var(--sans);margin:0 0 1rem;letter-spacing:.09em}
.titre-references h2{font:900 clamp(2.5rem,6vw,5.5rem)/.96 var(--sans);letter-spacing:-.075em;margin:0}
.titre-references h2 span{background:#ffe100;color:#151718}
.titre-references>span{font:800 .68rem/1.5 var(--sans);text-align:right;max-width:20ch}
.liste-references{list-style:none;margin:0;padding:0;counter-reset:document}
.liste-references li{display:grid;grid-template-columns:1fr 2.6fr;gap:1.6rem;padding:1.5rem 0;border-bottom:1px solid var(--filet)}
.ligne-meta{font:900 .67rem/1.5 var(--sans);text-transform:uppercase;display:flex;flex-direction:column;gap:.45rem}
.ligne-meta .source{color:var(--encre)}
.ligne-meta span:last-child{color:var(--encre-2)}
.liste-references h3{font:850 clamp(1.25rem,2vw,1.7rem)/1.25 var(--sans);letter-spacing:-.035em;margin:0}
.liste-references h3 a:hover{background:#ffe100;color:#151718}
.sortie{display:inline-block;font-weight:900;font-size:1rem;margin-left:.3rem}
.pagination-dossiers{display:grid;grid-template-columns:1fr auto 1fr;gap:.8rem;align-items:center;padding:2rem 0;border-bottom:3px solid #151718;font:900 .7rem/1.4 var(--sans)}
.pagination-dossiers a{padding:1rem 1.2rem;color:#151718;background:#ffe100;border:2px solid #151718;text-align:center}
.pagination-dossiers a:last-child{justify-self:end}
.pagination-dossiers a:hover{background:#151718;color:#fff}
.pagination-dossiers>span{text-align:center}
.bas-dossier{display:flex;gap:1.3rem;justify-content:space-between;flex-wrap:wrap;padding:2rem 0 4rem;font:900 .71rem/1.4 var(--sans)}
.bas-dossier a:hover{text-decoration:underline}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
@media(max-width:48rem){.fil-ariane{font-size:.58rem}.entete-dossier{padding:2rem 1.2rem}.entete-dossier h1{font-size:clamp(2.8rem,10vw,4.5rem)}.repere{margin-top:2rem}.separation{grid-template-columns:1fr}.methode{padding:1.5rem 0}.periode{padding:1.5rem}.liste-references li{grid-template-columns:1fr;gap:.6rem}.ligne-meta{flex-direction:row;justify-content:space-between;flex-wrap:wrap}.titre-references{align-items:start;flex-direction:column}.titre-references>span{text-align:left}.pagination-dossiers a{padding:.8rem .6rem}.couverture ul{grid-template-columns:repeat(2,minmax(0,1fr))}}
.repere-detail{padding-top:2.6rem;margin:3rem 0 2rem;border-top:8px solid #151718;scroll-margin-top:2rem}
.tete-reperes{display:grid;grid-template-columns:1.2fr 1fr;gap:1.4rem 2.5rem;align-items:end;margin-bottom:2rem}
.tete-reperes>p{grid-column:1/-1;margin:0;font:900 .67rem/1.4 var(--sans);letter-spacing:.08em}
.tete-reperes h2{font:900 clamp(2rem,4.7vw,4.5rem)/.96 var(--sans);letter-spacing:-.065em;margin:0}
.tete-reperes h2 span{background:#ffe100;color:#151718}
.explication-reperes p{font:500 .87rem/1.55 var(--sans);margin:0 0 .65rem}
.explication-reperes a{display:flex;gap:1rem;justify-content:space-between;align-items:center;padding:.8rem 0;border-top:2px solid #151718;font:900 .65rem/1.45 var(--sans)}
.explication-reperes a:hover{background:#ffe100;color:#151718}
.retour-frise{margin:2rem 0;background:#ffe100;color:#151718;padding:1.1rem;font:700 .84rem/1.55 var(--sans)}
.retour-frise a{text-decoration:underline}
@media(max-width:48rem){.tete-reperes{grid-template-columns:1fr}.tete-reperes>p{grid-column:auto}.tete-reperes h2{font-size:2.5rem}}
</style>
