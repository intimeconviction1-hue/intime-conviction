---
import VisuelAssises from '../../components/VisuelAssises.astro';
import photoAssises from '../../assets/assises-bordeaux.webp';
import Base from '../../layouts/Base.astro';
import { lireVeille } from '../../lib/veille.mjs';
import { DOSSIERS, referencesPourDossier, statistiquesDossier } from '../../lib/dossiers.mjs';

const veille = await lireVeille();
const dossiers = DOSSIERS
  .map(d => ({ ...d, ...statistiquesDossier(referencesPourDossier(d, veille.articles)) }))
  .filter(d => d.total > 0);
const totalReferences = dossiers.reduce((total, d) => total + d.total, 0);
const nombre = (n) => n.toLocaleString('fr-FR');
const date = (s) => new Intl.DateTimeFormat('fr-FR', {
  day:'numeric',month:'long',year:'numeric',timeZone:'Europe/Paris'
}).format(new Date(s + 'T12:00:00Z'));
---
<Base
  titre="Les dossiers judiciaires"
  description="Les affaires criminelles suivies par la presse : articles, décisions et chronologies judiciaires."
  rubriqueActive="dossiers"
>
  <header class="en-tete-dossiers ouverture-illustree">
    <div>
    <p class="code-dossier">Les affaires et leurs sources</p>
    <p class="en-tete-sur">Dossiers judiciaires</p>
    <h1>Les dossiers<br /><span>judiciaires</span></h1>
    <p class="sous-titre">Les grandes affaires criminelles, à travers les articles de presse et les étapes judiciaires documentées.</p>
    <div class="chiffres"><span><strong>{dossiers.length}</strong> dossiers thématiques</span><span><strong>{nombre(totalReferences)}</strong> liens répertoriés</span></div>
    </div>
    <VisuelAssises image={photoAssises} alt="Salle de la cour d’assises, palais Thiac, Bordeaux" source="https://commons.wikimedia.org/wiki/File:Palais_Thiac,_Salle_d%27audience_de_la_cour_d%27assises.jpg" credit="Tiraden" licence="CC BY-SA 4.0" licenceUrl="https://creativecommons.org/licenses/by-sa/4.0/" prioritaire />
  </header>
  <aside class="lien-chronologie">
    <div><span>Repères judiciaires documentés</span><strong>Les étapes des procédures</strong><p>Ouvertures d’audience, verdicts et appels : retrouvez les dates et les décisions documentées pour chaque affaire.</p></div>
    <a href="/chronologie/">Consulter la chronologie judiciaire <span aria-hidden="true">↗</span></a>
  </aside>
  <p class="lien-carte-index"><a href="/carte/">Voir les juridictions sur la carte <span aria-hidden="true">↗</span></a></p>
  <section class="repertoire" aria-labelledby="titre-repertoire">
    <div class="barre"><h2 id="titre-repertoire">Explorer les dossiers</h2><span>{dossiers.length} dossiers disponibles</span></div>
    <ol class="cartes">
      {dossiers.map((d,i)=>(
        <li>
          <a href={'/dossiers/' + d.slug + '/'} aria-label={'Explorer ' + d.titre}>
            <div class="ligne-haute"><span>DOSSIER Nº {String(i+1).padStart(2,'0')}</span><span class="signe" aria-hidden="true">↗</span></div>
            <p class="theme">{d.repere}</p>
            <h3>{d.titre}</h3>
            <p class="description">{d.presentation}</p>
            <div class="mesures"><span><strong>{nombre(d.total)}</strong> références</span><span><strong>{d.medias}</strong> médias</span></div>
            <p class="date-source">Dernière référence repérée le <time datetime={d.fin}>{date(d.fin)}</time></p>
          </a>
        </li>
      ))}
    </ol>
  </section>
  <aside class="pied-repertoire">
    <div><h2>Consulter l’ensemble des archives</h2><p>Retrouvez les autres articles de presse dans les archives, classés par année.</p></div>
    <a href="/archives/presse/">Consulter les archives de presse <span aria-hidden="true">↗</span></a>
  </aside>
</Base>
<style>
.en-tete-dossiers{background:#151718;color:#fff;margin-top:1.5rem;padding:clamp(1.5rem,5vw,5rem);border-top:8px solid #ffe100}
.code-dossier{font:850 .7rem/1.4 var(--sans);letter-spacing:.1em;color:#ffe100;margin:0 0 3rem}
.en-tete-sur{font:900 .8rem/1.4 var(--sans);letter-spacing:.1em;margin:0 0 1rem}
.en-tete-dossiers h1{font:900 clamp(2.7rem,7.8vw,7.5rem)/.94 var(--sans);letter-spacing:-.083em;margin:0 0 2rem;overflow-wrap:normal}
.en-tete-dossiers h1 span{color:#ffe100}
.en-tete-dossiers .sous-titre{font:650 clamp(1rem,1.65vw,1.35rem)/1.5 var(--sans);text-transform:uppercase;color:#f1f1ed;max-width:55ch;margin:0 0 2.2rem}
.chiffres{display:flex;flex-wrap:wrap;gap:1.5rem 4rem;border-top:1px solid #555;padding-top:1rem}
.chiffres span{font:850 .7rem/1.5 var(--sans);text-transform:uppercase;display:flex;gap:.7rem;align-items:baseline}
.chiffres strong{font:900 clamp(1.7rem,3vw,2.8rem)/1 var(--sans);color:#ffe100}
.chapo{display:grid;grid-template-columns:1fr 2fr;gap:2rem;border-bottom:4px solid #151718;padding:2.4rem 0}
.chapo h2{font:900 clamp(1.35rem,2.6vw,2.4rem)/1.13 var(--sans);letter-spacing:-.055em}
.chapo p{margin:0;max-width:80ch;font:500 .98rem/1.65 var(--sans)}
.repertoire{padding-top:2.5rem}
.repertoire .barre{display:flex;align-items:end;justify-content:space-between;flex-wrap:wrap;gap:1rem;padding:0 0 .9rem;border-bottom:5px solid #151718}
.repertoire .barre h2{font:900 clamp(1.8rem,4vw,3.2rem)/1 var(--sans);letter-spacing:-.06em;margin:0}
.repertoire .barre span{font:850 .67rem/1.5 var(--sans)}
.cartes{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0}
.cartes li{min-width:0}
.cartes li:nth-child(odd){border-right:2px solid #151718}
.cartes a{min-height:370px;height:100%;display:flex;flex-direction:column;gap:.6rem;padding:clamp(1.35rem,2.8vw,2.5rem);border-bottom:2px solid #151718;color:#151718;background:#fff;transition:background-color .15s}
.cartes li:first-child a{background:#ffe100}
.cartes a:hover,.cartes li:first-child a:hover{background:#f6e76a;color:#151718}
.ligne-haute{display:flex;justify-content:space-between;align-items:center;font:900 .67rem/1.5 var(--sans);letter-spacing:.08em}
.signe{font-size:1.65rem}
.cartes .theme{margin:1.5rem 0 0;font:850 .68rem/1.4 var(--sans);letter-spacing:.08em}
.cartes h3{font:900 clamp(1.9rem,3.7vw,3.35rem)/1.07 var(--sans);letter-spacing:-.06em;margin:0}
.cartes .description{font:500 .9rem/1.55 var(--sans);margin:.35rem 0 1.1rem;max-width:50ch}
.mesures{display:flex;flex-wrap:wrap;gap:2rem;margin-top:auto;border-top:2px solid #151718;padding-top:.85rem}
.mesures span{display:flex;align-items:baseline;gap:.5rem;font:850 .68rem/1.4 var(--sans);text-transform:uppercase}
.mesures strong{font:900 1.6rem/1 var(--sans)}
.date-source{font:750 .62rem/1.5 var(--sans);margin:.7rem 0 0;letter-spacing:.03em}
.pied-repertoire{background:#151718;color:white;display:grid;grid-template-columns:1.4fr 1fr;gap:2rem;align-items:end;padding:clamp(1.5rem,4vw,3rem);margin:3rem 0 2rem}
.pied-repertoire h2{font:900 clamp(1.4rem,2.6vw,2.4rem)/1.1 var(--sans);letter-spacing:-.05em}
.pied-repertoire p{font:500 .9rem/1.6 var(--sans);max-width:50ch}
.pied-repertoire a{display:flex;gap:1rem;justify-content:space-between;align-items:center;background:#ffe100;color:#151718;font:900 .7rem/1.3 var(--sans);padding:1.3rem}
.pied-repertoire a:hover{background:#fff;color:#151718}
@media(max-width:48rem){.en-tete-dossiers{padding:2rem 1.2rem}.en-tete-dossiers h1{font-size:clamp(2.5rem,10vw,4.6rem)}.chapo{grid-template-columns:1fr;gap:.8rem}.cartes{grid-template-columns:1fr}.cartes li:nth-child(odd){border-right:0}.cartes a{min-height:280px}.pied-repertoire{grid-template-columns:1fr}.code-dossier{margin-bottom:2rem}}
.lien-chronologie{display:flex;align-items:center;justify-content:space-between;gap:2rem;background:#151718;color:#fff;padding:clamp(1.3rem,3vw,2.3rem);margin:1.5rem 0 2rem;border-left:7px solid #ffe100}
.lien-chronologie div{display:flex;flex-direction:column;gap:.35rem;max-width:60ch}
.lien-chronologie div>span{font:900 .67rem/1.4 var(--sans);letter-spacing:.08em;color:#ffe100}
.lien-chronologie strong{font:900 clamp(1.15rem,2vw,1.8rem)/1.2 var(--sans);letter-spacing:-.03em}
.lien-chronologie p{font:500 .81rem/1.55 var(--sans);margin:.2rem 0 0}
.lien-chronologie a{flex-shrink:0;display:flex;align-items:center;justify-content:space-between;gap:1rem;background:#ffe100;color:#151718;padding:1rem;font:900 .67rem/1.4 var(--sans);max-width:220px}
.lien-chronologie a:hover{background:#fff;color:#151718}
@media(max-width:47.99rem){.lien-chronologie{flex-direction:column;align-items:stretch}.lien-chronologie a{max-width:none;flex-shrink:1}}.lien-carte-index{margin:0 0 1.5rem}.lien-carte-index a{display:flex;align-items:center;justify-content:space-between;gap:1rem;background:#ffe100;color:#151718;padding:1.25rem;font:900 .74rem/1.45 var(--sans)}.lien-carte-index a:hover{background:#151718;color:#fff}
/* Continuité visuelle avec les pages de dossier : papier, encre et bordeaux. */
.en-tete-dossiers{background:#f5f2ed;color:#202427;border-top:3px solid #a12c39}
.code-dossier{color:#96313b;font:700 .78rem/1.5 var(--sans);letter-spacing:.02em;margin-bottom:1.7rem}
.en-tete-sur{color:#596066;font:600 .8rem/1.5 var(--sans);letter-spacing:0;text-transform:none}
.en-tete-dossiers h1{font:650 clamp(2.7rem,6vw,5.2rem)/1.05 var(--serif);letter-spacing:-.045em;overflow-wrap:anywhere;margin-bottom:1.2rem}
.en-tete-dossiers h1 span{color:#96313b}
.en-tete-dossiers .sous-titre{font:450 clamp(1rem,1.6vw,1.18rem)/1.65 var(--sans);text-transform:none;color:#3b4145;max-width:64ch}
.chiffres{border-top:1px solid #c8c3bd}
.chiffres span{font:550 .85rem/1.5 var(--sans);text-transform:none}
.chiffres strong{font:650 clamp(1.5rem,3vw,2.5rem)/1 var(--sans);color:#96313b}
.chapo{border-bottom:1px solid #c8c3bd}
.chapo h2{font:650 clamp(1.35rem,2.4vw,2rem)/1.15 var(--serif);letter-spacing:-.02em}
.repertoire .barre{border-bottom:2px solid #a12c39}
.repertoire .barre h2{font:650 clamp(1.8rem,3.6vw,3rem)/1.15 var(--serif);letter-spacing:-.03em}
.repertoire .barre span{font:600 .8rem/1.5 var(--sans)}
.cartes{gap:1rem}
.cartes li:nth-child(odd){border-right:0}
.cartes a,.cartes li:first-child a{background:#f9f7f3;border:1px solid #d7d1cb;color:#202427;min-height:320px}
.cartes a:hover,.cartes li:first-child a:hover{background:#efe9e1;color:#202427;border-color:#a12c39}
.cartes a:focus-visible,.lien-chronologie a:focus-visible,.lien-carte-index a:focus-visible,.pied-repertoire a:focus-visible{outline:3px solid #a12c39;outline-offset:3px}
.ligne-haute{font:600 .75rem/1.5 var(--sans);letter-spacing:0;color:#62676b}
.signe{color:#96313b}
.cartes .theme{font:650 .76rem/1.5 var(--sans);letter-spacing:0;color:#96313b;margin-top:.9rem}
.cartes h3{font:650 clamp(1.8rem,3vw,2.8rem)/1.12 var(--serif);letter-spacing:-.035em}
.cartes .description{font:450 .94rem/1.65 var(--sans)}
.mesures{border-top:1px solid #d7d1cb}
.mesures span{font:550 .8rem/1.5 var(--sans);text-transform:none}
.mesures strong{font:650 1.25rem/1 var(--sans)}
.date-source{font:500 .76rem/1.5 var(--sans);letter-spacing:0;color:#62676b}
.lien-chronologie{background:#f3f0eb;color:#202427;border-left:3px solid #a12c39}
.lien-chronologie div>span{color:#96313b;font:650 .8rem/1.5 var(--sans);letter-spacing:0}
.lien-chronologie strong{font:650 clamp(1.25rem,2vw,1.85rem)/1.18 var(--serif);letter-spacing:-.02em}
.lien-chronologie p{font:450 .9rem/1.6 var(--sans)}
.lien-chronologie a{background:#fff;color:#202427;border:1px solid #a12c39;font:650 .8rem/1.45 var(--sans);max-width:235px}
.lien-chronologie a:hover{background:#a12c39;color:#fff}
.lien-carte-index a{background:#f9f7f3;color:#202427;border:1px solid #d7d1cb;font:650 .85rem/1.5 var(--sans)}
.lien-carte-index a:hover{background:#efe9e1;color:#202427}
.pied-repertoire{background:#f3f0eb;color:#202427;border-top:2px solid #a12c39}
.pied-repertoire h2{font:650 clamp(1.5rem,2.6vw,2.2rem)/1.15 var(--serif);letter-spacing:-.025em}
.pied-repertoire a{background:#fff;border:1px solid #a12c39;color:#202427;font:650 .82rem/1.5 var(--sans)}
.pied-repertoire a:hover{background:#a12c39;color:#fff}
@media(max-width:48rem){
 .en-tete-dossiers h1{font-size:clamp(2.5rem,9vw,4rem)}
 .cartes{grid-template-columns:minmax(0,1fr)}
 .cartes a{min-height:unset}
 .lien-chronologie a{max-width:none}
}
  .ouverture-illustree{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);align-items:center;gap:clamp(1rem,3vw,2.5rem)}
  @media(max-width:52rem){.ouverture-illustree{grid-template-columns:minmax(0,1fr)}}
</style>
