@media(prefers-reduced-motion:reduce){.articles-carrousel-piste{scroll-behavior:auto}}

.articles-carrousel-outils [data-editorial-toggle]{font-size:1rem;min-width:44px}
.articles-carrousel-outils button:focus-visible,.articles-carrousel-reperes button:focus-visible{outline:3px solid #a12c39;outline-offset:2px}

