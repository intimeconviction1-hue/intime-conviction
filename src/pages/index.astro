---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Actualites from '../components/Actualites.astro';
import Culture from '../components/Culture.astro';
import ParcoursEditorial from '../components/ParcoursEditorial.astro';
import { lireActualites, lireVeille } from '../lib/veille.mjs';
import { RUBRIQUES, rubrique } from '../lib/rubriques.mjs';
import { DOSSIERS, referencesPourDossier } from '../lib/dossiers.mjs';
import { tousLesArticles, dateLongue, minutesDeLecture } from '../lib/articles.mjs';
import fronton from '../assets/fronton-cour-dassises.jpg';

const articles = await tousLesArticles();
const [fil, veille] = await Promise.all([lireActualites(), lireVeille()]);
const [une,...suite] = articles;
const derniers = suite.slice(0,5);
const vus = new Set([une,...derniers].map(a=>a.data.slug));
const rubriques = RUBRIQUES.map(r=>{
  const archives=articles.filter(a=>a.data.rubrique===r.slug);
  return {...r,total:archives.length,presse:(fil?.articles??[]).filter(n=>n.rubrique===r.slug),titres:archives.filter(a=>!vus.has(a.data.slug)).slice(0,2)};
});
const parAnnee = new Map();
for(const a of articles){ const an=a.data.date.getFullYear(); if(an>=2009) parAnnee.set(an,(parAnnee.get(an)??0)+1); }
const parAnneePresse=new Map();
for(const a of veille.articles){const an=Number(a.dateAlerte.slice(0,4));if(an>=2009)parAnneePresse.set(an,(parAnneePresse.get(an)??0)+1);}
const annees=[...new Set([...parAnnee.keys(),...parAnneePresse.keys()])].sort((a,b)=>b-a).map(an=>({an,articles:parAnnee.get(an)??0,presse:parAnneePresse.get(an)??0}));
const nouvellesOuverture=(fil?.articles??[]).filter(n=>n.rubrique==='cours-du-jour').slice(0,3);
const dossiersMisEnAvant = DOSSIERS.map(d => ({...d, nombre:referencesPourDossier(d, veille.articles).length})).filter(d=>d.nombre>0).slice(0,4);
const total=articles.length.toLocaleString('fr-FR');
const datePresse=new Intl.DateTimeFormat('fr-FR',{day:'numeric',month:'long',timeZone:'Europe/Paris'});
---
<Base accueil>
  <div slot="fond" class="fond-page" aria-hidden="true"><Image src={fronton} alt="" width={500} loading="eager" fetchpriority="high" /></div>
  <section class="ouverture" aria-labelledby="titre-journal">
    <div class="cadre ouverture-interieur">
      <div class="edition"><p>PROCÈS CRIMINELS · AUDIENCES · VERDICTS · ANALYSES</p></div>
      <div class="une-grille">
        <article class="grand-angle">
          <Image src={fronton} alt="" width={900} loading="eager" fetchpriority="high" />
          <div class="grand-angle-voile"></div>
          <div class="grand-angle-texte">
            <p class="cartouche">PROCÈS CRIMINELS</p>
            <h1 id="titre-journal">L’actualité des cours d’assises et des procès criminels</h1>
            <p class="grand-angle-description">Suivi des audiences, décisions de justice, analyses et dossiers documentaires.</p>
            <div class="grand-angle-actions">
              <a class="une-lire" href="/rubrique/cours-du-jour/">SUIVRE LES AUDIENCES <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a>
              <a class="une-lire secondaire" href="/dossiers/">CONSULTER LES DOSSIERS <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a>
            </div>
          </div>
          <p class="credit-photo">Photographie d’illustration : fronton d’une cour d’assises</p>
        </article>
        <aside class="ouverture-fil" aria-labelledby="titre-fil-ouverture">
          <div class="fil-entete"><h2 id="titre-fil-ouverture">L’actualité<span>.</span></h2><span class="fil-label">REVUE DE PRESSE</span></div>
          {nouvellesOuverture.length>0 ? <ol>{nouvellesOuverture.map((n,i)=><li><span class="fil-numero" aria-hidden="true">0{i+1}</span><div><p>{n.source}<time datetime={n.date}>{n.dateAlerte ? 'Référence du ' : ''}{datePresse.format(new Date(n.date))}</time></p><h3><a href={n.lien} target="_blank" rel="noopener noreferrer">{n.titre}<span class="sr-only"> (nouvel onglet)</span></a></h3></div></li>)}</ol>:<p>Retrouvez les récits d’audience dans <a href="/rubrique/cours-du-jour/">Cours du Jour</a>.</p>}
          <a class="tout-le-fil" href="#actualites">Tout le fil d’audience <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a>
          
        </aside>
      </div>
      <div class="parcours"><span>À CONSULTER</span><a href="/agenda/">Sessions criminelles à venir <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a><a href="/comprendre/">Comprendre le procès <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a><a href="/annuaire/">Trouver une cour <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a><a href="/dossiers/">Dossiers judiciaires <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a><a href="/archives/">{total} articles d’archives <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div>
      <form class="accueil-recherche" action="/recherche/" method="get" role="search" aria-label="Rechercher dans les archives">
        <label for="recherche-accueil"><span>RECHERCHER DANS {total} ARTICLES</span><strong>RECHERCHER UN ARTICLE OU UNE AFFAIRE</strong></label>
        <div class="accueil-recherche-champs"><input id="recherche-accueil" type="search" name="q" placeholder="Nom, affaire, mot-clé..." autocomplete="off" /><button type="submit">RECHERCHER <span aria-hidden="true">↗</span></button></div>
      </form>
    </div>
  </section>

  <div class="surface-lecture"><div class="cadre journal-corps">
    <Actualites debut={nouvellesOuverture.length} limite={5} compacte />


    <section class="accueil-dossiers" aria-labelledby="titre-dossiers-accueil">
      <div class="accueil-dossiers-entete">
        <div><p class="accueil-dossiers-kicker">DOSSIERS JUDICIAIRES</p><h2 id="titre-dossiers-accueil">LES GRANDES<br /><span>AFFAIRES JUDICIAIRES.</span></h2></div>
        <p>Retrouvez, pour chaque affaire, les articles de presse répertoriés et les principales étapes judiciaires documentées.</p>
      </div>
      <ul class="accueil-dossiers-grille">
        {dossiersMisEnAvant.map((d,i)=><li><a href={`/dossiers/${d.slug}/`}><span class="accueil-dossiers-num">DOSSIER {String(i+1).padStart(2,'0')} <span aria-hidden="true">↗</span></span><h3>{d.titre}</h3><p>{d.nombre.toLocaleString('fr-FR')} références de presse</p></a></li>)}
      </ul>
      <div class="accueil-dossiers-liens"><a href="/dossiers/">EXPLORER TOUS LES DOSSIERS <span aria-hidden="true">↗</span></a><a href="/chronologie/">VOIR LA CHRONOLOGIE JUDICIAIRE <span aria-hidden="true">↗</span></a></div>
    </section>


    <section class="selection" aria-labelledby="titre-selection">
      <div class="titre-section"><h2 id="titre-selection">Dans les archives du journal</h2><a href="/archives/">Le fonds d’Intime Conviction <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div>
      <div class="selection-grille">
        <article class="article-principal">
          <p class="meta"><span class="etiquette">{rubrique(une.data.rubrique).nom}</span><time datetime={une.data.date.toISOString()}>{dateLongue(une.data.date)}</time></p>
          <h3><a href={une.data.chemin}>{une.data.titre}</a></h3>
          <p class="chapeau">{une.data.extrait}</p>
          <a class="lire-article" href={une.data.chemin}>Lire l’article <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg><span class="meta">{minutesDeLecture(une.data.mots)} min</span></a>
        </article>
        <ul class="selection-suite">{derniers.map(({data})=><li><p class="meta"><time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time></p><h3><a href={data.chemin}>{data.titre}</a></h3></li>)}</ul>
      </div>
    </section>

    <section class="bandeau-archives" aria-label="Explorer les archives"><div><span class="bandeau-kicker">LES ARCHIVES DU JOURNAL</span><strong>{total}</strong><p>articles conservés dans les archives éditoriales du journal.</p></div><a href="/archives/">Consulter les archives <span aria-hidden="true">↗</span></a></section>


    <ParcoursEditorial />

    <Culture />

    <section class="univers" aria-labelledby="titre-rubriques">
      <div class="titre-section"><h2 id="titre-rubriques">LES RUBRIQUES <span>DU JOURNAL.</span></h2></div>
      <ul class="rubriques">{rubriques.map(r=><li>
        <div class="rubrique-entete"><h3><a href={`/rubrique/${r.slug}/`}>{r.nom}</a></h3><a class="ouvrir-rubrique" href={`/rubrique/${r.slug}/`} aria-label={`Ouvrir ${r.nom}`}><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div>
        <p class="sous-titre">{r.sousTitre}</p>
        <ul class="titres">{r.titres.length ? r.titres.map(({data})=><li><a href={data.chemin}>{data.titre}</a><span class="meta source-presse">Intime Conviction · archive</span></li>) : r.presse.slice(0,2).map(n=><li><a href={n.lien} target="_blank" rel="noopener noreferrer">{n.titre}</a><span class="meta source-presse">{n.source} · revue de presse</span></li>)}</ul>
        <a class="rubrique-volume" href={`/rubrique/${r.slug}/`}>{r.total.toLocaleString('fr-FR')} articles d’archives{r.presse.length>0&&` · ${r.presse.length} nouvelle${r.presse.length>1?'s':''}`}</a>
      </li>)}</ul>
    </section>

    <section class="fonds" aria-labelledby="titre-fonds">
      <div class="fonds-intro"><h2 id="titre-fonds">Les archives<span>.</span></h2><p>{total} articles du journal<br />et une revue de presse, année par année.</p><a href="/archives/">Consulter les archives par année <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div>
      <p><a class="lire-article" href="/archives/presse/">Consulter les archives de presse</a></p>
      <ul class="annees">{annees.map(({an,articles:nbArticles,presse:nbPresse})=><li><a href={nbArticles ? `/archives/${an}/` : `/archives/presse/${an}/`}><span class="an">{an}</span><span class="meta">{nbArticles ? nbArticles.toLocaleString('fr-FR')+' articles du journal' : ''}{nbArticles && nbPresse ? ' · ' : ''}{nbPresse ? nbPresse.toLocaleString('fr-FR')+' références presse' : ''}</span></a></li>)}</ul>
    </section>
  </div></div>
</Base>
<style>
  .fond-page{position:fixed;inset:0;z-index:-1;pointer-events:none;background:#1b1b1b}.fond-page img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);opacity:.32}.fond-page::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#10101055,#101010dd)}
  .ouverture{background:var(--papier);color:var(--encre);padding-top:0}.ouverture-interieur{padding-top:1.1rem;padding-bottom:0}.edition{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;padding-bottom:1.1rem;font:600 .62rem/1.5 var(--sans);letter-spacing:.09em}.edition p{margin:0;display:flex;align-items:center;gap:.55rem}.edition p+p{color:var(--encre-2);font-weight:400;letter-spacing:0}.point-rouge{width:7px;height:7px;background:var(--action);display:inline-block}
  .une-grille{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(0,1fr);gap:1.75rem}.grand-angle{min-width:0;position:relative;display:flex;align-items:flex-end;min-height:560px;background:#151515;color:#fff;overflow:hidden}.grand-angle>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 32%;filter:grayscale(1) contrast(1.16)}.grand-angle-voile{position:absolute;inset:0;background:linear-gradient(180deg,#10101000 0%,#10101038 22%,#101010d9 65%,#101010f5 100%)}.grand-angle-texte{position:relative;z-index:1;padding:2rem 2.25rem 3rem;width:100%}.cartouche{display:inline-block;background:var(--action);color:#fff;padding:.5rem .65rem;margin:0 0 1.2rem;font:700 .62rem/1.3 var(--sans);letter-spacing:.09em}.une-source{font:700 .65rem/1.6 var(--sans);margin:0 0 .75rem;color:#fff}.une-source span{font-weight:400;color:#ddd}h1{font-size:clamp(2.15rem,3.6vw,3.25rem);line-height:1.04;font-weight:600;letter-spacing:-.035em;margin:0;max-width:22ch}h1.titre-long{font-size:clamp(2rem,3vw,2.8rem)}h1 a:hover{color:#fff;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.15em}.une-lire{display:inline-flex;align-items:center;gap:2rem;min-height:44px;margin-top:1rem;font:600 .7rem/1.5 var(--sans);border-bottom:1px solid #ffffff66}.une-lire:hover{color:#fff}.une-lire span{font-size:1.25rem}.credit-photo{position:absolute;bottom:0;left:0;right:0;z-index:1;margin:0;padding:.45rem 2.25rem;font:400 .53rem/1.4 var(--sans);color:#bbb;background:#111c}
  .ouverture-fil{min-width:0;display:flex;flex-direction:column;border-top:5px solid var(--action);padding-top:1rem}.fil-entete{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;margin-bottom:.5rem}.fil-entete h2{font-size:2.5rem;font-weight:600;line-height:1;margin:0;letter-spacing:-.04em}.fil-entete h2 span{color:var(--rouge)}.fil-label{font:600 .55rem/1.5 var(--sans);letter-spacing:.09em;color:var(--encre-2)}.ouverture-fil ol{padding:0;margin:0;list-style:none}.ouverture-fil li{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.7rem;padding:1.2rem 0;border-bottom:1px solid var(--filet)}.fil-numero{font:400 1.6rem/1 var(--serif);color:var(--rouge)}.ouverture-fil li p{display:flex;flex-wrap:wrap;gap:.4rem .8rem;font:600 .58rem/1.5 var(--sans);color:var(--rouge);margin:0 0 .55rem}.ouverture-fil time{color:var(--encre-2);font-weight:400}.ouverture-fil h3{font-size:clamp(1.2rem,1.65vw,1.55rem);line-height:1.17;font-weight:600;margin:0}.tout-le-fil{display:flex;align-items:center;justify-content:space-between;min-height:50px;font:600 .65rem/1.5 var(--sans)}.tout-le-fil span{font-size:1.3rem}.note-redaction{margin-top:auto;background:var(--papier-2);display:flex;align-items:center;gap:1rem;padding:1rem}.note-signe{font:700 2.6rem/1 var(--serif);color:var(--rouge)}.note-redaction p{font:400 .65rem/1.7 var(--sans);margin:0}.note-redaction strong{font-weight:600}
  .parcours{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.4rem 1.5rem;border-bottom:1px solid var(--filet-fort);padding:.65rem 0;margin-top:1rem;font:600 .65rem/1.5 var(--sans)}.parcours>span{color:var(--rouge);font-size:.58rem;letter-spacing:.08em}.parcours a{min-height:38px;display:flex;align-items:center;gap:1.2rem}.parcours a span{font-size:1rem}
  .surface-lecture{background:color-mix(in srgb,var(--papier) 97%,transparent)}.journal-corps{padding-top:.1rem;padding-bottom:4rem}.journal-corps :global(.titre-section){margin-top:3.5rem}
  .conviction-editoriale{display:grid;grid-template-columns:1fr 1fr;gap:3rem;margin-top:3.5rem;padding:3rem;background:var(--action);color:#fff;position:relative}.conviction-editoriale::before{content:'NOTRE CONVICTION';position:absolute;left:3rem;top:1.2rem;font:700 .55rem/1.5 var(--sans);letter-spacing:.13em}.conviction-editoriale h2{font-size:clamp(2rem,3.4vw,3rem);font-weight:600;line-height:1.05;margin:.8rem 0 0}.conviction-editoriale h2 em{font-style:normal}.conviction-editoriale p{font-size:1.05rem;line-height:1.6;margin:0 0 1rem;max-width:55ch}.conviction-editoriale a{text-decoration:underline;text-underline-offset:.25em}.conviction-editoriale a:hover{color:#fff}
  .selection-grille{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:3rem;padding-top:1rem}.article-principal{padding-right:3rem;border-right:1px solid var(--filet)}.article-principal .meta{display:flex;flex-wrap:wrap;gap:.5rem 1rem}.article-principal h3{font-size:clamp(2.25rem,3.7vw,3.5rem);line-height:1.06;font-weight:600;margin:1rem 0}.chapeau{font-size:1.15rem;color:var(--encre-2);line-height:1.6;margin:0 0 1rem}.lire-article{display:inline-flex;align-items:center;flex-wrap:wrap;gap:1rem;min-height:44px;font:600 .65rem/1.5 var(--sans)}.selection-suite{list-style:none;padding:0;margin:0;counter-reset:selection}.selection-suite li{position:relative;counter-increment:selection;padding:1rem 0 1rem 2.8rem;border-bottom:1px solid var(--filet)}.selection-suite li::before{content:counter(selection,decimal-leading-zero);position:absolute;left:0;top:1.2rem;font:500 1.5rem/1 var(--serif);color:var(--rouge)}.selection-suite .meta{margin:0 0 .4rem}.selection-suite h3{font-weight:600;font-size:1.4rem;line-height:1.15;margin:0}
  .univers h2{font-weight:600}.univers h2 br{display:none}.univers h2 em{font-style:normal}.rubriques{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));counter-reset:rubrique;gap:1rem}.rubriques>li{counter-increment:rubrique;min-width:0;padding:1.5rem;background:var(--papier-2);border-top:3px solid var(--encre)}.rubriques>li::before{content:'0' counter(rubrique);display:block;font:500 .65rem/1 var(--sans);color:var(--rouge);margin-bottom:1.75rem}.rubrique-entete{display:flex;justify-content:space-between;align-items:start;gap:.5rem}.rubrique-entete h3{font-weight:600;font-size:1.9rem;line-height:1.05;margin:0}.ouvrir-rubrique{min-height:44px;min-width:44px;display:flex;align-items:center;justify-content:center}.sous-titre{font:400 .65rem/1.6 var(--sans);color:var(--encre-2);margin:.6rem 0 1.25rem}.titres{list-style:none;padding:0;margin:0}.titres li{border-top:1px solid var(--filet);padding:.75rem 0;font-size:1rem;line-height:1.35}.source-presse{display:block;margin-top:.4rem;font-size:.55rem}.rubrique-volume{display:flex;align-items:center;min-height:44px;font:600 .6rem/1.5 var(--sans);margin-top:.4rem}
  .fonds{border-top:4px solid var(--encre);padding-top:1.5rem;margin-top:4rem}.fonds-intro{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem 2rem}.fonds h2{font-size:clamp(2.7rem,5vw,4.5rem);font-weight:600;line-height:1;margin:0}.fonds h2 span{color:var(--rouge)}.fonds-intro p{font-size:1.1rem;line-height:1.4;color:var(--encre-2);margin:0}.fonds-intro>a{font:600 .65rem/1.6 var(--sans);display:flex;gap:1rem;align-items:center;min-height:44px}.annees{list-style:none;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));padding:0;margin:1.5rem 0 0;gap:0 1rem}.annees a{border-top:1px solid var(--filet);display:flex;flex-direction:column;padding:1rem 0;min-height:80px}.an{font-size:2rem;line-height:1.2;font-weight:600}.annees .meta{font-size:.55rem}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  @media(min-width:90rem){.grand-angle{min-height:610px}}
  @media(max-width:63.99rem){.une-grille{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:1.25rem}.grand-angle{min-height:530px}.grand-angle-texte{padding:1.5rem 1.5rem 3rem}h1{font-size:2.3rem}.fil-entete{display:block}.fil-label{display:block;margin-top:.6rem}.ouverture-fil h3{font-size:1.15rem}.ouverture-fil li{grid-template-columns:1.4rem minmax(0,1fr);gap:.4rem}.fil-numero{font-size:1.3rem}.note-redaction{padding:.75rem}.note-redaction p{font-size:.6rem}.rubriques{grid-template-columns:repeat(2,minmax(0,1fr))}.annees{grid-template-columns:repeat(4,minmax(0,1fr))}.conviction-editoriale{padding:2.5rem 2rem;gap:2rem}.conviction-editoriale::before{left:2rem}.parcours{justify-content:flex-start}}
