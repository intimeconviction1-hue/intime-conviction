---
import Base from '../layouts/Base.astro';
import { photosArticles } from '../lib/photos-articles.mjs';
import VisuelAssises from '../components/VisuelAssises.astro';
import photoDossiers from '../assets/assises-bordeaux.webp';
import photoSalle from '../assets/salle-voltaire.webp';
import AgendaEnBref from '../components/AgendaEnBref.astro';
import { CULTURE } from '../lib/culture.mjs';
import { lireVeille } from '../lib/veille.mjs';
import { RUBRIQUES, rubrique } from '../lib/rubriques.mjs';
import { DOSSIERS, referencesPourDossier } from '../lib/dossiers.mjs';
import { tousLesArticles, dateLongue } from '../lib/articles.mjs';

const articles = await tousLesArticles();
const veille = await lireVeille();
const articlesVerifies = articles.filter(({data}) => data.verificationEnCours !== true);
const selectionUne = articlesVerifies.slice(0, 3);
// Sept dates civiles, aujourd’hui compris, selon l’heure de Paris.
const dateParis = new Intl.DateTimeFormat('fr-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit' });
const debutSemaine = new Date(dateParis.format(new Date()) + 'T00:00:00Z');
debutSemaine.setUTCDate(debutSemaine.getUTCDate() - 6);
const limiteRecente = debutSemaine.toISOString().slice(0, 10);
const [articlesRecents, articlesArchives] = articlesVerifies.slice(selectionUne.length)
  .reduce(([recents, anciens], article) => {
    const groupe = dateParis.format(article.data.date) >= limiteRecente ? recents : anciens;
    groupe.push(article);
    return [recents, anciens];
  }, [[], []]);
const dernieresPublications = articlesRecents.slice(0, 5);
const [archiveUne, ...derniers] = articlesArchives.slice(0, 4);
const vus = new Set([...selectionUne, ...dernieresPublications, archiveUne, ...derniers].filter(Boolean).map(a => a.data.slug));
const descriptionsRubriques = {
  'cours-du-jour': 'Le suivi des procès criminels et de leurs audiences.',
  'le-banc-des-jures': 'Les règles du procès, les jurés et les autres acteurs de l’audience.',
  'la-cour-se-leve': 'Des chroniques qui racontent les débats depuis la salle d’audience.',
  'delibere': 'Des réflexions et des points de vue sur la justice.',
  'l-expose': 'Des analyses pour comprendre les affaires et les décisions.',
  'le-greffe': 'Le cinéma, les livres et l’histoire de la justice.',
};
const rubriques = RUBRIQUES.map(r=>{
  const archives=articles.filter(a=>a.data.rubrique===r.slug);
  const titres = archives
    .filter(({data}) => data.verificationEnCours !== true && !vus.has(data.slug))
    .slice(0, 2);
  return {...r,titres};
});
const dossiersMisEnAvant = DOSSIERS.map(dossier => {
  const [derniere] = referencesPourDossier(dossier, veille.articles);
  return {...dossier, derniere};
}).filter(dossier => dossier.derniere)
  .sort((a,b) => b.derniere.dateAlerte.localeCompare(a.derniere.dateAlerte))
  .slice(0,3);
const repereUne = {
  '/proces-sollacaro-et-tout-recommence-aux-assises/11/2026/': 'Aix-en-Provence · Cour d’assises · Nouveau procès',
};
const articlesUne = selectionUne.map(({data}) => ({
  data,
  photo: photosArticles[data.chemin],
  repere: repereUne[data.chemin],
}));
---
<Base accueil>
  <section class="ouverture" aria-labelledby="titre-accueil">
    <div class="cadre ouverture-interieur">
      <h1 id="titre-accueil" class="sr-only">Intime Conviction, le journal des cours d’assises</h1>
      {articlesUne.length > 0 && (
        <section class="une-editoriale" aria-labelledby="une-editoriale-titre">
          <h2 id="une-editoriale-titre">À la une</h2>
          <div class="une-editoriale-grille">
            {articlesUne.map(({data, photo, repere}, i) => (
              <article class="article-redaction-une">
                {photo && (
                  <figure class:list={{"une-croquis": photo.croquis}}>
                    <img src={photo.image.src} width={photo.image.width} height={photo.image.height}
                      alt={photo.lieu} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
                    <figcaption>{photo.lieu} · <a href={photo.source}>{photo.auteur}</a> · <a href={photo.lienLicence}>{photo.licence}</a>{!photo.croquis && " · cadrée"}</figcaption>
                  </figure>
                )}
                <div class="une-editoriale-texte">
                  <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
                  {repere && <p class="repere-proces">{repere}</p>}
                  <h3><a href={data.chemin}>{data.titre}</a></h3>
                  {i === 0 && <><p>{data.extrait}</p><a class="lire-une" href={data.chemin}>Lire l’article <span aria-hidden="true">↗</span></a></>}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

    </div>
  </section>

  <div class="surface-lecture"><div class="cadre journal-corps">
    {dernieresPublications.length > 0 && (
      <section class="dernieres-publications" aria-labelledby="titre-dernieres-publications">
        <div class="selection-entete">
          <h2 id="titre-dernieres-publications">Derniers articles</h2>
          <a href="/rubrique/cours-du-jour/#articles-redaction">Toute l’actualité de la rédaction <span aria-hidden="true">↗</span></a>
        </div>
        <ul>
          {dernieresPublications.map(({data}) => (
            <li>
              <a href={data.chemin}>
                <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
                <h3>{data.titre}</h3>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="renvoi-presse" aria-labelledby="titre-revue-accueil">
      <div>
        <h2 id="titre-revue-accueil">Revue de presse</h2>
        <p>Les audiences et verdicts suivis par les médias, avec leurs sources.</p>
      </div>
      <a href="/revue-de-presse/">Voir la sélection <span aria-hidden="true">↗</span></a>
    </section>

    <section class="accueil-dossiers" aria-labelledby="titre-dossiers-accueil">
      <div class="accueil-dossiers-entete">
        <h2 id="titre-dossiers-accueil">Les affaires à suivre</h2>
        <a href="/dossiers/">Tous les dossiers <span aria-hidden="true">↗</span></a>
      </div>
      <div class="dossiers-visuel">
        <VisuelAssises image={photoDossiers} alt="Salle de la cour d’assises du palais Thiac, Bordeaux"
          source="https://commons.wikimedia.org/wiki/File:Palais_Thiac,_Salle_d%27audience_de_la_cour_d%27assises.jpg"
          credit="Tiraden" licence="CC BY-SA 4.0" licenceUrl="https://creativecommons.org/licenses/by-sa/4.0/" />
      </div>
      {dossiersMisEnAvant.length > 0 && (
        <ul class="accueil-dossiers-grille">
          {dossiersMisEnAvant.map(d => (
            <li>
              <a href={`/dossiers/${d.slug}/`} aria-labelledby={`accueil-dossier-${d.slug}`} aria-describedby={`accueil-dossier-repere-${d.slug}`}>
                <div class="accueil-dossiers-titre">
                  <h3 id={`accueil-dossier-${d.slug}`}>{d.titre}</h3>
                  <span aria-hidden="true">↗</span>
                </div>
                <p id={`accueil-dossier-repere-${d.slug}`}>{d.derniere.titre}</p>
                <span class="accueil-dossiers-total">
                  {d.derniere.source} · <time datetime={d.derniere.dateAlerte}>{dateLongue(new Date(d.derniere.dateAlerte + "T12:00:00Z"))}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      <div class="accueil-dossiers-liens">
        <a href="/chronologie/">Chronologie judiciaire <span aria-hidden="true">↗</span></a>
      </div>
    </section>


    <AgendaEnBref />
    <section class="guide-assises" aria-labelledby="titre-guide-assises">
      <figure>
        <img src={photoSalle.src} width={photoSalle.width} height={photoSalle.height}
          alt="Le banc de la cour dans la salle Voltaire, à Paris" loading="lazy" decoding="async" />
        <figcaption>Salle Voltaire, Paris · <a href="https://commons.wikimedia.org/wiki/File:Palais_de_justice_de_Paris_-_salle_Voltaire_(cour_d%27assises).jpg">Tiraden</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · cadrée</figcaption>
      </figure>
      <div class="guide-assises-texte">
        <h2 id="titre-guide-assises">Comprendre les assises</h2>
        <p>Qui siège à la cour ? Dans quel ordre parle-t-on ? Comment se prend la décision ?</p>
        <ul>
          <li><a href="/comprendre/">Le déroulement du procès <span aria-hidden="true">↗</span></a></li>
          <li><a href="/rubrique/le-banc-des-jures/">Les jurés et les acteurs du procès <span aria-hidden="true">↗</span></a></li>
          <li><a href="/assister/">Préparer sa première audience <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
    </section>

    {archiveUne && (
      <section class="selection" aria-labelledby="titre-selection">
        <div class="selection-entete">
          <h2 id="titre-selection">À relire dans nos archives</h2>
          <a href="/archives/">Archives du journal <span aria-hidden="true">↗</span></a>
        </div>
        <div class:list={['selection-grille', { 'selection-grille-simple': derniers.length === 0 }]}>
          <article class="archive-vedette">
            <a href={archiveUne.data.chemin} aria-labelledby="titre-archive-vedette">
              <div class="archive-vedette-entete">
                <h3 id="titre-archive-vedette">{archiveUne.data.titre}</h3>
              </div>
              <p class="archive-vedette-meta">
                <span>{rubrique(archiveUne.data.rubrique).libelle}</span>
                <time datetime={archiveUne.data.date.toISOString()}>{dateLongue(archiveUne.data.date)}</time>
              </p>
              <p class="archive-vedette-extrait">{archiveUne.data.extrait}</p>
            </a>
          </article>
          {derniers.length > 0 && (
            <div class="selection-suite">
              <h3>Autres articles à relire</h3>
              <ul>
                {derniers.map(({data}) => (
                  <li>
                    <a href={data.chemin}>
                      <div>
                        <h4>{data.titre}</h4>
                        <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
                      </div>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="greffe-accueil" aria-labelledby="titre-culture">
      <div class="greffe-accueil-entete">
        <div>
          <h2 id="titre-culture">Livres, films et histoire</h2>
        </div>
        <a href="/rubrique/le-greffe/">Voir les livres et les films <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="greffe-accueil-cartes">
        {CULTURE.map(({slug, genre, auteur, titre, extrait}) => (
          <li>
            <a href={`/culture/${slug}/`} aria-labelledby={`greffe-accueil-${slug}`} aria-describedby={`greffe-extrait-${slug}`}>
              <p class="greffe-accueil-genre">{genre}</p>
              <h3 id={`greffe-accueil-${slug}`}>{titre}</h3>
              <p class="greffe-accueil-auteur">{auteur}</p>
              <p class="greffe-accueil-extrait" id={`greffe-extrait-${slug}`}>{extrait}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="univers" aria-labelledby="titre-rubriques">
      <h2 id="titre-rubriques">Dans le journal</h2>
      <ul class="rubriques">
        {rubriques.map(r => (
          <li class="rubrique-carte">
            <h3>
              <a href={`/rubrique/${r.slug}/`}>{r.libelle}<span aria-hidden="true">↗</span></a>
            </h3>
            <p class="rubrique-description">{descriptionsRubriques[r.slug] ?? r.sousTitre}</p>
            {r.titres.length > 0 && (
              <ul class="rubrique-lectures" aria-label={`À lire dans ${r.libelle}`}>
                {r.titres.map(({data}) => <li><a href={data.chemin}>{data.titre}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>

    <div class="outils-accueil">
      <form class="accueil-recherche" action="/recherche/" method="get" role="search" aria-labelledby="titre-recherche-accueil">
        <label id="titre-recherche-accueil" for="recherche-accueil">Retrouver un article ou une affaire</label>
        <div class="accueil-recherche-champs">
          <input id="recherche-accueil" type="search" name="q" placeholder="Nom ou mot-clé" />
          <button type="submit">Rechercher</button>
        </div>
      </form>
      <nav aria-label="Consulter les archives">
        <a href="/archives/presse/">Archives de presse <span aria-hidden="true">↗</span></a>
      </nav>
    </div>

  </div></div>
</Base>

<style>
  .ouverture,.surface-lecture{color:#252525}
  .ouverture{background:linear-gradient(155deg,#f0e9e0,#fcfaf6 66%)}
  .surface-lecture{background:#fcfaf6}
  .renvoi-presse{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.65rem 1.5rem;padding:1.15rem clamp(1rem,3vw,2rem);background:#262526;color:#fff;border-left:5px solid #a12c39}
  .renvoi-presse h2{margin:0;color:#fff;font:650 clamp(1.5rem,3vw,2.2rem)/1.12 var(--serif)}
  .renvoi-presse p{margin:.4rem 0 0;color:#e7ded4;font:.87rem/1.5 var(--sans)}
  .renvoi-presse a{display:inline-flex;gap:.65rem;align-items:center;min-height:44px;padding:.4rem .75rem;border:1px solid #c6aea3;font:700 .8rem var(--sans);color:#fff}
  .renvoi-presse a:hover,.renvoi-presse a:focus-visible{background:#84323d}
  .dossiers-visuel{margin-bottom:1rem;background:#e8ded1}
  .dossiers-visuel :global(img){max-height:17rem;object-fit:cover;object-position:center 56%}
  .ouverture-interieur{padding-top:clamp(1rem,2.5vw,2rem)}
  .journal-corps{padding-bottom:3rem}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  .une-editoriale{margin:0 0 clamp(1.4rem,4vw,3rem)}
  .une-editoriale>h2{border-top:3px solid #943440;padding:.75rem 0;margin:0;color:#84323d;font:800 .8rem/1.4 var(--sans);letter-spacing:.1em;text-transform:uppercase}
  .une-editoriale-grille{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(0,1fr);gap:1rem 1.8rem}
  .article-redaction-une{min-width:0;border-bottom:1px solid #c7bdb2;padding-bottom:1rem}
  .article-redaction-une:first-child{grid-row:span 2}
  .article-redaction-une figure{margin:0 0 .55rem}
  .article-redaction-une img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}
  .article-redaction-une:first-child img{aspect-ratio:2/1}
  .article-redaction-une .une-croquis img{object-fit:contain;background:#fbfaf7}
  .article-redaction-une figcaption{color:#554b47;font:500 .68rem/1.4 var(--sans);margin-top:.35rem}
  .article-redaction-une figcaption a{text-decoration:underline}
  .une-editoriale-texte time{color:#84323d;font:750 .76rem/1.4 var(--sans)}
  .une-editoriale-texte h3{margin:.35rem 0 0;font:650 clamp(1.35rem,2.2vw,2rem)/1.1 var(--serif)}
  .article-redaction-une:first-child h3{font-size:clamp(2rem,4.2vw,3.85rem);letter-spacing:-.025em}
  .une-editoriale-texte p{max-width:65ch;margin:.7rem 0 0;font:500 1rem/1.55 var(--sans)}
  .une-editoriale a:hover{text-decoration:underline;text-underline-offset:.14em}
  @media(max-width:48rem){
    .une-editoriale-grille{grid-template-columns:minmax(0,1fr)}
    .article-redaction-une:first-child{grid-row:auto}
  }

  .journal-corps>section,.journal-corps>.outils-accueil{margin:clamp(1.75rem,5vw,3.75rem) 0}
  .dernieres-publications ul{list-style:none;margin:0;padding:0;border-bottom:1px solid #d2c8bf}
  .dernieres-publications li{border-top:1px solid #d2c8bf}
  .dernieres-publications li a{display:grid;grid-template-columns:10rem minmax(0,1fr) auto;align-items:baseline;gap:.35rem 1rem;padding:.75rem .35rem;min-height:44px}
  .dernieres-publications li a:hover{background:#f1ede6}
  .dernieres-publications li a:focus-visible{outline:2px solid #84323d;outline-offset:-2px}
  .dernieres-publications li a>span{color:#84323d}
  @media(max-width:48rem){
    .dernieres-publications li a{grid-template-columns:minmax(0,1fr) auto}
    .dernieres-publications time{grid-column:1/-1}
  }
  .accueil-dossiers,.dernieres-publications,.selection,.greffe-accueil,.univers{border-top:2px solid #84323d;padding-top:1rem}
  .journal-corps h2{margin:0;font:650 clamp(1.8rem,3.4vw,2.75rem)/1.08 var(--serif)}
  .accueil-dossiers-entete,.selection-entete,.greffe-accueil-entete{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:.45rem 1rem;margin-bottom:1rem}
  .accueil-dossiers-entete>a,.selection-entete>a,.greffe-accueil-entete>a,.accueil-dossiers-liens>a{color:#84323d;font:750 .82rem/1.4 var(--sans)}
  .accueil-dossiers-grille,.greffe-accueil-cartes,.rubriques{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;list-style:none;padding:0;margin:0}
  .accueil-dossiers-grille a,.greffe-accueil-cartes a{display:block;height:100%;padding:1.1rem;background:#f1ede6;border-top:1px solid #c9bcb1}
  .accueil-dossiers-titre{display:flex;justify-content:space-between;gap:.65rem}
  .journal-corps h3{margin:0;font:650 clamp(1.25rem,2vw,1.65rem)/1.15 var(--serif)}
  .journal-corps p{font:500 .9rem/1.55 var(--sans)}
  .accueil-dossiers-total,.greffe-accueil-genre,.archive-vedette-meta,time{color:#84323d;font:700 .75rem/1.4 var(--sans)}
  .accueil-dossiers-liens{margin-top:.85rem}
  .guide-assises{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);background:#262526;color:#fff}
  .guide-assises figure{margin:0;display:flex;flex-direction:column}
  .guide-assises img{display:block;width:100%;height:0;min-height:12rem;flex:1;object-fit:cover}
  .guide-assises figcaption{padding:.5rem .8rem;color:#e7ded4;font:500 .7rem/1.4 var(--sans)}
  .guide-assises figcaption a{text-decoration:underline}
  .guide-assises-texte{padding:clamp(1.2rem,4vw,2.75rem)}
  .guide-assises ul,.selection-suite ul,.rubrique-lectures{list-style:none;margin:0;padding:0}
  .guide-assises li a{display:flex;justify-content:space-between;gap:.5rem;padding:.75rem 0;border-top:1px solid #71686a;font:700 .85rem/1.4 var(--sans)}
  .selection-grille{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:1.5rem}
  .selection-grille-simple{grid-template-columns:minmax(0,1fr)}
  .archive-vedette{background:#f1ede6;padding:1.3rem}
  .archive-vedette>a{display:block}
  .archive-vedette-meta{display:flex;gap:.5rem 1rem;flex-wrap:wrap}
  .selection-suite ul{margin-top:.65rem}
  .selection-suite li{border-top:1px solid #d2c8bf}
  .selection-suite li a{display:flex;justify-content:space-between;gap:.7rem;padding:.65rem 0}
  .selection-suite h4{margin:0;font:650 .93rem/1.35 var(--sans)}
  .greffe-accueil-genre{margin:0 0 .4rem}
  .rubriques{margin-top:1rem}
  .rubrique-carte{padding:.85rem 0;border-top:1px solid #c9bcb1}
  .rubrique-carte h3 a{display:flex;justify-content:space-between;gap:.65rem}
  .rubrique-lectures li{margin:.5rem 0;font:650 .85rem/1.4 var(--sans)}
  .outils-accueil{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);align-items:end;gap:1rem;padding:1.2rem;background:#f1ede6}
  .outils-accueil label{display:block;margin-bottom:.45rem;font:700 .95rem/1.4 var(--sans)}
  .accueil-recherche-champs{display:flex;min-height:44px}
  .accueil-recherche input{flex:1;min-width:0;padding:.65rem;border:1px solid #847872;background:#fff;color:#252525;font:500 1rem/1.3 var(--sans)}
  .accueil-recherche button{padding:.65rem;background:#84323d;color:#fff;border:0;cursor:pointer;font:700 .8rem var(--sans)}
  .outils-accueil nav{display:grid;gap:.45rem;font:700 .85rem/1.4 var(--sans)}
  .journal-corps a:hover{text-decoration:underline;text-underline-offset:.15em}
  @media(max-width:48rem){
    .accueil-dossiers-grille,.greffe-accueil-cartes,.rubriques,.guide-assises,.selection-grille,.outils-accueil{grid-template-columns:minmax(0,1fr)}
    .guide-assises img{height:auto;min-height:0;aspect-ratio:16/9}
  }
  .article-redaction-une:first-child{background:#262526;color:#fff;padding-bottom:0;border-bottom:0}
  .article-redaction-une:first-child figure{margin:0}
  .article-redaction-une:first-child figcaption{padding:.45rem 1rem;color:#e5d9cf}
  .article-redaction-une:first-child .une-editoriale-texte{padding:clamp(1rem,3vw,2rem)}
  .article-redaction-une:first-child time{color:#f1bebf}
  .une-editoriale-texte .repere-proces{margin:.45rem 0;font:750 .72rem/1.45 var(--sans);letter-spacing:.06em;text-transform:uppercase}
  .lire-une{display:inline-flex;align-items:center;gap:.7rem;min-height:44px;margin-top:1rem;padding:.45rem .85rem;background:#84323d;color:#fff;font:750 .85rem/1.3 var(--sans)}
  .lire-une:focus-visible{outline:2px solid white;outline-offset:3px}
</style>
