---
import Base from '../layouts/Base.astro';
import photoAix from '../assets/palais-verdun-aix.webp';
import photoBlois from '../assets/blois.webp';
import photoParis from '../assets/rue-de-la-paix.webp';
import photoPoissy from '../assets/poissy.webp';
import AgendaEnBref from '../components/AgendaEnBref.astro';
import { CULTURE } from '../lib/culture.mjs';
import { lireVeille } from '../lib/veille.mjs';
import { RUBRIQUES, rubrique } from '../lib/rubriques.mjs';
import { DOSSIERS, referencesPourDossier } from '../lib/dossiers.mjs';
import { tousLesArticles, dateLongue, minutesDeLecture } from '../lib/articles.mjs';

const articles = await tousLesArticles();
const veille = await lireVeille();
const articlesCarrousel = articles.slice(0, 3);
const [archiveUne, ...derniers] = articles
  .slice(articlesCarrousel.length)
  .filter(({data}) => data.verificationEnCours !== true)
  .slice(0, 4);
const vus = new Set([...articlesCarrousel,archiveUne,...derniers].filter(Boolean).map(a=>a.data.slug));
const descriptionsRubriques = {
  'cours-du-jour': 'Le suivi des procès criminels et de leurs audiences.',
  'le-banc-des-jures': 'Les règles du procès, les jurés et les autres acteurs de l’audience.',
  'la-cour-se-leve': 'Des chroniques qui racontent les débats depuis la salle d’audience.',
  'delibere': 'Des réflexions et des points de vue sur la justice.',
  'l-expose': 'Des analyses pour comprendre les affaires et les décisions.',
  'le-greffe': 'Le cinéma, les livres et l’histoire de la justice.',
};
const rubriques = RUBRIQUES.map(r=>{
  const archives=articles.filter(a=>a.data.rubrique===r.slug);
  const titres = archives
    .filter(({data}) => data.verificationEnCours !== true && !vus.has(data.slug))
    .slice(0, 2);
  return {...r,total:archives.length,titres};
});
const dossiersMisEnAvant = DOSSIERS.map(dossier => {
  const [derniere] = referencesPourDossier(dossier, veille.articles);
  return {...dossier, derniere};
}).filter(dossier => dossier.derniere)
  .sort((a,b) => b.derniere.dateAlerte.localeCompare(a.derniere.dateAlerte))
  .slice(0,3);
const photoPalaisBlois = {
  image: photoBlois, lieu: 'Palais de justice de Blois', auteur: 'Chabe01',
  source: 'https://commons.wikimedia.org/wiki/File:Palais_Justice_-_Blois_(FR41)_-_2022-07-16_-_1.jpg',
  licence: 'CC BY-SA 4.0', lienLicence: 'https://creativecommons.org/licenses/by-sa/4.0/',
};
// Lier les photos au lieu évoqué dans l’article, indépendamment de sa position.
const photosCarrousel = {
  '/proces-sollacaro-et-tout-recommence-aux-assises/11/2026/': {
    image: photoAix, lieu: 'Palais Verdun, Aix-en-Provence', auteur: 'Lsmpascal',
    source: 'https://commons.wikimedia.org/wiki/File:Palais_de_justice_Aix-en-Provence.jpg',
    licence: 'CC BY-SA 3.0', lienLicence: 'https://creativecommons.org/licenses/by-sa/3.0/',
  },
  '/inass-touloub-a-blois-le-poids-des-trente-neuf-annees/11/2026/': photoPalaisBlois,
  '/piaget-le-braqueur-au-borsalino-revient-devant-les-assises/11/2026/': {
    image: photoParis, lieu: 'Rue de la Paix, Paris', auteur: 'Mustang Joe',
    source: 'https://commons.wikimedia.org/wiki/File:Rue_de_la_Paix_(5999837542).jpg',
    licence: 'CC0', lienLicence: 'https://creativecommons.org/publicdomain/zero/1.0/',
  },
  '/mort-dolivio-gomes-le-proces-en-appel-du-policier-souvre-a-nanterre/11/2026/': {
    image: photoPoissy, lieu: 'Hôtel de ville de Poissy', auteur: 'Chabe01',
    source: 'https://commons.wikimedia.org/wiki/File:Hôtel_Ville_-_Poissy_(FR78)_-_2025-07-12_-_3.jpg',
    licence: 'CC BY-SA 4.0', lienLicence: 'https://creativecommons.org/licenses/by-sa/4.0/',
  },
};
const articlesUne = articlesCarrousel.map(({data}) => ({data, photo: photosCarrousel[data.chemin]}));
---
<Base accueil>
  <section class="ouverture" aria-labelledby="titre-accueil">
    <div class="cadre ouverture-interieur">
      <h1 id="titre-accueil" class="sr-only">Intime Conviction, le journal des cours d’assises</h1>
      {articlesUne.length > 0 && (
        <section class="une-editoriale" aria-labelledby="une-editoriale-titre">
          <h2 id="une-editoriale-titre">À la une</h2>
          <div class="une-editoriale-grille">
            {articlesUne.map(({data, photo}, i) => (
              <article class="article-redaction-une">
                {photo && (
                  <figure>
                    <img src={photo.image.src} width={photo.image.width} height={photo.image.height}
                      alt={photo.lieu} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
                    <figcaption>{photo.lieu} · <a href={photo.source}>{photo.auteur}</a> · <a href={photo.lienLicence}>{photo.licence}</a> · cadrée</figcaption>
                  </figure>
                )}
                <div class="une-editoriale-texte">
                  <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
                  <h3><a href={data.chemin}>{data.titre}</a></h3>
                  {i === 0 && <p>{data.extrait}</p>}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

    </div>
  </section>

  <div class="surface-lecture"><div class="cadre journal-corps">



    <section class="accueil-dossiers" aria-labelledby="titre-dossiers-accueil">
      <div class="accueil-dossiers-entete">
        <h2 id="titre-dossiers-accueil">Les affaires à suivre</h2>
        </div>
      {dossiersMisEnAvant.length > 0 && (
        <ul class="accueil-dossiers-grille">
          {dossiersMisEnAvant.map(d => (
            <li>
              <a href={`/dossiers/${d.slug}/`} aria-labelledby={`accueil-dossier-${d.slug}`} aria-describedby={`accueil-dossier-repere-${d.slug}`}>
                <div class="accueil-dossiers-titre">
                  <h3 id={`accueil-dossier-${d.slug}`}>{d.titre}</h3>
                  <span aria-hidden="true">↗</span>
                </div>
                <p id={`accueil-dossier-repere-${d.slug}`}>{d.derniere.titre}</p>
                <span class="accueil-dossiers-total">
                  {d.derniere.source}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      <div class="accueil-dossiers-liens">
        <a href="/dossiers/">Tous les dossiers <span aria-hidden="true">↗</span></a>
        <a href="/chronologie/">Chronologie judiciaire <span aria-hidden="true">↗</span></a>
      </div>
    </section>


    <AgendaEnBref />
      <div class="outils-accueil">
        <form class="accueil-recherche" action="/recherche/" method="get" role="search" aria-labelledby="titre-recherche-accueil">
          <label id="titre-recherche-accueil" for="recherche-accueil">Retrouver un article ou une affaire</label>
          <div class="accueil-recherche-champs">
            <input id="recherche-accueil" type="search" name="q" placeholder="Nom ou mot-clé" autocomplete="off" />
            <button type="submit">Rechercher</button>
          </div>
        </form>
      </div>

    {archiveUne && (
      <section class="selection" aria-labelledby="titre-selection">
        <div class="selection-entete">
          <h2 id="titre-selection">À relire dans nos archives</h2>
          <a href="/archives/">Toutes les archives <span aria-hidden="true">↗</span></a>
        </div>
        <div class:list={['selection-grille', { 'selection-grille-simple': derniers.length === 0 }]}>
          <article class="archive-vedette">
            <a href={archiveUne.data.chemin} aria-labelledby="titre-archive-vedette">
              <div class="archive-vedette-entete">
                <h3 id="titre-archive-vedette">{archiveUne.data.titre}</h3>
                <img src={`/illustrations/${archiveUne.data.rubrique}.svg`} alt="" width="640" height="520" loading="lazy" decoding="async" />
              </div>
              <p class="archive-vedette-meta">
                <span>{rubrique(archiveUne.data.rubrique).libelle}</span>
                <time datetime={archiveUne.data.date.toISOString()}>{dateLongue(archiveUne.data.date)}</time>
              </p>
              <p class="archive-vedette-extrait">{archiveUne.data.extrait}</p>
              <p class="archive-vedette-lire">
                <span>Lire l’article <span aria-hidden="true">↗</span></span>
                <span>{minutesDeLecture(archiveUne.data.mots)} min de lecture</span>
              </p>
            </a>
          </article>
          {derniers.length > 0 && (
            <div class="selection-suite">
              <h3>Autres articles à relire</h3>
              <ul>
                {derniers.map(({data}) => (
                  <li>
                    <a href={data.chemin}>
                      <div>
                        <h4>{data.titre}</h4>
                        <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
                      </div>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="greffe-accueil" aria-labelledby="titre-culture">
      <div class="greffe-accueil-entete">
        <div>
          <h2 id="titre-culture">Livres, films et histoire</h2>
        </div>
        <a href="/rubrique/le-greffe/">Voir les livres et les films <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="greffe-accueil-cartes">
        {CULTURE.map(({slug, genre, auteur, titre, extrait}) => (
          <li>
            <a href={`/culture/${slug}/`} aria-labelledby={`greffe-accueil-${slug}`} aria-describedby={`greffe-extrait-${slug}`}>
              <p class="greffe-accueil-genre">{genre}</p>
              <h3 id={`greffe-accueil-${slug}`}>{titre}</h3>
              <p class="greffe-accueil-auteur">{auteur}</p>
              <p class="greffe-accueil-extrait" id={`greffe-extrait-${slug}`}>{extrait}</p>
              <span class="greffe-accueil-ouvrir" aria-hidden="true">Lire la fiche <span>↗</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="univers" aria-labelledby="titre-rubriques">
      <h2 id="titre-rubriques">Les six rubriques du journal</h2>
      <ul class="rubriques">
        {rubriques.map(r => (
          <li class="rubrique-carte">
            <h3>
              <a href={`/rubrique/${r.slug}/`}>{r.libelle}<span aria-hidden="true">↗</span></a>
            </h3>
            <p class="rubrique-description">{descriptionsRubriques[r.slug] ?? r.sousTitre}</p>
            {r.titres.length > 0 && (
              <ul class="rubrique-lectures" aria-label={`À lire dans ${r.libelle}`}>
                {r.titres.map(({data}) => <li><a href={data.chemin}>{data.titre}</a></li>)}
              </ul>
            )}
            <p class="rubrique-volume">
              {r.total.toLocaleString('fr-FR')} {r.total === 1 ? 'article d’archives' : 'articles d’archives'}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <nav class="archives-passerelle" aria-labelledby="titre-collections">
      <h2 id="titre-collections">Les archives</h2>
      <div class="archives-collections">
        <a href="/archives/">
          <strong>Archives du journal <span aria-hidden="true">↗</span></strong>
          <span>Les articles publiés par Intime Conviction.</span>
        </a>
        <a href="/archives/presse/">
          <strong>Archives de presse <span aria-hidden="true">↗</span></strong>
          <span>Des références et des liens vers d’autres médias.</span>
        </a>
      </div>
    </nav>

  </div></div>
</Base>

<style>
  .ouverture{background:var(--papier);color:var(--encre);padding-top:0}.ouverture-interieur{padding-top:1.1rem;padding-bottom:0}h1{font-size:clamp(2.15rem,3.6vw,3.25rem);line-height:1.04;font-weight:600;letter-spacing:-.035em;margin:0;max-width:22ch}h1 a:hover{color:#fff;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.15em}
  .surface-lecture{background:color-mix(in srgb,var(--papier) 97%,transparent)}.journal-corps{padding-top:.1rem;padding-bottom:4rem}.journal-corps :global(.titre-section){margin-top:3.5rem}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  @media(max-width:63.99rem){h1{font-size:2.3rem}}
  @media(max-width:47.99rem){h1{font-size:2.2rem;max-width:23ch}.journal-corps :global(.titre-section){margin-top:2.8rem}}

/* Nouvelle direction artistique : la une des assises */
.ouverture{background:#f1ede5;color:#171716}
.surface-lecture{background:#f8f5ef}
.journal-corps{padding-top:1.5rem}


/* Identite 2026 : vrai contraste noir / jaune, langage de bande-annonce, sans effets decoratifs gratuits. */
.ouverture{background:#111314;color:#fff}
.ouverture-interieur{padding-top:0}
.surface-lecture{background:#f4f4f1}
.journal-corps{padding-top:2rem}
.journal-corps :global(.titre-section){border-top:7px solid #111314;margin-top:4.5rem}

  /* Une d'information : l'ancien article d'archives ne simule plus l'actualité. */

/* Direction artistique de la une : composition de presse, retenue et lisibilité. */
.ouverture{background:#f7f5f0;color:#1b2024}
.ouverture-interieur{padding-top:0}
.surface-lecture{background:#faf9f6}
.journal-corps{padding-top:1.5rem}
.journal-corps :global(.titre-section){border-top:1px solid #b9b7b1;margin-top:3.3rem;padding-top:1.2rem}

/* Règles propres à la une : une hiérarchie éditoriale sans blocs redondants. */
.ouverture{background:#f7f5f0}
.surface-lecture{background:#fbfaf8}
.journal-corps{padding-top:1.2rem}
.journal-corps :global(.titre-section){margin-top:2.7rem}
.archives-passerelle {
  margin-top:2.8rem;
  padding-top:1.3rem;
  border-top:2px solid #943440;
}
.archives-passerelle h2 {
  margin:0 0 1rem;
  font:650 clamp(1.9rem,3.4vw,3rem)/1.05 var(--serif);
}
.archives-collections {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:.75rem;
}
.archives-collections a {
  display:grid;
  gap:.4rem;
  padding:clamp(.85rem,2vw,1.4rem);
  border:1px solid #d6cdc2;
  background:#f4f1eb;
}
.archives-collections strong {
  display:flex;
  justify-content:space-between;
  gap:.65rem;
  font:650 clamp(1.35rem,2.3vw,1.9rem)/1.15 var(--serif);
}
.archives-collections strong span { color:#84323d; }
.archives-collections a > span { color:#504945; font:480 .88rem/1.5 var(--sans); }
.archives-collections a:hover { background:#eee6dc; color:#84323d; }
.archives-collections a:focus-visible { outline:2px solid #84323d; outline-offset:3px; }
@media(max-width:36rem) {
  .archives-collections { grid-template-columns:minmax(0,1fr); gap:.5rem; }
}

/* Accueil : la une présente un vrai dossier et non une seconde présentation du site. */
.ouverture-interieur{padding-top:1.25rem}
@media(max-width:47.99rem){.ouverture-interieur{padding-top:.9rem}}

/* Espacement de la une. */
.ouverture{background:#f7f5f0}
.ouverture-interieur{padding-top:2.1rem}
@media(max-width:47.99rem){
 .ouverture-interieur{padding-top:1.1rem}
}

/* Le dernier article du journal précède la revue de presse externe. */
  .une-editoriale{margin:0 0 clamp(1.4rem,4vw,3rem)}
  .une-editoriale>h2{border-top:3px solid #943440;padding:.75rem 0;margin:0;color:#84323d;font:800 .8rem/1.4 var(--sans);letter-spacing:.1em;text-transform:uppercase}
  .une-editoriale-grille{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(0,1fr);gap:1rem 1.8rem}
  .article-redaction-une{min-width:0;border-bottom:1px solid #c7bdb2;padding-bottom:1rem}
  .article-redaction-une:first-child{grid-row:span 2}
  .article-redaction-une figure{margin:0 0 .55rem}
  .article-redaction-une img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}
  .article-redaction-une:first-child img{aspect-ratio:2/1}
  .article-redaction-une figcaption{color:#554b47;font:500 .68rem/1.4 var(--sans);margin-top:.35rem}
  .article-redaction-une figcaption a{text-decoration:underline}
  .une-editoriale-texte time{color:#84323d;font:750 .76rem/1.4 var(--sans)}
  .une-editoriale-texte h3{margin:.35rem 0 0;font:650 clamp(1.35rem,2.2vw,2rem)/1.1 var(--serif)}
  .article-redaction-une:first-child h3{font-size:clamp(2rem,4.2vw,3.85rem);letter-spacing:-.025em}
  .une-editoriale-texte p{max-width:65ch;margin:.7rem 0 0;font:500 1rem/1.55 var(--sans)}
  .une-editoriale a:hover{text-decoration:underline;text-underline-offset:.14em}
  @media(max-width:48rem){
    .une-editoriale-grille{grid-template-columns:minmax(0,1fr)}
    .article-redaction-une:first-child{grid-row:auto}
  }

  .outils-accueil {
    display:grid;
    grid-template-columns:minmax(0, 1fr);
    gap:clamp(1.25rem, 3vw, 3rem);
    align-items:center;
    padding:clamp(1rem, 2.8vw, 2.25rem);
    background:#f0ebe4;
    border:1px solid #d6cdc2;
    border-top:2px solid #943440;
  }
  .accueil-recherche label {
    display:block;
    margin:0 0 .75rem;
    font:650 clamp(1.4rem, 2.3vw, 2rem)/1.15 var(--serif);
  }
  .accueil-recherche-champs { display:flex; min-height:48px; }
  .accueil-recherche input {
    flex:1;
    min-width:0;
    padding:.65rem .7rem;
    border:1px solid #9e9187;
    border-radius:0;
    color:var(--encre);
    background:#fff;
    font:500 1rem/1.3 var(--sans);
  }
  .accueil-recherche input::placeholder { color:#615a55; }
  .accueil-recherche button {
    border:0;
    padding:0 clamp(.55rem, 1.5vw, 1.15rem);
    color:#fff;
    background:#923342;
    cursor:pointer;
    font:700 .78rem/1.2 var(--sans);
  }
  .accueil-recherche button:hover { background:#762636; }
  .outils-accueil :is(a, input, button):focus-visible {
    outline:2px solid #84323d;
    outline-offset:2px;
    position:relative;
    z-index:1;
  }
  @media(max-width:47.99rem) {
    .outils-accueil { grid-template-columns:minmax(0, 1fr); }
  }
  .accueil-dossiers {
    margin:2.2rem 0 0;
    padding-top:1.3rem;
    border-top:2px solid #943440;
  }
  .accueil-dossiers-entete h2 {
    margin:0;
    font:650 clamp(1.9rem,3.4vw,3rem)/1.05 var(--serif);
  }
  .accueil-dossiers-entete p {
    margin:.55rem 0 0;
    color:#504945;
    font:480 .91rem/1.55 var(--sans);
  }
  .accueil-dossiers-grille {
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:.75rem;
    list-style:none;
    margin:1rem 0 0;
    padding:0;
  }
  .accueil-dossiers-grille a {
    display:flex;
    height:100%;
    flex-direction:column;
    gap:.65rem;
    padding:clamp(.85rem,1.65vw,1.25rem);
    background:#f4f1eb;
    border:1px solid #d6cdc2;
  }
  .accueil-dossiers-grille a:hover {
    background:#eee6dc;
    color:#84323d;
  }
  .accueil-dossiers-titre {
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:.5rem;
  }
  .accueil-dossiers-titre h3 {
    margin:0;
    font:650 clamp(1.3rem,2vw,1.75rem)/1.13 var(--serif);
  }
  .accueil-dossiers-titre span { color:#84323d; }
  .accueil-dossiers-grille p {
    margin:0;
    color:#504945;
    font:480 .83rem/1.5 var(--sans);
  }
  .accueil-dossiers-total {
    margin-top:auto;
    padding-top:.55rem;
    border-top:1px solid #d6cdc2;
    color:#84323d;
    font:700 .75rem/1.4 var(--sans);
  }
  .accueil-dossiers-liens {
    display:flex;
    flex-wrap:wrap;
    gap:0 1.5rem;
    margin-top:.55rem;
  }
  .accueil-dossiers-liens a {
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    min-height:44px;
    color:#84323d;
    font:750 .82rem/1.4 var(--sans);
  }
  .accueil-dossiers-liens a:hover { text-decoration:underline; }
  .accueil-dossiers a:focus-visible {
    outline:2px solid #84323d;
    outline-offset:3px;
  }
  @media(max-width:64rem) {
    .accueil-dossiers-grille { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media(max-width:36rem) {
    .accueil-dossiers-grille { grid-template-columns:1fr; gap:.5rem; }
  }
  .selection {
    margin-top:2.8rem;
    padding-top:1.3rem;
    border-top:2px solid #943440;
  }
  .selection-entete {
    display:flex;
    flex-wrap:wrap;
    align-items:end;
    justify-content:space-between;
    gap:.2rem 1rem;
    margin-bottom:1rem;
  }
  .selection-entete h2 {
    margin:0;
    font:650 clamp(1.9rem,3.4vw,3rem)/1.05 var(--serif);
  }
  .selection-entete a {
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    min-height:44px;
    color:#84323d;
    font:750 .82rem/1.4 var(--sans);
  }
