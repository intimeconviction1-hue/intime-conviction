---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Actualites from '../components/Actualites.astro';
import { lireFil } from '../lib/fil-actualites.mjs';
import { RUBRIQUES, rubrique } from '../lib/rubriques.mjs';
import { tousLesArticles, dateLongue, minutesDeLecture } from '../lib/articles.mjs';
import fronton from '../assets/fronton-cour-dassises.jpg';

const articles = await tousLesArticles();
const fil = await lireFil();
const [une,...suite] = articles;
const derniers = suite.slice(0,5);
const vus = new Set([une,...derniers].map(a=>a.data.slug));
const rubriques = RUBRIQUES.map(r=>{
  const archives=articles.filter(a=>a.data.rubrique===r.slug);
  return {...r,total:archives.length,presse:(fil?.articles??[]).filter(n=>n.rubrique===r.slug),titres:archives.filter(a=>!vus.has(a.data.slug)).slice(0,2)};
});
const parAnnee = new Map();
for(const a of articles){ const an=a.data.date.getFullYear(); if(an>=2009) parAnnee.set(an,(parAnnee.get(an)??0)+1); }
const annees=[...parAnnee].sort((a,b)=>b[0]-a[0]);
const nouvellesOuverture=(fil?.articles??[]).filter(n=>n.rubrique==='cours-du-jour').slice(0,3);
const total=articles.length.toLocaleString('fr-FR');
---
<Base accueil>
  <div slot="fond" class="fond-page" aria-hidden="true"><Image src={fronton} alt="" width={500} loading="eager" fetchpriority="high" /></div>
  <section class="ouverture" aria-labelledby="titre-journal">
    <div class="cadre ouverture-interieur">
      <div class="ouverture-texte">
        <h1 id="titre-journal">Intime<br /><em>Conviction<span>.</span></em></h1>
        <p class="ouverture-promesse">Les assises comme si vous y étiez.</p>
        <p class="ouverture-description">Suivre les audiences. Comprendre le procès.<br class="desktop-br" /> Regarder la justice à hauteur humaine.</p>
        <div class="ouverture-actions">
          <a class="entrer" href="#actualites">Lire Cours du Jour <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
          <a class="explorer" href="/archives/">Explorer les archives</a>
        </div>
      </div>
      <aside class="ouverture-fil" aria-labelledby="titre-fil-ouverture">
        <div class="fil-entete"><h2 id="titre-fil-ouverture">À la barre</h2><a href="#actualites">Cours du Jour</a></div>
        {nouvellesOuverture.length ? <ol>{nouvellesOuverture.map(n=><li><p>{n.source}<time datetime={n.date}>{new Intl.DateTimeFormat('fr-FR',{day:'numeric',month:'long',timeZone:'Europe/Paris'}).format(new Date(n.date))}</time></p><h3><a href={n.lien} target="_blank" rel="noopener noreferrer">{n.titre}<span class="sr-only"> (nouvel onglet)</span></a></h3></li>)}</ol> : <p>Les récits d’audience et les dernières nouvelles sont à retrouver dans <a href="/rubrique/cours-du-jour/">Cours du Jour</a>.</p>}
      </aside>
      <div class="ouverture-bas">
        <a href="#actualites">Au fil des audiences <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a>
        <p>Fronton d’une cour d’assises<br />Photo Intime Conviction · 2009</p>
      </div>
    </div>
  </section>

  <div class="surface-lecture"><div class="cadre journal-corps">
    <Actualites debut={nouvellesOuverture.length} limite={5} compacte />
<section class="conviction-editoriale" aria-labelledby="titre-conviction"><h2 id="titre-conviction">Des vies se jouent.<br /><em>La justice se raconte.</em></h2><div><p>À la barre, des faits deviennent des récits, des certitudes se discutent et des destins se nouent. Intime Conviction s’intéresse à ce moment du procès où chacun peut être entendu.</p><p>Raconter l’audience, expliquer ses règles, restituer ses voix et ses silences : une justice à comprendre, ouverte à la curiosité de tous, avec attention pour les personnes et sans voyeurisme.</p><a class="lire-article" href="/ligne-editoriale/">Découvrir notre ligne éditoriale</a></div></section>

    <section class="selection" aria-labelledby="titre-selection">
      <div class="titre-section"><h2 id="titre-selection">À relire.</h2><a href="/archives/">Le fonds d’Intime Conviction <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div>
      <div class="selection-grille">
        <article class="article-principal">
          <p class="meta"><span class="etiquette">{rubrique(une.data.rubrique).nom}</span><time datetime={une.data.date.toISOString()}>{dateLongue(une.data.date)}</time></p>
          <h3><a href={une.data.chemin}>{une.data.titre}</a></h3>
          <p class="chapeau">{une.data.extrait}</p>
          <a class="lire-article" href={une.data.chemin}>Lire l’article <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg><span class="meta">{minutesDeLecture(une.data.mots)} min</span></a>
        </article>
        <ul class="selection-suite">{derniers.map(({data})=><li><p class="meta"><time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time></p><h3><a href={data.chemin}>{data.titre}</a></h3></li>)}</ul>
      </div>
    </section>

    <section class="univers" aria-labelledby="titre-rubriques">
      <div class="titre-section"><h2 id="titre-rubriques">Six regards<br /><em>sur la justice.</em></h2></div>
      <ul class="rubriques">{rubriques.map(r=><li>
        <div class="rubrique-entete"><h3><a href={`/rubrique/${r.slug}/`}>{r.nom}</a></h3><a class="ouvrir-rubrique" href={`/rubrique/${r.slug}/`} aria-label={`Ouvrir ${r.nom}`}><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div>
        <p class="sous-titre">{r.sousTitre}</p>
        <ul class="titres">{r.presse.length ? r.presse.slice(0,2).map(n=><li><a href={n.lien} target="_blank" rel="noopener noreferrer">{n.titre}</a><span class="meta source-presse">{n.source} · presse</span></li>) : r.titres.map(({data})=><li><a href={data.chemin}>{data.titre}</a></li>)}</ul>
        <a class="rubrique-volume" href={`/rubrique/${r.slug}/`}>{r.total.toLocaleString('fr-FR')} articles d’archives{r.presse.length>0&&` · ${r.presse.length} nouvelles`}</a>
      </li>)}</ul>
    </section>

    <section class="fonds" aria-labelledby="titre-fonds">
      <div class="fonds-intro"><h2 id="titre-fonds">Les archives<span>.</span></h2><p>{total} articles,<br />année par année.</p><a href="/archives/">Explorer tout le fonds <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div>
      <ul class="annees">{annees.map(([an,n])=><li><a href={`/archives/${an}/`}><span class="an">{an}</span><span class="meta">{n.toLocaleString('fr-FR')} articles</span></a></li>)}</ul>
    </section>
  </div></div>
</Base>
<style>
  .fond-page { position:fixed; inset:0; z-index:-1; pointer-events:none; background:var(--pied); }
  .fond-page img { display:block; width:100%; height:100%; object-fit:cover; object-position:60% center; filter:grayscale(1) contrast(1.08); }
  .fond-page::after { content:''; position:absolute; inset:0; background:color-mix(in srgb,var(--pied) 22%,transparent); }
  .ouverture { position:relative; color:var(--pied-texte); min-height:calc(100svh - 9rem); display:grid; align-items:center; }
  .ouverture::before { content:''; position:absolute; inset:0; background:linear-gradient(90deg,color-mix(in srgb,var(--pied) 93%,transparent),color-mix(in srgb,var(--pied) 69%,transparent) 48%,color-mix(in srgb,var(--pied) 12%,transparent)); pointer-events:none; }
  .ouverture-interieur { position:relative; padding-top:clamp(3rem,7vh,6rem); padding-bottom:1.5rem; }
  .ouverture-texte { max-width:45rem; }
  h1 { font-size:clamp(4rem,9.5vw,6rem); font-weight:500; line-height:0.91; letter-spacing:-0.04em; margin:0 0 2rem; }
  h1 em { font-weight:400; }h1 em span { color:var(--pied-survol); }
  .ouverture-promesse { font-size:clamp(1.25rem,2.5vw,1.75rem); margin:0 0 0.8rem; }
  .ouverture-description { font-family:var(--sans); font-size:0.8125rem; color:var(--pied-texte); line-height:1.9; margin:0; }
  .ouverture-actions { display:flex; align-items:center; flex-wrap:wrap; gap:0.75rem 1.75rem; margin-top:2rem; font-family:var(--sans); font-size:0.75rem; }
  .entrer { display:inline-flex; align-items:center; justify-content:space-between; gap:1.5rem; min-height:52px; padding:0.85rem 1.25rem; background:var(--action); color:var(--sur-action); font-weight:600; }
  .entrer:hover { background:var(--action-survol); color:var(--sur-action); }
  .explorer { display:inline-flex; align-items:center; min-height:44px; border-bottom:1px solid color-mix(in srgb,var(--pied-texte) 55%,transparent); }.explorer:hover { color:var(--pied-survol); }
  .ouverture-bas { margin-top:clamp(2.5rem,7vh,5rem); display:flex; align-items:end; justify-content:space-between; gap:2rem; font-family:var(--sans); font-size:0.625rem; color:var(--pied-texte); }
  .ouverture-bas a { display:flex; align-items:center; gap:1rem; min-height:44px; }.ouverture-bas p { text-align:right; margin:0; padding:0.6rem 0.8rem; line-height:1.8; background:color-mix(in srgb,var(--pied) 84%,transparent); }
  .surface-lecture { background:color-mix(in srgb,var(--papier) 95%,transparent); padding-top:0.25rem; }
  .journal-corps { padding-bottom:5rem; }
  .conviction-editoriale { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:2rem 4rem; margin-top:5rem; padding-block:2.5rem; border-block:1px solid var(--filet-fort); }
  .conviction-editoriale h2 { margin:0; font-size:clamp(2.25rem,4vw,3.5rem); line-height:1.1; }
  .conviction-editoriale p { margin:0 0 1rem; max-width:60ch; font-size:1.1875rem; line-height:1.65; }
  .conviction-editoriale p+p { color:var(--encre-2); }
  @media(max-width:47.99rem) { .conviction-editoriale { grid-template-columns:minmax(0,1fr); gap:1.5rem; } }
  .selection-grille { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,0.95fr); gap:4rem; padding-top:1rem; }
  .article-principal { padding-right:3rem; border-right:1px solid var(--filet); }.article-principal .meta { display:flex; flex-wrap:wrap; gap:0.5rem 1rem; }
  .article-principal h3 { font-size:clamp(2.5rem,4.2vw,3.75rem); line-height:1.05; margin:1.25rem 0; }
  .chapeau { font-size:1.1875rem; line-height:1.65; color:var(--encre-2); margin:0 0 1.5rem; }
  .lire-article { display:inline-flex; align-items:center; flex-wrap:wrap; gap:1rem; min-height:44px; font-family:var(--sans); font-size:0.75rem; }.lire-article .meta { margin-left:0.5rem; }
  .selection-suite { list-style:none; margin:0; padding:0; }.selection-suite li { border-bottom:1px solid var(--filet); padding:1.1rem 0; }.selection-suite li:first-child { padding-top:0; }.selection-suite .meta { margin:0 0 0.4rem; }.selection-suite h3 { margin:0; font-size:1.5rem; line-height:1.18; }
  .univers .titre-section { padding-bottom:1rem; }.univers h2 { font-size:clamp(2.5rem,5vw,4.5rem); }
  .rubriques { list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:4rem; }
  .rubriques>li { min-width:0; padding:2rem 0; border-bottom:1px solid var(--filet); }
  .rubrique-entete { display:flex; justify-content:space-between; align-items:start; gap:1rem; }.rubrique-entete h3 { margin:0; font-size:clamp(1.75rem,3vw,2.5rem); }.ouvrir-rubrique { min-width:44px; min-height:44px; display:flex; align-items:center; justify-content:center; }
  .sous-titre { margin:0.5rem 0 1.5rem; font-size:1.0625rem; font-style:italic; color:var(--encre-2); }
  .titres { list-style:none; padding:0; margin:0; }.titres li { margin:0.65rem 0; line-height:1.4; font-size:1.125rem; }.source-presse { display:block; font-size:0.625rem; margin-top:0.25rem; }
  .rubrique-volume { display:inline-flex; align-items:center; min-height:44px; margin-top:1rem; font-family:var(--sans); font-size:0.6875rem; color:var(--encre-2); }
  .fonds { margin-top:5rem; border-top:1px solid var(--filet-fort); padding-top:2.5rem; }
  .fonds-intro { display:grid; grid-template-columns:1.5fr 1fr; gap:1rem 2rem; align-items:center; }.fonds h2 { margin:0; font-size:clamp(3rem,5.5vw,5rem); line-height:1; }.fonds h2 span { color:var(--rouge); }.fonds-intro p { color:var(--encre-2); font-size:1.25rem; margin:0; }.fonds-intro>a { grid-column:1/-1; display:inline-flex; align-items:center; gap:1.5rem; min-height:44px; font-family:var(--sans); font-size:0.75rem; justify-self:start; }
  .annees { list-style:none; display:grid; grid-template-columns:repeat(auto-fill,minmax(7.5rem,1fr)); gap:0 1.5rem; padding:0; margin:2rem 0 0; }.annees a { display:flex; flex-direction:column; border-top:1px solid var(--filet); padding:1.1rem 0; min-height:70px; }.an { font-size:2rem; line-height:1.1; }.annees .meta { font-size:0.625rem; margin-top:0.35rem; }
  @media(max-width:47.99rem) { h1 { font-size:clamp(3.5rem,13.7vw,5.5rem); }.ouverture { min-height:calc(100svh - 8rem); }.ouverture-texte { max-width:100%; }.ouverture::before { background:color-mix(in srgb,var(--pied) 73%,transparent); }.ouverture-actions { gap:0.75rem 1rem; }.ouverture-bas { gap:1rem; font-size:0.5625rem; }.ouverture-bas a { max-width:9rem; }.selection-grille { grid-template-columns:minmax(0,1fr); gap:2rem; }.article-principal { padding:0 0 1.5rem; border-right:0; border-bottom:1px solid var(--filet); }.rubriques { grid-template-columns:minmax(0,1fr); }.fonds-intro { grid-template-columns:minmax(0,1fr); }.fonds-intro>a { grid-column:1; }.annees { grid-template-columns:repeat(3,minmax(0,1fr)); gap:0 1.25rem; }.ouverture-interieur { padding-top:3rem; }.desktop-br { display:none; } }
  @media(prefers-reduced-motion:no-preference) { .ouverture-texte { animation:ouvrir 700ms cubic-bezier(.16,1,.3,1) both; }@keyframes ouvrir { from { transform:translateY(18px); opacity:0.75; }to { transform:translateY(0); opacity:1; } } }

  /* Une page de journal : les nouvelles occupent le premier écran. */
  .ouverture { min-height:0; }
  .ouverture-interieur { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,0.85fr); gap:1.5rem 4rem; align-items:center; padding-top:3rem; padding-bottom:1rem; }
  h1 { font-size:clamp(4rem,7.5vw,6rem); margin-bottom:1.5rem; }
  .ouverture-actions { margin-top:1.5rem; }
  .ouverture-fil { min-width:0; padding:1.25rem 1.5rem; background:color-mix(in srgb,var(--pied) 92%,transparent); border-top:1px solid var(--pied-survol); }
  .fil-entete { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; padding-bottom:0.5rem; }
  .fil-entete h2 { margin:0; font-style:italic; font-size:2rem; }.fil-entete>a { font-family:var(--sans); font-size:0.6875rem; min-height:44px; display:inline-flex; align-items:center; color:var(--pied-survol); }
  .ouverture-fil ol { padding:0; margin:0; list-style:none; }.ouverture-fil li { padding:1rem 0; border-top:1px solid color-mix(in srgb,var(--pied-texte) 25%,transparent); }
  .ouverture-fil li p { margin:0 0 0.5rem; display:flex; flex-wrap:wrap; gap:0.25rem 1rem; font-family:var(--sans); font-size:0.625rem; color:var(--pied-survol); }.ouverture-fil time { color:var(--pied-2); }
  .ouverture-fil h3 { font-size:1.375rem; line-height:1.2; margin:0; }.ouverture-fil li:first-child h3 { font-size:1.75rem; }.ouverture-fil a:hover { color:var(--pied-survol); }
  .ouverture-bas { grid-column:1/-1; margin-top:0; }.ouverture-bas p { background:none; padding:0; }
  .journal-corps { padding-bottom:3rem; }
  .journal-corps :global(.titre-section) { margin-top:3rem; }
  .conviction-editoriale { margin-top:3rem; padding:2rem; gap:2rem; background:var(--action); color:var(--sur-action); border:0; }
  .conviction-editoriale p+p { color:var(--sur-action); }.conviction-editoriale h2 { font-size:clamp(2rem,3.5vw,3rem); }.conviction-editoriale p { font-size:1.0625rem; line-height:1.55; }
  .conviction-editoriale a { text-decoration:underline; text-underline-offset:0.25em; }.conviction-editoriale a:hover { color:var(--sur-action); text-decoration-thickness:2px; }
  .selection-grille { gap:2rem; }.article-principal { padding-right:2rem; }.article-principal h3 { font-size:clamp(2rem,3.7vw,3.25rem); }
  .rubriques { grid-template-columns:repeat(3,minmax(0,1fr)); gap:0 2rem; }.rubriques>li { padding:1.5rem 0; }.rubrique-entete h3 { font-size:1.875rem; }.sous-titre { margin-bottom:1rem; }.titres li { font-size:1.0625rem; }.rubrique-volume { margin-top:0.5rem; }
  .fonds { margin-top:3rem; padding-top:1.5rem; }.fonds-intro { grid-template-columns:1.2fr 1fr auto; }.fonds h2 { font-size:clamp(2.5rem,4.5vw,4rem); }.fonds-intro>a { grid-column:auto; }.annees { margin-top:1rem; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
  @media(max-width:63.99rem) { .ouverture-interieur { column-gap:2rem; }.rubriques { grid-template-columns:repeat(2,minmax(0,1fr)); }.fonds-intro { grid-template-columns:1fr 1fr; }.fonds-intro>a { grid-column:1/-1; } }
  @media(max-width:47.99rem) { .ouverture { min-height:0; }.ouverture-interieur { grid-template-columns:minmax(0,1fr); padding-top:2rem; gap:1.5rem; }.ouverture-fil { padding:1rem; }.ouverture-fil li { padding:0.75rem 0; }.ouverture-fil h3,.ouverture-fil li:first-child h3 { font-size:1.25rem; }.ouverture-bas { gap:0.5rem; }.conviction-editoriale { padding:1.5rem; grid-template-columns:minmax(0,1fr); gap:1rem; }.rubriques { grid-template-columns:minmax(0,1fr); }.rubrique-entete h3 { font-size:2rem; }.article-principal { padding-right:0; }.fonds-intro { grid-template-columns:minmax(0,1fr); }.fonds-intro>a { grid-column:1; }.journal-corps :global(.titre-section) { margin-top:2rem; } }
</style>
