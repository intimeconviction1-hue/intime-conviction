---
import Base from '../layouts/Base.astro';
import { photosArticles } from '../lib/photos-articles.mjs';
import VisuelAssises from '../components/VisuelAssises.astro';
import photoDossiers from '../assets/assises-bordeaux.webp';
import photoSalle from '../assets/salle-voltaire.webp';
import Actualites from '../components/Actualites.astro';
import ListeArticles from '../components/ListeArticles.astro';
import AgendaEnBref from '../components/AgendaEnBref.astro';
import { CULTURE } from '../lib/culture.mjs';
import { lireVeille } from '../lib/veille.mjs';
import { RUBRIQUES, rubrique } from '../lib/rubriques.mjs';
import { DOSSIERS, referencesPourDossier } from '../lib/dossiers.mjs';
import { tousLesArticles, dateLongue } from '../lib/articles.mjs';
import { articleVisible } from '../lib/article-visible.mjs';

const articles = await tousLesArticles();
const veille = await lireVeille();
const maintenant = Date.now();
const articlesVerifies = articles.filter(({data}) => articleVisible(data, maintenant));
// Une même affaire ne doit pas occuper deux emplacements du carrousel.
// Les chroniques transversales sont écartées si elles reprennent une affaire
// déjà choisie. La sélection reste fondée sur des articles réellement publiés.
const affairesUne = [
  'zecler','heaulme','clement','safari','daubon','gomes','sollacaro',
  'ferreira','crepol','lourdes','inass','touloub','lyanna','piaget',
  'vannes','saint-junien','chateauneuf','manosque','luca'
];
const etiquettesUne = article => {
  const texte = (article.data.titre + ' ' + article.data.slug).toLocaleLowerCase('fr')
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  return affairesUne.filter(mot => texte.includes(mot));
};
const selectionUne = [];
const dejaUne = new Set();
for (const article of articlesVerifies) {
  const etiquettes = etiquettesUne(article);
  if (etiquettes.some(mot => dejaUne.has(mot))) continue;
  selectionUne.push(article);
  etiquettes.forEach(mot => dejaUne.add(mot));
  if (selectionUne.length === 3) break;
}
// Sept dates civiles, aujourd’hui compris, selon l’heure de Paris.
const dateParis = new Intl.DateTimeFormat('fr-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit' });
const debutSemaine = new Date(dateParis.format(new Date()) + 'T00:00:00Z');
debutSemaine.setUTCDate(debutSemaine.getUTCDate() - 6);
const limiteRecente = debutSemaine.toISOString().slice(0, 10);
const [articlesRecents, articlesArchives] = articlesVerifies.filter(article => !selectionUne.includes(article))
  .reduce(([recents, anciens], article) => {
    const groupe = dateParis.format(article.data.date) >= limiteRecente ? recents : anciens;
    groupe.push(article);
    return [recents, anciens];
  }, [[], []]);
// Les chapeaux sont ceux de la rédaction : les cartes reprennent les extraits
// des articles vérifiés, sans résumé automatique depuis les flux de presse.
const dernieresPublications = articlesRecents.slice(0, 6);
const [archiveUne, ...derniers] = articlesArchives.slice(0, 4);
const vus = new Set([...selectionUne, ...dernieresPublications, archiveUne, ...derniers].filter(Boolean).map(a => a.data.slug));
const descriptionsRubriques = {
  'cours-du-jour': 'Le suivi des procès criminels et de leurs audiences.',
  'le-banc-des-jures': 'Les règles du procès, les jurés et les autres acteurs de l’audience.',
  'la-cour-se-leve': 'Des chroniques qui racontent les débats depuis la salle d’audience.',
  'delibere': 'Des réflexions et des points de vue sur la justice.',
  'l-expose': 'Des analyses pour comprendre les affaires et les décisions.',
  'le-greffe': 'Le cinéma, les livres et l’histoire de la justice.',
};
const rubriques = RUBRIQUES.map(r=>{
  const archives=articles.filter(a=>a.data.rubrique===r.slug);
  const titres = archives
    .filter(({data}) => articleVisible(data, maintenant) && !vus.has(data.slug))
    .slice(0, 2);
  return {...r,titres};
});
const dossiersMisEnAvant = DOSSIERS.map(dossier => {
  const [derniere] = referencesPourDossier(dossier, veille.articles);
  return {...dossier, derniere};
}).filter(dossier => dossier.derniere)
  .sort((a,b) => b.derniere.dateAlerte.localeCompare(a.derniere.dateAlerte))
  .slice(0,3);
const repereUne = {
  '/proces-sollacaro-et-tout-recommence-aux-assises/11/2026/': 'Aix-en-Provence · Cour d’assises · Nouveau procès',
};
const articlesUne = selectionUne.map(({data}) => ({
  data,
  photo: photosArticles[data.chemin],
  repere: repereUne[data.chemin],
}));
---
<Base accueil>
  <section class="ouverture" aria-labelledby="titre-accueil">
    <div class="cadre ouverture-interieur">
      <h1 id="titre-accueil" class="sr-only">Intime Conviction, le journal des cours d’assises</h1>
      {articlesUne.length > 0 && (
        <section class="une-editoriale" aria-labelledby="une-editoriale-titre">
          <h2 id="une-editoriale-titre">À la une</h2>
          <div class="commandes-une" hidden aria-label="Navigation de la une">
            <div class="une-pagination" role="group" aria-label="Choisir un article">
              {articlesUne.map((_, i) => <button type="button" data-aller={i} aria-label={`Afficher l’article ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}><span class="sr-only">Article {i + 1}</span></button>)}
            </div>
            <div class="une-commandes-droite">
              <span class="une-compteur" data-compteur aria-live="polite" aria-atomic="true"></span>
              <button class="une-fleche" type="button" data-precedent aria-label="Article précédent">←</button>
              <button class="une-fleche" type="button" data-suivant aria-label="Article suivant">→</button>
              <button class="une-pause" type="button" data-pause aria-pressed="false">Pause</button>
            </div>
          </div>
          <div class="une-editoriale-grille">
            {articlesUne.map(({data, photo, repere}, i) => (
              <article class="article-redaction-une">
                <div class="une-visuel-cadre">
                <div class:list={["une-couverture", {"avec-photo": photo, "une-croquis": photo?.croquis}]}>
                  {photo && (
                    <img src={photo.image.src} width={photo.image.width} height={photo.image.height}
                      alt={photo.lieu} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
                  )}
                </div>
                {photo && (
                  <div class="une-credit">
                    <span>Illustration d’archives</span>
                    <details><summary>Crédits photo</summary><span>{photo.lieu} · <a href={photo.source}>{photo.auteur}</a> · <a href={photo.lienLicence}>{photo.licence}</a></span></details>
                  </div>
                )}
                </div>
                <div class="une-edito">
                  <div class="une-titre">
                    <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
                    {repere && <p class="repere-proces">{repere}</p>}
                    <h3><a href={data.chemin}>{data.titre}</a></h3>
                  </div>
                <div class="une-editoriale-texte">
                  <p>{data.extrait}</p><a class="lire-une" href={data.chemin}>Lire l’article <span aria-hidden="true">→</span></a>
                </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

    </div>
  </section>

  <div class="surface-lecture"><div class="cadre journal-corps">
    {dernieresPublications.length > 0 && (
      <section class="dernieres-publications" aria-labelledby="titre-dernieres-publications">
        <h2 id="titre-dernieres-publications" class="sr-only">Actualité</h2>
        <ListeArticles articles={dernieresPublications} rubriqueVisible={false} illustres />
        <a class="suite-actualite" href="/rubrique/cours-du-jour/#articles-redaction">Toute l’actualité <span aria-hidden="true">→</span></a>
      </section>
    )}

    <Actualites accueil titre="Revue de presse" limite={5} lienRubrique={false} imagesExclues={[...articlesUne, ...dernieresPublications.map(({data}) => ({photo: photosArticles[data.chemin]}))].map(({photo}) => photo?.image?.src)} />

    <section class="accueil-dossiers" aria-labelledby="titre-dossiers-accueil">
      <div class="accueil-dossiers-entete">
        <h2 id="titre-dossiers-accueil">Dossiers judiciaires</h2>
        <a href="/dossiers/">Tous les dossiers <span aria-hidden="true">→</span></a>
      </div>
      <div class="dossiers-visuel">
        <VisuelAssises image={photoDossiers} alt="Salle de la cour d’assises du palais Thiac, Bordeaux"
          source="https://commons.wikimedia.org/wiki/File:Palais_Thiac,_Salle_d%27audience_de_la_cour_d%27assises.jpg"
          credit="Tiraden" licence="CC BY-SA 4.0" licenceUrl="https://creativecommons.org/licenses/by-sa/4.0/" />
      </div>
      {dossiersMisEnAvant.length > 0 && (
        <ul class="accueil-dossiers-grille">
          {dossiersMisEnAvant.map(d => (
            <li>
              <a href={`/dossiers/${d.slug}/`} aria-labelledby={`accueil-dossier-${d.slug}`} aria-describedby={`accueil-dossier-repere-${d.slug}`}>
                <div class="accueil-dossiers-titre">
                  <h3 id={`accueil-dossier-${d.slug}`}>{d.titre}</h3>
                  <span aria-hidden="true">→</span>
                </div>
                <p id={`accueil-dossier-repere-${d.slug}`}>{d.derniere.titre}</p>
                <span class="accueil-dossiers-total">
                  {d.derniere.source} · <time datetime={d.derniere.dateAlerte}>{dateLongue(new Date(d.derniere.dateAlerte + "T12:00:00Z"))}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}

    </section>


    <AgendaEnBref />
    <section class="guide-assises" aria-labelledby="titre-guide-assises">
      <figure>
        <img src={photoSalle.src} width={photoSalle.width} height={photoSalle.height}
          alt="Le banc de la cour dans la salle Voltaire, à Paris" loading="lazy" decoding="async" />
        <figcaption>Salle Voltaire, Paris · <a href="https://commons.wikimedia.org/wiki/File:Palais_de_justice_de_Paris_-_salle_Voltaire_(cour_d%27assises).jpg">Tiraden</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · cadrée</figcaption>
      </figure>
      <div class="guide-assises-texte">
        <h2 id="titre-guide-assises">Comprendre les assises</h2>
        <p>Qui siège à la cour ? Dans quel ordre parle-t-on ? Comment se prend la décision ?</p>
        <ul>
          <li><a href="/comprendre/">Le déroulement du procès <span aria-hidden="true">→</span></a></li>
          <li><a href="/rubrique/le-banc-des-jures/">Les jurés et les acteurs du procès <span aria-hidden="true">→</span></a></li>
          <li><a href="/assister/">Préparer sa première audience <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </section>

    {archiveUne && (
      <section class="selection" aria-labelledby="titre-selection">
        <div class="selection-entete">
          <h2 id="titre-selection">Les archives du journal</h2>
          <a href="/archives/">Archives du journal <span aria-hidden="true">→</span></a>
        </div>
        <div class:list={['selection-grille', { 'selection-grille-simple': derniers.length === 0 }]}>
          <article class="archive-vedette">
            <a href={archiveUne.data.chemin} aria-labelledby="titre-archive-vedette">
              <div class="archive-vedette-entete">
                <h3 id="titre-archive-vedette">{archiveUne.data.titre}</h3>
              </div>
              <p class="archive-vedette-meta">
                <span>{rubrique(archiveUne.data.rubrique).libelle}</span>
                <time datetime={archiveUne.data.date.toISOString()}>{dateLongue(archiveUne.data.date)}</time>
              </p>
              <p class="archive-vedette-extrait">{archiveUne.data.extrait}</p>
            </a>
          </article>
          {derniers.length > 0 && (
            <div class="selection-suite">
              <h3>Autres articles à relire</h3>
              <ul>
                {derniers.map(({data}) => (
                  <li>
                    <a href={data.chemin}>
                      <div>
                        <h4>{data.titre}</h4>
                        <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
                      </div>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="greffe-accueil" aria-labelledby="titre-culture">
      <div class="greffe-accueil-entete">
        <div>
          <h2 id="titre-culture">Livres, films et histoire</h2>
        </div>
        <a href="/rubrique/le-greffe/">Voir les livres et les films <span aria-hidden="true">→</span></a>
      </div>
      <ul class="greffe-accueil-cartes">
        {CULTURE.map(({slug, genre, auteur, titre, extrait}) => (
          <li>
            <a href={`/culture/${slug}/`} aria-labelledby={`greffe-accueil-${slug}`} aria-describedby={`greffe-extrait-${slug}`}>
              <p class="greffe-accueil-genre">{genre}</p>
              <h3 id={`greffe-accueil-${slug}`}>{titre}</h3>
              <p class="greffe-accueil-auteur">{auteur}</p>
              <p class="greffe-accueil-extrait" id={`greffe-extrait-${slug}`}>{extrait}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="videos-accueil" aria-labelledby="titre-videos-accueil">
      <div class="selection-entete">
        <h2 id="titre-videos-accueil">À voir et à écouter</h2>
        <a href="/culture/videos/">Toutes les vidéos <span aria-hidden="true">→</span></a>
      </div>
      <a class="video-accueil-lien" href="/culture/videos/">
        <span class="video-accueil-icone" aria-hidden="true">▶</span>
        <span><strong>Justice en France : les meilleures audiences au tribunal</strong><small>Une sélection de vidéos judiciaires · Source extérieure : YouTube</small></span>
        <span class="video-accueil-fleche" aria-hidden="true">→</span>
      </a>
    </section>

    <section class="univers" aria-labelledby="titre-rubriques">
      <h2 id="titre-rubriques">Dans le journal</h2>
      <ul class="rubriques">
        {rubriques.map(r => (
          <li class="rubrique-carte">
            <h3>
              <a href={`/rubrique/${r.slug}/`}>{r.libelle}<span aria-hidden="true">→</span></a>
            </h3>
            <p class="rubrique-description">{descriptionsRubriques[r.slug] ?? r.sousTitre}</p>
            {r.titres.length > 0 && (
              <ul class="rubrique-lectures" aria-label={`À lire dans ${r.libelle}`}>
                {r.titres.map(({data}) => <li><a href={data.chemin}>{data.titre}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>

    <nav class="outils-accueil" aria-label="Explorer le fonds judiciaire">
      <h2>Explorer le fonds judiciaire</h2>
      <ul>
        <li><a href="/chronologie/">Chronologie des affaires <span aria-hidden="true">→</span></a></li>
        <li><a href="/carte/">Carte des affaires <span aria-hidden="true">→</span></a></li>
        <li><a href="/annuaire/#repertoire">Annuaire des juridictions <span aria-hidden="true">→</span></a></li>
        <li><a href="/archives/presse/">Archives de presse <span aria-hidden="true">→</span></a></li>
      </ul>
    </nav>

  </div></div>
</Base>
<script>
  const carrousel = document.querySelector('.une-editoriale');
  const cartes = [...(carrousel?.querySelectorAll<HTMLElement>('.article-redaction-une') ?? [])];
  const commandes = carrousel?.querySelector<HTMLElement>('.commandes-une');
  const pause = commandes?.querySelector<HTMLButtonElement>('[data-pause]');
  const compteur = commandes?.querySelector<HTMLElement>('[data-compteur]');
  if (carrousel && commandes && pause && cartes.length > 1) {
    const mouvement = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let enPause = mouvement.matches;
    let survol = false;
    let timer: number | undefined;
    const afficher = (position: number) => {
      index = (position + cartes.length) % cartes.length;
      cartes.forEach((carte, i) => { carte.hidden = i !== index; });
      if (compteur) compteur.textContent = `${index + 1} / ${cartes.length}`;
      commandes.querySelectorAll<HTMLButtonElement>('[data-aller]').forEach((bouton, i) =>
        bouton.setAttribute('aria-pressed', String(i === index)));
    };
    const regler = () => {
      window.clearInterval(timer);
      pause.textContent = enPause ? 'Lecture' : 'Pause';
      pause.setAttribute('aria-pressed', String(enPause));
      if (!enPause && !survol && !document.hidden) timer = window.setInterval(() => afficher(index + 1), 8000);
    };
    const parcourir = (pas: number) => {
      enPause = true;
      afficher(index + pas);
      regler();
    };
    commandes.querySelectorAll<HTMLButtonElement>('[data-aller]').forEach(bouton => {
      bouton.addEventListener('click', () => { enPause = true; afficher(Number(bouton.dataset.aller)); regler(); });
    });
    commandes.querySelector('[data-precedent]')?.addEventListener('click', () => parcourir(-1));
    commandes.querySelector('[data-suivant]')?.addEventListener('click', () => parcourir(1));
    pause.addEventListener('click', () => { enPause = !enPause; regler(); });
    carrousel.querySelector('.une-editoriale-grille')?.addEventListener('focusin', () => { enPause = true; regler(); });
    carrousel.addEventListener('mouseenter', () => { survol = true; regler(); });
    carrousel.addEventListener('mouseleave', () => { survol = false; regler(); });
    mouvement.addEventListener('change', () => { if (mouvement.matches) { enPause = true; regler(); } });
    document.addEventListener('visibilitychange', regler);
    carrousel.classList.add('une-carrousel');
    commandes.hidden = false;
    afficher(0);
    regler();
  }
</script>

<style>
.videos-accueil{margin:2rem 0;padding:1rem 0;border-top:2px solid var(--filet);border-bottom:1px solid var(--filet)}
.video-accueil-lien{display:flex;gap:1.5rem;align-items:center;padding:1.4rem;background:#17191a;color:#fff;text-decoration:none;margin-top:1.5rem}
.video-accueil-lien:hover,.video-accueil-lien:focus-visible{color:#ffe100}
.video-accueil-icone{display:grid;place-items:center;flex-shrink:0;width:3.3rem;height:3.3rem;background:#ffe100;color:#17191a;border-radius:50%;font-size:1.2rem}
.video-accueil-lien strong{display:block;font:800 clamp(1rem,2vw,1.4rem)/1.35 var(--sans)}
.video-accueil-lien small{display:block;font:500 .78rem/1.5 var(--sans);color:#ccc;margin-top:.5rem}
.video-accueil-fleche{margin-left:auto;font-size:1.4rem}
@media(max-width:650px){.video-accueil-lien{gap:.9rem;padding:1rem}.video-accueil-icone{width:2.6rem;height:2.6rem}}

  .ouverture,.surface-lecture{color:#252525}
  .ouverture{background:linear-gradient(155deg,#f0e9e0,#fcfaf6 66%)}
  .surface-lecture{background:#fcfaf6}
  .dossiers-visuel{margin-bottom:1rem;background:#e8ded1}
  .section-intro{max-width:78ch;margin:.25rem 0 1rem;color:#534943;font:500 .96rem/1.55 var(--sans)}
  .dossiers-visuel :global(img){max-height:17rem;object-fit:cover;object-position:center 56%}
  .ouverture-interieur{padding-top:clamp(1rem,2.5vw,2rem)}
  .journal-corps{padding-bottom:3rem}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  .une-editoriale{margin:0 0 1rem}
  .une-editoriale>h2{padding:.75rem 0;margin:0;color:#84323d;font:750 clamp(1.9rem,4.2vw,3.4rem)/1.05 var(--serif);letter-spacing:-.025em;text-transform:uppercase}
  .une-compteur{font:750 .8rem/1.4 var(--sans);color:#641e30;white-space:nowrap;min-width:3.5rem;text-align:center;font-variant-numeric:tabular-nums}
  .commandes-une button:focus-visible{outline:3px solid #84323d;outline-offset:3px}
  .une-editoriale-grille{display:grid;grid-template-columns:minmax(0,2.2fr) minmax(0,1fr);gap:1rem 1.8rem}
  .article-redaction-une{min-width:0;border-bottom:1px solid #c7bdb2;padding-bottom:1rem}
  .article-redaction-une:first-child{grid-row:span 2}
  .une-couverture{position:relative;display:grid;align-items:end;isolation:isolate}
  .une-couverture.avec-photo{min-height:clamp(16rem,34vw,30rem);background:#554b47;color:#fff}
  .une-couverture img,.une-couverture.avec-photo::after{position:absolute;inset:0;width:100%;height:100%;z-index:-1}
  .une-couverture img{object-fit:cover}
  .une-couverture.une-croquis img{object-fit:contain;background:#fbfaf7}
  .une-couverture.avec-photo::after{content:"";background:linear-gradient(to top,rgba(16,12,12,.94),rgba(16,12,12,.68) 46%,transparent 82%)}
  .une-couverture.avec-photo .une-titre{padding:clamp(.85rem,3vw,2rem);text-shadow:0 1px 4px #161010}
  .une-titre time{color:#84323d;font:750 .76rem/1.4 var(--sans)}
  .avec-photo time{color:inherit}
  .une-titre h3{margin:.35rem 0 0;font:650 clamp(1.35rem,2.2vw,2rem)/1.1 var(--serif);overflow-wrap:anywhere}
  .article-redaction-une:first-child h3,.une-carrousel h3{font-size:clamp(1.65rem,4.2vw,3.85rem);letter-spacing:-.025em}
  .une-credit{color:#554b47;font:500 .68rem/1.4 var(--sans);margin:.4rem 0 0}
  .une-credit a{text-decoration:underline}
  .une-credit details{display:inline;margin-left:.45rem}
  .une-credit summary{display:inline;cursor:pointer;text-decoration:underline;text-underline-offset:.14em}
  .une-credit summary::marker{content:''}
  .une-credit details[open] span{display:block;margin-top:.3rem}
  .une-editoriale-texte p{max-width:65ch;margin:.7rem 0 0;font:500 1rem/1.55 var(--sans)}
  .une-editoriale a:hover{text-decoration:underline;text-underline-offset:.14em}
  @media(max-width:48rem){
    .une-editoriale-grille{grid-template-columns:minmax(0,1fr)}
    .article-redaction-une:first-child{grid-row:auto}
  }

