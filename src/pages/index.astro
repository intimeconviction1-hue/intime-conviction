---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Actualites from '../components/Actualites.astro';
import { lireFil } from '../lib/fil-actualites.mjs';
import { RUBRIQUES, rubrique } from '../lib/rubriques.mjs';
import { tousLesArticles, dateLongue, minutesDeLecture } from '../lib/articles.mjs';
// Photo prise le 14/10/2009 (Panasonic DMC-TZ4). Astro la convertit en WebP
// et en retire les métadonnées (appareil, date, lieu) à la construction.
import fronton from '../assets/fronton-cour-dassises.jpg';

const articles = await tousLesArticles();
const fil = await lireFil();
const [une, ...suite] = articles;
const derniers = suite.slice(0, 6);
const dejaVus = new Set([une, ...derniers].map((a) => a.data.slug));

const rubriques = RUBRIQUES.map((r) => {
  const liste = articles.filter((a) => a.data.rubrique === r.slug);
  // Les titres d'une rubrique ne répètent pas ceux de la une et des derniers.
  return { ...r, total: liste.length, titres: liste.filter((a) => !dejaVus.has(a.data.slug)).slice(0, 3), presse:(fil?.articles ?? []).filter(n=>n.rubrique===r.slug) };
}).filter((r) => r.total > 0);

const parAnnee = new Map();
for (const a of articles) {
  const an = a.data.date.getFullYear();
  if (an >= 2009) parAnnee.set(an, (parAnnee.get(an) ?? 0) + 1);
}
const annees = [...parAnnee].sort((a, b) => b[0] - a[0]);
const total = articles.length.toLocaleString('fr-FR');
---
<Base accueil>
  <div class="journal-intro">
    <p>Suivi d’audience, règles du procès, culture criminelle.</p>
    <a href="/archives/">{total} articles à explorer <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></a>
  </div>
  <section class="une" aria-labelledby="titre-une">
    <div class="une-texte">
      <p class="meta"><span class="etiquette">{rubrique(une.data.rubrique).nom}</span>&ensp;<time datetime={une.data.date.toISOString()}>{dateLongue(une.data.date)}</time></p>
      <h2 id="titre-une"><a href={une.data.chemin}>{une.data.titre}</a></h2>
      <p class="chapeau">{une.data.extrait}</p>
      <div class="lecture">
        <a class="lire" href={une.data.chemin}>Lire l’article <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
        <span class="meta">{minutesDeLecture(une.data.mots)} min de lecture</span>
      </div>
    </div>
    {/* Image d'ambiance de la maison, indépendante de l'affaire présentée. */}
    <div class="une-fond" aria-hidden="true">
      <Image src={fronton} alt="" width={500} loading="eager" fetchpriority="high" />
    </div>
    <p class="credit-photo meta">Fronton d’une cour d’assises · photo Intime Conviction, 2009</p>
  </section>

  <Actualites />

  <section aria-labelledby="titre-derniers">
    <div class="titre-section"><h2 id="titre-derniers">Derniers articles</h2><a href="/archives/">Tout le fonds <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div>
    <ul class="colonnes derniers">
      {derniers.map(({ data }, i) => (
        <li class:list={{principal: i === 0}}>
          <p class="meta"><span class="etiquette">{rubrique(data.rubrique).nom}</span>&ensp;<time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time></p>
          <h3><a href={data.chemin}>{data.titre}</a></h3>
          {i === 0 && <p class="apercu">{data.extrait}</p>}
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="titre-rubriques">
    <div class="titre-section"><h2 id="titre-rubriques">Les rubriques</h2></div>
    <ul class="colonnes rubriques">
      {rubriques.map((r) => (
        <li>
          <h3><a href={`/rubrique/${r.slug}/`}>{r.nom}</a></h3>
          <p class="sous-titre">{r.sousTitre}</p>
          {r.titres.length > 0 && (
            <ul class="titres">
              {r.presse.length ? r.presse.slice(0,3).map(n=><li><a href={n.lien} target="_blank" rel="noopener noreferrer">{n.titre}</a><span class="meta source-presse">{n.source} · presse</span></li>) : r.titres.map(({ data }) => <li><a href={data.chemin}>{data.titre}</a></li>)}
            </ul>
          )}
          <p class="tout"><a href={`/rubrique/${r.slug}/`}>Toute la rubrique</a><span class="meta volume">{r.total.toLocaleString('fr-FR')} articles d’archives{r.presse.length > 0 && ` · ${r.presse.length} nouvelles`}</span></p>
        </li>
      ))}
    </ul>
  </section>

  <section class="fonds" aria-labelledby="titre-fonds">
    <div class="titre-section">
      <h2 id="titre-fonds">Le fonds<small>{total} articles, année par année</small></h2>
      <a href="/archives/">Toutes les archives</a>
    </div>
    <ul class="annees">
      {annees.map(([an, n]) => (
        <li><a href={`/archives/${an}/`}><span class="an">{an}</span><span class="meta">{n.toLocaleString('fr-FR')}</span></a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .journal-intro { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.25rem 2rem; padding:1.25rem 0; border-bottom:1px solid var(--filet); }
  .journal-intro p { font-size:1.25rem; margin:0; font-style:italic; }
  .journal-intro a { flex-shrink:0; font-family:var(--sans); font-size:0.75rem; min-height:44px; display:inline-flex; align-items:center; gap:1rem; }
  .une { position:relative; isolation:isolate; overflow:hidden; display:grid; gap:2rem; min-height:34rem; padding:clamp(1.5rem,4vw,3rem); margin-top:2rem; grid-template-columns:minmax(0,1fr); background:var(--papier-2); }
  .une-fond { position:absolute; inset:0; z-index:-2; }
  .une-fond img { display:block; width:100%; height:100%; object-fit:cover; object-position:center 46%; filter:grayscale(1) contrast(1.05); }
  .une::before { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(90deg,color-mix(in srgb,var(--papier) 98%,transparent) 0%,color-mix(in srgb,var(--papier) 96%,transparent) 45%,color-mix(in srgb,var(--papier) 88%,transparent) 60%,color-mix(in srgb,var(--papier) 15%,transparent) 100%); }
  .credit-photo { grid-column:1/-1; align-self:end; justify-self:start; max-width:100%; margin:0; padding:0.4rem 0.6rem; background:var(--papier); font-size:0.6875rem; line-height:1.5; }
  .une-texte { min-width:0; max-width:36rem; align-self:center; }
  .une .meta { margin:0; display:flex; flex-wrap:wrap; gap:0.35rem 0.6rem; align-items:center; }
  .une h2 { font-size:clamp(2.4rem,5.4vw,4.5rem); line-height:1.04; letter-spacing:-0.025em; margin:1rem 0 1.25rem; text-wrap:balance; }
  .chapeau { font-size:1.25rem; line-height:1.5; color:var(--encre-2); margin:0; max-width:38rem; }
  .lecture { display:flex; flex-wrap:wrap; gap:0.75rem 1.5rem; align-items:center; margin-top:1.5rem; }
  .lire { display:inline-flex; align-items:center; gap:1.5rem; font-family:var(--sans); font-size:0.875rem; font-weight:700; min-height:44px; border-bottom:1px solid var(--encre); }
  @media (min-width:64rem) {
    .une { grid-template-columns:minmax(0,1.1fr) minmax(0,0.9fr); gap:2rem; align-items:center; margin-top:2.5rem; }
  }
  .colonnes { list-style:none; margin:0; padding:0; display:grid; gap:0 2rem; grid-template-columns:repeat(2,minmax(0,1fr)); }
  .colonnes > li { min-width:0; padding:1.5rem 0; border-bottom:1px solid var(--filet); }
  .colonnes .meta { margin:0; line-height:1.6; }
  .colonnes h3 { font-size:1.5rem; line-height:1.2; margin:0.6rem 0 0; text-wrap:pretty; }
  .derniers .principal { grid-row:span 3; padding-right:2rem; border-right:1px solid var(--filet); border-bottom:0; }
  .derniers .principal h3 { font-size:clamp(2rem,3.3vw,2.75rem); margin-top:0.75rem; line-height:1.1; }
  .derniers .apercu { color:var(--encre-2); font-size:1.125rem; line-height:1.6; margin:1rem 0 0; }
  .rubriques { column-gap:3.5rem; }
  .rubriques > li { padding:1.75rem 0 2rem; }
  .rubriques h3 { font-size:2rem; margin:0; }
  .sous-titre { margin:0.35rem 0 0; font-style:italic; color:var(--encre-2); }
  .titres { list-style:none; margin:1.25rem 0 0; padding:0; }
  .titres li { padding:0.65rem 0; border-top:1px solid var(--filet); line-height:1.4; font-size:1.125rem; }
  .source-presse, .volume { display:block; margin-top:0.3rem; font-size:0.6875rem; font-weight:400; }
  .tout { margin:0.75rem 0 0; font-family:var(--sans); font-size:0.75rem; font-weight:600; }
  .tout a { display:inline-flex; align-items:center; min-height:44px; color:var(--rouge); text-decoration:underline; text-underline-offset:0.3em; }
  .fonds { padding-bottom:1rem; }
  .annees { list-style:none; margin:1.5rem 0 0; padding:0; display:grid; gap:0 1.5rem; grid-template-columns:repeat(auto-fill,minmax(8rem,1fr)); }
  .annees a { display:flex; align-items:baseline; justify-content:space-between; gap:0.5rem; padding:1rem 0; min-height:44px; border-bottom:1px solid var(--filet); }
  .an { font-weight:500; font-size:2rem; line-height:1; font-variant-numeric:lining-nums; }
  @media (max-width:47.99rem) {
    .journal-intro { padding:0.75rem 0; }
    .journal-intro p { font-size:1.125rem; }
    .journal-intro a { font-size:0.6875rem; }
    .colonnes { grid-template-columns:minmax(0,1fr); }
    .derniers .principal { grid-row:auto; border-right:0; border-bottom:1px solid var(--filet); padding-right:0; }
    .rubriques h3 { font-size:1.75rem; }
    .une { min-height:0; padding:1.5rem; gap:1.5rem; }
    .une::before { background:color-mix(in srgb,var(--papier) 94%,transparent); }
    .une-fond img { object-position:65% center; }
    .annees { grid-template-columns:repeat(3,minmax(0,1fr)); gap:0 1.25rem; }
  }
</style>
