---
import Base from '../layouts/Base.astro';
import { photosArticles, illustrationNeutre } from '../lib/photos-articles.mjs';
import photoSalle from '../assets/salle-voltaire.webp';
import ListeArticles from '../components/ListeArticles.astro';
import { CULTURE } from '../lib/culture.mjs';
import { RUBRIQUES, rubrique } from '../lib/rubriques.mjs';
import { tousLesArticles, dateLongue } from '../lib/articles.mjs';
import { articleVisible } from '../lib/article-visible.mjs';

const articles = await tousLesArticles();
const maintenant = Date.now();
const articlesVerifies = articles.filter(({data}) => articleVisible(data, maintenant));
// Une même affaire ne doit pas occuper deux emplacements du carrousel.
// Les chroniques transversales sont écartées si elles reprennent une affaire
// déjà choisie. La sélection reste fondée sur des articles réellement publiés.
const affairesUne = [
  'zecler','heaulme','clement','safari','daubon','gomes','sollacaro',
  'ferreira','crepol','lourdes','inass','touloub','lyanna','piaget',
  'vannes','saint-junien','chateauneuf','manosque','luca'
];
const etiquettesUne = article => {
  const texte = (article.data.titre + ' ' + article.data.slug).toLocaleLowerCase('fr')
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  return affairesUne.filter(mot => texte.includes(mot));
};
const selectionUne = [];
const dejaUne = new Set();
const imagesUne = new Set([photoSalle.src]);
for (const article of articlesVerifies) {
  const etiquettes = etiquettesUne(article);
  if (etiquettes.some(mot => dejaUne.has(mot))) continue;
  const image = (photosArticles[article.data.chemin] ?? illustrationNeutre).image.src;
  if (imagesUne.has(image)) continue;
  imagesUne.add(image);
  selectionUne.push(article);
  etiquettes.forEach(mot => dejaUne.add(mot));
  if (selectionUne.length === 3) break;
}
// Sept dates civiles, aujourd’hui compris, selon l’heure de Paris.
const dateParis = new Intl.DateTimeFormat('fr-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit' });
const debutSemaine = new Date(dateParis.format(new Date()) + 'T00:00:00Z');
debutSemaine.setUTCDate(debutSemaine.getUTCDate() - 6);
const limiteRecente = debutSemaine.toISOString().slice(0, 10);
const [articlesRecents, articlesArchives] = articlesVerifies.filter(article => !selectionUne.includes(article))
  .reduce(([recents, anciens], article) => {
    const groupe = dateParis.format(article.data.date) >= limiteRecente ? recents : anciens;
    groupe.push(article);
    return [recents, anciens];
  }, [[], []]);
// Les chapeaux sont ceux de la rédaction : les cartes reprennent les extraits
// des articles vérifiés, sans résumé automatique depuis les flux de presse.
const dernieresPublications = articlesRecents.slice(0, 6);
const [archiveUne, ...derniers] = articlesArchives.slice(0, 4);
const vus = new Set([...selectionUne, ...dernieresPublications, archiveUne, ...derniers].filter(Boolean).map(a => a.data.slug));
const descriptionsRubriques = {
  'cours-du-jour': 'Le suivi des procès criminels et de leurs audiences.',
  'le-banc-des-jures': 'Les règles du procès, les jurés et les autres acteurs de l’audience.',
  'la-cour-se-leve': 'Des chroniques qui racontent les débats depuis la salle d’audience.',
  'delibere': 'Des réflexions et des points de vue sur la justice.',
  'l-expose': 'Des analyses pour comprendre les affaires et les décisions.',
  'le-greffe': 'Le cinéma, les livres et l’histoire de la justice.',
};
const rubriques = RUBRIQUES.map(r=>{
  const archives=articles.filter(a=>a.data.rubrique===r.slug);
  const titres = archives
    .filter(({data}) => articleVisible(data, maintenant) && !vus.has(data.slug))
    .slice(0, 2);
  return {...r,titres};
});
const repereUne = {
  '/proces-sollacaro-et-tout-recommence-aux-assises/11/2026/': 'Aix-en-Provence · Cour d’assises · Nouveau procès',
};
const articlesUne = selectionUne.map(({data}) => ({
  data,
  photo: photosArticles[data.chemin] ?? illustrationNeutre,
  repere: repereUne[data.chemin],
  titre: data.titre.replace(/ (?=[:;!?])/g, '\u00A0'),
}));
---
<Base accueil>
  <section class="ouverture" aria-labelledby="titre-accueil">
    <div class="cadre ouverture-interieur">
      <h1 id="titre-accueil" class="sr-only">Intime Conviction, le journal des cours d’assises</h1>
      {articlesUne.length > 0 && (
        <section class="une-editoriale" aria-labelledby="une-editoriale-titre">
          <div class="une-entete">
            <h2 id="une-editoriale-titre">À la une</h2>
            <a href="/agenda/">Agenda des assises</a>
          </div>
          <div class="une-editoriale-grille">
            <div class="une-reportages">
              {articlesUne.map(({data, photo, repere, titre}, i) => (
                <article class="article-redaction-une" id={`article-une-${i}`}>
                  <div class="une-couverture">
                    <img src={photo.image.src} width={photo.image.width} height={photo.image.height}
                      alt={photo.lieu} loading={i === 0 ? 'eager' : 'lazy'} decoding="async"
                      fetchpriority={i === 0 ? 'high' : undefined} />
                    <div class="une-edito">
                      <span class="une-rubrique">{rubrique(data.rubrique).libelle}</span>
                      {repere && <p class="repere-proces">{repere}</p>}
                      <h3><a href={data.chemin}>{titre}</a></h3>
                      {data.extrait && <p class="une-chapeau">{data.extrait}</p>}
                    </div>
                  </div>
                  <div class="une-credit">
                    <span><time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time> · Illustration</span>
                    <details><summary>Crédits photo</summary><span>{photo.lieu} · <a href={photo.source}>{photo.auteur}</a> · <a href={photo.lienLicence}>{photo.licence}</a></span></details>
                  </div>
                </article>
              ))}
            </div>
            {articlesUne.length > 1 && (
              <aside class="une-sommaire" aria-label="Les articles à la une" hidden>
                <div class="une-sommaire-entete">
                  <h3>Dans cette édition</h3>
                  <button class="une-pause" type="button" aria-pressed="false" aria-label="Suspendre le défilement automatique" title="Suspendre le défilement automatique">
                    <svg class="pause-icone" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9m5-9v9" fill="none" stroke="currentColor" stroke-width="1.75"/></svg>
                    <svg class="lecture-icone" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="m5 3 8 5-8 5z" fill="currentColor"/></svg>
                  </button>
                </div>
                <ul>
                  {articlesUne.map(({data, titre}, i) => (
                    <li><button type="button" class="une-choix" aria-controls={`article-une-${i}`} aria-pressed={i === 0}>
                      <span>{rubrique(data.rubrique).libelle}</span>
                      <strong>{titre}</strong>
                    </button></li>
                  ))}
                </ul>
              </aside>
            )}
          </div>
        </section>
      )}
    </div>
  </section>

  <div class="surface-lecture"><div class="cadre journal-corps">
    <div class="fil-du-journal">
      {dernieresPublications.length > 0 && (
        <section class="dernieres-publications" aria-labelledby="titre-dernieres-publications">
          <div class="selection-entete">
            <h2 id="titre-dernieres-publications">À lire dans le journal</h2>
            <a href="/rubrique/cours-du-jour/#articles-redaction">Voir tous les articles de la rédaction</a>
          </div>
          <ListeArticles articles={dernieresPublications} rubriqueVisible={false} illustres imagesExclues={[...imagesUne]} />
        </section>
      )}
    </div>

    <nav class="selection-entete" aria-label="Repères du journal">
      <a href="/dossiers/">Grandes affaires</a>
      <a href="/agenda/">Calendrier des audiences</a>
    </nav>
    <section class="guide-assises" aria-labelledby="titre-guide-assises">
      <figure>
        <img src={photoSalle.src} width={photoSalle.width} height={photoSalle.height}
          alt="Le banc de la cour dans la salle Voltaire, à Paris" loading="lazy" decoding="async" />
        <figcaption>Salle Voltaire, Paris · <a href="https://commons.wikimedia.org/wiki/File:Palais_de_justice_de_Paris_-_salle_Voltaire_(cour_d%27assises).jpg">Tiraden</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · cadrée</figcaption>
      </figure>
      <div class="guide-assises-texte">
        <h2 id="titre-guide-assises">Comprendre les assises</h2>
        <p>Qui siège à la cour ? Dans quel ordre parle-t-on ? Comment se prend la décision ?</p>
        <ul>
          <li><a href="/comprendre/">Le déroulement du procès <span aria-hidden="true">→</span></a></li>
          <li><a href="/rubrique/le-banc-des-jures/">Les jurés et les acteurs du procès <span aria-hidden="true">→</span></a></li>
          <li><a href="/assister/">Préparer sa première audience <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </section>

    {archiveUne && (
      <section class="selection" aria-labelledby="titre-selection">
        <div class="selection-entete">
          <h2 id="titre-selection">Les archives du journal</h2>
          <a href="/archives/">Archives du journal <span aria-hidden="true">→</span></a>
        </div>
        <div class:list={['selection-grille', { 'selection-grille-simple': derniers.length === 0 }]}>
          <article class="archive-vedette">
            <a href={archiveUne.data.chemin} aria-labelledby="titre-archive-vedette">
              <div class="archive-vedette-entete">
                <h3 id="titre-archive-vedette">{archiveUne.data.titre}</h3>
              </div>
              <p class="archive-vedette-meta">
                <span>{rubrique(archiveUne.data.rubrique).libelle}</span>
                <time datetime={archiveUne.data.date.toISOString()}>{dateLongue(archiveUne.data.date)}</time>
              </p>
              <p class="archive-vedette-extrait">{archiveUne.data.extrait}</p>
            </a>
          </article>
          {derniers.length > 0 && (
            <div class="selection-suite">
              <h3>Autres articles à relire</h3>
              <ul>
                {derniers.map(({data}) => (
                  <li>
                    <a href={data.chemin}>
                      <div>
                        <h4>{data.titre}</h4>
                        <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
                      </div>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="greffe-accueil" aria-labelledby="titre-culture">
      <div class="greffe-accueil-entete">
        <div>
          <h2 id="titre-culture">Livres, films et histoire</h2>
        </div>
        <a href="/rubrique/le-greffe/">Voir les livres et les films <span aria-hidden="true">→</span></a>
      </div>
      <ul class="greffe-accueil-cartes">
        {CULTURE.map(({slug, genre, auteur, titre, extrait}) => (
          <li>
            <a href={`/culture/${slug}/`} aria-labelledby={`greffe-accueil-${slug}`} aria-describedby={`greffe-extrait-${slug}`}>
              <p class="greffe-accueil-genre">{genre}</p>
              <h3 id={`greffe-accueil-${slug}`}>{titre}</h3>
              <p class="greffe-accueil-auteur">{auteur}</p>
              <p class="greffe-accueil-extrait" id={`greffe-extrait-${slug}`}>{extrait}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="videos-accueil" aria-labelledby="titre-videos-accueil">
      <div class="selection-entete">
        <h2 id="titre-videos-accueil">À voir et à écouter</h2>
        <a href="/culture/videos/">Toutes les vidéos <span aria-hidden="true">→</span></a>
      </div>
      <a class="video-accueil-lien" href="/culture/videos/">
        <span class="video-accueil-icone" aria-hidden="true">▶</span>
        <span><strong>Justice en France : les meilleures audiences au tribunal</strong><small>Une sélection de vidéos judiciaires · Source extérieure : YouTube</small></span>
        <span class="video-accueil-fleche" aria-hidden="true">→</span>
      </a>
    </section>

    <section class="univers" aria-labelledby="titre-rubriques">
      <h2 id="titre-rubriques">Dans le journal</h2>
      <ul class="rubriques">
        {rubriques.map(r => (
          <li class="rubrique-carte">
            <h3>
              <a href={`/rubrique/${r.slug}/`}>{r.libelle}<span aria-hidden="true">→</span></a>
            </h3>
            <p class="rubrique-description">{descriptionsRubriques[r.slug] ?? r.sousTitre}</p>
          </li>
        ))}
      </ul>
    </section>

    <nav class="outils-accueil" aria-label="Explorer le fonds judiciaire">
      <h2>Explorer le fonds judiciaire</h2>
      <ul>
        <li><a href="/chronologie/">Chronologie des affaires <span aria-hidden="true">→</span></a></li>
        <li><a href="/carte/">Carte des affaires <span aria-hidden="true">→</span></a></li>
        <li><a href="/annuaire/#repertoire">Annuaire des juridictions <span aria-hidden="true">→</span></a></li>
        <li><a href="/archives/presse/">Archives de presse <span aria-hidden="true">→</span></a></li>
      </ul>
    </nav>

  </div></div>
</Base>
<script>
  const carrousel = document.querySelector('.une-editoriale');
  const articles = [...(carrousel?.querySelectorAll<HTMLElement>('.article-redaction-une') ?? [])];
  const sommaire = carrousel?.querySelector<HTMLElement>('.une-sommaire');
  const choix = [...(sommaire?.querySelectorAll<HTMLButtonElement>('.une-choix') ?? [])];
  const pause = sommaire?.querySelector<HTMLButtonElement>('.une-pause');

  if (carrousel && sommaire && pause && articles.length > 1) {
    const mouvement = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let survol = false;
    let focus = false;
    let suspendu = false;
    let timer: number | undefined;

    function afficher(position: number) {
      index = position;
      articles.forEach((article, i) => { article.hidden = i !== index; });
      choix.forEach((bouton, i) => bouton.setAttribute('aria-pressed', String(i === index)));
    }

    function reglerDefilement() {
      window.clearInterval(timer);
      pause!.hidden = mouvement.matches;
      if (!mouvement.matches && !survol && !focus && !suspendu && !document.hidden) {
        timer = window.setInterval(() => afficher((index + 1) % articles.length), 9000);
      }
    }

    choix.forEach((bouton, i) => bouton.addEventListener('click', () => {
      afficher(i);
      const article = articles[i];
      if (article.getBoundingClientRect().bottom < 0) {
        article.scrollIntoView({ block: 'start' });
      }
      article.querySelector('h3 a')?.focus({ preventScroll: true });
    }));
    pause.addEventListener('click', () => {
      suspendu = !suspendu;
      pause.setAttribute('aria-pressed', String(suspendu));
      pause.title = suspendu ? 'Reprendre le défilement automatique' : 'Suspendre le défilement automatique';
      reglerDefilement();
    });
    carrousel.addEventListener('mouseenter', () => { survol = true; reglerDefilement(); });
    carrousel.addEventListener('mouseleave', () => { survol = false; reglerDefilement(); });
    carrousel.addEventListener('focusin', () => { focus = true; reglerDefilement(); });
    carrousel.addEventListener('focusout', event => {
      if (!(event.relatedTarget instanceof Node) || !carrousel.contains(event.relatedTarget)) {
        focus = false;
        reglerDefilement();
      }
    });
    mouvement.addEventListener('change', reglerDefilement);
    document.addEventListener('visibilitychange', reglerDefilement);
    afficher(0);
    sommaire.hidden = false;
    carrousel.classList.add('une-interactive');
    reglerDefilement();
  }
</script>

<style>
.videos-accueil{margin:2rem 0;padding:1rem 0;border-top:2px solid var(--filet);border-bottom:1px solid var(--filet)}
.video-accueil-lien{display:flex;gap:1.5rem;align-items:center;padding:1.4rem;background:var(--anthracite-journal);color:#fff;text-decoration:none;margin-top:1.5rem}
.video-accueil-lien:hover,.video-accueil-lien:focus-visible{color:#eeebe6}
.video-accueil-icone{display:grid;place-items:center;flex-shrink:0;width:3.3rem;height:3.3rem;background:#eeebe6;color:var(--anthracite-journal);border-radius:50%;font-size:1.2rem}
.video-accueil-lien strong{display:block;font:800 clamp(1rem,2vw,1.4rem)/1.35 var(--sans)}
.video-accueil-lien small{display:block;font:500 .78rem/1.5 var(--sans);color:#ccc;margin-top:.5rem}
.video-accueil-fleche{margin-left:auto;font-size:1.4rem}
@media(max-width:650px){.video-accueil-lien{gap:.9rem;padding:1rem}.video-accueil-icone{width:2.6rem;height:2.6rem}}

  .ouverture, .surface-lecture { background: var(--papier-journal); color: var(--encre-journal); }
  .ouverture-interieur { padding-top: clamp(1.2rem, 3vw, 2.75rem); }
  .journal-corps { padding-bottom: 3rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .une-entete { display: flex; justify-content: space-between; align-items: center; gap: .75rem; margin-bottom: .9rem; border-bottom: 1px solid var(--filet-journal); }
  .une-entete h2 { margin: 0; padding: 0 0 .2rem; font: 630 clamp(2.55rem, 5.6vw, 5rem)/1 var(--serif); letter-spacing: -.065em; }
  .une-entete > a { display: flex; align-items: center; min-height: 44px; color: var(--rouge-journal); font: 700 .8rem/1.25 var(--sans); text-align: end; }
  .une-editoriale a:hover { text-decoration: underline; text-underline-offset: .16em; }
  .une-interactive .une-editoriale-grille { display: grid; grid-template-columns: minmax(0, 2.6fr) minmax(0, 1fr); gap: 1.15rem; align-items: start; }
  .une-reportages { min-width: 0; }
  .article-redaction-une:not([hidden]) + .article-redaction-une:not([hidden]) { margin-top: 1.25rem; }
  .une-interactive .article-redaction-une { margin: 0; }
  .une-couverture { position: relative; isolation: isolate; display: flex; align-items: end; min-height: clamp(26rem, 43vw, 35rem); overflow: hidden; background: #252628; color: #fff; }
  .une-couverture img, .une-couverture::after { position: absolute; inset: 0; width: 100%; height: 100%; }
  .une-couverture img { z-index: -2; object-fit: cover; object-position: center 46%; }
  .une-couverture::after { z-index: -1; content: ""; background: linear-gradient(0deg, #18191a 0%, #18191ae8 20%, #18191aa6 56%, #18191a12 90%); }
  .une-edito { width: 100%; padding: clamp(1.3rem, 4vw, 3.3rem); }
  .une-rubrique { display: inline-block; padding: .42rem .62rem; background: var(--rouge-journal); font: 700 .72rem/1.25 var(--sans); letter-spacing: .035em; text-transform: uppercase; }
  .une-edito h3 { margin: .65rem 0 .4rem; max-width: 24ch; font: 630 clamp(2.1rem, 4.7vw, 4.45rem)/.99 var(--serif); letter-spacing: -.046em; text-wrap: balance; }
  .une-edito a:hover { color: #fff; }
  .une-edito a:focus-visible { outline-color: #fff; }
  .une-chapeau { max-width: 58ch; margin: .85rem 0 0; font: 470 clamp(.95rem, 1.35vw, 1.07rem)/1.55 var(--sans); color: #fffaf4; }
  .repere-proces { margin: .55rem 0 0; font: 650 .8rem/1.4 var(--sans); }
  .une-credit { display: flex; justify-content: space-between; align-items: baseline; gap: .4rem 1rem; padding: .55rem 0; color: #5a4c4e; font: 500 .73rem/1.45 var(--sans); }
  .une-credit time { flex: 0 0 auto; }
  .une-credit details { text-align: end; }
  .une-credit summary { cursor: pointer; text-underline-offset: .2em; text-decoration: underline; }
  .une-credit details span { display: block; margin-top: .35rem; }
  .une-credit details a { text-decoration: underline; }
  .une-sommaire { min-width: 0; background: var(--surface-journal); border-top: 3px solid var(--rouge-journal); }
  .une-sommaire-entete { display: flex; justify-content: space-between; align-items: center; gap: .5rem; padding: .35rem .7rem .35rem 1.05rem; }
  .une-sommaire-entete h3 { margin: 0; color: var(--rouge-journal); font: 720 .78rem/1.25 var(--sans); letter-spacing: .09em; text-transform: uppercase; }
  .une-pause { display: grid; place-items: center; min-width: 44px; min-height: 44px; padding: 0; color: var(--rouge-journal); border: 0; background: transparent; }
  .une-pause:hover { color: #fff; background: var(--rouge-journal); }
  .une-pause[hidden], .une-pause .lecture-icone, .une-pause[aria-pressed="true"] .pause-icone { display: none; }
  .une-pause[aria-pressed="true"] .lecture-icone { display: block; }
  .une-sommaire ul { margin: 0; padding: 0; list-style: none; }
  .une-sommaire li { border-top: 1px solid var(--filet-journal); }
  .une-choix { width: 100%; padding: .9rem .9rem .9rem 1rem; border: 0; border-inline-start: 3px solid transparent; background: transparent; color: var(--encre-journal); text-align: start; text-transform: none; }
  .une-choix[aria-pressed="true"] { display: none; }
  .une-choix:hover { border-inline-start-color: var(--rouge-journal); background: var(--papier-journal); }
  .une-sommaire button:focus-visible { outline: 2px solid var(--rouge-journal); outline-offset: -3px; }
  .une-choix span { display: block; margin-bottom: .38rem; color: var(--rouge-journal); font: 690 .72rem/1.3 var(--sans); }
  .une-choix strong { display: block; font: 630 clamp(1.22rem, 1.75vw, 1.62rem)/1.12 var(--serif); letter-spacing: -.016em; }
  @media (max-width: 59.99rem) {
    .une-interactive .une-editoriale-grille { grid-template-columns: minmax(0, 1fr); gap: .65rem; }
    .une-sommaire ul { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
    .une-sommaire li + li { border-inline-start: 1px solid var(--filet-journal); }
    .une-choix { height: 100%; }
  }
  @media (max-width: 37rem) {
    .une-entete > a { display: none; }
    .une-couverture { display: block; min-height: 0; padding-top: 60%; }
    .une-couverture img { bottom: auto; height: auto; aspect-ratio: 5/3; }
    .une-couverture::after { bottom: auto; height: auto; aspect-ratio: 5/3; background: linear-gradient(0deg, #252628, #25262800 44%); }
    .une-edito { position: relative; margin-top: -1.2rem; padding: 0 1.05rem 1.25rem; }
    .une-edito h3 { max-width: none; text-wrap: pretty; }
    .une-sommaire ul { display: block; }
    .une-sommaire li + li { border-inline-start: 0; }
