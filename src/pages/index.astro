---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photoBlois from '../assets/blois.webp';
import photoParis from '../assets/rue-de-la-paix.webp';
import photoPoissy from '../assets/poissy.webp';
import photoSalle from '../assets/salle-voltaire.webp';
import photoTribunal from '../assets/tribunal-paris.webp';
import AgendaEnBref from '../components/AgendaEnBref.astro';
import Culture from '../components/Culture.astro';
import { lireVeille } from '../lib/veille.mjs';
import { RUBRIQUES, rubrique } from '../lib/rubriques.mjs';
import { DOSSIERS, referencesPourDossier } from '../lib/dossiers.mjs';
import { tousLesArticles, dateLongue, minutesDeLecture } from '../lib/articles.mjs';

const articles = await tousLesArticles();
const veille = await lireVeille();
const articlesCarrousel = articles.slice(0, 3);
const [archiveUne,...archivesSuite] = articles.slice(3);
const derniers = archivesSuite.slice(0,3);
const vus = new Set([...articlesCarrousel,archiveUne,...derniers].filter(Boolean).map(a=>a.data.slug));
const rubriques = RUBRIQUES.map(r=>{
  const archives=articles.filter(a=>a.data.rubrique===r.slug);
  return {...r,total:archives.length,titres:archives.filter(a=>!vus.has(a.data.slug)).slice(0,2)};
});
const dossiersMisEnAvant = DOSSIERS.map(d => ({...d, nombre:referencesPourDossier(d, veille.articles).length})).filter(d=>d.nombre>0).slice(0,4);
const total=articles.length.toLocaleString('fr-FR');
const reperes = [
  { href: '/agenda/', titre: 'Agenda des sessions' },
  { href: '/comprendre/', titre: 'Comprendre le procès' },
  { href: '/annuaire/', titre: 'Trouver une cour' },
  { href: '/dossiers/', titre: 'Dossiers judiciaires' },
  { href: '/archives/', titre: `${total} articles d’archives` },
];
const photoPalaisBlois = {
  image: photoBlois, lieu: 'Palais de justice de Blois', auteur: 'Chabe01',
  source: 'https://commons.wikimedia.org/wiki/File:Palais_Justice_-_Blois_(FR41)_-_2022-07-16_-_1.jpg',
  licence: 'CC BY-SA 4.0', lienLicence: 'https://creativecommons.org/licenses/by-sa/4.0/',
};
// Lier les photos au lieu évoqué dans l’article, indépendamment de sa position.
const photosCarrousel = {
  '/inass-touloub-a-blois-le-poids-des-trente-neuf-annees/11/2026/': photoPalaisBlois,
  '/piaget-le-braqueur-au-borsalino-revient-devant-les-assises/11/2026/': {
    image: photoParis, lieu: 'Rue de la Paix, Paris', auteur: 'Mustang Joe',
    source: 'https://commons.wikimedia.org/wiki/File:Rue_de_la_Paix_(5999837542).jpg',
    licence: 'CC0', lienLicence: 'https://creativecommons.org/publicdomain/zero/1.0/',
  },
  '/mort-dolivio-gomes-le-proces-en-appel-du-policier-souvre-a-nanterre/11/2026/': {
    image: photoPoissy, lieu: 'Hôtel de ville de Poissy', auteur: 'Chabe01',
    source: 'https://commons.wikimedia.org/wiki/File:Hôtel_Ville_-_Poissy_(FR78)_-_2025-07-12_-_3.jpg',
    licence: 'CC BY-SA 4.0', lienLicence: 'https://creativecommons.org/licenses/by-sa/4.0/',
  },
};
const photosIllustration = [
  {
    image: photoTribunal, lieu: 'Tribunal de Paris', auteur: 'Coppertarzan',
    source: 'https://commons.wikimedia.org/wiki/File:Tribunal_de_Paris_seen_from_Batignolles_park.jpg',
    licence: 'CC0', lienLicence: 'https://creativecommons.org/publicdomain/zero/1.0/',
  },
  {
    image: photoSalle, lieu: 'Salle Voltaire, Paris', auteur: 'Tiraden',
    source: 'https://commons.wikimedia.org/wiki/File:Palais_de_justice_de_Paris_-_salle_Voltaire_(cour_d%27assises).jpg',
    licence: 'CC BY-SA 4.0', lienLicence: 'https://creativecommons.org/licenses/by-sa/4.0/',
  },
  photoPalaisBlois,
];
const photosReservees = new Set(articlesCarrousel.map(({data}) => photosCarrousel[data.chemin]));
const photosDisponibles = photosIllustration.filter(photo => !photosReservees.has(photo));
const cartesCarrousel = await Promise.all(articlesCarrousel.map(async ({data}) => {
  const photoArticle = photosCarrousel[data.chemin];
  const photo = photoArticle ?? photosDisponibles.shift();
  const { image } = photo;
  // Portrait 3:4 sur téléphone, avec des variantes adaptées à la définition de l’écran.
  const largeur = Math.floor(Math.min(image.width, image.height * .75, 720) / 3) * 3;
  const portrait = await getImage({
    src: image,
    width: largeur,
    height: largeur * 4 / 3,
    widths: [360, 540].filter(taille => taille < largeur).concat(largeur),
    fit: 'cover',
    format: 'webp',
    quality: 76,
  });
  return { data, photo, illustration: !photoArticle, portrait };
}));
---
<Base accueil>
  <section class="ouverture" aria-labelledby="titre-accueil">
    <div class="cadre ouverture-interieur">
      <h1 id="titre-accueil" class="sr-only">Intime Conviction, le journal des cours d’assises</h1>
      {articlesCarrousel.length > 0 && (
        <section class="articles-carrousel" aria-label="Articles à la une" data-editorial-carousel>
          <div class="articles-carrousel-tete">
            <p>À LA UNE</p>
            <div class="articles-carrousel-outils" aria-label="Navigation dans les articles">
              <span data-editorial-position aria-live="polite">01 / {String(articlesCarrousel.length).padStart(2,'0')}</span>
              <button type="button" data-editorial-prev aria-label="Article précédent">←</button>
              <button type="button" data-editorial-next aria-label="Article suivant">→</button>
              <button type="button" data-editorial-toggle aria-label="Mettre le défilement automatique en pause" aria-pressed="false" title="Mettre en pause">Ⅱ</button>
            </div>
          </div>
          <div class="articles-carrousel-piste" data-editorial-track tabindex="0" aria-label="Articles de la rédaction à faire défiler">
            {cartesCarrousel.map(({data, photo, illustration, portrait},i) => {
              const { image } = photo;
              return (
                <article class="article-redaction-une" aria-label={`Article ${i+1} sur ${articlesCarrousel.length}`}>
                  <picture class="article-redaction-fond" aria-hidden="true">
                    <source media="(max-width: 520px)" srcset={portrait.srcSet.attribute} sizes="calc(100vw - 2.5rem)" />
                    <img
                      src={image.src}
                      alt=""
                      width={image.width}
                      height={image.height}
                      loading={i===0?'eager':'lazy'}
                      fetchpriority={i===0?'high':undefined}
                      decoding="async"
                    />
                  </picture>
                  <p class="article-redaction-credit">
                    {illustration && 'Illustration · '}{photo.lieu} · <a href={photo.source}>{photo.auteur}</a> · <a href={photo.lienLicence}>{photo.licence}</a> · cadrée
                  </p>
                  <div class="article-redaction-une-texte">
                    <p class="article-redaction-une-kicker">LE JOURNAL / {String(i+1).padStart(2,'0')}</p>
                    <p class="article-redaction-une-date"><time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time> · {rubrique(data.rubrique).nom}</p>
                    <h2><a href={data.chemin}>{data.titre}</a></h2>
                    <p class="article-redaction-une-extrait">{data.extrait}</p>
                    <a class="article-redaction-une-lien" href={data.chemin}>Lire l’article <span aria-hidden="true">↗</span></a>
                  </div>
                </article>
              );
            })}
          </div>
          <div class="articles-carrousel-reperes" aria-label="Choisir un article">
            {articlesCarrousel.map((_,i)=><button type="button" data-editorial-dot={i} aria-label={`Afficher l’article ${i+1}`} aria-current={i===0?'true':undefined}>{String(i+1).padStart(2,'0')}</button>)}
          </div>
        </section>
      )}
      <div class="outils-accueil">
        <form class="accueil-recherche" action="/recherche/" method="get" role="search" aria-labelledby="titre-recherche-accueil">
          <label id="titre-recherche-accueil" for="recherche-accueil">Retrouver un article ou une affaire</label>
          <div class="accueil-recherche-champs">
            <input id="recherche-accueil" type="search" name="q" placeholder="Nom ou mot-clé" autocomplete="off" />
            <button type="submit">Rechercher</button>
          </div>
        </form>
        <nav class="parcours" aria-labelledby="titre-reperes-accueil">
          <h2 id="titre-reperes-accueil">Repères</h2>
          <ul>
            {reperes.map(({href, titre}) => (
              <li><a href={href}>{titre}<span aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <div class="surface-lecture"><div class="cadre journal-corps">
    <AgendaEnBref />


    <section class="accueil-dossiers" aria-labelledby="titre-dossiers-accueil">
      <div class="accueil-dossiers-entete">
        <h2 id="titre-dossiers-accueil">Dossiers judiciaires</h2>
        <p>Retrouver, affaire par affaire, les références et les liens vers les publications de presse.</p>
      </div>
      {dossiersMisEnAvant.length > 0 && (
        <ul class="accueil-dossiers-grille">
          {dossiersMisEnAvant.map(d => (
            <li>
              <a href={`/dossiers/${d.slug}/`} aria-labelledby={`accueil-dossier-${d.slug}`} aria-describedby={`accueil-dossier-repere-${d.slug}`}>
                <div class="accueil-dossiers-titre">
                  <h3 id={`accueil-dossier-${d.slug}`}>{d.titre}</h3>
                  <span aria-hidden="true">↗</span>
                </div>
                <p id={`accueil-dossier-repere-${d.slug}`}>{d.presentation}</p>
                <span class="accueil-dossiers-total">
                  {d.nombre.toLocaleString('fr-FR')} {d.nombre === 1 ? 'référence de presse' : 'références de presse'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      <div class="accueil-dossiers-liens">
        <a href="/dossiers/">Tous les dossiers <span aria-hidden="true">↗</span></a>
        <a href="/chronologie/">Chronologie judiciaire <span aria-hidden="true">↗</span></a>
      </div>
    </section>


    {archiveUne && (
      <section class="selection" aria-labelledby="titre-selection">
        <div class="selection-entete">
          <h2 id="titre-selection">À relire dans nos archives</h2>
          <a href="/archives/">Toutes les archives <span aria-hidden="true">↗</span></a>
        </div>
        <div class:list={['selection-grille', { 'selection-grille-simple': derniers.length === 0 }]}>
          <article class="archive-vedette">
            <a href={archiveUne.data.chemin} aria-labelledby="titre-archive-vedette">
              <div class="archive-vedette-entete">
                <h3 id="titre-archive-vedette">{archiveUne.data.titre}</h3>
                <img src={`/illustrations/${archiveUne.data.rubrique}.svg`} alt="" width="640" height="520" loading="lazy" decoding="async" />
              </div>
              <p class="archive-vedette-meta">
                <span>{rubrique(archiveUne.data.rubrique).nom}</span>
                <time datetime={archiveUne.data.date.toISOString()}>{dateLongue(archiveUne.data.date)}</time>
              </p>
              <p class="archive-vedette-extrait">{archiveUne.data.extrait}</p>
              <p class="archive-vedette-lire">
                <span>Lire l’article <span aria-hidden="true">↗</span></span>
                <span>{minutesDeLecture(archiveUne.data.mots)} min de lecture</span>
              </p>
            </a>
          </article>
          {derniers.length > 0 && (
            <div class="selection-suite">
              <h3>Autres articles à relire</h3>
              <ul>
                {derniers.map(({data}) => (
                  <li>
                    <a href={data.chemin}>
                      <div>
                        <h4>{data.titre}</h4>
                        <time datetime={data.date.toISOString()}>{dateLongue(data.date)}</time>
                      </div>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <Culture />

    <section class="univers" aria-labelledby="titre-rubriques">
      <div class="titre-section"><h2 id="titre-rubriques">LES SIX RUBRIQUES <span>DU JOURNAL.</span></h2></div>
      <ul class="rubriques">{rubriques.map(r=><li>
        <div class="rubrique-entete"><h3><a href={`/rubrique/${r.slug}/`}>{r.nom}</a></h3><a class="ouvrir-rubrique" href={`/rubrique/${r.slug}/`} aria-label={`Ouvrir ${r.nom}`}><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div>
        <p class="sous-titre">{r.sousTitre}</p>
        <ul class="titres">{r.titres.map(({data})=><li><a href={data.chemin}>{data.titre}</a><span class="meta source-presse">Intime Conviction · archive</span></li>)}</ul>
        <a class="rubrique-volume" href={`/rubrique/${r.slug}/`}>{r.total.toLocaleString('fr-FR')} articles d’archives</a>
      </li>)}</ul>
    </section>

    <nav class="archives-passerelle" aria-label="Consulter les collections">
      <div><span>LES COLLECTIONS</span><strong>Retrouver les publications et les références</strong><p>Les archives du journal et les références de la presse extérieure sont consultables séparément.</p></div>
      <div><a href="/archives/">Archives du journal ↗</a><a href="/archives/presse/">Revue de presse ↗</a></div>
    </nav>

  </div></div>
</Base>
<script>
  const carrousel = document.querySelector('[data-editorial-carousel]');
  if (carrousel) {
    const piste = carrousel.querySelector('[data-editorial-track]');
    const diapositives = [...piste.querySelectorAll('.article-redaction-une')];
    const reperes = [...carrousel.querySelectorAll('[data-editorial-dot]')];
    const position = carrousel.querySelector('[data-editorial-position]');
    const boutonPause = carrousel.querySelector('[data-editorial-toggle]');
    const mouvementReduit = window.matchMedia('(prefers-reduced-motion: reduce)');
    const DELAI = 8000;
    let actif = 0;
    let minuteur = null;
    let suspenduSurvol = false;
    let suspenduFocus = false;
    let suspenduToucher = false;
    let pauseDemandee = mouvementReduit.matches;

    const afficher = (index, defiler = true) => {
      actif = (index + diapositives.length) % diapositives.length;
      reperes.forEach((repere,i) => {
        if (i === actif) repere.setAttribute('aria-current','true');
        else repere.removeAttribute('aria-current');
      });
      position.textContent = String(actif+1).padStart(2,'0')+' / '+String(diapositives.length).padStart(2,'0');
      if (defiler) piste.scrollTo({
        left:diapositives[actif].offsetLeft,
        behavior:mouvementReduit.matches?'instant':'smooth'
      });
    };

    const actualiserBouton = () => {
      const enPause = pauseDemandee || mouvementReduit.matches;
      boutonPause.setAttribute('aria-pressed',String(enPause));
      boutonPause.setAttribute('aria-label',enPause?'Relancer le défilement automatique':'Mettre le défilement automatique en pause');
      boutonPause.title = enPause?'Relancer le défilement':'Mettre en pause';
      boutonPause.textContent = enPause?'▶':'Ⅱ';
    };
    const arreter = () => {
      if (minuteur !== null) { window.clearInterval(minuteur); minuteur = null; }
    };
    const synchroniser = () => {
      arreter();
      actualiserBouton();
      if (diapositives.length < 2 || pauseDemandee || mouvementReduit.matches ||
          suspenduSurvol || suspenduFocus || suspenduToucher || document.hidden) return;
      minuteur = window.setInterval(() => afficher(actif+1), DELAI);
    };
    const naviguer = index => { afficher(index); synchroniser(); };

    carrousel.querySelector('[data-editorial-prev]')?.addEventListener('click',()=>naviguer(actif-1));
    carrousel.querySelector('[data-editorial-next]')?.addEventListener('click',()=>naviguer(actif+1));
    reperes.forEach((repere,i)=>repere.addEventListener('click',()=>naviguer(i)));
    boutonPause.addEventListener('click',()=>{pauseDemandee=!pauseDemandee;synchroniser();});

    carrousel.addEventListener('mouseenter',()=>{suspenduSurvol=true;synchroniser();});
    carrousel.addEventListener('mouseleave',()=>{suspenduSurvol=false;synchroniser();});
    carrousel.addEventListener('focusin',()=>{suspenduFocus=true;synchroniser();});
    carrousel.addEventListener('focusout',event=>{
      if (event.relatedTarget instanceof Node && carrousel.contains(event.relatedTarget)) return;
      suspenduFocus=false;synchroniser();
    });
    piste.addEventListener('touchstart',()=>{suspenduToucher=true;synchroniser();},{passive:true});
    piste.addEventListener('touchend',()=>{suspenduToucher=false;synchroniser();},{passive:true});
    piste.addEventListener('touchcancel',()=>{suspenduToucher=false;synchroniser();},{passive:true});
    document.addEventListener('visibilitychange',synchroniser);
    mouvementReduit.addEventListener('change',event=>{pauseDemandee=event.matches;synchroniser();});

    let raf=0;
    piste.addEventListener('scroll',()=>{
      cancelAnimationFrame(raf);
      raf=requestAnimationFrame(()=>{
        const centre=piste.scrollLeft + piste.clientWidth/2;
        let index=0, distance=Infinity;
        diapositives.forEach((slide,i)=>{
          const ecart=Math.abs(slide.offsetLeft+slide.clientWidth/2-centre);
          if(ecart<distance){distance=ecart;index=i;}
        });
        afficher(index,false);
      });
    },{passive:true});
    afficher(0,false);
    synchroniser();
  }
</script>
<style>
  .ouverture{background:var(--papier);color:var(--encre);padding-top:0}.ouverture-interieur{padding-top:1.1rem;padding-bottom:0}h1{font-size:clamp(2.15rem,3.6vw,3.25rem);line-height:1.04;font-weight:600;letter-spacing:-.035em;margin:0;max-width:22ch}h1 a:hover{color:#fff;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.15em}
  .surface-lecture{background:color-mix(in srgb,var(--papier) 97%,transparent)}.journal-corps{padding-top:.1rem;padding-bottom:4rem}.journal-corps :global(.titre-section){margin-top:3.5rem}
  .univers h2{font-weight:600}.univers h2 br{display:none}.univers h2 em{font-style:normal}.rubriques{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));counter-reset:rubrique;gap:1rem}.rubriques>li{counter-increment:rubrique;min-width:0;padding:1.5rem;background:var(--papier-2);border-top:3px solid var(--encre)}.rubriques>li::before{content:'0' counter(rubrique);display:block;font:500 .65rem/1 var(--sans);color:var(--rouge);margin-bottom:1.75rem}.rubrique-entete{display:flex;justify-content:space-between;align-items:start;gap:.5rem}.rubrique-entete h3{font-weight:600;font-size:1.9rem;line-height:1.05;margin:0}.ouvrir-rubrique{min-height:44px;min-width:44px;display:flex;align-items:center;justify-content:center}.sous-titre{font:400 .65rem/1.6 var(--sans);color:var(--encre-2);margin:.6rem 0 1.25rem}.titres{list-style:none;padding:0;margin:0}.titres li{border-top:1px solid var(--filet);padding:.75rem 0;font-size:1rem;line-height:1.35}.source-presse{display:block;margin-top:.4rem;font-size:.55rem}.rubrique-volume{display:flex;align-items:center;min-height:44px;font:600 .6rem/1.5 var(--sans);margin-top:.4rem}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  @media(max-width:63.99rem){h1{font-size:2.3rem}.rubriques{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:47.99rem){h1{font-size:2.2rem;max-width:23ch}.rubriques{grid-template-columns:1fr}.rubriques>li{padding:1.25rem}.rubriques>li::before{margin-bottom:1.25rem}.journal-corps :global(.titre-section){margin-top:2.8rem}}

/* Nouvelle direction artistique : la une des assises */
.ouverture{background:#f1ede5;color:#171716}
.surface-lecture{background:#f8f5ef}
.journal-corps{padding-top:1.5rem}
.rubriques{gap:0;border-top:1px solid #c8c0b5;border-left:1px solid #c8c0b5}
.rubriques>li{background:#f2ede4;border:0;border-right:1px solid #c8c0b5;border-bottom:1px solid #c8c0b5;padding:2rem;min-height:300px;transition:background .2s ease}
.rubriques>li:hover{background:#e8ded1}
.rubrique-entete h3{font-size:clamp(1.9rem,2.4vw,2.8rem)}
@media(max-width:63.99rem){.rubriques>li{min-height:250px}}
@media(max-width:47.99rem){.rubriques{grid-template-columns:1fr}.rubriques>li{min-height:0;padding:1.5rem}}


/* Identite 2026 : vrai contraste noir / jaune, langage de bande-annonce, sans effets decoratifs gratuits. */
.ouverture{background:#111314;color:#fff}
.ouverture-interieur{padding-top:0}
.surface-lecture{background:#f4f4f1}
.journal-corps{padding-top:2rem}
.journal-corps :global(.titre-section){border-top:7px solid #111314;margin-top:4.5rem}
.rubriques{gap:0;border-left:2px solid #111314;border-top:2px solid #111314}
.rubriques>li{border:0;border-right:2px solid #111314;border-bottom:2px solid #111314;background:#f4f4f1;min-height:300px;padding:2rem}
.rubriques>li:hover{background:#ffe100}
.rubriques>li::before{font:900 .72rem var(--sans);color:#111314;margin-bottom:3rem}
.rubrique-entete h3{font:900 clamp(1.8rem,2.2vw,2.6rem)/1.04 var(--sans);letter-spacing:-.05em;text-transform:uppercase}
.sous-titre{font:700 .76rem/1.5 var(--sans);text-transform:uppercase;color:#555}
.rubriques .titres li{font:650 .9rem/1.45 var(--sans)}
.rubrique-volume{font-size:.7rem;font-weight:850;text-transform:uppercase;margin-top:1rem}
@media(max-width:47.99rem){
.rubriques{grid-template-columns:1fr}
.rubriques>li{min-height:0;padding:1.5rem}
.rubriques>li::before{margin-bottom:1.3rem}
}

  /* Une d'information : l'ancien article d'archives ne simule plus l'actualité. */

/* Direction artistique de la une : composition de presse, retenue et lisibilité. */
.ouverture{background:#f7f5f0;color:#1b2024}
.ouverture-interieur{padding-top:0}
.surface-lecture{background:#faf9f6}
.journal-corps{padding-top:1.5rem}
.journal-corps :global(.titre-section){border-top:1px solid #b9b7b1;margin-top:3.3rem;padding-top:1.2rem}

/* Règles propres à la une : une hiérarchie éditoriale sans blocs redondants. */
.ouverture{background:#f7f5f0}
.surface-lecture{background:#fbfaf8}
.journal-corps{padding-top:1.2rem}
.journal-corps :global(.titre-section){margin-top:2.7rem}
.rubriques>li{background:#f4f1eb;border-top:2px solid #353738;padding:1.3rem}
.rubriques>li::before{margin-bottom:.9rem}
.rubrique-entete h3{font-size:clamp(1.5rem,2.1vw,2rem)}
.archives-passerelle{border-top:2px solid #33383a;border-bottom:1px solid #d0cbc4;padding:1.6rem 0;margin-top:3rem;display:flex;align-items:center;justify-content:space-between;gap:2rem}
.archives-passerelle span{font:700 .65rem/1.5 var(--sans);color:#943440;letter-spacing:.06em}
.archives-passerelle strong{display:block;font:650 clamp(1.5rem,2.4vw,2.2rem)/1.18 var(--serif);margin:.4rem 0}
.archives-passerelle p{font:450 .87rem/1.6 var(--sans);color:#565b5e;margin:0;max-width:55ch}
.archives-passerelle>div:last-child{display:flex;flex-direction:column;gap:.35rem;min-width:12rem}
.archives-passerelle a{font:700 .78rem/1.4 var(--sans);border-bottom:1px solid #c7c1b8;padding:.55rem 0}
.archives-passerelle a:hover{color:#943440}
@media(max-width:47.99rem){.archives-passerelle{flex-direction:column;align-items:stretch;gap:1rem}.archives-passerelle>div:last-child{min-width:0}}

/* Accueil : la une présente un vrai dossier et non une seconde présentation du site. */
.ouverture-interieur{padding-top:1.25rem}
@media(max-width:47.99rem){.ouverture-interieur{padding-top:.9rem}}

/* Espacement de la une. */
.ouverture{background:#f7f5f0}
.ouverture-interieur{padding-top:2.1rem}
@media(max-width:47.99rem){
 .ouverture-interieur{padding-top:1.1rem}
}

/* Le dernier article du journal précède la revue de presse externe. */
.article-redaction-une{margin:1.4rem 0 2.5rem;border:1px solid #a9a49c;border-top:5px solid #a12c39;background:#fff;color:#181b1c;padding:clamp(1.35rem,3vw,2.8rem);max-width:100%}
.article-redaction-une-texte{max-width:83ch}
.article-redaction-une-kicker{font:850 .72rem/1.45 var(--sans);color:#8f2734;letter-spacing:.08em;margin:0 0 .9rem}
.article-redaction-une-date{font:650 .76rem/1.4 var(--sans);color:#565b5e;margin:0 0 1rem}
