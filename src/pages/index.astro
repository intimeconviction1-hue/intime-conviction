---
import Base from '../layouts/Base.astro';
import ListeArticles from '../components/ListeArticles.astro';
import Mouche from '../components/Mouche.astro';
import { RUBRIQUES } from '../lib/rubriques.mjs';
import { tousLesArticles, dateGreffe, minutesDeLecture } from '../lib/articles.mjs';

const articles = await tousLesArticles();
const [une, ...suite] = articles;
const parRubrique = RUBRIQUES.map((r) => {
  const liste = articles.filter((a) => a.data.rubrique === r.slug);
  return { ...r, total: liste.length, derniers: liste.slice(0, 3) };
}).filter((r) => r.total > 0);
const total = articles.length.toLocaleString('fr-FR');
---
<Base accueil>
  <section class="une" aria-labelledby="titre-une">
    <p class="greffe rouge">À la une · <time datetime={une.data.date.toISOString()}>{dateGreffe(une.data.date)}</time></p>
    <h2 id="titre-une"><a href={une.data.chemin}>{une.data.titre}</a></h2>
    <p class="chapeau">{une.data.extrait}</p>
    <p class="greffe lecture">{minutesDeLecture(une.data.mots)} min de lecture</p>
  </section>

  <div class="titre-section"><h2><Mouche />Derniers articles</h2></div>
  <ListeArticles articles={suite.slice(0, 5)} />

  {parRubrique.map((r) => (
    <section aria-labelledby={`r-${r.slug}`}>
      <div class="titre-section">
        <h2 id={`r-${r.slug}`}><Mouche /><span>{r.nom}<small>{r.sousTitre}</small></span></h2>
        <a class="greffe" href={`/rubrique/${r.slug}/`}>Les {r.total.toLocaleString('fr-FR')} articles</a>
      </div>
      <ListeArticles articles={r.derniers} rubriqueVisible={false} extraits={false} />
    </section>
  ))}

  <p class="fonds greffe">{total} articles depuis 2009 · <a href="/archives/">Parcourir les archives</a></p>
</Base>

<style>
  .une { margin: 3rem 0 0; padding-bottom: 2.5rem; border-bottom: 1px solid var(--pierre); }
  .une h2 { font-size: clamp(2.4rem, 7.5vw, 5rem); line-height: 1; margin: 0.75rem 0 1rem; max-width: 18ch; }
  .une h2 a { text-decoration: none; }
  .chapeau { font-size: 1.25rem; line-height: 1.5; color: var(--encre-2); margin: 0; max-width: 46rem; }
  .lecture { color: var(--encre-2); margin: 1rem 0 0; }
  .fonds { margin-top: 3.5rem; text-align: center; color: var(--encre-2); }
</style>
