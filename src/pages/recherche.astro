---
import Base from '../layouts/Base.astro';
import { RUBRIQUES, rubrique as trouverRubrique } from '../lib/rubriques.mjs';
import { tousLesArticles } from '../lib/articles.mjs';
import { lireVeille } from '../lib/veille.mjs';

const [articles, veille] = await Promise.all([tousLesArticles(), lireVeille()]);
const index = articles.filter(({data}) => data.verificationEnCours !== true).map(({data:d})=>({
  titre:d.titre,chemin:d.chemin,rubrique:d.rubrique,
  rubriqueNom:trouverRubrique(d.rubrique).libelle,
  annee:d.date.getFullYear(),extrait:d.extrait
}));
const annees = [...new Set([
  ...index.map(a=>String(a.annee)),
  ...veille.articles.map(a=>a.dateAlerte.slice(0,4))
])].sort((a,b)=>b.localeCompare(a));
const total=index.length.toLocaleString('fr-FR');
---
<Base noindex titre="Rechercher" description="Retrouvez les dossiers judiciaires, les articles du journal et les références de presse à partir d’une seule recherche.">
  <header class="titre-page recherche-intro">
    <h1>Rechercher une affaire</h1>
    <p class="sous-titre">Un nom, une affaire, une ville : retrouvez les dossiers, les articles du journal et les références de presse.</p>
  </header>
  <form id="recherche" class="recherche-form" role="search">
    <label>RECHERCHE
      <input type="search" name="q" id="requete" placeholder="Ex. Hélène Pastor, Vannes…" autocomplete="off" enterkeyhint="search" aria-controls="resultats" />
    </label>
    <button type="submit">CHERCHER <span aria-hidden="true">→</span></button>
    <details class="filtres-recherche">
      <summary>Affiner les articles par rubrique ou par année</summary>
      <div>
        <label>Rubrique du journal
          <select id="rubrique" name="rubrique"><option value="">Toutes les rubriques</option>{RUBRIQUES.map(r=><option value={r.slug}>{r.libelle}</option>)}</select>
        </label>
        <label>Année de publication
          <select id="annee" name="annee"><option value="">Toutes les années</option>{annees.map(a=><option value={a}>{a}</option>)}</select>
        </label>
      </div>
    </details>
  </form>
  <button type="button" id="effacer" class="effacer-recherche" hidden>EFFACER LES FILTRES</button>
  <section id="dossiers-recherche" class="resultats-fonds dossier-recherche" aria-labelledby="titre-dossiers" hidden>
    <p class="surtitre-resultats">Pour suivre une affaire</p>
    <h2 id="titre-dossiers">Dossiers consacrés à cette affaire</h2>
    <p>Les repères et les articles rassemblés par la rédaction autour de cette affaire.</p>
    <ul id="resultats-dossiers"></ul>
  </section>
  <section class="resultats-fonds" aria-labelledby="titre-journal">
    <h2 id="titre-journal">Articles du journal</h2>
    <p id="compteur" class="meta" role="status">Chargement de l’index des archives…</p>
    <ul id="resultats" class="role"></ul>
    <button id="suite" class="suite-resultats" type="button" hidden>AFFICHER 30 ARTICLES DE PLUS <span aria-hidden="true">↓</span></button>
  </section>
  <section id="presse-recherche" class="resultats-fonds" aria-labelledby="titre-presse" hidden>
    <h2 id="titre-presse">Revue de presse</h2>
    <p id="compteur-presse" class="meta" role="status"></p>
    <ul id="apercu-presse"></ul>
    <a id="suite-presse" href="/archives/presse/rechercher/">Voir tous les résultats presse →</a>
  </section>
  <noscript>Cette recherche nécessite JavaScript. Vous pouvez consulter <a href="/archives/">les archives par année</a>.</noscript>
</Base>
<script>
import { preparerIndex, chercherArticles, chargerIndexPresse, filtrerPresse } from '../lib/recherche.mjs';
import { dossiersPourRecherche } from '../lib/dossiers.mjs';
let index = [];
const form = document.querySelector('#recherche');
const q = document.querySelector('#requete');
const rubrique = document.querySelector('#rubrique');
const annee = document.querySelector('#annee');
const liste = document.querySelector('#resultats');
const suite = document.querySelector('#suite');
const compteur = document.querySelector('#compteur');
const effacer = document.querySelector('#effacer');
const dossiers = document.querySelector('#dossiers-recherche');
const listeDossiers = document.querySelector('#resultats-dossiers');
const presse = document.querySelector('#presse-recherche');
const listePresse = document.querySelector('#apercu-presse');
const compteurPresse = document.querySelector('#compteur-presse');
const suitePresse = document.querySelector('#suite-presse');
let demandePresse = 0;

function ajouterLien(liste, texte, href, source = '') {
  const item = document.createElement('li');
  const lien = document.createElement('a');
  lien.href = href;
  lien.textContent = texte;
  if (source) {
    lien.target = '_blank';
    lien.rel = 'noopener noreferrer';
    lien.textContent += ' ↗';
    item.append(document.createTextNode(source + ' · '));
  }
  item.append(lien);
  liste.append(item);
}

async function chercherPresse(options) {
  const demande = ++demandePresse;
  presse.hidden = options.q.length < 2;
  listePresse.replaceChildren();
  if (presse.hidden) return;
  const params = new URLSearchParams({q: options.q});
  if (options.annee) params.set('annee', options.annee);
  suitePresse.href = '/archives/presse/rechercher/?' + params.toString();
  compteurPresse.textContent = 'Recherche dans les titres de presse…';
  try {
    const references = await chargerIndexPresse();
    if (demande !== demandePresse || options.q !== q.value.trim()) return;
    const resultats = filtrerPresse(references, options);
    const total = resultats.length;
    compteurPresse.textContent = total
      ? total.toLocaleString('fr-FR') + (total === 1 ? ' référence trouvée' : ' références trouvées')
      : 'Aucune référence de presse pour cette recherche.';
    for (const [titre, media, url] of resultats.slice(0, 3)) {
      ajouterLien(listePresse, titre, url, media);
    }
  } catch {
    if (demande === demandePresse && options.q === q.value.trim()) compteurPresse.textContent = 'La revue de presse est momentanément indisponible.';
  }
}
let matches = [], limite = 30, delai, approximatif = false, demandeJournal = 0;
let indexCorps, indexTitres;
function chargerIndex() {
  indexTitres ??= fetch('/index-recherche.json').then(async reponse => {
    if (!reponse.ok) throw new Error('Index indisponible');
    return preparerIndex(await reponse.json());
  }).catch(erreur => {
    indexTitres = undefined;
    throw erreur;
  });
  return indexTitres;
}
function chargerCorps() {
  indexCorps ??= fetch('/index-corps-recherche.json').then(async reponse => {
    if (!reponse.ok) throw new Error('Index du texte indisponible');
    return new Map(await reponse.json());
  }).catch(erreur => {
    indexCorps = undefined;
    throw erreur;
  });
  return indexCorps;
}

function affiche() {
  liste.replaceChildren();
  for (const a of matches.slice(0, limite)) {
    const li = document.createElement('li');
    const titre = document.createElement('h3');
    const lien = document.createElement('a');
    const extrait = document.createElement('p');
    const meta = document.createElement('p');
    lien.href = a.chemin;
    lien.textContent = a.titre;
    titre.append(lien);
    extrait.className = 'extrait';
    extrait.textContent = a.extrait;
    meta.className = 'meta';
    const dateValide = typeof a.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(a.date);
    const dateTexte = dateValide
      ? new Intl.DateTimeFormat('fr-FR',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(a.date+'T12:00:00Z'))
      : String(a.annee);
    meta.textContent = a.rubriqueNom + ' · ' + dateTexte;
    if (a.image && typeof a.image === 'string' && a.image.startsWith('/')) {
      const image = document.createElement('img');
      image.src = a.image;
      image.alt = '';
      image.width = 240;
      image.height = 160;
      image.loading = 'lazy';
      image.decoding = 'async';
      image.className = 'photo-resultat';
      li.append(image);
    }
    const texte = document.createElement('div');
    texte.className = 'texte-resultat';
    texte.append(meta,titre,extrait);
    li.append(texte);
    liste.append(li);
  }
  const n = matches.length;
  if (!n) compteur.textContent = 'Aucun article du journal pour cette recherche.';
  else compteur.textContent = n.toLocaleString('fr-FR') + ' article' + (n > 1 ? 's' : '') + ' · ' + Math.min(limite, n).toLocaleString('fr-FR') + ' affiché' + (Math.min(limite,n) > 1 ? 's' : '');
  if (approximatif) compteur.textContent = 'Résultats proches · ' + compteur.textContent;
  suite.hidden = n <= limite;
  effacer.hidden = !q.value.trim() && !rubrique.value && !annee.value;
}

function afficherResultats(resultat) {
  matches = resultat.articles;
  approximatif = resultat.approximatif;
  affiche();
}

async function rechercher() {
  clearTimeout(delai);
  const options = { q:q.value.trim(), rubrique:rubrique.value, annee:annee.value };
  const demande = ++demandeJournal;
  limite = 30;
  const params = new URLSearchParams();
  if (options.q) params.set('q', options.q);
  if (options.rubrique) params.set('rubrique', options.rubrique);
  if (options.annee) params.set('annee', options.annee);
  history.replaceState(null, '', location.pathname + (params.size ? '?' + params : ''));
  // Une fiche dossier peut réunir plusieurs années ou rubriques.
  // Les filtres d'articles ne doivent pas sembler s'appliquer à ces fiches.
  const correspondances = options.rubrique || options.annee ? [] : dossiersPourRecherche(options.q);
  dossiers.hidden = correspondances.length === 0;
  listeDossiers.replaceChildren();
  for (const dossier of correspondances) {
    ajouterLien(listeDossiers, dossier.titre, '/dossiers/' + dossier.slug + '/');
  }
  try {
    index = await chargerIndex();
  } catch {
    if (demande === demandeJournal) compteur.textContent = 'La recherche est momentanément indisponible. Vous pouvez consulter les archives par année.';
    return;
  }
  if (demande !== demandeJournal) return;
  afficherResultats(chercherArticles(index, options));
  chercherPresse(options);
  if (!options.q) return;
  try {
    const corps = await chargerCorps();
    if (demande === demandeJournal && options.q === q.value.trim()) {
      afficherResultats(chercherArticles(index, options, corps));
    }
  } catch {
    if (demande === demandeJournal && options.q === q.value.trim()) {
      compteur.textContent += ' La recherche dans le texte intégral est momentanément indisponible.';
    }
  }
}
const params = new URLSearchParams(location.search);
q.value = params.get('q') || '';
rubrique.value = params.get('rubrique') || '';
annee.value = params.get('annee') || '';
form.querySelector('details').open = Boolean(rubrique.value || annee.value);
form.addEventListener('submit', (e) => { e.preventDefault(); rechercher(); compteur.scrollIntoView({ block: 'nearest' }); });
q.addEventListener('input', () => { clearTimeout(delai); delai = setTimeout(rechercher, 220); });
rubrique.addEventListener('change', rechercher);
annee.addEventListener('change', rechercher);
suite.addEventListener('click', () => { limite += 30; affiche(); });
effacer.addEventListener('click', () => { q.value = ''; rubrique.value = ''; annee.value = ''; rechercher(); q.focus(); });
rechercher();
</script>
<style>
.recherche-intro{background:#17191a;color:#fff;padding:clamp(1.1rem,3vw,2.5rem);margin:1rem 0 0;border:0}
.recherche-intro h1{font:900 clamp(1.65rem,5vw,3.8rem)/1.05 var(--sans);letter-spacing:-.055em;margin:0 0 .45rem}
.recherche-intro .sous-titre{font:600 .95rem/1.45 var(--sans);max-width:68ch;color:#e6e7e4;margin:0}
.recherche-form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.65rem;align-items:end;margin:0;padding:clamp(.8rem,2vw,1.5rem);background:var(--action);color:var(--sur-action)}
.recherche-form label{display:grid;min-width:0;font:900 .66rem/1.5 var(--sans);letter-spacing:.055em;color:var(--sur-action);gap:.3rem}
.recherche-form :is(input,select){width:100%;min-height:48px;background:#fff;color:#17191a;border:2px solid #17191a;border-radius:0;font:600 1rem/1.4 var(--sans)}
.recherche-form button{min-height:48px;background:#17191a;color:#fff;border:2px solid #17191a;font:900 .72rem/1.2 var(--sans);letter-spacing:.05em;white-space:nowrap}
.recherche-form button:hover{background:#fff;color:#17191a}
.filtres-recherche{grid-column:1/-1}
.filtres-recherche summary{display:list-item;cursor:pointer;min-height:44px;padding:.65rem 0;font-weight:750;font-size:.85rem}
.filtres-recherche>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}
.effacer-recherche{background:transparent;border:0;border-bottom:2px solid #17191a;color:#17191a;padding:.4rem 0;margin-top:1rem;font:850 .68rem/1.4 var(--sans)}
.effacer-recherche:hover{background:var(--action);color:var(--sur-action)}
.resultats-fonds{margin:2rem 0;border-top:4px solid #17191a;padding-top:1rem}
.resultats-fonds>h2{margin:0 0 .5rem}
.resultats-fonds>p{margin:.5rem 0;font:850 .8rem/1.4 var(--sans)}
.resultats-fonds>ul:not(.role){padding-left:1.15rem;line-height:1.65}
.resultats-fonds a{text-decoration:underline;text-underline-offset:.18em}
.role{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:2.4rem;list-style:none;padding:0;margin:0}
:global(#resultats > li){border-bottom:2px solid #d1d2cd;padding:1.6rem 0}
:global(#resultats h3){font:850 clamp(1.3rem,2.2vw,2rem)/1.17 var(--sans);letter-spacing:-.04em;margin:.6rem 0 .5rem}
:global(#resultats h3 a:hover){background:var(--action);color:var(--sur-action)}
:global(#resultats .meta){font:850 .64rem/1.5 var(--sans);letter-spacing:.05em;text-transform:uppercase}
:global(#resultats .extrait){font:450 .94rem/1.6 var(--sans);color:#454848;margin:0}
.suite-resultats{display:block;margin:2rem auto 0;background:#17191a;color:#fff;border:2px solid #17191a;font:900 .72rem/1.4 var(--sans)}
.suite-resultats:hover{background:var(--action);color:var(--sur-action)}
.suite-resultats[hidden],.effacer-recherche[hidden]{display:none}
@media(max-width:47.99rem){.role,.filtres-recherche>div{grid-template-columns:1fr}.recherche-form button{padding-inline:.6rem}.recherche-form button span{display:none}}

/* Résultats sous forme de fiches de presse : photo, date, titre et résumé. */
:global(#resultats > li){display:grid;grid-template-columns:clamp(7.5rem,16vw,11.5rem) minmax(0,1fr);align-content:start;gap:1rem;min-width:0;border-bottom:1px solid #d5d0c9;padding:1.35rem 0}
:global(#resultats > li:not(:has(.photo-resultat))){grid-template-columns:minmax(0,1fr)}
:global(#resultats .photo-resultat){display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;background:#ece9e2}
:global(#resultats .texte-resultat){min-width:0}
:global(#resultats h3){font:650 clamp(1.18rem,1.8vw,1.65rem)/1.2 var(--serif);letter-spacing:-.02em;margin:.35rem 0 .45rem}
:global(#resultats .meta){font:700 .7rem/1.5 var(--sans);letter-spacing:0;text-transform:none;color:#87313c}
:global(#resultats .extrait){font:450 .85rem/1.55 var(--sans);color:#4d5051;margin:0}
.dossier-recherche{background:#f0eee9;border-top:3px solid #a12c39;padding:1.35rem clamp(1rem,3vw,2rem);margin-top:2rem}
.dossier-recherche .surtitre-resultats{font:700 .72rem/1.35 var(--sans);text-transform:uppercase;letter-spacing:.045em;color:#8f2c38;margin:0 0 .45rem}
.dossier-recherche>h2{font:650 clamp(1.55rem,2.4vw,2.1rem)/1.2 var(--serif);margin:0}
.dossier-recherche>p:not(.surtitre-resultats){font:450 .85rem/1.55 var(--sans);margin:.5rem 0}
:global(#resultats-dossiers){list-style:none;padding:0!important;margin:1rem 0 0;display:grid;gap:.45rem}
:global(#resultats-dossiers li){margin:0;display:block;background:#fff;border-left:3px solid #a12c39}
:global(#resultats-dossiers a){display:block;padding:.85rem 1rem;font:650 1.05rem/1.3 var(--serif);text-decoration:none}
:global(#resultats-dossiers a:hover){text-decoration:underline}
@media(max-width:47.99rem){:global(#resultats > li){grid-template-columns:minmax(6rem,30%) minmax(0,1fr);gap:.8rem}:global(#resultats .photo-resultat){aspect-ratio:1/1}:global(#resultats h3){font-size:1.2rem}}
</style>
