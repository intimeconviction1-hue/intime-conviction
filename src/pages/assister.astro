(72px,.5fr) 3fr;gap:1.5rem;border-bottom:1px solid var(--filet);padding:1.4rem 0}.etapes-visite>li>strong{font:900 clamp(2.1rem,4vw,3rem)/1 var(--sans);color:var(--encre-2)}.etapes-visite h3{font:900 clamp(1.2rem,2.3vw,1.8rem)/1.2 var(--sans);margin:0 0 .4rem}.etapes-visite p{font:500 .91rem/1.6 var(--sans);margin:0;max-width:75ch}.sources-roles{background:#ffe100;color:#151718;padding:clamp(1.25rem,3vw,2.5rem);margin:2rem 0}.sources-roles>p{font:900 .65rem/1.4 var(--sans);letter-spacing:.05em}.sources-roles>div{display:grid;grid-template-columns:1.4fr 1fr;gap:2rem;align-items:end}.sources-roles h2{font:900 clamp(1.65rem,3vw,2.7rem)/1.05 var(--sans);letter-spacing:-.05em}.sources-roles div p{font:500 .9rem/1.6 var(--sans)}.sources-roles a{padding:1rem;background:#151718;color:#fff;display:flex;justify-content:space-between;gap:1rem;font:900 .7rem/1.4 var(--sans)}.sources-roles a:hover{background:#fff;color:#151718}.grille-jure{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.grille-jure article{background:#efefeb;color:#151718;border:2px solid #151718;padding:1.7rem}.grille-jure article>span{font:900 .65rem/1.4 var(--sans)}.grille-jure h3{font:900 clamp(1.3rem,2.1vw,1.9rem)/1.16 var(--sans);margin:1.2rem 0 .65rem}.grille-jure article p{font:500 .9rem/1.55 var(--sans)}.grille-jure article a{font:900 .7rem/1.45 var(--sans);text-decoration:underline}.accordeons{border-top:3px solid #151718}.accordeons details{border-bottom:1px solid var(--filet)}.accordeons summary{cursor:pointer;list-style:none;display:grid;grid-template-columns:35px 1fr 25px;gap:1rem;align-items:center;padding:1rem .35rem;font:700 .92rem/1.5 var(--sans)}.accordeons summary::-webkit-details-marker{display:none}.accordeons summary>span:first-child{font:900 .65rem var(--sans);color:var(--encre-2)}.accordeons summary>span:last-child{font:900 1.6rem/1 var(--sans)}.accordeons details[open] summary{background:#ffe100;color:#151718}.accordeons details p{padding:0 3.7rem 1.3rem;font:500 .9