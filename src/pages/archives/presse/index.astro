---
import Base from '../../../layouts/Base.astro';
import { lireVeille } from '../../../lib/veille.mjs';
const veille=await lireVeille();
const annees=new Map();for(const a of veille.articles){const an=a.dateAlerte.slice(0,4);annees.set(an,(annees.get(an)??0)+1);}
---
<Base titre="Archives de la revue de presse" description="Rechercher les références de presse judiciaire classées par année et par source dans les archives d’Intime Conviction." rubriqueActive="archives">
  <header class="titre-page"><h1>Archives de<br /><em>la revue de presse</em></h1><p class="sous-titre">{veille.articles.length.toLocaleString('fr-FR')} références de presse, année par année.</p></header>
  <div class="explication"><p>Cette collection rassemble des références à des articles publiés par d’autres médias. Les dates correspondent au repérage des références et non nécessairement à la publication des articles ou aux événements judiciaires. Certains liens anciens peuvent ne plus être disponibles.</p><a href="/archives/">Retrouver les articles d’Intime Conviction</a> · <a href="/dossiers/">Explorer les dossiers judiciaires par affaire</a> · <a href="/chronologie/">Consulter les repères judiciaires documentés</a></div>
  <form action="/archives/presse/rechercher/" method="get" class="recherche-globale-presse" role="search">
    <label for="recherche-globale">RECHERCHER DANS TOUTES LES ANNÉES</label>
    <div><input id="recherche-globale" name="q" type="search" placeholder="Un nom, une ville, une juridiction..." minlength="2" required /><button type="submit">CHERCHER <span aria-hidden="true">↗</span></button></div>
    <p>Recherche transversale dans les titres et les médias. Les dates indiquées sont celles des références enregistrées.</p>
  </form>
  <ul class="annees-presse">{[...annees].map(([an,n])=><li><a href={'/archives/presse/'+an+'/'}><strong>{an}</strong><span>{n.toLocaleString('fr-FR')} références</span></a></li>)}</ul>
</Base>
<style>.explication { max-width:65ch; margin:2rem 0; }.explication a { text-decoration:underline; }.annees-presse { display:grid; grid-template-columns:repeat(auto-fit,minmax(10rem,1fr)); list-style:none; padding:0; gap:1.5rem; }.annees-presse a { display:flex; flex-direction:column; border-block:1px solid var(--filet); padding:1.5rem 0; min-height:44px; }.annees-presse strong { font-size:3rem; font-weight:500; }.annees-presse span { font-family:var(--sans); font-size:0.75rem; color:var(--encre-2); }.recherche-globale-presse{background:#151718;color:#fff;padding:clamp(1rem,3vw,2.3rem);margin:2rem 0}.recherche-globale-presse label{font:900 .68rem/1.4 var(--sans);color:#ffe100;letter-spacing:.07em}.recherche-globale-presse>div{display:flex;gap:.7rem;margin-top:1rem}.recherche-globale-presse input{flex:1;min-width:0;min-height:50px;border:2px solid #fff;background:#fff;color:#151718;padding:.7rem;font:650 .85rem var(--sans)}.recherche-globale-presse button{background:#ffe100;color:#151718;min-height:50px;border:2px solid #ffe100;padding:0 1rem;font:900 .7rem var(--sans);cursor:pointer}.recherche-globale-presse button:hover{background:#fff;color:#151718}.recherche-globale-presse p{font:500 .73rem/1.6 var(--sans)}@media(max-width:47.99rem){.recherche-globale-presse>div{flex-direction:column}}

.titre-page{border-bottom:1px solid #cfcac2;padding-bottom:1.5rem}
.titre-page h1{font:650 clamp(2.4rem,5vw,4.7rem)/1.06 var(--serif);text-transform:none;letter-spacing:-.03em}
.explication{color:#45494b;line-height:1.7;max-width:78ch}
.recherche-globale-presse{background:#eeece7;color:#22272b;border-left:3px solid #a12c39;padding:clamp(1.2rem,3vw,2rem)}
.recherche-globale-presse label{color:#33373a;font-weight:700;letter-spacing:.03em}
.recherche-globale-presse button{background:#a12c39;border-color:#a12c39;color:#fff;font-weight:700}
.recherche-globale-presse button:hover{background:#842631;border-color:#842631;color:#fff}
.annees-presse strong{font-family:var(--serif);font-weight:650;letter-spacing:-.03em}
.annees-presse a:hover{color:#a12c39}

</style>
