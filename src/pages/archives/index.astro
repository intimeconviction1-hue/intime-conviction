---
import Base from '../../layouts/Base.astro';
import { tousLesArticles } from '../../lib/articles.mjs';
import { lireVeille } from '../../lib/veille.mjs';

// Deux collections distinctes, mais une seule chronologie accessible.
// Ne jamais présenter les liens de presse comme des textes de la rédaction.
const [articles, veille] = await Promise.all([tousLesArticles(), lireVeille()]);
const publications = new Map();
for (const a of articles) {
  const an = a.data.date.getFullYear();
  publications.set(an, (publications.get(an) ?? 0) + 1);
}
const presse = new Map();
for (const a of veille.articles) {
  const an = Number(a.dateAlerte.slice(0, 4));
  if (Number.isFinite(an)) presse.set(an, (presse.get(an) ?? 0) + 1);
}
const annees = [...new Set([...publications.keys(), ...presse.keys()])]
  .sort((a, b) => b - a)
  .map((an) => ({ an, documents: publications.get(an) ?? 0, references: presse.get(an) ?? 0 }));
const totalArticles = articles.length.toLocaleString('fr-FR');
const totalPresse = veille.articles.length.toLocaleString('fr-FR');
---
<Base titre="Archives" description="Toutes les archives d’Intime Conviction, année par année : documents historiques conservés et références de revue de presse, clairement distingués." rubriqueActive="archives">
  <header class="titre-page archives-tete">
    <p class="etiquette">INTIME CONVICTION</p>
    <h1>ARCHIVES<br /><span>DU JOURNAL.</span></h1>
    <p class="sous-titre">Parcourez les textes historiques conservés et les références de presse, classés par année et présentés séparément.</p>
  </header>

  <div class="fonds-legende" aria-label="Comprendre les deux collections">
    <section class="fonds-original">
      <span class="fonds-chiffre">{totalArticles}</span>
      <h2>FONDS HISTORIQUE</h2>
      <p>Retrouvez les textes conservés dans le fonds historique du journal. Certains proviennent de médias extérieurs et font l’objet d’un contrôle de provenance.</p>
    </section>
    <section class="fonds-presse">
      <span class="fonds-chiffre">{totalPresse}</span>
      <h2>REVUE DE PRESSE</h2>
      <p>Références issues de la veille : titres et liens vers des médias extérieurs. Classement selon la date de l’alerte, pas nécessairement celle de l’article.</p>
      <a href="/archives/presse/">PARCOURIR TOUTE LA REVUE DE PRESSE <span aria-hidden="true">↗</span></a>
    </section>
  </div>

  <aside class="acces-dossiers" aria-label="Dossiers par affaire"><div><span>LES AFFAIRES / PAR THÈME</span><strong>Consulter les dossiers judiciaires</strong></div><a href="/dossiers/">OUVRIR LES DOSSIERS JUDICIAIRES <span aria-hidden="true">↗</span></a></aside>
  <section class="chronologie" aria-labelledby="titre-chronologie">
    <div class="chronologie-tete">
      <h2 id="titre-chronologie">Archives par année</h2>
      <span>{annees.length} ANNÉES RÉPERTORIÉES</span>
    </div>
    <ol class="annees">
      {annees.map(({an,documents,references}) => (
        <li>
          <strong class="annee">{an}</strong>
          <div class="annee-acces">
            {documents > 0 ? (
              <a class="lien-original" href={`/archives/${an}/`}>
                <span>DOCUMENTS HISTORIQUES</span>
                <strong>{documents.toLocaleString('fr-FR')} document{documents > 1 ? 's' : ''}</strong>
                <span aria-hidden="true" class="fleche">↗</span>
              </a>
            ) : (
              <p class="aucun-original">Aucun document historique conservé pour cette année</p>
            )}
            {references > 0 && (
              <a class="lien-presse" href={`/archives/presse/${an}/`}>
                <span>REVUE DE PRESSE</span>
                <strong>{references.toLocaleString('fr-FR')} références</strong>
                <span aria-hidden="true" class="fleche">↗</span>
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
.archives-tete{background:#151718;color:#fff;border:0;margin:1.5rem 0 0;padding:clamp(2rem,5vw,5rem)}
.archives-tete .etiquette{margin-bottom:1.8rem}
.archives-tete h1{font:900 clamp(3rem,8vw,8rem)/.91 var(--sans);letter-spacing:-.085em}
.archives-tete h1 span{color:#ffe100}
.archives-tete .sous-titre{font:700 clamp(1rem,1.5vw,1.3rem)/1.5 var(--sans);text-transform:uppercase;max-width:38ch;margin:1.6rem 0 0;color:#eee}
.fonds-legende{display:grid;grid-template-columns:1fr 1fr;border:3px solid #151718;gap:0;margin-bottom:3rem}
.fonds-legende section{padding:clamp(1.3rem,3vw,2.8rem);min-width:0;display:flex;flex-direction:column}
.fonds-original{background:#f0f0eb;color:#151718;border-right:3px solid #151718}
.fonds-presse{background:#ffe100;color:#151718}
.fonds-chiffre{font:900 clamp(2.5rem,5vw,5rem)/1 var(--sans);letter-spacing:-.08em}
.fonds-legende h2{font:900 clamp(1.2rem,2vw,1.8rem)/1.1 var(--sans);letter-spacing:-.04em;margin:.8rem 0}
.fonds-legende p{font:500 .91rem/1.65 var(--sans);max-width:49ch;margin:0 0 1.2rem}
.fonds-legende a{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding-top:.75rem;border-top:2px solid #151718;margin-top:auto;font:900 .7rem/1.5 var(--sans)}
.fonds-legende a:hover{text-decoration:underline;color:#151718}
.chronologie-tete{display:flex;justify-content:space-between;align-items:end;gap:1rem;border-bottom:7px solid #151718;padding-bottom:1rem}
.chronologie-tete h2{font:900 clamp(2rem,4vw,4rem)/1 var(--sans);letter-spacing:-.065em;margin:0}
.chronologie-tete span{font:900 .65rem/1.45 var(--sans);letter-spacing:.08em}
.annees{list-style:none;padding:0;margin:0}
.annees>li{display:grid;grid-template-columns:minmax(7rem,.45fr) minmax(0,2fr);gap:2rem;align-items:stretch;border-bottom:2px solid #151718;padding:1.3rem 0}
.annee{font:900 clamp(3rem,6vw,6rem)/1 var(--sans);letter-spacing:-.075em}
.annee-acces{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;align-items:stretch}
.annee-acces a{position:relative;display:flex;flex-direction:column;gap:.3rem;padding:1rem 3rem 1rem 1.2rem;min-height:105px;border:2px solid #151718;transition:background-color .15s ease}
.annee-acces a span:first-child{font:900 .65rem/1.4 var(--sans);letter-spacing:.055em}
.annee-acces a strong{font:850 clamp(.95rem,1.4vw,1.25rem)/1.25 var(--sans);letter-spacing:-.025em}
.lien-original{background:#fff;color:#151718}
.lien-original:hover{background:#e6e7e3;color:#151718}
.lien-presse{background:#ffe100;color:#151718}
.lien-presse:hover{background:#ffeb65;color:#151718}
.annee-acces .fleche{position:absolute;right:1rem;top:1rem;font:900 1.3rem/1 var(--sans)}
.aucun-original{align-self:center;margin:0;padding:1rem 1.2rem;font:650 .79rem/1.5 var(--sans);color:#545852}
@media(max-width:47.99rem){.archives-tete{padding:2rem 1.2rem}.archives-tete h1{font-size:clamp(2.7rem,11vw,4.5rem)}.fonds-legende{grid-template-columns:1fr}.fonds-original{border-right:0;border-bottom:3px solid #151718}.chronologie-tete{align-items:start;flex-direction:column}.annees>li{grid-template-columns:1fr;gap:.7rem}.annee-acces{grid-template-columns:1fr}.annee-acces a{min-height:90px}.annee{font-size:3.5rem}.aucun-original{align-self:start;padding:.4rem 0}}
.acces-dossiers{display:flex;align-items:center;justify-content:space-between;gap:1rem;background:#151718;color:#fff;padding:1.5rem 2rem;margin:1.5rem 0 3rem}.acces-dossiers div{display:flex;flex-direction:column;gap:.6rem}.acces-dossiers div span{font:850 .7rem/1.4 var(--sans);letter-spacing:.08em;color:#ffe100}.acces-dossiers div strong{font:900 clamp(1rem,1.8vw,1.6rem)/1.2 var(--sans);letter-spacing:-.04em}.acces-dossiers a{flex-shrink:0;display:flex;gap:1rem;justify-content:space-between;align-items:center;background:#ffe100;color:#151718;font:900 .7rem/1.4 var(--sans);padding:1.2rem}.acces-dossiers a:hover{background:white;color:#151718}@media(max-width:48rem){.acces-dossiers{flex-direction:column;align-items:stretch;padding:1.3rem}.acces-dossiers a{flex-shrink:1}}

.archives-tete{background:#f0eee9;color:#202529;border:0;border-top:3px solid #a12c39;padding:clamp(1.8rem,4vw,3.5rem)}
.archives-tete .etiquette{background:transparent;color:#a12c39;padding:0}
.archives-tete h1{font:650 clamp(2.8rem,6vw,5.3rem)/1.06 var(--serif);letter-spacing:-.04em;text-transform:none}
.archives-tete h1 span{color:#202529}
.archives-tete .sous-titre{font:450 clamp(1rem,1.6vw,1.2rem)/1.6 var(--sans);text-transform:none;max-width:65ch;color:#505457}
.fonds-legende{border:1px solid #d2cec6;gap:1px;background:#d2cec6}
.fonds-original,.fonds-presse{background:#fff;color:#202529;border:0}
.fonds-presse{background:#f0eee9}
.fonds-chiffre{font:650 clamp(2.8rem,5vw,4.8rem)/1 var(--serif);letter-spacing:-.04em}
.fonds-legende h2{font:700 clamp(1.15rem,2vw,1.55rem)/1.2 var(--sans);letter-spacing:-.02em}
.fonds-legende a{border-color:#bbb7b1;font-weight:700}
.chronologie-tete{border-color:#a12c39;border-bottom-width:2px}
.chronologie-tete h2{font:650 clamp(2rem,3.7vw,3.2rem)/1.15 var(--serif);letter-spacing:-.03em;text-transform:none}
.annees>li{border-bottom:1px solid #d9d5ce}
.annee{font:650 clamp(2.5rem,5vw,4.4rem)/1 var(--serif);letter-spacing:-.04em}
.annee-acces a{border:1px solid #d1ccc4}
.annee-acces a span:first-child{font-weight:700}
.lien-original{background:#fff}.lien-presse{background:#f0eee9}
.lien-original:hover,.lien-presse:hover{background:#e5dfd5}
.acces-dossiers{background:#eeece7;color:#202529;border-left:3px solid #a12c39}
.acces-dossiers div span{color:#a12c39}
.acces-dossiers div strong{font:650 clamp(1.15rem,2vw,1.65rem)/1.2 var(--serif);letter-spacing:0}
.acces-dossiers a{background:#a12c39;color:#fff;font-weight:700}
.acces-dossiers a:hover{background:#842631;color:#fff}

</style>
