---
import Base from '../../layouts/Base.astro';
import { tousLesArticles } from '../../lib/articles.mjs';

const articles = await tousLesArticles();
const parAnnee = new Map();
for (const a of articles) {
  const an = a.data.date.getFullYear();
  parAnnee.set(an, (parAnnee.get(an) ?? 0) + 1);
}
---
<Base titre="Archives" rubriqueActive="archives">
  <div class="titre-section">
    <h1><span>Archives<small>{articles.length.toLocaleString('fr-FR')} articles, année par année</small></span></h1>
  </div>
  <ul class="annees">
    {[...parAnnee].map(([an, n]) => (
      <li><a href={`/archives/${an}/`}><strong>{an}</strong><span class="greffe">{n.toLocaleString('fr-FR')} article{n > 1 ? 's' : ''}</span></a></li>
    ))}
  </ul>
</Base>

<style>
  .annees { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 0.75rem; }
  .annees a { display: flex; flex-direction: column; padding: 1rem; border: 1px solid var(--pierre); text-decoration: none; min-height: 44px; }
  .annees a:hover { border-color: var(--rouge-texte); }
  .annees strong { font-family: var(--affiche); font-weight: 400; font-size: 2rem; line-height: 1; }
  .annees span { color: var(--encre-2); margin-top: 0.35rem; font-size: 0.8rem; }
</style>
