---
import Base from '../../layouts/Base.astro';
import { tousLesArticles } from '../../lib/articles.mjs';

const articles = await tousLesArticles();
const parAnnee = new Map();
for (const a of articles) {
  const an = a.data.date.getFullYear();
  parAnnee.set(an, (parAnnee.get(an) ?? 0) + 1);
}
---
<Base titre="Archives" rubriqueActive="archives">
  <header class="titre-page">
    <p class="etiquette">Le fonds</p>
    <h1>Archives</h1>
    <p class="sous-titre">{articles.length.toLocaleString('fr-FR')} articles, année par année</p>
  </header>
  <p class="acces-presse"><a href="/archives/presse/">Explorer aussi les archives de la revue de presse</a><br /><span class="meta">Titres et liens repérés dans les alertes de veille, classés par année.</span></p>
  <ul class="annees">
    {[...parAnnee].map(([an, n]) => (
      <li><a href={`/archives/${an}/`}><strong>{an}</strong><span class="meta">{n.toLocaleString('fr-FR')} article{n > 1 ? 's' : ''}</span></a></li>
    ))}
  </ul>
</Base>

<style>
  .annees { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 0 2rem; }
  .annees a { display: flex; flex-direction: column; padding: 1rem 0; border-bottom: 1px solid var(--filet); min-height: 44px; }
  .annees strong { font-size: 2rem; line-height: 1; }
  .annees span { margin-top: 0.35rem; }
</style>
