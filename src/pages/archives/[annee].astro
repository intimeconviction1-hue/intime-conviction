---
import Base from '../../layouts/Base.astro';
import { rubrique } from '../../lib/rubriques.mjs';
import { tousLesArticles, nomDuMois } from '../../lib/articles.mjs';

export async function getStaticPaths() {
  const articles = await tousLesArticles();
  const annees = [...new Set(articles.map((a) => a.data.date.getFullYear()))];
  return annees.map((annee) => ({
    params: { annee: String(annee) },
    props: { articles: articles.filter((a) => a.data.date.getFullYear() === annee) },
  }));
}

const { articles } = Astro.props;
const { annee } = Astro.params;
// Une seule liste de titres par mois, sans extrait : 2009 compte plus de deux
// mille articles, une page d'extraits ne se parcourrait pas.
const parMois = new Map();
for (const a of articles) {
  const m = nomDuMois(a.data.date);
  if (!parMois.has(m)) parMois.set(m, []);
  parMois.get(m).push(a);
}
---
<Base titre={`Archives ${annee}`} description={`Consulter les ${articles.length.toLocaleString('fr-FR')} articles publiés par Intime Conviction en ${annee}, classés par mois et par rubrique.`} rubriqueActive="archives">
  <header class="titre-page">
    <p class="etiquette"><a href="/archives/">Archives</a></p>
    <h1>Archives {annee}</h1>
    <p class="sous-titre">{articles.length.toLocaleString('fr-FR')} article{articles.length > 1 ? 's' : ''} publié{articles.length > 1 ? 's' : ''} cette année-là</p>
  </header>
  {[...parMois].map(([mois, liste]) => (
    <section>
      <h2 class="mois etiquette">{mois} · {liste.length}</h2>
      <ul class="titres">
        {liste.map(({ data }) => (
          <li><a href={data.chemin}>{data.titre}</a> <span class="meta">{rubrique(data.rubrique).nom}</span></li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .mois { margin: 2.5rem 0 0.5rem; padding-top: 0.6rem; border-top: 3px solid var(--filet-fort); }
  .titres { list-style: none; padding: 0; margin: 0; columns: 22rem; column-gap: 2.5rem; }
  .titres li { break-inside: avoid; padding: 0.35rem 0; border-bottom: 1px solid var(--filet); line-height: 1.35; }
  .titres a { text-decoration: none; }


.titre-page{border-bottom:2px solid #a12c39}
.titre-page h1{font:650 clamp(2.3rem,5vw,4rem)/1.12 var(--serif);text-transform:none;letter-spacing:-.035em}
.titres a:hover{color:#a12c39;text-decoration:underline;text-underline-offset:.18em}
.titres li{padding:.55rem 0}

</style>
