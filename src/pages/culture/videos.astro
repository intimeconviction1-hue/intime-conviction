---
import Base from '../../layouts/Base.astro';
const videos = [
  {
    titre: "Cour d’assises : un juge face au « doute raisonnable »",
    type: 'Documentaire judiciaire',
    presentation: 'Un documentaire proposé par VIDOC sous le titre « Cour d’assises : un juge face au doute raisonnable ».',
    videoId: 'jro0ZEFX2ww',
    source: 'Chaîne YouTube VIDOC — Documentaires Complets en Français',
  },
  {
    titre: 'Meurtre à Caen : quand un fils tue son père — JEF',
    type: 'Documentaire judiciaire',
    presentation: 'Un documentaire de la chaîne Esprit de justice, publié sous le titre « Meurtre à Caen : quand un fils tue son père - JEF ».',
    videoId: 'ZMCna4ZSrFQ',
    start: 71,
    source: 'Chaîne YouTube Esprit de justice',
  },
  {
    titre: 'Au cœur d’un procès d’assises — Envoyé spécial',
    type: 'Reportage · Envoyé spécial',
    presentation: 'Un reportage d’Envoyé spécial consacré à un procès d’assises.',
    videoId: '6ELepzi4Nk4',
    source: 'Chaîne YouTube Élise Lucet',
  },
  {
    titre: 'Fabrice Da Silva, innocent ou coupable ?',
    type: 'Reportage judiciaire',
    presentation: 'Un reportage mis en ligne sous le titre « Fabrice Da Silva, Innocent ou Coupable ? Grand Reportage TF1 ».',
    videoId: 'HK2oSCtUyl4',
    source: 'Chaîne YouTube de Michèle Fines',
  },
  {
    titre: 'Attention, Aquitator, Monument d’Argumentation Persuasive !',
    type: 'Vidéo · Argumentation et persuasion',
    presentation: 'Une vidéo publiée sous le titre « Attention, Aquitator, Monument d’Argumentation Persuasive ! ».',
    videoId: 'KT4EKEyaphg',
    source: 'Chaîne YouTube de Baptiste Leber',
  },
  {
    titre: 'Le jour où j’ai été juré d’assises',
    type: 'Vidéo · Expérience de juré',
    presentation: 'Une vidéo consacrée à l’expérience de juré d’assises.',
    videoId: '5W98asfiWVw',
    source: 'Chaîne YouTube cnoby',
  },
  {
    titre: 'Un procès en cour d’assises',
    type: 'Documentaire · Déroulement d’un procès',
    presentation: 'Une présentation du déroulement d’un procès en cour d’assises, pour observer la salle d’audience et la place de ses acteurs.',
    videoId: '0w74mODGe3c',
    source: 'Chaîne YouTube de Pascal Goletto · mise en ligne sous le titre « exemple-assises »',
  },
  {
    titre: 'Justice en France : les meilleures audiences au tribunal',
    type: 'Émission judiciaire · Rediffusions et direct',
    presentation: 'Une sélection d’audiences françaises diffusées dans le cadre de l’émission Justice en France. Une ressource audiovisuelle pour observer les échanges à l’audience et les mécanismes du procès.',
    videoId: 'QPIOAn6chGc',
    source: 'Justice en France, sur YouTube',
  },
  {
    titre: 'Verdict : l’affaire Rist',
    type: 'Documentaire judiciaire · Affaire criminelle',
    presentation: 'Un documentaire de la série Verdict consacré à l’affaire Rist, proposé parmi les ressources audiovisuelles sélectionnées par la rédaction.',
    videoId: 'yRLSB_Oa5AI',
    source: 'Verdict, sur YouTube',
  },
];
---
<Base titre="À voir et à écouter" description="Une sélection de vidéos, documentaires, archives et entretiens consacrés aux audiences et à la justice.">
  <div class="video-dossier">
    <nav class="fil" aria-label="Fil d’Ariane"><a href="/">Accueil</a> <span aria-hidden="true">›</span> <a href="/rubrique/le-greffe/">Livres, films et histoire</a> <span aria-hidden="true">›</span> À voir et à écouter</nav>
    <header class="video-intro">
      <p class="sur-titre">Analyses &amp; culture</p>
      <h1>À voir et à écouter</h1>
      <p>Documentaires, archives, témoignages et émissions : des images et des voix pour éclairer la justice criminelle. Chaque référence est présentée avec sa provenance. Les vidéos extérieures ne sont pas des productions d’Intime Conviction.</p>
    </header>
    <section aria-labelledby="selection-video">
      <h2 id="selection-video">Notre sélection</h2>
      <ul class="videos">
        {videos.map(v => <li>
          <article>
            <div class="video-cadre"><iframe src={`https://www.youtube-nocookie.com/embed/${v.videoId}${v.start ? `?start=${v.start}` : ''}`} title={`Visionner ${v.titre}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
            <div class="video-texte">
              <p class="nature">{v.type}</p>
              <h3>{v.titre}</h3>
              <p>{v.presentation}</p>
              <p class="source">Source : {v.source}</p>
            </div>
          </article>
        </li>)}
      </ul>
      <p class="note">Le contenu des diffusions en direct peut évoluer. Les propos tenus dans les vidéos restent ceux de leurs auteurs ou intervenants.</p>
    </section>
  </div>
</Base>
<style>
.video-dossier{max-width:1080px;margin:0 auto;padding:2.5rem 0 5rem}
.fil{font:600 .76rem/1.5 var(--sans);display:flex;gap:.7rem;flex-wrap:wrap;margin-bottom:2rem;color:var(--encre-2)}
.fil a{text-decoration:underline;text-underline-offset:3px}
.video-intro{border-top:4px solid currentColor;border-bottom:1px solid var(--filet);padding:2rem 0 2.5rem;margin-bottom:3rem}
.sur-titre,.nature{font:800 .72rem/1.5 var(--sans);letter-spacing:.08em;text-transform:uppercase}
.video-intro h1{font-size:clamp(2.3rem,5vw,4.3rem);line-height:1.06;letter-spacing:-.04em;margin:.7rem 0 1rem}
.video-intro>p:last-child{max-width:780px;font-size:1.15rem;line-height:1.65;color:var(--encre-2)}
h2{font-size:1.55rem;margin:0 0 1.6rem}
.videos{list-style:none;margin:0;padding:0}
.videos article{display:grid;grid-template-columns:minmax(240px,1fr) minmax(0,1.25fr);gap:2.2rem;padding:1.4rem 0;border-top:1px solid var(--filet)}
.video-cadre{background:#17191a;aspect-ratio:16/9;min-width:0;overflow:hidden}
.video-cadre iframe{display:block;width:100%;height:100%;border:0}
.video-texte h3{font-size:clamp(1.45rem,2.5vw,2.1rem);line-height:1.2;margin:.5rem 0 1rem}
.video-texte>p:not(.nature){line-height:1.65;color:var(--encre-2)}
.source,.note{font:500 .83rem/1.6 var(--sans)}
.note{margin-top:2rem;color:var(--encre-2)}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
@media(max-width:700px){.video-dossier{padding:1.5rem 0 3rem}.videos article{grid-template-columns:1fr;gap:1rem}}
</style>
