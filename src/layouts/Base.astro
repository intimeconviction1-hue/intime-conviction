---
// L'axe optique de Newsreader ouvre le texte courant aux petites tailles.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/gloock/latin.css';
import '@fontsource/courier-prime/latin-400.css';
import '../styles/global.css';
import { RUBRIQUES } from '../lib/rubriques.mjs';

const { titre, description = "Intime Conviction, le média des cours d'assises : suivi d'audience, règles du procès, chroniques et culture criminelle.", rubriqueActive } = Astro.props;
const titreComplet = titre ? `${titre} · Intime Conviction` : "Intime Conviction · Le média des cours d'assises";
const canonique = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="theme-color" content="#6e0f1a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="robe">
      <div class="cadre">
        <a class="titre-du-journal" href="/">
          <strong>Intime Conviction</strong>
          <span class="greffe">Le média des cours d'assises</span>
        </a>
      </div>
      <nav class="rubriques-nav" aria-label="Rubriques">
        <div class="cadre">
          <ul>
            {RUBRIQUES.map((r) => (
              <li><a class="greffe" href={`/rubrique/${r.slug}/`} aria-current={rubriqueActive === r.slug ? 'page' : undefined}>{r.nom}</a></li>
            ))}
            <li><a class="greffe" href="/archives/" aria-current={rubriqueActive === 'archives' ? 'page' : undefined}>Archives</a></li>
          </ul>
        </div>
      </nav>
      <div class="epitoge" aria-hidden="true"></div>
    </header>

    <main id="contenu" class="cadre">
      <slot />
    </main>

    <footer class="pied robe">
      <div class="epitoge" aria-hidden="true"></div>
      <div class="cadre">
        <strong>Intime Conviction</strong>
        <p class="greffe" style="margin:0"><a href="https://x.com/IntimeConv" rel="noopener">@IntimeConv sur X</a></p>
      </div>
    </footer>
  </body>
</html>
