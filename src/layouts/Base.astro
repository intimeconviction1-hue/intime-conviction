---
// Newsreader en graisse variable seule : la version à axe optique pesait
// 279 Ko (romain + italique) pour 122 ici, sans écart visible au corps de
// lecture. L'italique ne sert qu'aux sous-titres de rubrique et aux citations.
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource/gloock/latin.css';
import '@fontsource/courier-prime/latin-400.css';
import '../styles/global.css';
// Les trois fichiers du premier écran, préchargés : sans ça, les titres
// s'affichent d'abord dans la police de secours puis « sautent ».
import policeTitre from '@fontsource/gloock/files/gloock-latin-400-normal.woff2?url';
import policeTexte from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import policeGreffe from '@fontsource/courier-prime/files/courier-prime-latin-400-normal.woff2?url';
import { RUBRIQUES } from '../lib/rubriques.mjs';

const { titre, description = "Intime Conviction, le média des cours d'assises : suivi d'audience, règles du procès, chroniques et culture criminelle.", rubriqueActive, accueil = false } = Astro.props;
const EnTete = accueil ? 'h1' : 'p';
const titreComplet = titre ? `${titre} · Intime Conviction` : "Intime Conviction · Le média des cours d'assises";
const canonique = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="theme-color" content="#6e0f1a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {[policeTitre, policeTexte, policeGreffe].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="robe">
      <div class="cadre">
        <EnTete class="titre-du-journal">
          <a href="/">
            <strong>Intime Conviction</strong>
            <span class="greffe">Le média des cours d'assises</span>
          </a>
        </EnTete>
      </div>
      <nav class="rubriques-nav" aria-label="Rubriques">
        <div class="cadre">
          <ul>
            {RUBRIQUES.map((r) => (
              <li><a class="greffe" href={`/rubrique/${r.slug}/`} aria-current={rubriqueActive === r.slug ? 'page' : undefined}>{r.nom}</a></li>
            ))}
            <li><a class="greffe" href="/archives/" aria-current={rubriqueActive === 'archives' ? 'page' : undefined}>Archives</a></li>
          </ul>
        </div>
      </nav>
      <div class="epitoge" aria-hidden="true"></div>
    </header>

    <main id="contenu" class="cadre">
      <slot />
    </main>

    <footer class="pied robe">
      <div class="epitoge" aria-hidden="true"></div>
      <div class="cadre">
        <strong>Intime Conviction</strong>
        <p class="greffe"><a href="https://x.com/IntimeConv" rel="noopener">@IntimeConv sur X</a></p>
      </div>
    </footer>
  </body>
</html>
