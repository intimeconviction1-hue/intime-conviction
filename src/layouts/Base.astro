---
// Une seule typographie : Libre Franklin, droite et en graisses fortes.
import '@fontsource-variable/libre-franklin/wght.css';
import '@fontsource-variable/newsreader/wght.css';
import '../styles/global.css';
import frontonAssises from '../assets/fronton-cour-dassises.jpg';
// Précharger la police d'interface, employée également pour les titres.
import policeSans from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import { RUBRIQUES } from '../lib/rubriques.mjs';

const { titre, description = "Intime Conviction, journal consacré aux procès criminels : actualité des audiences, verdicts, analyses et archives judiciaires.", rubriqueActive, accueil = false, noindex = false, image, article, imageAlt = "Image d'Intime Conviction" } = Astro.props;
// Le nom du journal est le titre principal (h1) de la seule page d'accueil ;
// ailleurs c'est un paragraphe, le h1 revenant au titre de la page.
const Marque = 'p';
const titreComplet = titre ? `${titre} · Intime Conviction` : "Intime Conviction | Le journal des cours d'assises";
const canonique = new URL(Astro.url.pathname, Astro.site);
// À l'accueil, une image éditoriale propre au journal ; chaque article pourra
// fournir sa propre photographie sans illustration trompeuse.
const imagePartage = image ? new URL(image, Astro.site).href : (accueil ? new URL(frontonAssises.src, Astro.site).href : null);
const annee = new Date().getFullYear();
// Les pages-outils restent à leur adresse historique, mais relèvent d'une rubrique.
const rattachement = {
  comprendre: 'le-banc-des-jures', annuaire: 'le-banc-des-jures', carte: 'le-banc-des-jures',
  dossiers: 'l-expose', chronologie: 'l-expose'
};
const rubriqueCourante = rattachement[rubriqueActive] ?? rubriqueActive;
const menusRubriques = {
  'cours-du-jour': { accroche:'Suivre les procès criminels', liens:[{nom:'Les actualités',href:'/rubrique/cours-du-jour/'},{nom:'Agenda des audiences',href:'/agenda/'},{nom:'Rôles officiels',href:'/veille-roles/'}] },
  'le-banc-des-jures': { accroche:'Comprendre le procès et ses acteurs', liens:[{nom:'Comprendre les assises',href:'/comprendre/'},{nom:'Assister à une audience',href:'/assister/'},{nom:'Trouver une cour',href:'/annuaire/'}] },
  'la-cour-se-leve': { accroche:'Récits et chroniques d’audience', liens:[{nom:'Lire les chroniques',href:'/rubrique/la-cour-se-leve/'},{nom:'Parcourir les archives',href:'/archives/'}] },
  'delibere': { accroche:'Regards et débats sur la justice', liens:[{nom:'Lire les réflexions',href:'/rubrique/delibere/'},{nom:'Notre ligne éditoriale',href:'/ligne-editoriale/'}] },
  'l-expose': { accroche:'Éclairer les affaires et les décisions', liens:[{nom:'Dossiers judiciaires',href:'/dossiers/'},{nom:'Chronologie des affaires',href:'/chronologie/'},{nom:'Jurisprudence criminelle',href:'/jurisprudence/'}] },
  'le-greffe': { accroche:'La justice dans l’histoire et la culture', liens:[{nom:'Livres et cinéma',href:'/rubrique/le-greffe/#titre-culture'},{nom:'Archives du journal',href:'/archives/'}] }
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "max-image-preview:large"} />
    <link rel="canonical" href={canonique} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:site_name" content="Intime Conviction" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.datePublished} />}
    {article?.dateModified && <meta property="article:modified_time" content={article.dateModified} />}
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    {imagePartage && <meta property="og:image" content={imagePartage} />}
    {imagePartage && <meta property="og:image:alt" content={image ? imageAlt : "Fronton d'une cour d'assises"} />}
    {article && <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@type':'Article',
      headline:article.headline,
      description,
      datePublished:article.datePublished,
      ...(article.dateModified ? { dateModified:article.dateModified } : {}),
      ...(article.author ? { author:{'@type':'Person',name:article.author} } : {}),
      publisher:{'@type':'Organization',name:'Intime Conviction',url:'https://www.intimeconviction.fr/'},
      mainEntityOfPage:canonique.href,
      inLanguage:'fr-FR'
    })} />}
    <meta name="twitter:card" content={imagePartage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    {imagePartage && <meta name="twitter:image" content={imagePartage} />}
    {accueil && <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'WebSite', name:'Intime Conviction', alternateName:'Le journal des cours d’assises', url:'https://www.intimeconviction.fr/', description, inLanguage:'fr-FR' })} />}
    <meta name="theme-color" content="#121314" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {[policeSans].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  </head>
  <body class:list={{'avec-fond':accueil}}>
    <slot name="fond" />
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="barre cadre">
        <div class="identite-journal">
          <Marque class="marque"><a href="/" aria-label="Intime Conviction, accueil"><span class="marque-mot"><span class="marque-intime">INTIME</span><span class="marque-conviction">CONVICTION<span class="marque-point">.</span></span></span></a></Marque>
          <p class="signature">Le journal des cours d’assises</p>
        </div>
        <a class="recherche-lien" href="/recherche/" aria-label="Rechercher dans les articles"><span>Rechercher</span><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a>
      </div>
      <nav class="rubriques-nav" aria-label="Rubriques">
        <ul class="cadre">
          {RUBRIQUES.map(r=><li class="rubrique-menu-item">
            <a href={`/rubrique/${r.slug}/`} aria-current={rubriqueCourante===r.slug?'page':undefined}>{r.nom}</a>
            <button type="button" class="rubrique-menu-bouton" aria-label={`Explorer ${r.nom}`} aria-expanded="false" aria-controls={`menu-${r.slug}`} data-menu-toggle={r.slug}><svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button>
          </li>)}
        </ul>
      </nav>
      <div class="rubrique-menus" data-rubrique-menus>
        {RUBRIQUES.map(r=>(
          <section id={`menu-${r.slug}`} class="rubrique-menu-panneau" data-menu-panel={r.slug} aria-label={`Explorer ${r.nom}`} hidden>
            <div class="cadre rubrique-menu-interieur">
              <div class="rubrique-menu-presentation">
                <p class="rubrique-menu-sur">À DÉCOUVRIR</p>
                <h2>{r.nom}</h2>
                <p>{menusRubriques[r.slug].accroche}</p>
              </div>
              <div class="rubrique-menu-liens">
                {menusRubriques[r.slug].liens.map(l=><a href={l.href}>{l.nom}<span aria-hidden="true">↗</span></a>)}
              </div>
              <button class="rubrique-menu-fermer" type="button" data-menu-close aria-label="Fermer le menu">×</button>
            </div>
          </section>
        ))}
      </div>
    </header>

    <main id="contenu" class="cadre">
      <slot />
    </main>

    <footer class="pied">
      <div class="cadre">
        <div class="pied-intro"><a class="pied-nom" href="/">INTIME<br /><span>CONVICTION.</span></a><p>Le journal des cours d’assises. Actualité des procès criminels, analyses judiciaires et archives.</p></div>
        <nav aria-label="Les rubriques du journal"><ul>{RUBRIQUES.map(r=><li><a href={`/rubrique/${r.slug}/`}>{r.nom}</a></li>)}<li><a href="/boutique/">La Boutique</a></li><li><a href="/archives/">Archives</a></li><li><a href="/dossiers/">Dossiers judiciaires</a></li><li><a href="/chronologie/">Chronologie judiciaire</a></li><li><a href="/carte/">Carte des juridictions</a></li><li><a href="/annuaire/">Annuaire des cours d’assises</a></li><li><a href="/agenda/">Agenda des sessions criminelles</a></li><li><a href="/veille-roles/">Veille des rôles officiels</a></li><li><a href="/comprendre/">Comprendre les assises</a></li><li><a href="/assister/">Assister à une audience</a></li><li><a href="/jurisprudence/">Jurisprudence criminelle</a></li><li><a href="/recherche/">Rechercher un article</a></li><li><a href="/archives/presse/">Archives de presse</a></li><li><a href="/archives/presse/rechercher/">Rechercher dans la presse</a></li><li><a href="/ligne-editoriale/">Notre ligne éditoriale</a></li><li><a href="/mentions-legales/">Mentions légales</a></li></ul></nav>
        <div class="pied-bas"><span>Intime Conviction · {annee}</span><a href="https://x.com/IntimeConv" rel="noopener">@IntimeConv sur X</a><a href="#contenu">Retour en haut <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 20V4m-6 6 6-6 6 6"/></svg></a></div>
      </div>
    </footer>
  <script>
    const boutons = [...document.querySelectorAll<HTMLButtonElement>('[data-menu-toggle]')];
    const panneaux = [...document.querySelectorAll<HTMLElement>('[data-menu-panel]')];
    const entete = document.querySelector<HTMLElement>('.entete');
    const fermer = () => {
      boutons.forEach(b=>b.setAttribute('aria-expanded','false'));
      panneaux.forEach(p=>p.hidden=true);
    };
    boutons.forEach(b=>b.addEventListener('click',()=>{
      const id=b.dataset.menuToggle;
      const dejaOuvert=b.getAttribute('aria-expanded')==='true';
      fermer();
      if(!dejaOuvert){
        b.setAttribute('aria-expanded','true');
        const panneau=panneaux.find(p=>p.dataset.menuPanel===id);
        if(panneau) panneau.hidden=false;
      }
    }));
    entete?.querySelectorAll<HTMLButtonElement>('[data-menu-close]').forEach(b=>b.addEventListener('click',()=>{
      const actif=b.closest<HTMLElement>('[data-menu-panel]')?.dataset.menuPanel;
      fermer();
      boutons.find(x=>x.dataset.menuToggle===actif)?.focus();
    }));
    document.addEventListener('keydown',e=>{
      if(e.key==='Escape'){
        const actif=boutons.find(b=>b.getAttribute('aria-expanded')==='true');
        if(actif){fermer();actif.focus();}
      }
    });
    document.addEventListener('pointerdown',e=>{
      if(entete && e.target instanceof Node && !entete.contains(e.target)) fermer();
    });
    entete?.addEventListener('focusout',e=>{
      if(e.relatedTarget instanceof Node && !entete.contains(e.relatedTarget)) fermer();
    });
  </script>
  <style is:global>
    /* Identité éditoriale commune à l'ensemble du site. */
    .entete,.avec-fond .entete{background:#f7f5f0;color:#22282a;border-top:3px solid #9b303d;border-bottom:0}
    .entete .barre{min-height:124px;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}
    .identite-journal{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-width:0;padding:1.15rem 0 1rem;gap:.5rem}
    .identite-journal .marque{margin:0}
    .identite-journal .marque a{display:inline-flex;min-height:0;padding:0;font:750 clamp(2.2rem,4.3vw,4.1rem)/.98 var(--sans);letter-spacing:-.067em}
    .identite-journal .marque-mot{display:inline-flex;align-items:center;gap:.13em;white-space:nowrap}
    .identite-journal .marque-intime{color:#252a2d}
    .identite-journal .marque-conviction{display:inline-block;background:#a12c39;color:#fff;padding:.13em .16em .16em;line-height:1}
    .identite-journal .marque-point{color:#fff}
    .identite-journal .signature,.avec-fond .identite-journal .signature{display:flex;align-items:center;gap:.85rem;margin:.23rem 0 0;padding:0;font:700 clamp(.96rem,1.32vw,1.12rem)/1.35 var(--sans);letter-spacing:.012em;text-transform:none;max-width:none;color:#363b3e}
    .identite-journal .signature::before{content:'';display:block;flex:none;width:32px;height:3px;background:#a12c39}
    .entete .recherche-lien{display:inline-flex;gap:.6rem;width:auto;min-width:0;min-height:44px;height:44px;border:1px solid #bbb4ad;color:#303638;border-radius:0;margin-left:auto;padding:.5rem .85rem;font:650 .75rem/1.3 var(--sans)}
    .entete .recherche-lien span{position:static;width:auto;height:auto;overflow:visible;clip-path:none;white-space:nowrap}
    .entete .recherche-lien svg{width:18px;height:18px}
    .entete .recherche-lien:hover,.avec-fond .entete .recherche-lien:hover{background:#9b303d;border-color:#9b303d;color:#fff!important}
    .entete .rubriques-nav,.avec-fond .entete .rubriques-nav{background:#edeae4;border-top:1px solid #d8d2cb;border-bottom:1px solid #d8d2cb}
    .entete .rubriques-nav ul{display:flex;justify-content:space-between;align-items:stretch;gap:clamp(1.2rem,2.3vw,2.35rem);overflow-x:auto;overflow-y:hidden;scrollbar-width:thin;scrollbar-color:#b9b1aa transparent;padding-block:0}
    .entete .rubriques-nav li{flex-shrink:0}
    .entete .rubriques-nav a,.avec-fond .entete .rubriques-nav a{display:flex;align-items:center;min-height:56px;padding:0;font:750 clamp(.8rem,1.03vw,.92rem)/1.25 var(--sans);text-transform:none;letter-spacing:0;color:#313638;white-space:nowrap;box-shadow:none;background:transparent;flex-shrink:0}
    .entete .rubriques-nav a::after{height:2px;bottom:0;background:#9b303d!important}
    .entete .rubriques-nav a:hover,.avec-fond .entete .rubriques-nav a:hover{color:#9b303d}
    .entete .rubriques-nav a[aria-current='page'],.avec-fond .entete .rubriques-nav a[aria-current='page']{color:#8c2935;border-bottom:2px solid #9b303d;box-shadow:none;background:transparent}
    /* Sous-menus ouverts par bouton : le nom de rubrique reste un lien direct. */
    .entete .rubriques-nav .rubrique-menu-item{display:flex;align-items:center;gap:.22rem;flex-shrink:0}
    .entete .rubriques-nav .rubrique-menu-bouton{display:grid;place-items:center;min-width:28px;width:28px;height:38px;padding:0;background:transparent;border:0;color:#505456;cursor:pointer}
    .entete .rubriques-nav .rubrique-menu-bouton:hover,.entete .rubriques-nav .rubrique-menu-bouton[aria-expanded="true"]{color:#a12c39;background:#e4ddd5}
    .entete .rubriques-nav .rubrique-menu-bouton[aria-expanded="true"] svg{transform:rotate(180deg)}
    .entete .rubrique-menus{position:relative;z-index:20}
    .entete .rubrique-menu-panneau[hidden]{display:none!important}
    .entete .rubrique-menu-panneau{position:absolute;top:0;left:0;right:0;background:#f7f5f0;border-bottom:2px solid #a12c39;box-shadow:0 15px 25px #1d212622;color:#262b2e}
    .entete .rubrique-menu-interieur{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) auto;gap:2.5rem;padding-block:1.7rem 1.9rem;align-items:start}
    .entete .rubrique-menu-sur{font:750 .65rem/1.3 var(--sans);letter-spacing:.08em;color:#a12c39;margin:0 0 .45rem}
    .entete .rubrique-menu-presentation h2{font:750 clamp(1.4rem,2vw,1.9rem)/1.1 var(--sans);margin:0 0 .6rem}
    .entete .rubrique-menu-presentation>p:last-child{font:450 .88rem/1.5 var(--sans);color:#555b5e;margin:0}
    .entete .rubrique-menu-liens{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem 1.3rem}
    .entete .rubrique-menu-liens a,.avec-fond .entete .rubrique-menu-liens a{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.68rem 0;border-bottom:1px solid #d5d0c9;color:#2f3336;font:700 .83rem/1.35 var(--sans)}
    .entete .rubrique-menu-liens a:hover{color:#a12c39}
    .entete .rubrique-menu-fermer{display:grid;place-items:center;background:transparent;color:#35393b;border:1px solid #b8b2aa;border-radius:0;width:38px;height:38px;padding:0;font:400 1.5rem/1 var(--sans);cursor:pointer}
    .entete .rubrique-menu-fermer:hover{background:#a12c39;color:#fff}
    .entete .rubrique-menu-bouton:focus-visible,.entete .rubrique-menu-fermer:focus-visible{outline:2px solid #a12c39;outline-offset:2px}
    @media(max-width:47.99rem){
      .entete .rubrique-menu-interieur{grid-template-columns:minmax(0,1fr) auto;gap:1.1rem;padding-block:1.15rem}
      .entete .rubrique-menu-liens{grid-column:1/-1;grid-row:2;grid-template-columns:1fr}
      .entete .rubrique-menu-fermer{grid-column:2;grid-row:1}
      .entete .rubriques-nav .rubrique-menu-bouton{width:30px;min-width:30px}
    }
    .entete .rubriques-nav a:focus-visible,.entete .recherche-lien:focus-visible,.entete .marque a:focus-visible{outline:2px solid #9b303d;outline-offset:3px}
    @media(max-width:63.99rem){
      .entete .barre{min-height:105px}
      .identite-journal .marque a{font-size:clamp(1.75rem,4.4vw,3rem)}
      .entete .rubriques-nav ul{justify-content:flex-start;gap:1.85rem}
    }
    @media(max-width:47.99rem){
      .entete .barre{min-height:88px;gap:.65rem}
      .identite-journal{padding:.75rem 0;gap:.35rem}
      .identite-journal .marque a{font-size:clamp(1.28rem,5.35vw,2.1rem);letter-spacing:-.06em}
      .identite-journal .marque-mot{gap:.1em}
      .identite-journal .signature,.avec-fond .identite-journal .signature{font-size:clamp(.76rem,2.65vw,.9rem);letter-spacing:0;gap:.55rem}
      .identite-journal .signature::before{width:21px;height:2px}
      .entete .recherche-lien{min-width:42px;width:42px;height:42px;padding:0;justify-content:center;flex-shrink:0}
      .entete .recherche-lien span{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
      .entete .rubriques-nav ul{justify-content:flex-start;gap:1.35rem;padding-inline:1.15rem;scroll-snap-type:x proximity}
      .entete .rubriques-nav a,.avec-fond .entete .rubriques-nav a{min-height:49px;font-size:.82rem}
      .entete .rubriques-nav li{scroll-snap-align:start}
    }
    @media(max-width:23rem){
      .identite-journal .marque a{font-size:1.16rem}
      .identite-journal .signature,.avec-fond .identite-journal .signature{font-size:.74rem}
    }
  </style>
  </body>
</html>
