---
// Newsreader en graisse variable seule (122 Ko romain + italique, contre 279
// pour la version à axe optique) et Libre Franklin pour la voix « journal ».
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/libre-franklin/wght.css';
import '../styles/global.css';
import frontonAssises from '../assets/fronton-cour-dassises.jpg';
// Les deux fichiers du premier écran, préchargés : sans ça, les titres
// s'affichent d'abord dans la police de secours puis « sautent ».
import policeTexte from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import policeSans from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import { RUBRIQUES } from '../lib/rubriques.mjs';

const { titre, description = "Intime Conviction, le site des cours d'assises : suivre les audiences, comprendre les procès criminels, retrouver les verdicts et les récits d'assises.", rubriqueActive, accueil = false, image, imageAlt = "Image d'Intime Conviction" } = Astro.props;
// Le nom du journal est le titre principal (h1) de la seule page d'accueil ;
// ailleurs c'est un paragraphe, le h1 revenant au titre de la page.
const Marque = 'p';
const titreComplet = titre ? `${titre} · Intime Conviction` : "Intime Conviction | Le site des cours d'assises";
const canonique = new URL(Astro.url.pathname, Astro.site);
// À l'accueil, une image éditoriale propre au journal ; chaque article pourra
// fournir sa propre photographie sans illustration trompeuse.
const imagePartage = image ? new URL(image, Astro.site).href : (accueil ? new URL(frontonAssises.src, Astro.site).href : null);
const annee = new Date().getFullYear();
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="canonical" href={canonique} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:site_name" content="Intime Conviction" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    {imagePartage && <meta property="og:image" content={imagePartage} />}
    {imagePartage && <meta property="og:image:alt" content={image ? imageAlt : "Fronton d'une cour d'assises"} />}
    <meta name="twitter:card" content={imagePartage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    {imagePartage && <meta name="twitter:image" content={imagePartage} />}
    {accueil && <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'WebSite', name:'Intime Conviction', alternateName:'Le site des cours d’assises', url:'https://www.intimeconviction.fr/', description, inLanguage:'fr-FR' })} />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101010" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {[policeTexte, policeSans].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  </head>
  <body class:list={{'avec-fond':accueil}}>
    <slot name="fond" />
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="surbarre cadre" aria-label="Informations du journal">
        <span>LE JOURNAL DES COURS D’ASSISES</span>
        <span>RÉCITS D’AUDIENCE <span aria-hidden="true">·</span> DÉCRYPTAGES <span aria-hidden="true">·</span> MÉMOIRE</span>
        <a href="/archives/">Explorer les archives <span aria-hidden="true">↗</span></a>
      </div>
      <div class="barre cadre">
        <Marque class="marque"><a href="/" aria-label="Intime Conviction, accueil"><span class="marque-mot">Intime<span class="marque-point">.</span>Conviction</span></a></Marque>
        <p class="signature">Des vies se jouent.<br />Les assises se racontent.</p>
        <a class="recherche-lien" href="/recherche/" aria-label="Rechercher dans les articles"><span>Rechercher</span><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a>
      </div>
      <nav class="rubriques-nav" aria-label="Rubriques">
        <ul class="cadre">
          {RUBRIQUES.map(r=><li><a href={`/rubrique/${r.slug}/`} aria-current={rubriqueActive===r.slug?'page':undefined}>{r.nom}</a></li>)}
          <li><a href="/archives/" aria-current={rubriqueActive==='archives'?'page':undefined}>Archives</a></li>
        </ul>
      </nav>
    </header>

    <main id="contenu" class="cadre">
      <slot />
    </main>

    <footer class="pied">
      <div class="cadre">
        <div class="pied-intro"><a class="pied-nom" href="/">Intime<br /><span>Conviction.</span></a><p>Le site des cours d’assises. Suivre les audiences, comprendre le procès, regarder la justice à hauteur humaine.</p></div>
        <nav aria-label="Les rubriques du journal"><ul>{RUBRIQUES.map(r=><li><a href={`/rubrique/${r.slug}/`}>{r.nom}</a></li>)}<li><a href="/archives/">Archives</a></li><li><a href="/recherche/">Rechercher un article</a></li><li><a href="/archives/presse/">Archives de presse</a></li><li><a href="/ligne-editoriale/">Notre ligne éditoriale</a></li></ul></nav>
        <div class="pied-bas"><span>Intime Conviction · {annee}</span><a href="https://x.com/IntimeConv" rel="noopener">@IntimeConv sur X</a><a href="#contenu">Retour en haut <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 20V4m-6 6 6-6 6 6"/></svg></a></div>
      </div>
    </footer>
  </body>
</html>
