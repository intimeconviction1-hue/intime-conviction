---
// Une seule typographie : Libre Franklin, droite et en graisses fortes.
import '@fontsource-variable/libre-franklin/wght.css';
import '@fontsource-variable/newsreader/wght.css';
import '../styles/global.css';
import croquisEntete from '../assets/code-procedure-penale-croquis.webp';
import frontonAssises from '../assets/fronton-cour-dassises.jpg';
// Précharger la police d'interface, employée également pour les titres.
import policeSans from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import { tousLesArticles } from '../lib/articles.mjs';
import { RUBRIQUES } from '../lib/rubriques.mjs';

const { titre, description = "Intime Conviction, journal consacré aux procès criminels : actualité des audiences, verdicts, analyses et archives judiciaires.", accueil = false, noindex = false, image, article, imageAlt = "Image d'Intime Conviction" } = Astro.props;
// Le nom du journal est le titre principal (h1) de la seule page d'accueil ;
// ailleurs c'est un paragraphe, le h1 revenant au titre de la page.
const Marque = 'p';
const titreComplet = titre ? `${titre} · Intime Conviction` : "Intime Conviction | Le journal des cours d'assises";
const canonique = new URL(Astro.url.pathname, Astro.site);
// À l'accueil, une image éditoriale propre au journal ; chaque article pourra
// fournir sa propre photographie sans illustration trompeuse.
const imagePartage = image ? new URL(image, Astro.site).href : (accueil ? new URL(frontonAssises.src, Astro.site).href : null);
const annee = new Date().getFullYear();
const articlesEdition = await tousLesArticles();
const edition = articlesEdition.find(({data}) => data.verificationEnCours !== true)?.data.date;
const formatEdition = new Intl.DateTimeFormat('fr-FR', {
  timeZone: 'Europe/Paris', day: 'numeric', month: 'long', year: 'numeric',
});
const heureEdition = new Intl.DateTimeFormat('fr-FR', {
  timeZone: 'Europe/Paris', hour: '2-digit', minute: '2-digit',
});
const reseaux = {
  x: 'https://x.com/IntimeConv',
  instagram: 'https://www.instagram.com/inti.meconviction/',
  facebook: 'https://www.facebook.com/profile.php?id=100062932463597',
};
const navigation = [
  { titre: 'Nos articles', href: '/rubrique/cours-du-jour/#articles-redaction', liens: [
    {titre:'Chroniques d’audience',href:'/rubrique/la-cour-se-leve/'},
  ] },
  { titre: 'Agenda', href: '/agenda/', liens: [
    {titre:'Sources de l’agenda',href:'/veille-roles/'},
  ] },
  { titre: 'Dossiers', href: '/dossiers/', liens: [
    {titre:'Chronologie des affaires',href:'/chronologie/'},
  ] },
  { titre: 'Comprendre', href: '/comprendre/', liens: [
    {titre:'Les jurés et les acteurs du procès',href:'/rubrique/le-banc-des-jures/'},
    {titre:'Jurisprudence',href:'/jurisprudence/'},
  ] },
  { titre: 'Archives', href: '/archives/', liens: [
    {titre:'Archives de presse',href:'/archives/presse/'},
  ] },
];
const accesDirects = [
  { href: '/rubrique/cours-du-jour/#actualites', titre: 'Revue de presse' },
  { href: '/annuaire/#repertoire', titre: 'Trouver un tribunal' },
  { href: '/carte/', titre: 'Carte des affaires' },
  { href: '/assister/', titre: 'Assister à un procès' },
];
const piedNavigation = [
  { titre: 'Le journal', liens: [
    ...RUBRIQUES.map(r=>({titre:r.libelle,href:`/rubrique/${r.slug}/`})),
    {titre:'Archives du journal',href:'/archives/'},
    {titre:'Revue de presse',href:'/archives/presse/'},
  ] },
  { titre: 'Infos pratiques', liens: [
    {titre:'Agenda des sessions',href:'/agenda/'},
    {titre:'Assister à une audience',href:'/assister/'},
    {titre:'Liste des juridictions',href:'/annuaire/#repertoire'},
    {titre:'Carte des affaires',href:'/carte/'},
  ] },
  { titre: 'À propos', liens: [
    {titre:'Ligne éditoriale',href:'/ligne-editoriale/'},
    {titre:'Flux RSS',href:'/feed.xml'},
    {titre:'Boutique',href:'/boutique/'},
    {titre:'Mentions légales',href:'/mentions-legales/'},
  ] },
];
const courant = href => Astro.url.pathname === href ? 'page' : undefined;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "max-image-preview:large"} />
    <link rel="canonical" href={canonique} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:site_name" content="Intime Conviction" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.datePublished} />}
    {article?.dateModified && <meta property="article:modified_time" content={article.dateModified} />}
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    {imagePartage && <meta property="og:image" content={imagePartage} />}
    {imagePartage && <meta property="og:image:alt" content={image ? imageAlt : "Fronton d'une cour d'assises"} />}
    {article && <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@type':article.type,
      '@id':canonique.href+'#article',
      headline:article.headline,
      description,
      datePublished:article.datePublished,
      ...(article.dateModified ? { dateModified:article.dateModified } : {}),
      ...(article.author ? { author:{'@type':article.authorType,name:article.author,...(article.authorType === 'Organization' ? {url:new URL('/ligne-editoriale/',Astro.site).href} : {})} } : {}),
      publisher:{'@id':'https://www.intimeconviction.fr/#organisation'},
      ...(imagePartage ? {image:[imagePartage]} : {}),
      mainEntityOfPage:canonique.href,
      isAccessibleForFree:true,
      inLanguage:'fr-FR'
    })} />}
    <meta name="twitter:card" content={imagePartage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    {imagePartage && <meta name="twitter:image" content={imagePartage} />}
    {accueil && <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'WebSite', '@id':'https://www.intimeconviction.fr/#site', name:'Intime Conviction', alternateName:'Le journal des cours d’assises', url:'https://www.intimeconviction.fr/', description, inLanguage:'fr-FR' })} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@type':'Organization',
      '@id':'https://www.intimeconviction.fr/#organisation',
      name:'Intime Conviction',
      url:'https://www.intimeconviction.fr/',
      description:"Média français consacré aux procès criminels, aux cours d'assises et à la justice pénale.",
      logo:new URL('/favicon.svg',Astro.site).href,
      sameAs:Object.values(reseaux)
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@type':'WebPage',
      '@id':canonique.href+'#page',
      url:canonique.href,
      name:titreComplet,
      description,
      inLanguage:'fr-FR',
      isPartOf:{'@type':'WebSite','@id':'https://www.intimeconviction.fr/#site',name:'Intime Conviction',url:'https://www.intimeconviction.fr/'},
      ...(article ? {mainEntity:{'@id':canonique.href+'#article'}} : {})
    })} />
    <meta name="theme-color" content="#121314" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Intime Conviction" href={new URL('/feed.xml', Astro.site)} />
    {[policeSans].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  </head>
  <body class:list={{'avec-fond':accueil}}>
    <slot name="fond" />
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class:list={["barre", "cadre", { "barre-illustree": accueil }]} style={accueil ? `--croquis-entete: url("${croquisEntete.src}")` : undefined}>
        <div class="identite-journal">
          <Marque class="marque"><a href="/" aria-label="Intime Conviction, accueil"><span class="marque-mot"><span class="marque-intime">INTIME</span><span class="marque-conviction">CONVICTION<span class="marque-point">.</span></span></span></a></Marque>
          <p class="signature">Le journal des <strong>cours d’assises</strong></p>
          {edition && <p class="edition-date">Édition du <time datetime={edition.toISOString()}>{formatEdition.format(edition)} · {heureEdition.format(edition)}</time></p>}
        </div>
        <nav class="liens-entete" aria-label="Recherche, réseaux sociaux et espace lecteur">
          <a class="recherche-lien" href="/recherche/" aria-label="Rechercher dans les articles"><span>Rechercher</span><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a>
          <a class="edition-reseau" href={reseaux.x} aria-label="Intime Conviction sur X">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-7.5L5.4 22H2.3l7.3-8.4L1.8 2h6.5l4.4 6.8L18.9 2ZM17.8 20h1.7L7.3 4H5.5l12.3 16Z"/></svg>
          </a>
          <a class="edition-reseau" href={reseaux.instagram} aria-label="Intime Conviction sur Instagram">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a class="edition-reseau" href={reseaux.facebook} aria-label="Intime Conviction sur Facebook">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="currentColor"><path d="M14 22v-9h3l.5-3H14V8c0-.9.3-1.5 1.6-1.5H18V3.8c-.4-.1-1.6-.3-3-.3-3 0-5 1.8-5 5V10H7v3h3v9z"/></svg>
          </a>
          <a href="/connexion/">Se connecter</a>
          <a class="edition-abonnement" href="/abonnement/">S’abonner</a>
        </nav>
      </div>
      <div class="bande-navigation">
        <div class="cadre bande-navigation-interieur">
          <button class="navigation-bouton navigation-bouton-rubriques" type="button" aria-expanded="false" aria-controls="navigation-rubriques">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            Rubriques
          </button>
          <nav id="navigation-rubriques" class="navigation-principale" aria-label="Navigation principale">
            <ul>
              {navigation.map(lien=><li class="navigation-entree">
                <a href={lien.href} aria-current={courant(lien.href)}>{lien.titre}</a>
                <details name="navigation-principale" class="navigation-rubriques navigation-sous-menu">
                  <summary aria-label={`Sous-menu ${lien.titre}`}><svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></summary>
                  <ul>{lien.liens.map(l=> <li><a href={l.href}>{l.titre}</a></li>)}</ul>
                </details>
              </li>)}
              <li>
                <details name="navigation-principale" class="navigation-rubriques">
                  <summary>Analyses et culture <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></summary>
                  <ul>
                    {RUBRIQUES.filter(r=>!['cours-du-jour','la-cour-se-leve','le-banc-des-jures'].includes(r.slug)).map(r=>{
                      const href = `/rubrique/${r.slug}/`;
                      return <li><a href={href} aria-current={courant(href)}>{r.libelle}</a></li>;
                    })}
                  </ul>
                </details>
              </li>
            </ul>
          </nav>
          <details class="navigation-acces">
            <summary class="navigation-bouton">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
              Accès rapides
            </summary>
            <nav class="acces-directs" aria-label="Accès rapides">
              <ul>
                {accesDirects.map(({href, titre}) => (
                  <li><a href={href}>{titre}<span aria-hidden="true">↗</span></a></li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="contenu" class="cadre" tabindex="-1">
      <slot />
    </main>

    <footer class="pied">
      <div class="cadre">
        <div class="pied-intro"><a class="pied-nom" href="/">INTIME<br /><span>CONVICTION.</span></a><p>Le journal des cours d’assises. Actualité des procès criminels, analyses judiciaires et archives.</p></div>
        <nav class="pied-navigation" aria-label="Pied de page">
          {piedNavigation.map(groupe=><div>
            <h2>{groupe.titre}</h2>
            <ul>{groupe.liens.map(lien=><li><a href={lien.href}>{lien.titre}</a></li>)}</ul>
          </div>)}
        </nav>
        <div class="pied-bas"><span>Intime Conviction · {annee}</span><a href={reseaux.x} rel="noopener">@IntimeConv sur X</a><a href="#contenu">Retour en haut <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 20V4m-6 6 6-6 6 6"/></svg></a></div>
      </div>
    </footer>
  <script>
    const bande = document.querySelector('.bande-navigation');
    const bouton = bande?.querySelector<HTMLButtonElement>('.navigation-bouton-rubriques');
    const rubriques = bande?.querySelector<HTMLElement>('.navigation-principale');
    const acces = bande?.querySelector<HTMLDetailsElement>('.navigation-acces');
    const resumeAcces = acces?.querySelector('summary');
    const compact = window.matchMedia('(max-width: 63.99rem)');

    if (bande && bouton && rubriques && acces && resumeAcces) {
      bande.classList.add('navigation-interactive');

      function fermerSousMenus() {
        rubriques?.querySelectorAll<HTMLDetailsElement>('details[open]').forEach(menu => {
          menu.open = false;
        });
      }

      function fermerRubriques() {
        bouton?.setAttribute('aria-expanded', 'false');
        fermerSousMenus();
      }

      bouton.addEventListener('click', () => {
        if (bouton.getAttribute('aria-expanded') === 'true') {
          fermerRubriques();
        } else {
          acces.open = false;
          bouton.setAttribute('aria-expanded', 'true');
        }
      });

      resumeAcces.addEventListener('click', () => {
        if (!acces.open) fermerRubriques();
      });

      bande.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        const sousMenu = rubriques.querySelector<HTMLDetailsElement>('details[open]');
        if (sousMenu && sousMenu.contains(event.target as Node)) {
          sousMenu.open = false;
          sousMenu.querySelector('summary')?.focus();
        } else if (acces.open) {
          acces.open = false;
          resumeAcces.focus();
        } else if (bouton.getAttribute('aria-expanded') === 'true') {
          fermerRubriques();
          bouton.focus();
        } else if (sousMenu) {
          sousMenu.open = false;
        } else {
          return;
        }
        event.preventDefault();
      });

      bande.addEventListener('focusout', event => {
        if (event.relatedTarget instanceof Node && !bande.contains(event.relatedTarget)) {
          fermerRubriques();
          acces.open = false;
        }
      });

      document.addEventListener('pointerdown', event => {
        if (!(event.target instanceof Node)) return;
        if (!rubriques.contains(event.target) && !bouton.contains(event.target)) fermerRubriques();
        if (!acces.contains(event.target)) acces.open = false;
      });

      bande.addEventListener('click', event => {
        if (event.target instanceof Element && event.target.closest('a[href]')) {
          // Les liens d’ancrage gardent la même page ouverte.
          if (acces.contains(event.target)) resumeAcces.focus();
          else if (compact.matches) bouton.focus();
          else event.target.closest('details')?.querySelector('summary')?.focus();
          fermerRubriques();
          acces.open = false;
        }
      });

      compact.addEventListener('change', () => {
        const focusDansLesRubriques = rubriques.contains(document.activeElement);
        const focusSurLeBouton = document.activeElement === bouton;
        fermerRubriques();
        if (compact.matches && focusDansLesRubriques) bouton.focus();
        if (!compact.matches && focusSurLeBouton) rubriques.querySelector('a')?.focus();
      });
    }
  </script>
  <style is:global>
    /* Identité éditoriale commune à l'ensemble du site. */
    .entete,.avec-fond .entete{background:#f7f5f0;color:#22282a;border-top:3px solid #9b303d;border-bottom:0}
    .entete .barre{min-height:124px;display:flex;align-items:center;justify-content:space-between;gap:.75rem 1.25rem;flex-wrap:wrap}
    .entete .barre-illustree{position:relative;isolation:isolate}
    .barre-illustree::before{
      content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
      background:linear-gradient(90deg,#f7f5f0 15%,#f7f5f000 65%),var(--croquis-entete) 75% 57% / clamp(34rem,62vw,62rem) auto no-repeat;
      mix-blend-mode:multiply;opacity:.23
    }
    @media(max-width:47.99rem){
      .barre-illustree::before{background-position:0 0, right 55%;background-size:auto,27rem auto;opacity:.16}
    }
    .edition-date{margin:.1rem 0 0;color:#565052;font:650 .73rem/1.4 var(--sans)}
    .liens-entete{display:flex;flex-wrap:wrap;align-items:center;gap:.3rem;margin-inline-start:auto}
    .entete .liens-entete a:not(.recherche-lien){display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:.25rem .55rem;color:#303638;font:700 .75rem/1.3 var(--sans);white-space:nowrap}
    .entete .liens-entete a:hover{text-decoration:underline}
    .entete .liens-entete a:focus-visible{outline:2px solid #9b303d;outline-offset:2px}
    .entete .liens-entete .edition-reseau{min-width:44px}
    .entete .liens-entete .edition-abonnement:not(.recherche-lien){background:#a12c39;color:#fff;padding-inline:.75rem}
    .identite-journal{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-width:0;padding:1.15rem 0 1rem;gap:.5rem}
    .identite-journal .marque{margin:0}
    .identite-journal .marque a{display:inline-flex;min-height:0;padding:0;font:750 clamp(2.2rem,4.3vw,4.1rem)/.98 var(--sans);letter-spacing:-.067em}
    .identite-journal .marque-mot{display:inline-flex;align-items:center;gap:.13em;white-space:nowrap}
    .identite-journal .marque-intime{color:#252a2d}
    .identite-journal .marque-conviction{display:inline-block;background:#a12c39;color:#fff;padding:.13em .16em .16em;line-height:1}
    .identite-journal .marque-point{color:#fff}
    .identite-journal .signature,.avec-fond .identite-journal .signature{display:flex;align-items:center;gap:.85rem;margin:.23rem 0 0;padding:0;font:700 clamp(.96rem,1.32vw,1.12rem)/1.35 var(--sans);letter-spacing:.012em;text-transform:none;max-width:none;color:#363b3e}
    .identite-journal .signature strong{font:700 1.23em/1.1 var(--serif);text-transform:uppercase;letter-spacing:.02em}
    .identite-journal .signature{column-gap:.35rem}
    .identite-journal .signature::before{content:'';display:block;flex:none;width:32px;height:3px;background:#a12c39}
    .entete .recherche-lien{display:inline-flex;gap:.6rem;width:auto;min-width:0;min-height:44px;height:44px;border:1px solid #bbb4ad;color:#303638;border-radius:0;margin-left:auto;padding:.5rem .85rem;font:650 .75rem/1.3 var(--sans)}
    .entete .recherche-lien span{position:static;width:auto;height:auto;overflow:visible;clip-path:none;white-space:nowrap}
    .entete .recherche-lien svg{width:18px;height:18px}
    .entete .recherche-lien:hover,.avec-fond .entete .recherche-lien:hover{background:#9b303d;border-color:#9b303d;color:#fff!important}
    .bande-navigation{position:relative;z-index:20;background:#edeae4;border-block:1px solid #d8d2cb}
    .bande-navigation-interieur{position:relative;display:flex;align-items:stretch;gap:.55rem}
    .bande-navigation ul{list-style:none;margin:0;padding:0}
    .navigation-principale{flex:1;min-width:0}
    .navigation-principale>ul{display:flex;align-items:stretch;justify-content:space-between;gap:.2rem}
    .navigation-principale>ul>li{position:relative;min-width:0}
    .navigation-entree{display:flex;align-items:stretch}
    .bande-navigation :is(a,summary,button){display:flex;align-items:center;justify-content:center;gap:.35rem;min-height:44px;padding:.35rem .45rem;color:#303638;font:750 .76rem/1.25 var(--sans);text-transform:uppercase}
    .entete .recherche-lien{text-transform:uppercase}
    .bande-navigation :is(summary,button){cursor:pointer;list-style:none}
    .bande-navigation summary::-webkit-details-marker{display:none}
    .navigation-sous-menu summary{min-width:32px;padding-inline:.35rem}
    .navigation-rubriques[open]>summary svg{transform:rotate(180deg)}
    .bande-navigation :is(a,summary,button):hover,.bande-navigation a[aria-current="page"],.bande-navigation [aria-expanded="true"],.bande-navigation details[open]>summary{background:#e8ddd8;color:#842631}
    .bande-navigation a[aria-current="page"]{box-shadow:inset 0 -2px #9b303d}
    .bande-navigation :is(a,summary,button):focus-visible,.entete .recherche-lien:focus-visible,.entete .marque a:focus-visible{outline:2px solid #9b303d;outline-offset:-2px}
    .bande-navigation .navigation-bouton-rubriques{display:none;border:0;background:transparent}
    .navigation-acces{position:relative;border-inline-start:1px solid #d8d2cb}
    .bande-navigation .navigation-acces>summary{padding-inline:.75rem;white-space:nowrap}
    .navigation-rubriques>ul,.acces-directs{position:absolute;top:100%;left:0;width:16rem;background:#f7f5f0;border:1px solid #c8bdb4;box-shadow:0 8px 18px #22282a26}
    .navigation-principale>ul>li:last-child .navigation-rubriques>ul,.acces-directs{left:auto;right:0}
