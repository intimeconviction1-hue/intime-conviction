---
// Newsreader en graisse variable seule (122 Ko romain + italique, contre 279
// pour la version à axe optique) et Libre Franklin pour la voix « journal ».
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/libre-franklin/wght.css';
import '../styles/global.css';
// Les deux fichiers du premier écran, préchargés : sans ça, les titres
// s'affichent d'abord dans la police de secours puis « sautent ».
import policeTexte from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import policeSans from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import { RUBRIQUES } from '../lib/rubriques.mjs';

const { titre, description = "Intime Conviction, le média des cours d'assises : suivi d'audience, règles du procès, chroniques et culture criminelle.", rubriqueActive, accueil = false } = Astro.props;
// Le nom du journal est le titre principal (h1) de la seule page d'accueil ;
// ailleurs c'est un paragraphe, le h1 revenant au titre de la page.
const Marque = accueil ? 'h1' : 'p';
const titreComplet = titre ? `${titre} · Intime Conviction` : "Intime Conviction · Le média des cours d'assises";
const canonique = new URL(Astro.url.pathname, Astro.site);
const annee = new Date().getFullYear();
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101010" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {[policeTexte, policeSans].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="cadre">
        <div class="journal-identite"><p class="signature">Le média des cours d’assises</p><Marque class="marque"><a href="/">Intime Conviction</a></Marque></div><a class="recherche-lien" href="/recherche/">Rechercher <span aria-hidden="true">↗</span></a>
        <nav class="rubriques-nav" aria-label="Rubriques">
          <ul>
            <li><a href="/#actualites">Actualités</a></li>
            {RUBRIQUES.map((r) => (
              <li><a href={`/rubrique/${r.slug}/`} aria-current={rubriqueActive === r.slug ? 'page' : undefined}>{r.nom}</a></li>
            ))}
            <li><a href="/archives/" aria-current={rubriqueActive === 'archives' ? 'page' : undefined}>Archives</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenu" class="cadre">
      <slot />
    </main>

    <footer class="pied">
      <div class="cadre">
        <div>
          <p class="marque"><a href="/">Intime Conviction</a></p>
          <p>Le média des cours d'assises : suivi d'audience, règles du procès, chroniques et culture criminelle.</p>
        </div>
        <ul>
          <li><a href="/#actualites">Actualités</a></li>
          {RUBRIQUES.map((r) => <li><a href={`/rubrique/${r.slug}/`}>{r.nom}</a></li>)}
          <li><a href="/archives/">Archives</a></li>
          <li><a href="https://x.com/IntimeConv" rel="noopener">@IntimeConv sur X</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
