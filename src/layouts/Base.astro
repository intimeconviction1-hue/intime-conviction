---
import '@fontsource-variable/libre-franklin/wght.css';
import '@fontsource-variable/newsreader/wght.css';
import '../styles/global.css';
import frontonAssises from '../assets/fronton-cour-dassises.jpg';
import policeTitres from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import { tousLesArticles } from '../lib/articles.mjs';
import { RUBRIQUES } from '../lib/rubriques.mjs';
import ConsentementEditorial from '../components/ConsentementEditorial.astro';

const { titre, description = "Intime Conviction, journal consacré aux procès criminels : actualité des audiences, verdicts, analyses et archives judiciaires.", accueil = false, noindex = false, cheminCanonique = Astro.url.pathname, image, article, imageAlt = "Image d'Intime Conviction" } = Astro.props;
// Le nom du journal est le titre principal (h1) de la seule page d'accueil ;
// ailleurs c'est un paragraphe, le h1 revenant au titre de la page.
const Marque = 'p';
const titreComplet = titre ? `${titre} · Intime Conviction` : "Intime Conviction | Le journal des cours d'assises";
// Titres de recherche distincts des titres éditoriaux, relus par affaire.
const titresRecherche = {
  "bouches-du-rhone-acquittement-assassinat-association-malfaiteurs-indemnisation": "Assassinat : pourquoi un acquitté doit indemniser les proches",
  "camille-paul-basse-terre-enregistrement-verdict": "Affaire Camille Paul : un enregistrement aux assises",
  "carine-charpentier-aisne-leroux-verdict-perles": "Meurtre de Carine Charpentier : Laurent Leroux condamné",
  "caro-coups-au-telephone-version-defense": "Caro : douze ans de réclusion, l’intention de tuer en débat",
  "chahinez-daoud-boutaa-perigueux-discernement": "Chahinez Daoud : Mounir Boutaa conteste la perpétuité",
  "charente-assises-romain-runel-ouverture-proces": "Charente : Romain Runel jugé pour viols et torture présumés",
  "colmar-mulhouse-viol-reunion-proces-renvoye": "Colmar : procès pour viol en réunion reporté",
  "duchere-lyon-enregistrement-audience-paroles-sous-scelles": "Procès de la Duchère : les débats enregistrés à Lyon",
  "duchere-lyon-proces-absence-ben-addi": "Procès de la Duchère : le dossier Ben Addi disjoint",
  "eleonore-douai-verdict-neuville-saint-remy": "Douai : les dernières photos d’Éléonore devant les jurés",
  "enver-hadri-nivelles-parties-civiles-dossier-draskovic": "Enver Hadri : le rôle de Draskovic examiné à Nivelles",
  "evry-meurtre-sabine-appel-au-17": "Meurtre de Sabine à Évry : l’appel au 17 et le témoignage",
  "grasse-nora-mike-furlad-trente-ans-intention-contestee": "Mort de Nora à Grasse : Mike Furlad condamné pour meurtre",
  "grenoble-henry-duffourd-tentative-meurtre-quatre-condamnations": "Grenoble : quatre condamnations après un tir",
  "guadeloupe-proces-assises-mineurs-mandat-arret": "Guadeloupe : procès aux assises renvoyé",
  "jean-joseph-clement-heaulme-aveux-renvoi-conteste": "Francis Heaulme : aveux rétractés et renvoi contesté",
  "jean-paul-benjamin-bobigny-images-legitime-defense": "Jean-Paul Benjamin : la légitime défense écartée à Bobigny",
  "karen-baldi-proces-chambery-protection-premeditation": "Karen Baldi : procès pour assassinat et protection",
  "la-duchere-proces-guerre-sans-fiston": "La Duchère : le procès sans son principal accusé",
  "luca-toulouse-soiree-amis-premeditation-verdict": "Meurtre de Luca à Toulouse : préméditation retenue",
  "manosque-deux-chocs-intention-contestee-digne": "Manosque : deux chocs et une intention de tuer contestée",
  "martinique-morne-acajou-frere-ronny-william": "Morne Acajou : un homme jugé pour la mort de son frère",
  "nahel-merzouk-versailles-intention-du-tir": "Mort de Nahel : renvoi du policier pour meurtre",
  "orlan-melon-liege-balistique-peine-brandon-mathy": "Affaire Orlan Melon : la balistique au procès à Liège",
  "papeete-derniere-session-assises-dossiers-viol-2026": "Assises de Papeete : cinq dossiers de viol sur mineur",
  "puy-en-velay-hotel-tentative-meurtre-verdict": "Le Puy-en-Velay : l’intention de tuer retenue",
  "roubaix-square-bousquet-tir-mehdi-proces-douai": "Tir à Roubaix : la victime témoigne aux assises de Douai",
  "rue-des-rosiers-extradition-appel-renvoi": "Rue des Rosiers : extradition et appel du renvoi",
  "sainte-rose-minorite-quinze-ans": "Meurtre à Sainte-Rose : quinze ans et excuse de minorité",
  "samia-mimoun-maurepas-legitime-defense-verdict": "Samia Mimoun : la cour retient le meurtre à Versailles",
  "sarah-sadani-temoin-rescapee-fusillade-proces-aix": "Sarah Sadani : le témoignage d’une rescapée de la fusillade",
  "yordan-arron-basse-terre-desistement-appel": "Basse-Terre : Yordan Arron retire son appel"
};
const cleArticle = cheminCanonique.split('/').filter(Boolean)[0];
const titreRecherche = accueil ? "Cour d’assises : actualité, procès et verdicts | Intime Conviction" : (article && titresRecherche[cleArticle]) || (titre && titreComplet.length > 60 ? titre : titreComplet);
// Ne jamais couper une phrase judiciaire au milieu : garder un extrait complet
// si aucune phrase autonome suffisamment informative ne tient dans la cible.
const descriptionsRecherche = {
  "bouches-du-rhone-acquittement-assassinat-association-malfaiteurs-indemnisation": "Acquitté de l’assassinat, un homme reste condamné pour association de malfaiteurs. Pourquoi doit-il indemniser les proches de la victime ?",
  "camille-paul-basse-terre-enregistrement-verdict": "Au procès de Pascal Velayoudom à Basse-Terre, un enregistrement est examiné par la cour. Retour sur les débats dans l’affaire Camille Paul.",
  "carine-charpentier-aisne-leroux-verdict-perles": "La cour d’assises de l’Aisne a condamné Laurent Leroux à vingt-deux ans de réclusion pour le meurtre de sa compagne, Carine Charpentier.",
  "caro-coups-au-telephone-version-defense": "Arsène Marchand a été condamné à douze ans de réclusion aux assises du Morbihan. Retour sur les débats autour de l’intention de tuer.",
  "carte": "Explorez la carte des affaires judiciaires suivies par Intime Conviction et situez les cours d’assises et autres juridictions concernées.",
  "chahinez-daoud-boutaa-perigueux-discernement": "Au procès en appel de l’affaire Chahinez Daoud, Mounir Boutaa conteste la peine de perpétuité. Retour sur l’ouverture des débats à Périgueux.",
  "charente-assises-romain-runel-ouverture-proces": "Le 23 novembre, les assises de Charente ont ouvert un procès portant sur des accusations de viols et de torture dans un entourage familial.",
  "chronologie": "Retrouvez les étapes judiciaires documentées des affaires suivies par Intime Conviction : audiences, décisions et chronologies des dossiers.",
  "colmar-mulhouse-viol-reunion-proces-renvoye": "À Colmar, le procès de deux hommes accusés de viol en réunion a été reporté le 23 novembre après l’absence de l’un des accusés.",
  "duchere-lyon-enregistrement-audience-paroles-sous-scelles": "À Lyon, le président de la cour ordonne l’enregistrement des débats du procès de la Duchère. Un éclairage sur cette pratique judiciaire.",
  "enver-hadri-nivelles-parties-civiles-dossier-draskovic": "Aux assises du Brabant wallon, la famille d’Enver Hadri demande que la culpabilité d’Andrija Draskovic soit retenue. Retour sur les débats.",
  "evry-meurtre-sabine-appel-au-17": "Au procès du meurtre de Sabine, la cour d’assises de l’Essonne entend un appel au 17 enregistré en 2022 et le témoignage de sa fille.",
  "grasse-nora-mike-furlad-trente-ans-intention-contestee": "Mike Furlad a été condamné pour le meurtre de Nora à Grasse. Il soutenait avoir blessé sa compagne par accident. Retour sur le verdict.",
  "grenoble-henry-duffourd-tentative-meurtre-quatre-condamnations": "Quatre condamnations après un tir dans un appartement de Grenoble, dont une pour tentative de meurtre. Retour sur la décision de justice.",
  "guadeloupe-proces-assises-mineurs-mandat-arret": "Le 23 novembre, la cour d’assises des mineurs de Guadeloupe a renvoyé un procès après l’absence de l’accusé à l’ouverture de l’audience.",
  "jean-joseph-clement-heaulme-aveux-renvoi-conteste": "Francis Heaulme conteste son renvoi devant les assises dans l’affaire Jean-Joseph Clément. Retour sur les aveux rétractés et les enjeux judiciaires.",
  "jean-paul-benjamin-bobigny-images-legitime-defense": "Mort de Jean-Paul Benjamin : la cour criminelle de Seine-Saint-Denis a condamné le policier à cinq ans de prison et écarté la légitime défense.",
  "jurisprudence": "Comprendre la jurisprudence pénale, les décisions de la Cour de cassation et les différences entre appel et pourvoi en cassation.",
  "karen-baldi-proces-chambery-protection-premeditation": "Au procès Karen Baldi à Chambéry, Georges Damiano reconnaît les faits matériels mais conteste l’intention de tuer. Retour sur les débats.",
  "la-duchere-proces-guerre-sans-fiston": "À Lyon, le procès de la Duchère s’ouvre en l’absence de son principal accusé. Intime Conviction revient sur les enjeux de cette affaire criminelle.",
  "ligne-editoriale": "Découvrez la ligne éditoriale d’Intime Conviction : raconter les audiences, expliquer les procès criminels et rendre la justice accessible.",
  "luca-toulouse-soiree-amis-premeditation-verdict": "Au procès du meurtre de Luca à Toulouse, la cour retient la préméditation, contestée par la défense. Retour sur les débats et le verdict.",
  "manosque-deux-chocs-intention-contestee-digne": "À Digne, un conducteur reconnaît avoir volontairement percuté un homme à Manosque, mais conteste l’intention de tuer. Retour sur le procès.",
  "martinique-morne-acajou-frere-ronny-william": "En Martinique, la mort de William au Morne Acajou conduit son frère devant la justice. Retour sur les faits et les enjeux du procès.",
  "nahel-merzouk-versailles-intention-du-tir": "Mort de Nahel : la chambre de l’instruction de Versailles retient des charges suffisantes pour renvoyer le policier devant les assises pour meurtre.",
  "orlan-melon-liege-balistique-peine-brandon-mathy": "À Liège, Brandon Mathy a été reconnu coupable d’assassinat et condamné à trente ans. Retour sur la balistique et les débats du procès.",
  "papeete-derniere-session-assises-dossiers-viol-2026": "Sept affaires figurent au rôle des assises de Papeete du 24 novembre au 11 décembre 2026, dont cinq dossiers de viol sur mineur.",
  "puy-en-velay-hotel-tentative-meurtre-verdict": "Au Puy-en-Velay, la victime témoigne le 23 novembre. La cour retient l’intention de tuer. Retour sur les débats et le verdict.",
  "roubaix-square-bousquet-tir-mehdi-proces-douai": "Blessé par balle à Roubaix en avril 2020, Mehdi témoigne au deuxième jour du procès devant la cour d’assises de Douai.",
  "rue-des-rosiers-extradition-appel-renvoi": "Affaire de la rue des Rosiers : la Cour de cassation rejette le recours d’un accusé extradé. Explication des enjeux de l’appel du renvoi.",
  "sainte-rose-minorite-quinze-ans": "À Sainte-Rose, la cour d’assises des mineurs prononce quinze ans de réclusion. Explication du plafond de peine lié à l’excuse de minorité.",
  "samia-mimoun-maurepas-legitime-defense-verdict": "Samia Mimoun reconnaît le coup mortel porté à Alexandre Millet à Maurepas et invoque la légitime défense. La cour retient le meurtre.",
  "sarah-sadani-temoin-rescapee-fusillade-proces-aix": "Aux assises à Aix, une survivante de la fusillade qui a tué Sarah Sadani témoigne de ce qu’elle a entendu, sans avoir vu les tireurs.",
  "yordan-arron-basse-terre-desistement-appel": "À Basse-Terre, Yordan Arron retire son appel à l’ouverture de l’audience prévue pour rejuger deux séries de violences sur des nourrissons."
};
const descriptionRecherche = (() => {
  if (Object.hasOwn(descriptionsRecherche, cleArticle) && (article || cheminCanonique === '/' + cleArticle + '/')) return descriptionsRecherche[cleArticle];
  if (description.length <= 160) return description;
  const phrases = Array.from(new Intl.Segmenter('fr', {granularity:'sentence'}).segment(description), p => p.segment).filter(Boolean);
  let extrait = '';
  for (const phrase of phrases) {
    if ((extrait + phrase).trim().length > 160) break;
    extrait += phrase;
  }
  // Une seconde phrase peut porter une réserve ou une contestation essentielle.
  // Ne raccourcir automatiquement que les pages non judiciaires.
  return !article && extrait.trim().length >= 70 ? extrait.trim() : description;
})();
const canonique = new URL(cheminCanonique, Astro.site);
// À l'accueil, une image éditoriale propre au journal ; chaque article pourra
// fournir sa propre photographie sans illustration trompeuse.
const imagePartage = image ? new URL(image, Astro.site).href : (accueil ? new URL(frontonAssises.src, Astro.site).href : null);
const dimensionsImage = image ? article?.imageDimensions : (accueil ? frontonAssises : null);
const imageStructuree = imagePartage ? { '@type':'ImageObject', url:imagePartage, ...(dimensionsImage?.width && dimensionsImage?.height ? {width:dimensionsImage.width,height:dimensionsImage.height} : {}), caption:image ? imageAlt : "Fronton d'une cour d'assises" } : null;
const annee = new Date().getFullYear();
const articlesEdition = await tousLesArticles();
const edition = articlesEdition.find(({data}) => data.verificationEnCours !== true)?.data.date;
const formatEdition = new Intl.DateTimeFormat('fr-FR', {
  timeZone: 'Europe/Paris', day: 'numeric', month: 'long', year: 'numeric',
});
const heureEdition = new Intl.DateTimeFormat('fr-FR', {
  timeZone: 'Europe/Paris', hour: '2-digit', minute: '2-digit',
});
const reseaux = {
  x: 'https://x.com/IntimeConv',
  instagram: 'https://www.instagram.com/inti.meconviction/',
  facebook: 'https://www.facebook.com/profile.php?id=100062932463597',
};
const navigation = [
  { titre: 'Actualité', href: '/rubrique/cours-du-jour/#articles-redaction', liens: [
    {titre:'Chroniques d’audience',href:'/rubrique/la-cour-se-leve/'},
  ] },
  { titre: 'Agenda', href: '/agenda/', liens: [
    {titre:'Les sessions',href:'/agenda/#sessions-annoncees'},
    {titre:'Les procès au rôle',href:'/agenda/#audiences-a-verifier'},
    {titre:'Les rôles',href:'/veille-roles/'},
    {titre:'Trouver une cour d’assises',href:'/annuaire/#repertoire'},
    {titre:'Assister à une audience',href:'/assister/'},
  ] },
  { titre: 'Dossiers', href: '/dossiers/', liens: [
    {titre:'Grandes affaires',href:'/dossiers/'},
    {titre:'Analyses et dossiers',href:'/rubrique/l-expose/'},
    {titre:'Archives judiciaires',href:'/archives/'},
    {titre:'Carte des affaires',href:'/carte/'},
  ] },
  { titre: 'Comprendre', href: '/comprendre/', liens: [
    {titre:'Les acteurs du procès et les jurés',href:'/rubrique/le-banc-des-jures/'},
    {titre:'Opinions et débats',href:'/rubrique/delibere/'},
    {titre:'Jurisprudence',href:'/jurisprudence/'},
  ] },
];
const piedNavigation = [
  { titre: 'Le journal', liens: [
    ...RUBRIQUES.map(r=>({titre:r.libelle,href:`/rubrique/${r.slug}/`})),
    {titre:'Archives du journal',href:'/archives/'},
    {titre:'Revue de presse',href:'/revue-de-presse/'},
  ] },
  { titre: 'Agenda et accès aux assises', liens: [
    {titre:'Les sessions et les procès au rôle',href:'/agenda/'},
    {titre:'Les rôles',href:'/veille-roles/'},
    {titre:'Trouver une cour d’assises',href:'/annuaire/#repertoire'},
    {titre:'Assister à une audience',href:'/assister/'},
  ] },
  { titre: 'À propos', liens: [
    {titre:'Ligne éditoriale',href:'/ligne-editoriale/'},
    {titre:'Flux RSS',href:'/feed.xml'},
    {titre:'Boutique',href:'/boutique/'},
    {titre:'Confidentialité',href:'/confidentialite/'},
    {titre:'Mentions légales',href:'/mentions-legales/'},
  ] },
];
const courant = href => Astro.url.pathname === href.split('#')[0] ? 'page' : undefined;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreRecherche}</title>
    <meta name="description" content={descriptionRecherche} />
    <meta name="robots" content={noindex ? "noindex,follow" : "max-image-preview:large"} />
    {accueil && <script is:inline>
      // Les pages statiques ne peuvent pas varier leurs balises selon la query string.
      // Ces anciennes URL de pagination ne sont que des variantes de l’accueil.
      const params = new URLSearchParams(window.location.search);
      if ([...params.keys()].some(key => /^query-\\d+-page$/.test(key))) {
        document.querySelector('meta[name="robots"]')?.setAttribute('content', 'noindex,follow');
      }
    </script>}
    <link rel="canonical" href={canonique} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:site_name" content="Intime Conviction" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.datePublished} />}
    {article?.dateModified && <meta property="article:modified_time" content={article.dateModified} />}
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    {imagePartage && <meta property="og:image" content={imagePartage} />}
    {imagePartage && dimensionsImage?.width && <meta property="og:image:width" content={String(dimensionsImage.width)} />}
    {imagePartage && dimensionsImage?.height && <meta property="og:image:height" content={String(dimensionsImage.height)} />}
    {imagePartage && <meta property="og:image:alt" content={image ? imageAlt : "Fronton d'une cour d'assises"} />}
    {article && <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@type':article.type,
      '@id':canonique.href+'#article',
      headline:article.headline,
      description,
      datePublished:article.datePublished,
      ...(article.dateModified ? { dateModified:article.dateModified } : {}),
      ...(article.author ? { author:{'@type':article.authorType,name:article.author,...(article.authorType === 'Organization' ? {url:new URL('/ligne-editoriale/',Astro.site).href} : {})} } : {}),
      publisher:{'@id':'https://www.intimeconviction.fr/#organisation'},
      ...(imageStructuree ? {image:[imageStructuree]} : {}),
      ...(article.section ? {articleSection:article.section} : {}),
      mainEntityOfPage:canonique.href,
      isAccessibleForFree:true,
      inLanguage:'fr-FR'
    })} />}
    <meta name="twitter:site" content="@IntimeConv" />
    <meta name="twitter:card" content={imagePartage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    {imagePartage && <meta name="twitter:image" content={imagePartage} />}
    {imagePartage && <meta name="twitter:image:alt" content={image ? imageAlt : "Fronton d'une cour d'assises"} />}
    {accueil && <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'WebSite', '@id':'https://www.intimeconviction.fr/#site', name:'Intime Conviction', alternateName:'Le journal des cours d’assises', url:'https://www.intimeconviction.fr/', description, inLanguage:'fr-FR' })} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@type':'Organization',
      '@id':'https://www.intimeconviction.fr/#organisation',
      name:'Intime Conviction',
      url:'https://www.intimeconviction.fr/',
      description:"Média français consacré aux procès criminels, aux cours d'assises et à la justice pénale.",
      logo:new URL('/favicon.svg',Astro.site).href,
      sameAs:Object.values(reseaux)
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@type':'WebPage',
      '@id':canonique.href+'#page',
      url:canonique.href,
      name:titreComplet,
      description,
      inLanguage:'fr-FR',
      isPartOf:{'@type':'WebSite','@id':'https://www.intimeconviction.fr/#site',name:'Intime Conviction',url:'https://www.intimeconviction.fr/'},
      ...(article ? {mainEntity:{'@id':canonique.href+'#article'}} : {})
    })} />
    <meta name="theme-color" content="#fcfaf6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Intime Conviction" href={new URL('/feed.xml', Astro.site)} />
    <link rel="preload" as="font" type="font/woff2" href={policeTitres} crossorigin />
  </head>
  <body class:list={{'avec-fond':accueil}}>
    <slot name="fond" />
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <div class="barre cadre">
        <div class="identite-journal">
          <Marque class="marque"><a href="/" aria-label="Intime Conviction, accueil"><span class="sceau-journal" aria-hidden="true"><span>IC</span></span><span class="marque-mot">INTIME <span class="marque-conviction">CONVICTION</span></span></a></Marque>
          <div class="identite-meta">
            <p class="signature">Le journal des cours d’assises</p>
            {edition && <p class="edition-date">Édition du <time datetime={edition.toISOString()}>{formatEdition.format(edition)} · {heureEdition.format(edition)}</time></p>}
            <nav class="reseaux-entete" aria-label="Suivre Intime Conviction sur les réseaux sociaux">
              <a href={reseaux.x} aria-label="X (Twitter)" title="X"><svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-7.5L5.4 22H2.3l7.3-8.4L1.8 2h6.5l4.4 6.8L18.9 2ZM17.8 20h1.7L7.3 4H5.5l12.3 16Z"/></svg></a>
              <a href={reseaux.instagram} aria-label="Instagram" title="Instagram"><svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
              <a href={reseaux.facebook} aria-label="Facebook" title="Facebook"><svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="currentColor"><path d="M14 22v-9h3l.5-3H14V8c0-.9.3-1.5 1.6-1.5H18V3.8c-.4-.1-1.6-.3-3-.3-3 0-5 1.8-5 5V10H7v3h3v9z"/></svg></a>
            </nav>
          </div>
        </div>
        <div class="liens-entete">
          <form class="recherche-entete" action="/recherche/" method="get" role="search" aria-label="Rechercher dans le journal">
            <input type="search" name="q" aria-label="Nom, ville ou affaire" placeholder="Rechercher" enterkeyhint="search" />
